class DKUpgrade_Skill_TaxLoopholes extends DKUpgrade_Skill
	config(ZedternalUnlimited);

var config array<int> TaxRefundAmount;
var config int SpendingThreshold;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.TaxRefundAmount[0] = 150;
		default.TaxRefundAmount[1] = 300;
		default.SpendingThreshold = 5000;

		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


static simulated function InitiateWeapon(int upgLevel, KFWeapon KFW, KFPawn OwnerPawn)
{
    local DKUpgrade_Skill_TaxLoopholes_Helper UPG;
    local bool bFound;

    if (KFPawn_Human(OwnerPawn) != None && OwnerPawn.Role == Role_Authority)
    {
        bFound = False;
        foreach OwnerPawn.ChildActors(class'DKUpgrade_Skill_TaxLoopholes_Helper', UPG)
        {
            bFound = True;
            break;
        }

        if (!bFound)
        {
            UPG = OwnerPawn.Spawn(class'DKUpgrade_Skill_TaxLoopholes_Helper', OwnerPawn);
            UPG.bDeluxe = (upgLevel > 1);
            UPG.UpgradeLevel = upgLevel;
        }
    }
}

static simulated function DeleteHelperClass(Pawn OwnerPawn)
{
    local DKUpgrade_Skill_TaxLoopholes_Helper UPG;

    if (OwnerPawn != None)
    {
        foreach OwnerPawn.ChildActors(class'DKUpgrade_Skill_TaxLoopholes_Helper', UPG)
        {
            UPG.Destroy();
        }
    }
}

defaultproperties
{
    // --- Localization (auto-generated by mass_localize_dk_upgrades.py) ---
    // Strings live in KFGame/Localization/<lang>/ZedternalRBPerkpackage.<langext>
    // Section: [DKUpgrade_Skill_TaxLoopholes]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalRBPerkpackage"
    LocSection="DKUpgrade_Skill_TaxLoopholes"

    UpgradeName="Tax Loopholes"
    
    upgradeDescription(0)="Every <font color=\"#ff6600\">5000 dosh spent</font>, get <font color=\"#00ff00\">150 dosh</font> tax refund."
    upgradeDescription(1)="Every <font color=\"#ff6600\">5000 dosh spent</font>, get <font color=\"#00ff00\">300 dosh</font> tax refund."
    
    UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_TaxLoopholes'
    UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_TaxLoopholes_Deluxe'

    Name="Default__DKUpgrade_Skill_TaxLoopholes"
}