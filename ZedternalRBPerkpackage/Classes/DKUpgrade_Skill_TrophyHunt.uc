class DKUpgrade_Skill_TrophyHunt extends DKUpgrade_Skill
	config(ZedternalUnlimited);

// Theme: The apex predator hunts the biggest game
var config array<float> Damage;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.Damage[0] = 0.25f;
		default.Damage[1] = 0.6f;

		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


static function ModifyDamageGiven(out int InDamage, int DefaultDamage, int upgLevel, optional Actor DamageCauser, optional KFPawn_Monster MyKFPM, optional KFPlayerController DamageInstigator, optional class<KFDamageType> DamageType, optional int HitZoneIdx, optional KFWeapon MyKFW)
{
	// Detect "big game": large zeds (bLargeZed) plus bosses. Bosses are matched
	// two ways because they don't all flag themselves identically: IsABoss() is
	// overridden on KFPawn_MonsterBoss-derived bosses, while bosses built on
	// existing zeds (Fleshpound/Bloat King) implement KFInterface_MonsterBoss
	// instead -- IsABoss() alone misses those. Instance-style calls dynamic-
	// dispatch on the pawn's real class (matches the rest of the codebase, e.g.
	// the Detonator helper) rather than the declared KFPawn_Monster type.
	if (MyKFPM != None && (MyKFPM.IsLargeZed() || MyKFPM.IsABoss() || KFInterface_MonsterBoss(MyKFPM) != None))
		InDamage += Round(float(DefaultDamage) * default.Damage[upgLevel - 1]);
}

defaultproperties
{

    // --- Localization (auto-generated by mass_localize_dk_upgrades.py) ---
    // Strings live in KFGame/Localization/<lang>/ZedternalRBPerkpackage.<langext>
    // Section: [DKUpgrade_Skill_TrophyHunt]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalRBPerkpackage"
    LocSection="DKUpgrade_Skill_TrophyHunt"

	UpgradeName="Trophy Hunt"
	UpgradeDescription(0)="<font color=\"#4682B4\">Trophy Hunt:</font> Deal <font color=\"#FFFFFF\">+25%</font> <font color=\"#87CEEB\">damage</font> to <font color=\"#F0F8FF\">Large Zeds</font> and <font color=\"#F0F8FF\">Bosses</font>"
	UpgradeDescription(1)="<font color=\"#4682B4\">Trophy Hunt:</font> Deal <font color=\"#FFFFFF\">+60%</font> <font color=\"#87CEEB\">damage</font> to <font color=\"#F0F8FF\">Large Zeds</font> and <font color=\"#F0F8FF\">Bosses</font>"

	UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_TrophyHunt'
	UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_TrophyHunt_Deluxe'

	Name="Default__DKUpgrade_Skill_TrophyHunt"
}
