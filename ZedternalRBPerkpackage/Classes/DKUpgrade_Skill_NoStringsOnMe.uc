class DKUpgrade_Skill_NoStringsOnMe extends DKUpgrade_Skill
	config(ZedternalUnlimited);

var config array<float> Health;
var config array<float> Haste;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.Health[0] = 0.40f;
		default.Health[1] = 0.60f;
		default.Haste[0] = 0.15f;
		default.Haste[1] = 0.30f;

		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


static function ModifyHealth(out int InHealth, int DefaultHealth, int upgLevel)
{
	InHealth -= (DefaultHealth * default.Health[upgLevel - 1]);
}

static simulated function ModifySpeedPassive(out float speedFactor, int upgLevel)
{
    speedFactor += (default.Haste[upgLevel - 1]);
}

defaultproperties
{
    // --- Localization (auto-generated by mass_localize_dk_upgrades.py) ---
