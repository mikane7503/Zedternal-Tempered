    // Section: [DKUpgrade_Skill_NoStringsOnMe]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalRBPerkpackage"
    LocSection="DKUpgrade_Skill_NoStringsOnMe"

    UpgradeName="No Strings On Me"
    upgradeDescription(0)="<font color=\"#962ab9\">Decrease</font> your <font color=\"#962ab9\">Maximum Health</font> by <font color=\"#cb1b43\">40</font>. You gain <font color=\"#84d6d0\">15% Movement Speed</font> for every ZED you kill."
    upgradeDescription(1)="<font color=\"#962ab9\">Decrease</font> your <font color=\"#962ab9\">Maximum Health</font> by <font color=\"#cb1b43\">60</font>. You gain <font color=\"#84d6d0\">30% Movement Speed</font> for every ZED you kill."
	UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_NoStringsOnMe'
	UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_NoStringsOnMe_Deluxe'
	Name="Default__DKUpgrade_Skill_NoStringsOnMe" 
}