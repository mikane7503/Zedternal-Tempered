class DKUpgrade_Skill_SoulStealer extends DKUpgrade_Skill
	config(ZedternalUnlimited);

var config array<float> Health;
var config array<int> Dosh;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.Health[0] = 0.30f;
		default.Health[1] = 0.60f;
		default.Dosh[0] = 2;
		default.Dosh[1] = 4;

		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}



static function ModifyHealth(out int InHealth, int DefaultHealth, int upgLevel)
{
	InHealth -= (DefaultHealth * default.Health[upgLevel - 1]);
}

static function ModifyDamageGiven(out int InDamage, int DefaultDamage, int upgLevel, optional Actor DamageCauser, optional KFPawn_Monster MyKFPM, optional KFPlayerController DamageInstigator, optional Class<KFDamageType> DamageType, optional int HitZoneIdx, optional KFWeapon MyKFW)
{
    if((((MyKFPM != none) && MyKFPM.IsAliveAndWell()) && (MyKFPM.Health - InDamage) <= 0) && DamageInstigator != none)
    {
        KFPlayerReplicationInfo(DamageInstigator.PlayerReplicationInfo).AddDosh(default.Dosh[upgLevel - 1]);
    }  
}

defaultproperties
{
    // --- Localization (auto-generated by mass_localize_dk_upgrades.py) ---
    // Strings live in KFGame/Localization/<lang>/ZedternalRBPerkpackage.<langext>
    // Section: [DKUpgrade_Skill_SoulStealer]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalRBPerkpackage"
    LocSection="DKUpgrade_Skill_SoulStealer"

    UpgradeName="Soul Stealer"
    upgradeDescription(0)="<font color=\"#962ab9\">Decrease</font> your <font color=\"#962ab9\">Maximum Health</font> by <font color=\"#cb1b43\">30</font>. You gain <font color=\"#84d6d0\">2 Dosh</font> for every ZED you kill."
    upgradeDescription(1)="<font color=\"#962ab9\">Decrease</font> your <font color=\"#962ab9\">Maximum Health</font> by <font color=\"#cb1b43\">60</font>. You gain <font color=\"#84d6d0\">4 Dosh</font> for every ZED you kill."
	UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_SoulStealer'
	UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_SoulStealer_Deluxe'
	Name="Default__DKUpgrade_Skill_SoulStealer" 
}