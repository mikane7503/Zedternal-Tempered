    // Section: [DKUpgrade_Skill_SlowCooker]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalRBPerkpackage"
    LocSection="DKUpgrade_Skill_SlowCooker"

    UpgradeName="Slow Cooker"
	UpgradeDescription(0)="Increase length of <font color=\"#ff3399\">Damage over Time</font> effects of weapons by <font color=\"#66cc00\">25%</font>."
	UpgradeDescription(1)="Increase length of <font color=\"#ff3399\">Damage over Time</font> effects of weapons by <font color=\"#66cc00\">50%</font>."
	UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_SlowCooker'
	UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_SlowCooker_Deluxe'

	Name="Default__DKUpgrade_Skill_SlowCooker"
}