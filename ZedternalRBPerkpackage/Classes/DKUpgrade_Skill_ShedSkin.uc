    // --- Localization (auto-generated by mass_localize_dk_upgrades.py) ---
    // Strings live in KFGame/Localization/<lang>/ZedternalRBPerkpackage.<langext>
    // Section: [DKUpgrade_Skill_ShedSkin]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalRBPerkpackage"
    LocSection="DKUpgrade_Skill_ShedSkin"

    UpgradeName="Shed Skin"
    UpgradeDescription(0)="<font color=\"#8B008B\">Shed Skin:</font> After taking <font color=\"#FFFFFF\">50+</font> damage in <font color=\"#FFFFFF\">3 seconds</font>, gain <font color=\"#00FF00\">50% damage resistance</font> for <font color=\"#FFFFFF\">8 seconds</font> (30s cooldown)."
    UpgradeDescription(1)="<font color=\"#8B008B\">Shed Skin (Deluxe):</font> After taking <font color=\"#FFFFFF\">25+</font> damage in <font color=\"#FFFFFF\">3 seconds</font>, gain <font color=\"#00FF00\">75% damage resistance</font> for <font color=\"#FFFFFF\">12 seconds</font> (20s cooldown)."
    
    UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_ShedSkin'
    UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_ShedSkin_Deluxe'
    
    Name="Default__DKUpgrade_Skill_ShedSkin"
}