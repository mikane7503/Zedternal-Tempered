class DKUpgrade_Skill_ShedSkin extends DKUpgrade_Skill
	config(ZedternalUnlimited);

var config array<int> DamageTrigger;
var config array<float> DamageResistance;
var config array<float> BuffDuration;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.DamageTrigger[0] = 50;
		default.DamageTrigger[1] = 25;
		default.DamageResistance[0] = 0.5f;
		default.DamageResistance[1] = 0.75f;
		default.BuffDuration[0] = 8.0f;
		default.BuffDuration[1] = 12.0f;

		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


static function ModifyDamageTaken(out int InDamage, int DefaultDamage, int upgLevel, KFPawn OwnerPawn, optional class<DamageType> DamageType, optional Controller InstigatedBy, optional KFWeapon MyKFW)
{
    local DKUpgrade_Skill_ShedSkin_Helper ShedHelper;
    
    if (OwnerPawn == None) return;
    
    // Get helper to track damage and manage buff
    ShedHelper = GetHelper(OwnerPawn);
    if (ShedHelper != None)
    {
        // Track incoming damage for trigger detection
        ShedHelper.TrackDamage(InDamage, upgLevel);
        
        // Apply damage resistance if buff is active
        if (ShedHelper.bBuffActive)
        {
            InDamage = Round(float(InDamage) * (1.0f - default.DamageResistance[upgLevel - 1]));
        }
    }
}

static simulated function InitiateWeapon(int upgLevel, KFWeapon KFW, KFPawn OwnerPawn)
{
    local DKUpgrade_Skill_ShedSkin_Helper ShedHelper;
    local bool bFound;

    if (KFPawn_Human(OwnerPawn) != None && OwnerPawn.Role == Role_Authority)
    {
        bFound = False;
        foreach OwnerPawn.ChildActors(class'DKUpgrade_Skill_ShedSkin_Helper', ShedHelper)
        {
            bFound = True;
            break;
        }

        if (!bFound)
        {
            ShedHelper = OwnerPawn.Spawn(class'DKUpgrade_Skill_ShedSkin_Helper', OwnerPawn);
            ShedHelper.UpgradeLevel = upgLevel;
        }
    }
}

static function DKUpgrade_Skill_ShedSkin_Helper GetHelper(Pawn OwnerPawn)
{
    local DKUpgrade_Skill_ShedSkin_Helper ShedHelper;

    if (KFPawn_Human(OwnerPawn) != None)
    {
        foreach OwnerPawn.ChildActors(class'DKUpgrade_Skill_ShedSkin_Helper', ShedHelper)
        {
            return ShedHelper;
        }

        // Create one if needed
        ShedHelper = OwnerPawn.Spawn(class'DKUpgrade_Skill_ShedSkin_Helper', OwnerPawn);
    }

    return ShedHelper;
}

static simulated function DeleteHelperClass(Pawn OwnerPawn)
{
    local DKUpgrade_Skill_ShedSkin_Helper ShedHelper;

    if (OwnerPawn != None)
    {
        foreach OwnerPawn.ChildActors(class'DKUpgrade_Skill_ShedSkin_Helper', ShedHelper)
        {
            ShedHelper.Destroy();
        }
    }
}

defaultproperties
