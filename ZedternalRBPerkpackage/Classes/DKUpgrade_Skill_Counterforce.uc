    // --- Localization (auto-generated by mass_localize_dk_upgrades.py) ---
    // Strings live in KFGame/Localization/<lang>/ZedternalRBPerkpackage.<langext>
    // Section: [DKUpgrade_Skill_Counterforce]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalRBPerkpackage"
    LocSection="DKUpgrade_Skill_Counterforce"

	UpgradeName="Counterforce"

	UpgradeDescription(0)="<font color=\"#edb82a\">Counterforce</font> Damage you take is stored (<font color=\"#FF4500\">50%</font> conversion, max <font color=\"#FFFFFF\">200</font>). Your next <font color=\"#FF4500\">melee attack</font> releases all stored damage as bonus. <font color=\"#AAAAAA\">10 second cooldown after release.</font>"
	UpgradeDescription(1)="<font color=\"#edb82a\">Counterforce</font> Damage you take is stored (<font color=\"#FF4500\">80%</font> conversion, max <font color=\"#FFFFFF\">350</font>). Your next <font color=\"#FF4500\">melee attack</font> releases all stored damage as bonus. <font color=\"#AAAAAA\">10 second cooldown after release.</font>"

	UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_Counterforce'
	UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_Counterforce_Deluxe'

	Name="Default__DKUpgrade_Skill_Counterforce"
}
