    // --- Localization (auto-generated by mass_localize_dk_upgrades.py) ---
    // Strings live in KFGame/Localization/<lang>/ZedternalRBPerkpackage.<langext>
    // Section: [DKUpgrade_Skill_CloseCall]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalRBPerkpackage"
    LocSection="DKUpgrade_Skill_CloseCall"

	UpgradeName="Close Call"
	upgradeDescription(0)="While below <font color=\"#be4d25\">25% Health</font>, deal <font color=\"#ff3399\">30%</font> more <font color=\"#66cc00\">Damage</font> and take <font color=\"#ff3399\">20%</font> <font color=\"#66cc00\">less Damage</font>."
	upgradeDescription(1)="While below <font color=\"#be4d25\">25% Health</font>, deal <font color=\"#ff3399\">60%</font> more <font color=\"#66cc00\">Damage</font> and take <font color=\"#ff3399\">40%</font> <font color=\"#66cc00\">less Damage</font>."
	UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_CloseCall'
	UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_CloseCall_Deluxe'
	Name="Default__DKUpgrade_Skill_CloseCall"
}
