class DKUpgrade_Skill_HighRiskInvestment extends DKUpgrade_Skill
	config(ZedternalUnlimited);

var config array<int> MinPurchaseAmount;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.MinPurchaseAmount[0] = 2500;
		default.MinPurchaseAmount[1] = 1500;

		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


static simulated function InitiateWeapon(int upgLevel, KFWeapon KFW, KFPawn OwnerPawn)
{
    local DKUpgrade_Skill_HighRiskInvestment_Helper UPG;
    local bool bFound;

    if (KFPawn_Human(OwnerPawn) != None && OwnerPawn.Role == Role_Authority)
    {
        bFound = False;
        foreach OwnerPawn.ChildActors(class'DKUpgrade_Skill_HighRiskInvestment_Helper', UPG)
        {
            bFound = True;
            break;
        }

        if (!bFound)
        {
            UPG = OwnerPawn.Spawn(class'DKUpgrade_Skill_HighRiskInvestment_Helper', OwnerPawn);
            UPG.bDeluxe = (upgLevel > 1);
            UPG.UpgradeLevel = upgLevel;
        }
    }
}

static simulated function DeleteHelperClass(Pawn OwnerPawn)
{
    local DKUpgrade_Skill_HighRiskInvestment_Helper UPG;

    if (OwnerPawn != None)
    {
        foreach OwnerPawn.ChildActors(class'DKUpgrade_Skill_HighRiskInvestment_Helper', UPG)
        {
            UPG.Destroy();
        }
    }
}

defaultproperties
{
    // --- Localization (auto-generated by mass_localize_dk_upgrades.py) ---
    // Strings live in KFGame/Localization/<lang>/ZedternalRBPerkpackage.<langext>
    // Section: [DKUpgrade_Skill_HighRiskInvestment]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalRBPerkpackage"
    LocSection="DKUpgrade_Skill_HighRiskInvestment"

    UpgradeName="High Risk Investment"
    
    upgradeDescription(0)="Whenever you spend <font color=\"#ff3399\">2500+</font> dosh in a single purchase, <font color=\"#ffaa33\">10% chance</font> to get the purchase cost back as <font color=\"#00ff00\">bonus dosh</font>."
    upgradeDescription(1)="Whenever you spend <font color=\"#ff3399\">1500+</font> dosh in a single purchase, <font color=\"#ffaa33\">10% chance</font> to get the purchase cost back as <font color=\"#00ff00\">bonus dosh</font>."
    
    UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_HighRiskInvestment'
    UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_HighRiskInvestment_Deluxe'

    Name="Default__DKUpgrade_Skill_HighRiskInvestment"
}