// ===================================================================
// DKUpgrade_Skill_WarpPhase - Phased Existence
// Theme: Exist between moments of time. Immune to grabs and Siren
//        screams. Detect cloaked enemies from further away.
// Hooks: CanNotBeGrabbed, ProjSirenResist, ModifyCloakDetectionRange
// ===================================================================
class DKUpgrade_Skill_WarpPhase extends DKUpgrade_Skill
	config(ZedternalUnlimited);

var config array<float> CloakBonus;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.CloakBonus[0] = 1.0f;
		default.CloakBonus[1] = 2.0f;

		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


static function bool CanNotBeGrabbed(int upgLevel, KFPawn OwnerPawn)
{
	return True;
}

static simulated function bool ProjSirenResist(int upgLevel, KFPawn OwnerPawn)
{
	return True;
}

static simulated function ModifyCloakDetectionRange(out float InRange, float DefaultRange, int upgLevel)
{
	InRange += DefaultRange * default.CloakBonus[upgLevel - 1];
}

defaultproperties
{

    // --- Localization (auto-generated by mass_localize_dk_upgrades.py) ---
    // Strings live in KFGame/Localization/<lang>/ZedternalRBPerkpackage.<langext>
    // Section: [DKUpgrade_Skill_WarpPhase]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalRBPerkpackage"
    LocSection="DKUpgrade_Skill_WarpPhase"

	UpgradeName="Warp Phase"
	upgradeDescription(0)="<font color=\"#9632ff\">Phase between moments</font>. Cannot be grabbed by Clots. Projectiles are immune to <font color=\"#FFFFFF\">Siren screams</font>. Detect cloaked enemies from <font color=\"#d8b0ff\">+100%</font> further away."
	upgradeDescription(1)="<font color=\"#9632ff\">Phase between moments</font>. Cannot be grabbed by Clots. Projectiles are immune to <font color=\"#FFFFFF\">Siren screams</font>. Detect cloaked enemies from <font color=\"#d8b0ff\">+200%</font> further away."
	UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_WarpPhase'
	UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_WarpPhase_Deluxe'

	Name="Default__DKUpgrade_Skill_WarpPhase"
}
