    // Section: [DKWeaponUpg_Stun]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalRBPerkpackage"
    LocSection="DKWeaponUpg_Stun"

	UpgradeName="Concussive Impact"
	UpgradeDescription(0)="Increases your <font color=\"#15d7fa\">stun power</font> by <font color=\"#77d914\">+%x%%</font> per level."
	WeaponBonus=(baseValue=0, incValue=20, maxValue=-1)
	Name="Default__DKWeaponUpg_Stun"
}
