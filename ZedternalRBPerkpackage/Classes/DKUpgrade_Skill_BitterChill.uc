class DKUpgrade_Skill_BitterChill extends DKUpgrade_Skill
	config(ZedternalUnlimited);

// Theme: "Bitter Chill" - The weight of winter bears down on everything around you
// Increases stun power and snare power on all attacks

var config array<float> Stun;
var config array<float> Snare;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.Stun[0] = 0.30f;
		default.Stun[1] = 0.75f;
		default.Snare[0] = 0.30f;
		default.Snare[1] = 0.75f;

		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


static function ModifyStunPower(out float InStunPower, float DefaultStunPower, int upgLevel, optional class<DamageType> DamageType, optional byte HitZoneIdx)
{
    InStunPower += DefaultStunPower * default.Stun[upgLevel - 1];
}

static function ModifySnarePower(out float InSnarePower, float DefaultSnarePower, int upgLevel, optional class<DamageType> DamageType, optional byte BodyPart)
{
    InSnarePower += DefaultSnarePower * default.Snare[upgLevel - 1];
}

defaultproperties
{
    // --- Localization (auto-generated by mass_localize_dk_upgrades.py) ---
    // Strings live in KFGame/Localization/<lang>/ZedternalRBPerkpackage.<langext>
    // Section: [DKUpgrade_Skill_BitterChill]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalRBPerkpackage"
    LocSection="DKUpgrade_Skill_BitterChill"

    UpgradeName="Bitter Chill"
    upgradeDescription(0)="The weight of winter bears down on your targets. Increase <font color=\"#87CEEB\">Stun Power</font> and <font color=\"#15d7fa\">Snare Power</font> by <font color=\"#77d914\">30%</font>."
    upgradeDescription(1)="The weight of winter bears down on your targets. Increase <font color=\"#87CEEB\">Stun Power</font> and <font color=\"#15d7fa\">Snare Power</font> by <font color=\"#77d914\">75%</font>."
    UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_BitterChill'
    UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_BitterChill_Deluxe'

    Name="Default__DKUpgrade_Skill_BitterChill"
}
