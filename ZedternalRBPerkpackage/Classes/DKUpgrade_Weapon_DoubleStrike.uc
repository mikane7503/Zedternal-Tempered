class DKUpgrade_Weapon_DoubleStrike extends DKUpgrade_Weapon;

var float DoubleStrikeChancePerLevel;  // Chance increase per upgrade level

static function bool IsUpgradeCompatible(class<KFWeapon> KFW)
{
    // Compatible with all weapons
    return True;
}

static function ModifyDamageGiven(out int InDamage, int DefaultDamage, int upgLevel, optional Actor DamageCauser, optional KFPawn_Monster MyKFPM, optional KFPlayerController DamageInstigator, optional class<KFDamageType> DamageType, optional int HitZoneIdx, optional KFWeapon MyKFW)
{
    local float DoubleStrikeChance;
    local bool bDoubleStrike;
    
    if (MyKFPM == None || DamageInstigator == None || upgLevel <= 0) return;
    
    // Calculate double strike chance based on upgrade level
    DoubleStrikeChance = default.DoubleStrikeChancePerLevel * upgLevel;
    
    // Roll for double strike
    bDoubleStrike = (FRand() <= DoubleStrikeChance);
    
    if (bDoubleStrike)
    {
        // Double the damage
        InDamage = InDamage * 2;
    }
}

// Return bonus percentage for UI description
static function string GetBonusValue(int Level)
{
    local float TotalChance;
    
    // Calculate total double strike chance percentage
    TotalChance = default.DoubleStrikeChancePerLevel * Level * 100.0f;
    
    return string(int(TotalChance));
}

defaultproperties
{
    // --- Localization (auto-generated by mass_localize_dk_upgrades.py) ---
    // Strings live in KFGame/Localization/<lang>/ZedternalRBPerkpackage.<langext>
    // Section: [DKUpgrade_Weapon_DoubleStrike]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalRBPerkpackage"
    LocSection="DKUpgrade_Weapon_DoubleStrike"

    DoubleStrikeChancePerLevel=0.01f    // 1% chance per level (20% max at level 20)
    
    // Weapon bonus for UI display
    WeaponBonus=(baseValue=0, incValue=1, maxValue=20)  // Shows 1% per level, max 20%
    
    UpgradeName="Double Strike"
    
    // Upgrade description with orange theme to match multi-strike concept
    UpgradeDescription(0)="<font color=\"#77d914\">%x%%</font> chance for your attacks to <font color=\"#15d7fa\">hit twice</font>, dealing double damage."
    
    
    Name="Default__DKUpgrade_Weapon_DoubleStrike"
}