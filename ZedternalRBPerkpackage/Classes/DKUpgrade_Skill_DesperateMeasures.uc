class DKUpgrade_Skill_DesperateMeasures extends DKUpgrade_Skill
	config(ZedternalUnlimited);

// Damage scales inversely with spare ammo - the less spare ammo you have, the more damage you deal
// At 0% spare ammo: full bonus. At 100% spare ammo: no bonus.
// Creates a risk/reward dynamic with trader purchasing and ammo management

var config array<float> MaxDamageBonus;  // Maximum damage bonus at 0% spare ammo
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.MaxDamageBonus[0] = 0.40f;
		default.MaxDamageBonus[1] = 0.80f;

		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


static function ModifyDamageGiven(out int InDamage, int DefaultDamage, int upgLevel, optional Actor DamageCauser, optional KFPawn_Monster MyKFPM, optional KFPlayerController DamageInstigator, optional class<KFDamageType> DamageType, optional int HitZoneIdx, optional KFWeapon MyKFW)
{
	local float SparePercent;

	if (MyKFPM != None && MyKFW != None && MyKFW.SpareAmmoCapacity[0] > 0)
	{
		SparePercent = FClamp(float(MyKFW.SpareAmmoCount[0]) / float(MyKFW.SpareAmmoCapacity[0]), 0.0f, 1.0f);

		// Inverse scaling: 0% spare = full bonus, 100% spare = no bonus
		InDamage += Round(float(DefaultDamage) * default.MaxDamageBonus[upgLevel - 1] * (1.0f - SparePercent));
	}
}

defaultproperties
{

    // --- Localization (auto-generated by mass_localize_dk_upgrades.py) ---
    // Strings live in KFGame/Localization/<lang>/ZedternalRBPerkpackage.<langext>
    // Section: [DKUpgrade_Skill_DesperateMeasures]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalRBPerkpackage"
    LocSection="DKUpgrade_Skill_DesperateMeasures"

	UpgradeName="Desperate Measures"

	UpgradeDescription(0)="<font color=\"#DAA520\">Desperate Measures:</font> Deal up to <font color=\"#FF4444\">+40%</font> <font color=\"#87CEEB\">damage</font> based on how low your <font color=\"#FFFFFF\">spare ammo</font> is"
	UpgradeDescription(1)="<font color=\"#FFD700\">Desperate Measures:</font> Deal up to <font color=\"#FF4444\">+80%</font> <font color=\"#87CEEB\">damage</font> based on how low your <font color=\"#FFFFFF\">spare ammo</font> is"

	UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_DesperateMeasures'
	UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_DesperateMeasures_Deluxe'

	Name="Default__DKUpgrade_Skill_DesperateMeasures"
}
