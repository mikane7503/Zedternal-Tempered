	UpgradeDescription(0)="<font color=\"#edb82a\">Battering Ram</font> While <font color=\"#32CD32\">sprinting</font>: <font color=\"#4169E1\">+20% Damage Resistance</font> First melee within <font color=\"#FFFFFF\">1s</font> of stopping sprint: <font color=\"#FF4500\">2x Melee Damage</font> <font color=\"#AAAAAA\">Charge in. Swing hard.</font>"
	UpgradeDescription(1)="<font color=\"#edb82a\">Battering Ram</font> While <font color=\"#32CD32\">sprinting</font>: <font color=\"#4169E1\">+30% Damage Resistance</font> First melee within <font color=\"#FFFFFF\">1.5s</font> of stopping sprint: <font color=\"#FF4500\">3x Melee Damage</font> <font color=\"#AAAAAA\">Charge in. Swing hard.</font>"

