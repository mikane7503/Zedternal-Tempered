class DKUpgrade_Skill_Fimbulwinter extends DKUpgrade_Skill
	config(ZedternalUnlimited);

var config array<float> CrouchSpeed;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.CrouchSpeed[0] = 0.25f;
		default.CrouchSpeed[1] = 0.50f;

		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


static simulated function bool ImmuneToCameraShake(int upgLevel, KFPawn OwnerPawn)
{
    return true;
}

static simulated function GetCrouchSpeedModifier(out float InSpeed, float DefaultSpeed, int upgLevel)
{
    // Use += so we compose with any other crouch-speed contributors instead
    // of overwriting them. Old code did `InSpeed = DefaultSpeed * (1+bonus)`,
    // which discards any prior contribution to InSpeed.
    InSpeed += DefaultSpeed * default.CrouchSpeed[upgLevel - 1];
}

defaultproperties
{
    // --- Localization (auto-generated by mass_localize_dk_upgrades.py) ---
    // Strings live in KFGame/Localization/<lang>/ZedternalRBPerkpackage.<langext>
    // Section: [DKUpgrade_Skill_Fimbulwinter]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalRBPerkpackage"
    LocSection="DKUpgrade_Skill_Fimbulwinter"

    UpgradeName="Fimbulwinter"
    upgradeDescription(0)="Become completely <font color=\"#87CEEB\">Immune to Camera Shake</font> and gain <font color=\"#15d7fa\">25%</font> <font color=\"#9966FF\">Crouch Movement Speed</font>."
    upgradeDescription(1)="Become completely <font color=\"#87CEEB\">Immune to Camera Shake</font> and gain <font color=\"#15d7fa\">50%</font> <font color=\"#9966FF\">Crouch Movement Speed</font>."
    UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_Fimbulwinter'
    UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_Fimbulwinter_Deluxe'

    Name="Default__DKUpgrade_Skill_Fimbulwinter"
}