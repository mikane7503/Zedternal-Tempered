    // --- Localization (auto-generated by mass_localize_dk_upgrades.py) ---
    // Strings live in KFGame/Localization/<lang>/ZedternalRBPerkpackage.<langext>
    // Section: [DKUpgrade_Skill_FrostbiteArrows]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalRBPerkpackage"
    LocSection="DKUpgrade_Skill_FrostbiteArrows"

    UpgradeName="Frostbite Arrows"
    upgradeDescription(0)="Your <font color=\"#77d914\">Bow and Crossbow</font> shots apply a stacking <font color=\"#87CEEB\">Slow Effect</font> that increases your <font color=\"#FFAA33\">Damage</font> against that target by <font color=\"#15d7fa\">10%</font> per stack (max 5 stacks)."
    upgradeDescription(1)="Your <font color=\"#77d914\">Bow and Crossbow</font> shots apply a stacking <font color=\"#87CEEB\">Slow Effect</font> that increases your <font color=\"#FFAA33\">Damage</font> against that target by <font color=\"#15d7fa\">15%</font> per stack (max 5 stacks)."
    UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_FrostbiteArrows'
    UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_FrostbiteArrows_Deluxe'

    Name="Default__DKUpgrade_Skill_FrostbiteArrows"
}
