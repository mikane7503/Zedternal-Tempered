    // --- Localization (auto-generated by mass_localize_dk_upgrades.py) ---
    // Strings live in KFGame/Localization/<lang>/ZedternalRBPerkpackage.<langext>
    // Section: [DKUpgrade_Skill_Contagion]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalRBPerkpackage"
    LocSection="DKUpgrade_Skill_Contagion"

	UpgradeName="Contagion"
	UpgradeDescription(0)="<font color=\"#B40028\">Contagion:</font> <font color=\"#FF6464\">Siphoned</font> enemies passively spread siphon to non-siphoned enemies within <font color=\"#FFFFFF\">3m</font> every <font color=\"#FFFFFF\">2s</font>"
	UpgradeDescription(1)="<font color=\"#FFD700\">[DELUXE]</font> <font color=\"#B40028\">Contagion:</font> <font color=\"#FF6464\">Siphoned</font> enemies passively spread siphon to non-siphoned enemies within <font color=\"#FFFFFF\">5m</font> every <font color=\"#FFFFFF\">1.5s</font>"

	UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_Contagion'
	UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_Contagion_Deluxe'

	Name="Default__DKUpgrade_Skill_Contagion"
}
