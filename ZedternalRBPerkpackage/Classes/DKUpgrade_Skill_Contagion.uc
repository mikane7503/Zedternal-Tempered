// ===================================================================
// DKUpgrade_Skill_Contagion - Infectious Siphon
// Siphoned enemies passively spread siphon to nearby non-siphoned
// enemies through proximity. The infection spreads through the horde
// naturally. Let enemies cluster before engaging.
//
// Standard: 3m spread radius, checks every 2 seconds
// Deluxe:   5m spread radius, checks every 1.5 seconds
//
// All logic handled by helper class that runs periodic proximity
// checks against the Parasite perk helper's siphon list.
//
// REQUIRES: DKUpgrade_Perk_Parasite_Helper must expose:
//   - GetSiphonedEnemies(out array<KFPawn_Monster>) : void
//   - IsSiphoned(KFPawn_Monster) : bool
//   - ApplySiphonToTarget(KFPawn_Monster) : void
//   - GetSiphonedEnemyCount() : int
//   - GetMaxSiphons() : int
// ===================================================================
class DKUpgrade_Skill_Contagion extends DKUpgrade_Skill
	config(ZedternalUnlimited);

var config array<float> SpreadRadius;
var config array<float> SpreadInterval;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.SpreadRadius[0] = 300.0f;
		default.SpreadRadius[1] = 500.0f;
		default.SpreadInterval[0] = 2.0f;
		default.SpreadInterval[1] = 1.5f;

		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


// ===================================================================
// Helper Management
// ===================================================================
static simulated function InitiateWeapon(int upgLevel, KFWeapon KFW, KFPawn OwnerPawn)
{
	local DKUpgrade_Skill_Contagion_Helper UPG;
	local bool bFound;

	if (KFPawn_Human(OwnerPawn) != None && OwnerPawn.Role == Role_Authority)
	{
		bFound = False;
		foreach OwnerPawn.ChildActors(class'DKUpgrade_Skill_Contagion_Helper', UPG)
		{
			bFound = True;
			break;
		}

		if (!bFound)
		{
			UPG = OwnerPawn.Spawn(class'DKUpgrade_Skill_Contagion_Helper', OwnerPawn);
			if (UPG != None)
			{
				UPG.SpreadRadius = default.SpreadRadius[upgLevel - 1];
				UPG.SpreadInterval = default.SpreadInterval[upgLevel - 1];
				UPG.StartSpreadTimer();
			}
		}
	}
}

static simulated function DeleteHelperClass(Pawn OwnerPawn)
{
	local DKUpgrade_Skill_Contagion_Helper UPG;

	if (OwnerPawn != None)
	{
		foreach OwnerPawn.ChildActors(class'DKUpgrade_Skill_Contagion_Helper', UPG)
			UPG.Destroy();
	}
}

defaultproperties
