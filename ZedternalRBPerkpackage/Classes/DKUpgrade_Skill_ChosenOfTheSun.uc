class DKUpgrade_Skill_ChosenOfTheSun extends DKUpgrade_Skill
	config(ZedternalUnlimited);

var config array<float> Health;
var config array<float> MovementSpeed;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.Health[0] = 0.20f;
		default.Health[1] = 0.40f;
		default.MovementSpeed[0] = 0.10f;
		default.MovementSpeed[1] = 0.20f;

		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


static function ModifyHealth(out int InHealth, int DefaultHealth, int upgLevel)
{
	InHealth += Round(float(DefaultHealth) * (default.Health[upgLevel - 1]));
}

static simulated function ModifySpeedPassive(out float speedFactor, int upgLevel)
{
    // FIXED: Remove the non-existent MoveSpeed variable
    speedFactor += default.MovementSpeed[upgLevel - 1];  
}

defaultproperties
{
    // --- Localization (auto-generated by mass_localize_dk_upgrades.py) ---
    // Strings live in KFGame/Localization/<lang>/ZedternalRBPerkpackage.<langext>
    // Section: [DKUpgrade_Skill_ChosenOfTheSun]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalRBPerkpackage"
    LocSection="DKUpgrade_Skill_ChosenOfTheSun"

    UpgradeName="Chosen of the Sun"
	upgradeDescription(0)="Increase your <font color=\"e80948\">Maximum Health</font> by <font color=\"#e85009\">20%</font> and your <font color=\"e80948\">Movement Speed</font> by <font color=\"#e85009\">10%</font>."
	upgradeDescription(1)="Increase your <font color=\"e80948\">Maximum Health</font> by <font color=\"#e85009\">40%</font> and your <font color=\"e80948\">Movement Speed</font> by <font color=\"#e85009\">20%</font>."
	UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_ChosenOfTheSun'
	UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_ChosenOfTheSun_Deluxe'

	Name="Default__DKUpgrade_Skill_ChosenOfTheSun"
}