class DKUpgrade_Skill_FullMetalJacket extends DKUpgrade_Skill
	config(ZedternalUnlimited);

var config array<float> Penetration;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.Penetration[0] = 4.0f;
		default.Penetration[1] = 8.0f;

		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


static simulated function ModifyPenetrationPassive(out float penetrationFactor, int upgLevel)
{
	penetrationFactor += default.Penetration[upgLevel - 1];
}

defaultproperties
{
    // --- Localization (auto-generated by mass_localize_dk_upgrades.py) ---
