    // Section: [DKUpgrade_Skill_FullMetalJacket]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalRBPerkpackage"
    LocSection="DKUpgrade_Skill_FullMetalJacket"

    UpgradeName="Full Metal Jacket"
	upgradeDescription(0)="Gain <font color=\"#ff3399\">400%</font> more <font color=\"#66cc00\">Penetration</font> for all weapons." 
   	upgradeDescription(1)="Gain <font color=\"#ff3399\">800%</font> more <font color=\"#66cc00\">Penetration</font> for all weapons."
	UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_FullMetalJacket'
	UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_FullMetalJacket_Deluxe'
    Name="Default__DKUpgrade_Skill_FullMetalJacket"
}