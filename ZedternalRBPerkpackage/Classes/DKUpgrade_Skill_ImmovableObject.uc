class DKUpgrade_Skill_ImmovableObject extends DKUpgrade_Skill
	config(ZedternalUnlimited);

var config array<float> Health;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.Health[0] = 0.35f;
		default.Health[1] = 0.70f;

		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


// DK FIX: the Health config values existed but the hook was never
// implemented, so the skill granted no health at all. Fortitude pattern.
static function ModifyHealth(out int InHealth, int DefaultHealth, int upgLevel)
{
	InHealth += Round(float(DefaultHealth) * default.Health[upgLevel - 1]);
}


static simulated function bool ImmuneToCameraShake(int upgLevel, KFPawn OwnerPawn)
{
	return True;
}

static function bool CanNotBeGrabbed(int upgLevel, KFPawn OwnerPawn)
{
   if (upgLevel == 1)
    return False;
   else
    return True;
}


