class DKWeaponUpg_MagSize extends DKUpgrade_Weapon
	abstract
	config(ZedternalUnlimited);

var config float MagBonus;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 2)
	{
		default.MagBonus = 0.25f;
		default.MODEVERSION = 2;
		static.StaticSaveConfig();
	}
}

static function bool IsUpgradeCompatible(class<KFWeapon> KFW)
{
	if (KFW.default.MagazineCapacity[0] >= 5)
		return True;
	return False;
}

static simulated function ModifyMagSizeAndNumber(out int InMagazineCapacity, int DefaultMagazineCapacity, int upgLevel, KFWeapon KFW, optional array< class<KFPerk> > WeaponPerkClass, optional bool bSecondary=False, optional name WeaponClassname)
{
	local float Val;
	Val = default.MagBonus;
	if (Val <= 0.f) Val = 0.25f;
	`log("[DK_WEAPUPG_HIT] DKWeaponUpg_MagSize upgLevel="$upgLevel$" InMag="$InMagazineCapacity$" DefMag="$DefaultMagazineCapacity$" MagBonus="$default.MagBonus$" Val="$Val$" KFW="$KFW$" bSecondary="$bSecondary);
	InMagazineCapacity += Round(float(DefaultMagazineCapacity) * Val * upgLevel);
}

defaultproperties
{
    // --- Localization (auto-generated by mass_localize_dk_upgrades.py) ---
    // Strings live in KFGame/Localization/<lang>/ZedternalRBPerkpackage.<langext>
    // Section: [DKWeaponUpg_MagSize]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalRBPerkpackage"
    LocSection="DKWeaponUpg_MagSize"

	UpgradeName="Extended Mags"
	UpgradeDescription(0)="Increases your <font color=\"#15d7fa\">magazine capacity</font> by <font color=\"#77d914\">+%x%%</font> per level."
	WeaponBonus=(baseValue=0, incValue=25, maxValue=-1)
	Name="Default__DKWeaponUpg_MagSize"
}
