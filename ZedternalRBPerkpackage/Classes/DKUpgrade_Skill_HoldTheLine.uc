	UpgradeDescription(0)="<font color=\"#edb82a\">Hold the Line</font> While <font color=\"#87CEEB\">standing still</font>:  <font color=\"#FF4500\">+30% Melee Damage</font>  <font color=\"#4169E1\">+25% Damage Resistance</font> <font color=\"#AAAAAA\">Plant your feet and dare them to approach.</font>"
	UpgradeDescription(1)="<font color=\"#edb82a\">Hold the Line</font> While <font color=\"#87CEEB\">moving slowly</font>:  <font color=\"#FF4500\">+50% Melee Damage</font>  <font color=\"#4169E1\">+40% Damage Resistance</font> <font color=\"#AAAAAA\">Plant your feet and dare them to approach.</font>"

