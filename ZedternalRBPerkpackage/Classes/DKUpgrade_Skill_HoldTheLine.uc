class DKUpgrade_Skill_HoldTheLine extends DKUpgrade_Skill
	config(ZedternalUnlimited);

// Stand your ground, become immovable
// While standing still or barely moving, gain huge damage and resistance bonuses
// Moving at full speed removes bonuses

var config array<float> MeleeDamageBonus;   // +30% / +50% melee damage
var config array<float> ResistanceBonus;    // +25% / +40% damage resistance
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.MeleeDamageBonus[0] = 0.30f;
		default.MeleeDamageBonus[1] = 0.50f;
		default.ResistanceBonus[0] = 0.25f;
		default.ResistanceBonus[1] = 0.40f;

		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


static function ModifyDamageGiven(out int InDamage, int DefaultDamage, int upgLevel, optional Actor DamageCauser, optional KFPawn_Monster MyKFPM, optional KFPlayerController DamageInstigator, optional class<KFDamageType> DamageType, optional int HitZoneIdx, optional KFWeapon MyKFW)
{
	local DKUpgrade_Skill_HoldTheLine_Helper UPG;

	if (DamageType != None && static.IsMeleeDamageType(DamageType) && DamageInstigator != None && DamageInstigator.Pawn != None)
	{
		UPG = GetHelper(KFPawn(DamageInstigator.Pawn));
		if (UPG != None && UPG.bHolding)
		{
			InDamage += Round(float(DefaultDamage) * default.MeleeDamageBonus[upgLevel - 1]);
		}
	}
}

static function ModifyDamageTaken(out int InDamage, int DefaultDamage, int upgLevel, KFPawn OwnerPawn, optional class<DamageType> DamageType, optional Controller InstigatedBy, optional KFWeapon MyKFW)
{
	local DKUpgrade_Skill_HoldTheLine_Helper UPG;

	if (OwnerPawn != None)
	{
		UPG = GetHelper(OwnerPawn);
		if (UPG != None && UPG.bHolding)
		{
			InDamage -= Round(float(DefaultDamage) * default.ResistanceBonus[upgLevel - 1]);
			if (InDamage < 1)
				InDamage = 1;
		}
	}
}

static simulated function InitiateWeapon(int upgLevel, KFWeapon KFW, KFPawn OwnerPawn)
{
	local DKUpgrade_Skill_HoldTheLine_Helper UPG;
	local bool bFound;

	if (KFPawn_Human(OwnerPawn) != None && OwnerPawn.Role == Role_Authority)
	{
		bFound = False;
		foreach OwnerPawn.ChildActors(class'DKUpgrade_Skill_HoldTheLine_Helper', UPG)
		{
			bFound = True;
			break;
		}

		if (!bFound)
		{
			UPG = OwnerPawn.Spawn(class'DKUpgrade_Skill_HoldTheLine_Helper', OwnerPawn);
			UPG.SetDeluxe(upgLevel > 1);
		}
	}
}

static function DKUpgrade_Skill_HoldTheLine_Helper GetHelper(KFPawn OwnerPawn)
{
	local DKUpgrade_Skill_HoldTheLine_Helper UPG;

	if (KFPawn_Human(OwnerPawn) != None)
	{
		foreach OwnerPawn.ChildActors(class'DKUpgrade_Skill_HoldTheLine_Helper', UPG)
		{
			return UPG;
		}

		if (OwnerPawn.Role == Role_Authority)
		{
			UPG = OwnerPawn.Spawn(class'DKUpgrade_Skill_HoldTheLine_Helper', OwnerPawn);
		}
	}

	return UPG;
}

static simulated function DeleteHelperClass(Pawn OwnerPawn)
{
	local DKUpgrade_Skill_HoldTheLine_Helper UPG;

	if (OwnerPawn != None)
	{
		foreach OwnerPawn.ChildActors(class'DKUpgrade_Skill_HoldTheLine_Helper', UPG)
		{
			UPG.Destroy();
		}
	}
}

