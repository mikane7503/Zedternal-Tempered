class DKUpgrade_Skill_HammerShot extends DKUpgrade_Skill
	config(ZedternalUnlimited);

var config array<float> Spread;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.Spread[0] = 0.5f;
		default.Spread[1] = 1.0f;

		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


static simulated function ModifyTightChokePassive(out float tightChokeFactor, int upgLevel)
{
	if (upgLevel > 0 && upgLevel <= default.Spread.Length)
		tightChokeFactor -= default.Spread[upgLevel - 1];
}

defaultproperties
{
    // --- Localization (auto-generated by mass_localize_dk_upgrades.py) ---
    // Strings live in KFGame/Localization/<lang>/ZedternalRBPerkpackage.<langext>
    // Section: [DKUpgrade_Skill_HammerShot]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalRBPerkpackage"
    LocSection="DKUpgrade_Skill_HammerShot"

    UpgradeName="Hammer Shot"
	upgradeDescription(0)="Decrease <font color=\"#ff3399\">Spread</font> by <font color=\"#66cc00\">50%</font> for all weapons."
    upgradeDescription(1)="Decrease <font color=\"#ff3399\">Spread</font> by <font color=\"#66cc00\">100%</font> for all weapons."
	UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_HammerShot'
	UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_HammerShot_Deluxe'
    Name="Default__DKUpgrade_Skill_HammerShot"
}