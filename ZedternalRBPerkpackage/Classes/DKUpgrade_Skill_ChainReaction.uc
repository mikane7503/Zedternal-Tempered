class DKUpgrade_Skill_ChainReaction extends DKUpgrade_Skill
	config(ZedternalUnlimited);

// Chain Reaction: Enemies killed by explosives have a chance to detonate
// Normal: 20% chance | Deluxe: 50% chance

var config array<float> Chance;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.Chance[0] = 0.2f;
		default.Chance[1] = 0.5f;

		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


static function bool CouldBeZedShrapnel(int upgLevel, class<KFDamageType> KFDT)
{
	if (KFDT != None && ClassIsChildOf(KFDT, class'KFDT_Explosive'))
		return True;

	return False;
}

static function bool ShouldShrapnel(int upgLevel)
{
	return FRand() <= default.Chance[upgLevel - 1];
}

defaultproperties
{

    // --- Localization (auto-generated by mass_localize_dk_upgrades.py) ---
    // Strings live in KFGame/Localization/<lang>/ZedternalRBPerkpackage.<langext>
    // Section: [DKUpgrade_Skill_ChainReaction]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalRBPerkpackage"
    LocSection="DKUpgrade_Skill_ChainReaction"

	UpgradeName="Chain Reaction"
	UpgradeDescription(0)="Enemies killed by <font color=\"#e80948\">explosives</font> have a <font color=\"#e85009\">20%</font> chance to detonate."
	UpgradeDescription(1)="Enemies killed by <font color=\"#e80948\">explosives</font> have a <font color=\"#e85009\">50%</font> chance to detonate."
	UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_ChainReaction'
	UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_ChainReaction_Deluxe'

	Name="Default__DKUpgrade_Skill_ChainReaction"
}
