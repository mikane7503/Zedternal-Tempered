class DKUpgrade_Skill_DeathSentence extends DKUpgrade_Skill
	config(ZedternalUnlimited);

// Death Sentence: Enemies below a health percentage threshold take massively increased damage.
// An execute mechanic - once they're wounded, the Reaper finishes the job.

var config array<float> DamageBonus;
var config array<float> HealthThreshold;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.DamageBonus[0] = 0.40f;
		default.DamageBonus[1] = 0.80f;
		default.HealthThreshold[0] = 0.30f;
		default.HealthThreshold[1] = 0.40f;

		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


static function ModifyDamageGiven(out int InDamage, int DefaultDamage, int upgLevel, optional Actor DamageCauser, optional KFPawn_Monster MyKFPM, optional KFPlayerController DamageInstigator, optional class<KFDamageType> DamageType, optional int HitZoneIdx, optional KFWeapon MyKFW)
{
	if (MyKFPM != None && MyKFPM.IsAliveAndWell() && MyKFPM.GetHealthPercentage() <= default.HealthThreshold[upgLevel - 1])
		InDamage += Round(float(DefaultDamage) * default.DamageBonus[upgLevel - 1]);
}

defaultproperties
{

    // --- Localization (auto-generated by mass_localize_dk_upgrades.py) ---
    // Strings live in KFGame/Localization/<lang>/ZedternalRBPerkpackage.<langext>
    // Section: [DKUpgrade_Skill_DeathSentence]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalRBPerkpackage"
    LocSection="DKUpgrade_Skill_DeathSentence"

	UpgradeName="Death Sentence"
	UpgradeDescription(0)="<font color=\"#CC0000\">Death Sentence:</font> Enemies below <font color=\"#FFFFFF\">30%</font> <font color=\"#FF6666\">health</font> take <font color=\"#FFFFFF\">+40%</font> <font color=\"#FFD700\">bonus damage</font>. Finish what you started."
	UpgradeDescription(1)="<font color=\"#CC0000\">Death Sentence:</font> Enemies below <font color=\"#FFFFFF\">40%</font> <font color=\"#FF6666\">health</font> take <font color=\"#FFFFFF\">+80%</font> <font color=\"#FFD700\">bonus damage</font>. Finish what you started."

	UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_DeathSentence'
	UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_DeathSentence_Deluxe'

	Name="Default__DKUpgrade_Skill_DeathSentence"
}
