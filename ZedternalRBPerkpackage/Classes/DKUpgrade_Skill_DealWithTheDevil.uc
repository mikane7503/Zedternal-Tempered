    upgradeDescription(0)="<font color=\"#962ab9\">Decrease</font> your <font color=\"#962ab9\">Healing</font> by <font color=\"#cb1b43\">80%</font>. <font color=\"#42e087\">Increase</font> your <font color=\"#42e087\">Headshot Damage</font> with all weapons by <font color=\"#84d6d0\">80%</font>."
    upgradeDescription(1)="<font color=\"#962ab9\">Decrease</font> your <font color=\"#962ab9\">Healing</font> by <font color=\"#cb1b43\">60%</font>. <font color=\"#42e087\">Increase</font> your <font color=\"#42e087\">Headshot Damage</font> with all weapons by <font color=\"#84d6d0\">120%</font>."
	UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_DealWithTheDevil'
