    // --- Localization (auto-generated by mass_localize_dk_upgrades.py) ---
    // Strings live in KFGame/Localization/<lang>/ZedternalRBPerkpackage.<langext>
    // Section: [DKUpgrade_Skill_HuntDown]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalRBPerkpackage"
    LocSection="DKUpgrade_Skill_HuntDown"

    UpgradeName="Hunt Down"
    upgradeDescription(0)="Consecutive hits on the <font color=\"#ff3399\">same enemy</font> deal <font color=\"#66cc00\">+5%</font> more damage per hit. Max <font color=\"#ffff00\">5</font> stacks (<font color=\"#ff3399\">+25%</font>)."
    upgradeDescription(1)="Consecutive hits on the <font color=\"#ff3399\">same enemy</font> deal <font color=\"#66cc00\">+10%</font> more damage per hit. Max <font color=\"#ffff00\">5</font> stacks (<font color=\"#ff3399\">+50%</font>)."
    UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_HuntDown'
    UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_HuntDown_Deluxe'

    Name="Default__DKUpgrade_Skill_HuntDown"
}
