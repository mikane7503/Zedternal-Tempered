class DKUpgrade_Skill_HuntDown extends DKUpgrade_Skill
	config(ZedternalUnlimited);

var config array<float> DamagePerStack;
var config int MaxStacks;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.DamagePerStack[0] = 0.05f;
		default.DamagePerStack[1] = 0.10f;
		default.MaxStacks = 5;

		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


static function ModifyDamageGiven(out int InDamage, int DefaultDamage, int upgLevel, optional Actor DamageCauser, optional KFPawn_Monster MyKFPM, optional KFPlayerController DamageInstigator, optional class<KFDamageType> DamageType, optional int HitZoneIdx, optional KFWeapon MyKFW)
{
    local DKUpgrade_Skill_HuntDown_Helper UPG;
    local int CurrentStacks;
    
    if (DamageInstigator == None || DamageInstigator.Pawn == None)
        return;
    
    if (MyKFPM == None)
        return;
    
    UPG = GetHelper(DamageInstigator.Pawn);
    if (UPG == None)
        return;
    
    // Register the hit and get current stack count
    CurrentStacks = UPG.RegisterHit(MyKFPM, default.MaxStacks);
    
    // Apply damage bonus based on stacks (stacks from previous hits, not this one)
    if (CurrentStacks > 0)
    {
        InDamage += Round(float(DefaultDamage) * default.DamagePerStack[upgLevel - 1] * float(CurrentStacks));
    }
}

static simulated function InitiateWeapon(int upgLevel, KFWeapon KFW, KFPawn OwnerPawn)
{
    local DKUpgrade_Skill_HuntDown_Helper UPG;
    local bool bFound;

    if (KFPawn_Human(OwnerPawn) != None && OwnerPawn.Role == Role_Authority)
    {
        bFound = False;
        foreach OwnerPawn.ChildActors(class'DKUpgrade_Skill_HuntDown_Helper', UPG)
        {
            bFound = True;
            break;
        }

        if (!bFound)
        {
            UPG = OwnerPawn.Spawn(class'DKUpgrade_Skill_HuntDown_Helper', OwnerPawn);
        }
    }
}

static function DKUpgrade_Skill_HuntDown_Helper GetHelper(Pawn OwnerPawn)
{
    local DKUpgrade_Skill_HuntDown_Helper UPG;

    if (KFPawn_Human(OwnerPawn) != None)
    {
        foreach OwnerPawn.ChildActors(class'DKUpgrade_Skill_HuntDown_Helper', UPG)
        {
            return UPG;
        }

        // Should have one
        UPG = OwnerPawn.Spawn(class'DKUpgrade_Skill_HuntDown_Helper', OwnerPawn);
    }

    return UPG;
}

static simulated function DeleteHelperClass(Pawn OwnerPawn)
{
    local DKUpgrade_Skill_HuntDown_Helper UPG;

    if (OwnerPawn != None)
    {
        foreach OwnerPawn.ChildActors(class'DKUpgrade_Skill_HuntDown_Helper', UPG)
        {
            UPG.Destroy();
        }
    }
}

defaultproperties
