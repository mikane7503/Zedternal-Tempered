// ===================================================================
// DKUpgrade_Skill_HardenedPlate — Artificer Skill
//
// "While holding a ★ Reforged weapon, take reduced damage.
//  Your expertly forged weapon grants defensive awareness."
//
// Normal:  -15% damage taken with Reforged weapons
// Deluxe:  -30% damage taken with Reforged weapons
//
// Hook: ModifyDamageTaken
// Helper: None
// ===================================================================
class DKUpgrade_Skill_HardenedPlate extends DKUpgrade_Skill
	config(ZedternalUnlimited);

var config array<float> DamageReduction;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.DamageReduction[0] = 0.15f;
		default.DamageReduction[1] = 0.30f;

		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


static function ModifyDamageTaken(out int InDamage, int DefaultDamage, int upgLevel, KFPawn OwnerPawn, optional class<DamageType> DamageType, optional Controller InstigatedBy, optional KFWeapon MyKFW)
{
    if (MyKFW != None && class'DKUpgrade_Perk_Artificer'.static.IsReforgedWeapon(MyKFW))
        InDamage -= Round(float(DefaultDamage) * default.DamageReduction[upgLevel - 1]);
}

defaultproperties
{

    // --- Localization (auto-generated by mass_localize_dk_upgrades.py) ---
    // Strings live in KFGame/Localization/<lang>/ZedternalRBPerkpackage.<langext>
    // Section: [DKUpgrade_Skill_HardenedPlate]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalRBPerkpackage"
    LocSection="DKUpgrade_Skill_HardenedPlate"

    UpgradeName="Hardened Plate"
    UpgradeDescription(0)="While holding a <font color=\"#FFD700\"> Reforged</font> weapon, take <font color=\"#FFFFFF\">15%</font> less damage"
    UpgradeDescription(1)="While holding a <font color=\"#FFD700\"> Reforged</font> weapon, take <font color=\"#FFFFFF\">30%</font> less damage"
    UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_HardenedPlate'
    UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_HardenedPlate_Deluxe'

    Name="Default__DKUpgrade_Skill_HardenedPlate"
}
