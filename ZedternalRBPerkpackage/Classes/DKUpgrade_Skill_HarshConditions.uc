	upgradeDescription(0)="<font color=\"#0bf1f1\">Freeze Damage</font> slows ZEDs by <font color=\"#15d7fa\">25%</font>."
	upgradeDescription(1)="<font color=\"#0bf1f1\">Freeze Damage</font> slows ZEDs by <font color=\"#15d7fa\">50%</font>."
	UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_HarshConditions'
	UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_HarshConditions_Deluxe'

	Name="Default__DKUpgrade_Skill_HarshConditions"
