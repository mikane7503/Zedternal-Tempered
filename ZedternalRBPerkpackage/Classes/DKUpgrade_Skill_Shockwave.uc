    // --- Localization (auto-generated by mass_localize_dk_upgrades.py) ---
    // Strings live in KFGame/Localization/<lang>/ZedternalRBPerkpackage.<langext>
    // Section: [DKUpgrade_Skill_Shockwave]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalRBPerkpackage"
    LocSection="DKUpgrade_Skill_Shockwave"

	UpgradeName="Shockwave"

	UpgradeDescription(0)="<font color=\"#edb82a\">Shockwave</font> Every <font color=\"#FFFFFF\">5th</font> melee kill triggers a <font color=\"#FF6347\">shockwave</font>. Knocks down and damages all zeds within <font color=\"#FFFFFF\">5 meters</font>. <font color=\"#AAAAAA\">The ground shakes with every massacre.</font>"
	UpgradeDescription(1)="<font color=\"#edb82a\">Shockwave</font> Every <font color=\"#FFFFFF\">3rd</font> melee kill triggers a <font color=\"#FF6347\">shockwave</font>. Knocks down and damages all zeds within <font color=\"#FFFFFF\">7 meters</font>. <font color=\"#AAAAAA\">The ground shakes with every massacre.</font>"

	UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_Shockwave'
	UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_Shockwave_Deluxe'

	Name="Default__DKUpgrade_Skill_Shockwave"
}
