class DKWeaponUpg_SwitchSpeed extends DKUpgrade_Weapon
	abstract
	config(ZedternalUnlimited);

var config float SwitchBonus;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 2)
	{
		default.SwitchBonus = 0.25f;
		default.MODEVERSION = 2;
		static.StaticSaveConfig();
	}
}

static function bool IsUpgradeCompatible(class<KFWeapon> KFW)
{
	return True;
}

static simulated function ModifyWeaponSwitchTime(out float InSwitchTime, float DefaultSwitchTime, int upgLevel, KFWeapon KFW)
{
	local float Val;
	Val = default.SwitchBonus;
	if (Val <= 0.f) Val = 0.25f;
	InSwitchTime -= DefaultSwitchTime * Val * upgLevel;
}

defaultproperties
{
    // --- Localization (auto-generated by mass_localize_dk_upgrades.py) ---
    // Strings live in KFGame/Localization/<lang>/ZedternalRBPerkpackage.<langext>
    // Section: [DKWeaponUpg_SwitchSpeed]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalRBPerkpackage"
    LocSection="DKWeaponUpg_SwitchSpeed"

	UpgradeName="Quick Swap"
	UpgradeDescription(0)="Increases your <font color=\"#15d7fa\">weapon switch speed</font> by <font color=\"#77d914\">+%x%%</font> per level."
	WeaponBonus=(baseValue=0, incValue=25, maxValue=-1)
	Name="Default__DKWeaponUpg_SwitchSpeed"
}
