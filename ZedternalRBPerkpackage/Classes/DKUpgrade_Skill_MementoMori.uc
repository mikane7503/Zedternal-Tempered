	UpgradeName="Memento Mori"
	UpgradeDescription(0)="<font color=\"#CC0000\">Memento Mori:</font> Gain <font color=\"#FFFFFF\">+2 permanent Max Health</font> at the end of every <font color=\"#FFAA00\">wave survived</font>. <font color=\"#66FF66\">Stacks each wave</font>; resets on death."
	UpgradeDescription(1)="<font color=\"#CC0000\">Memento Mori:</font> Gain <font color=\"#FFFFFF\">+4 permanent Max Health</font> at the end of every <font color=\"#FFAA00\">wave survived</font>. <font color=\"#66FF66\">Stacks each wave</font>; resets on death."

	UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_MementoMori'
