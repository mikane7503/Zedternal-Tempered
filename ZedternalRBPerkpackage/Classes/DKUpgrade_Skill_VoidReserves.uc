// ===================================================================
// DKUpgrade_Skill_VoidReserves
// Hollow Skill — unlocks the Void Reserves weapon upgrade in the trader.
// Void Reserves: increases both magazine capacity AND spare ammo.
// Deluxe: stronger variant.
// ===================================================================
class DKUpgrade_Skill_VoidReserves extends DKUpgrade_Skill
	config(ZedternalUnlimited);

var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}

