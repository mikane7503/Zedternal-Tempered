    // Section: [DKUpgrade_Skill_ScorchedEarth]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalRBPerkpackage"
    LocSection="DKUpgrade_Skill_ScorchedEarth"

	UpgradeName="ScorchedEarth"
	upgradeDescription(0)="<font color=\"#42e087\">Enable</font> <font color=\"#42e087\">ground fire</font> and increase <font color=\"#42e087\">ground fire damage</font> by <font color=\"#84d6d0\">100%</font>."
	upgradeDescription(1)="<font color=\"#42e087\">Enable</font> <font color=\"#42e087\">ground fire</font> and increase <font color=\"#42e087\">ground fire damage</font> by <font color=\"#84d6d0\">250%</font>."
	UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_ScorchedEarth'
	UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_ScorchedEarth_Deluxe'

	Name="Default__DKUpgrade_Skill_ScorchedEarth"
}
