// ===================================================================
// DKUpgrade_Skill_ScavengersLuck - Active ability: instant reload + fire rate boost
// Standard: Instant reload + +30% fire rate for 10s
// Deluxe: Instant reload + +50% fire rate for 10s
// Cooldown: 60s after effect ends
// ===================================================================
class DKUpgrade_Skill_ScavengersLuck extends DKUpgrade_Skill
	config(ZedternalUnlimited);

var config array<float> FireRateBonus;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.FireRateBonus[0] = 0.3f;
		default.FireRateBonus[1] = 0.5f;

		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


static simulated function InitiateWeapon(int upgLevel, KFWeapon KFW, KFPawn OwnerPawn)
{
	local DKUpgrade_Skill_ScavengersLuck_Helper Helper;
	local DKPlayerController DKPC;
	local bool bFound;
	
	if (KFPawn_Human(OwnerPawn) == None || OwnerPawn.Role != Role_Authority)
		return;
	
	DKPC = DKPlayerController(OwnerPawn.Controller);
	if (DKPC == None)
	{
		`log("DKUpgrade_Skill_ScavengersLuck: ERROR - Player does not have DKPlayerController!");
		return;
	}
	
	bFound = false;
	foreach OwnerPawn.ChildActors(class'DKUpgrade_Skill_ScavengersLuck_Helper', Helper)
	{
		bFound = true;
		Helper.SetTier(upgLevel);
		`log("DKUpgrade_Skill_ScavengersLuck: Updated existing helper to tier" @ upgLevel);
		break;
	}
	
	if (!bFound)
	{
		Helper = OwnerPawn.Spawn(class'DKUpgrade_Skill_ScavengersLuck_Helper', OwnerPawn);
		if (Helper != None)
		{
			Helper.Initialize(upgLevel, KFPawn_Human(OwnerPawn), DKPC);
			`log("DKUpgrade_Skill_ScavengersLuck: Spawned helper for" @ OwnerPawn.PlayerReplicationInfo.PlayerName);
		}
		else
		{
			`log("DKUpgrade_Skill_ScavengersLuck: ERROR - Failed to spawn helper!");
		}
	}
}

static simulated function DeleteHelperClass(Pawn OwnerPawn)
{
	local DKUpgrade_Skill_ScavengersLuck_Helper Helper;
	
	if (OwnerPawn == None)
		return;
	
	foreach OwnerPawn.ChildActors(class'DKUpgrade_Skill_ScavengersLuck_Helper', Helper)
	{
		Helper.Cleanup();
		Helper.Destroy();
		`log("DKUpgrade_Skill_ScavengersLuck: Cleaned up helper");
	}
}

static simulated function ModifyRateOfFire(out float InRate, float DefaultRate, int upgLevel, KFWeapon KFW)
{
	local DKUpgrade_Skill_ScavengersLuck_Helper Helper;
	local KFPawn OwnerPawn;
	
	if (KFW == None || KFW.Owner == None)
		return;
	
	OwnerPawn = KFPawn(KFW.Owner);
	if (OwnerPawn == None)
		return;
	
	foreach OwnerPawn.ChildActors(class'DKUpgrade_Skill_ScavengersLuck_Helper', Helper)
	{
		if (Helper.bActive)
		{
			// BUGFIX: InRate is the fire INTERVAL (smaller = faster). The old
			// += INCREASED it, so activating the ability made you shoot 30/50%
			// SLOWER. Composed like ZR's WMUpgrade_Weapon_RateOfFire.
			InRate = DefaultRate / (DefaultRate / InRate + default.FireRateBonus[upgLevel - 1]);
		}
		break;
	}
}

