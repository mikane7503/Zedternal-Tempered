	upgradeDescription(0)="Unlocks <font color=\"#66cc00\">Scavenger's Luck</font> active ability: <font color=\"#00ffff\">Instant reload</font> + <font color=\"#00ffff\">+30% fire rate</font> for <font color=\"#ffaa33\">10 seconds</font>. Cooldown: <font color=\"#ff9900\">60 seconds</font>."
	
	upgradeDescription(1)="Unlocks <font color=\"#66cc00\">Scavenger's Luck (Deluxe)</font> active ability: <font color=\"#00ffff\">Instant reload</font> + <font color=\"#00ffff\">+50% fire rate</font> for <font color=\"#ffaa33\">10 seconds</font>. Cooldown: <font color=\"#ff9900\">60 seconds</font>."
	
	UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_ScavengersLuck'
	UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_ScavengersLuck_Deluxe'
	
	Name="Default__DKUpgrade_Skill_ScavengersLuck"
}