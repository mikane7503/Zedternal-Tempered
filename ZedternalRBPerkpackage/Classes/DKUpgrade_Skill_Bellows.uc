    // Section: [DKUpgrade_Skill_Bellows]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalRBPerkpackage"
    LocSection="DKUpgrade_Skill_Bellows"

	UpgradeName="Bellows"
	UpgradeDescription(0)="Extend <font color=\"#e80948\">flame weapon range</font> and increase fire rate by <font color=\"#e85009\">10%</font>."
	UpgradeDescription(1)="Extend <font color=\"#e80948\">flame weapon range</font> and increase fire rate by <font color=\"#e85009\">25%</font>."
	UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_Bellows'
	UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_Bellows_Deluxe'

	Name="Default__DKUpgrade_Skill_Bellows"
}
