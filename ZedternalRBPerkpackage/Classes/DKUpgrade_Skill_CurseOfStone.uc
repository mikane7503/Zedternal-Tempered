    UpgradeName="Curse of Stone"
    UpgradeDescription(0)="<font color=\"#8B008B\">Curse of Stone:</font> <font color=\"#FFFFFF\">3% chance</font> on hit to <font color=\"#FFD700\">curse</font> enemy - they take <font color=\"#FF6666\">double damage</font> from all sources for <font color=\"#FFFFFF\">5 seconds</font>."
    UpgradeDescription(1)="<font color=\"#8B008B\">Curse of Stone (Deluxe):</font> <font color=\"#FFFFFF\">5% chance</font> on hit to <font color=\"#FFD700\">curse</font> enemy - they take <font color=\"#FF6666\">double damage</font> from all sources for <font color=\"#FFFFFF\">5 seconds</font> + <font color=\"#FFD700\">cursed enemies spread curse</font> to nearby enemies on death."
    
    UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_CurseOfStone'
