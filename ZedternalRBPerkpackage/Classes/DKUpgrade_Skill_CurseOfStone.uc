class DKUpgrade_Skill_CurseOfStone extends DKUpgrade_Skill
	config(ZedternalUnlimited);

var config array<float> CurseChance;
var config array<float> CurseDamageMultiplier;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.CurseChance[0] = 0.03f;
		default.CurseChance[1] = 0.05f;
		default.CurseDamageMultiplier[0] = 1.0f;
		default.CurseDamageMultiplier[1] = 1.0f;

		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


static function ModifyDamageGiven(out int InDamage, int DefaultDamage, int upgLevel, optional Actor DamageCauser, optional KFPawn_Monster MyKFPM, optional KFPlayerController DamageInstigator, optional class<KFDamageType> DamageType, optional int HitZoneIdx, optional KFWeapon MyKFW)
{
    local DKUpgrade_Skill_CurseOfStone_Helper CurseHelper;
    local float RandValue;
    local bool bShouldCurse, bIsCursed;
    
    if (DamageInstigator == None || DamageInstigator.Pawn == None || MyKFPM == None) return;
    
    // Get helper to manage curse effects
    CurseHelper = GetHelper(DamageInstigator.Pawn);
    if (CurseHelper == None) return;
    
    // Check if target is already cursed
    bIsCursed = CurseHelper.IsMonsterCursed(MyKFPM);
    
    // If cursed, apply double damage
    if (bIsCursed)
    {
        InDamage += Round(float(DefaultDamage) * default.CurseDamageMultiplier[upgLevel - 1]);
    }
    
    // Roll for curse chance on hit (only if not already cursed)
    if (!bIsCursed)
    {
        RandValue = FRand();
        bShouldCurse = (RandValue <= default.CurseChance[upgLevel - 1]);
        
        if (bShouldCurse)
        {
            CurseHelper.CurseMonster(MyKFPM, upgLevel);
        }
    }
    
    // Handle curse spreading on death (Deluxe version)
    if (upgLevel == 2 && InDamage >= MyKFPM.Health && bIsCursed)
    {
        CurseHelper.SpreadCurseOnDeath(MyKFPM);
    }
}

static simulated function InitiateWeapon(int upgLevel, KFWeapon KFW, KFPawn OwnerPawn)
{
    local DKUpgrade_Skill_CurseOfStone_Helper CurseHelper;
    local bool bFound;

    if (KFPawn_Human(OwnerPawn) != None && OwnerPawn.Role == Role_Authority)
    {
        bFound = False;
        foreach OwnerPawn.ChildActors(class'DKUpgrade_Skill_CurseOfStone_Helper', CurseHelper)
        {
            bFound = True;
            break;
        }

        if (!bFound)
        {
            CurseHelper = OwnerPawn.Spawn(class'DKUpgrade_Skill_CurseOfStone_Helper', OwnerPawn);
            CurseHelper.UpgradeLevel = upgLevel;
        }
    }
}

static function DKUpgrade_Skill_CurseOfStone_Helper GetHelper(Pawn OwnerPawn)
{
    local DKUpgrade_Skill_CurseOfStone_Helper CurseHelper;

    if (KFPawn_Human(OwnerPawn) != None)
    {
        foreach OwnerPawn.ChildActors(class'DKUpgrade_Skill_CurseOfStone_Helper', CurseHelper)
        {
            return CurseHelper;
        }

        // Create one if needed
        CurseHelper = OwnerPawn.Spawn(class'DKUpgrade_Skill_CurseOfStone_Helper', OwnerPawn);
    }

    return CurseHelper;
}

static simulated function DeleteHelperClass(Pawn OwnerPawn)
{
    local DKUpgrade_Skill_CurseOfStone_Helper CurseHelper;

    if (OwnerPawn != None)
    {
        foreach OwnerPawn.ChildActors(class'DKUpgrade_Skill_CurseOfStone_Helper', CurseHelper)
        {
            CurseHelper.Destroy();
        }
    }
}

