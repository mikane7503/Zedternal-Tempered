	UpgradeName="Metabolic Overdrive"
	UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_MetabolicOverdrive'
    UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_MetabolicOverdrive_Deluxe'
	UpgradeDescription(0)="The symbiote optimizes cellular energy production for enhanced performance. <font color='#00FF7F'>115%</font> <font color='#9370DB'>magazine capacity</font> for all weapons."
	UpgradeDescription(1)="The symbiote maximizes cellular energy production for enhanced performance. <font color='#00FF7F'>230%</font> <font color='#9370DB'>magazine capacity</font> for all weapons."
	
	Name="Default__DKUpgrade_Skill_MetabolicOverdrive"
}