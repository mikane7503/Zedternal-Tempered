// Headhunter weapon upgrade — base tier
// +4% headshot damage bonus per level.
// L1=4%, L5=20%, L10=40%
class DKWeaponUpg_Headhunter extends DKWeaponUpg_HollowBase
	abstract
	config(ZedternalUnlimited);

var config float HeadshotBonus;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.HeadshotBonus = 0.04f;
		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}

static function bool IsUpgradeCompatible(class<KFWeapon> KFW)
{
	return True;
}

static function ModifyDamageGiven(out int InDamage, int DefaultDamage, int upgLevel, optional Actor DamageCauser, optional KFPawn_Monster MyKFPM, optional KFPlayerController DamageInstigator, optional class<KFDamageType> DamageType, optional int HitZoneIdx, optional KFWeapon MyKFW)
{
	if (HitZoneIdx != HZI_HEAD)
		return;

	InDamage += Round(float(DefaultDamage) * default.HeadshotBonus * upgLevel);
}

defaultproperties
{
    // --- Localization (auto-generated by mass_localize_dk_upgrades.py) ---
    // Strings live in KFGame/Localization/<lang>/ZedternalRBPerkpackage.<langext>
    // Section: [DKWeaponUpg_Headhunter]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalRBPerkpackage"
    LocSection="DKWeaponUpg_Headhunter"

	UpgradeName="Headhunter"
	UpgradeDescription(0)="Increases your <font color=\"#6B0099\">headshot damage</font> by <font color=\"#00CCFF\">+%x%%</font> per level."
	WeaponBonus=(baseValue=0, incValue=4, maxValue=-1)
	RequiredSkillClassPath="ZedternalRBPerkpackage.DKUpgrade_Skill_Headhunter"
	bRequiresDeluxe=False
	Name="Default__DKWeaponUpg_Headhunter"
}
