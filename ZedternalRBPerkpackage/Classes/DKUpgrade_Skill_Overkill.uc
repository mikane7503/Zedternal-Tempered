    // --- Localization (auto-generated by mass_localize_dk_upgrades.py) ---
    // Strings live in KFGame/Localization/<lang>/ZedternalRBPerkpackage.<langext>
    // Section: [DKUpgrade_Skill_Overkill]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalRBPerkpackage"
    LocSection="DKUpgrade_Skill_Overkill"

    UpgradeName="Overkill"
    upgradeDescription(0)="<font color=\"#ff3399\">50%</font> of <font color=\"#ffff00\">excess damage</font> from kills carries over to your <font color=\"#66cc00\">next attack</font>. Max <font color=\"#aaaaaa\">500</font> stored."
    upgradeDescription(1)="<font color=\"#ff3399\">75%</font> of <font color=\"#ffff00\">excess damage</font> from kills carries over to your <font color=\"#66cc00\">next attack</font>. Max <font color=\"#aaaaaa\">500</font> stored."
    UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_Overkill'
    UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_Overkill_Deluxe'

    Name="Default__DKUpgrade_Skill_Overkill"
}
