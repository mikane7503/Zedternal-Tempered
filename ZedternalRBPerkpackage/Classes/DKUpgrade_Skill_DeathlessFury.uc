    bShouldLocalize=True
    LocPackage="ZedternalRBPerkpackage"
    LocSection="DKUpgrade_Skill_DeathlessFury"

	UpgradeName="Deathless Fury"
	UpgradeDescription(0)="<font color=\"#CC0000\">Deathless Fury:</font> <font color=\"#FFFFFF\">+30%</font> <font color=\"#66CCFF\">weapon speed</font> during <font color=\"#9966FF\">Zed Time</font>. <font color=\"#FFFFFF\">+1s</font> <font color=\"#FFAA00\">Zed Time extension</font> on trigger kills."
	UpgradeDescription(1)="<font color=\"#CC0000\">Deathless Fury:</font> <font color=\"#FFFFFF\">+75%</font> <font color=\"#66CCFF\">weapon speed</font> during <font color=\"#9966FF\">Zed Time</font>. <font color=\"#FFFFFF\">+3s</font> <font color=\"#FFAA00\">Zed Time extension</font> on trigger kills."

	UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_DeathlessFury'
	UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_DeathlessFury_Deluxe'

	Name="Default__DKUpgrade_Skill_DeathlessFury"
