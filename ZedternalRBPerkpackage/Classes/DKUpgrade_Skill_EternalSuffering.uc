// ===================================================================
// DKUpgrade_Skill_EternalSuffering - Temporal Snare
// Theme: Tether enemies to a slower timestream. Increased snare
//        power on all attacks slows enemies more effectively.
// Hooks: ModifySnarePower
// Note:  ModifySnarePower has no OwnerPawn param, so no ZED Time
//        gating is possible here. Flat bonus at all times.
// ===================================================================
class DKUpgrade_Skill_EternalSuffering extends DKUpgrade_Skill
	config(ZedternalUnlimited);

var config array<float> SnareBonus;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.SnareBonus[0] = 0.4f;
		default.SnareBonus[1] = 0.8f;

		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


static function ModifySnarePower(out float InSnarePower, float DefaultSnarePower, int upgLevel, optional class<DamageType> DamageType, optional byte HitZoneIdx)
{
	InSnarePower += DefaultSnarePower * default.SnareBonus[upgLevel - 1];
}

defaultproperties
{

    // --- Localization (auto-generated by mass_localize_dk_upgrades.py) ---
    // Strings live in KFGame/Localization/<lang>/ZedternalRBPerkpackage.<langext>
    // Section: [DKUpgrade_Skill_EternalSuffering]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalRBPerkpackage"
    LocSection="DKUpgrade_Skill_EternalSuffering"

	UpgradeName="Eternal Suffering"
	upgradeDescription(0)="<font color=\"#9632ff\">Tether enemies to a slower timestream</font>. All attacks apply <font color=\"#d8b0ff\">+40%</font> snare power."
	upgradeDescription(1)="<font color=\"#9632ff\">Tether enemies to a slower timestream</font>. All attacks apply <font color=\"#d8b0ff\">+80%</font> snare power."
	UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_EternalSuffering'
	UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_EternalSuffering_Deluxe'

	Name="Default__DKUpgrade_Skill_EternalSuffering"
}
