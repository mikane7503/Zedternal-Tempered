class DKUpgrade_Skill_OneManArmy extends DKUpgrade_Skill
	config(ZedternalUnlimited);

// Gain movement speed for each weapon carried in your inventory
// Encourages investing in a full loadout rather than hoarding dosh
// Synergizes with weight limit increases and Bottomless Reserves

var config array<float> SpeedPerWeapon;  // Movement speed bonus per weapon in inventory
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.SpeedPerWeapon[0] = 0.03f;
		default.SpeedPerWeapon[1] = 0.05f;

		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


static simulated function ModifySpeed(out float InSpeed, float DefaultSpeed, int upgLevel, KFPawn OwnerPawn)
{
	local int WeaponCount;
	local Inventory Inv;

	if (OwnerPawn != None && OwnerPawn.InvManager != None)
	{
		WeaponCount = 0;
		for (Inv = OwnerPawn.InvManager.InventoryChain; Inv != None; Inv = Inv.Inventory)
		{
			if (KFWeapon(Inv) != None)
				WeaponCount++;
		}

		if (WeaponCount > 0)
			InSpeed += DefaultSpeed * default.SpeedPerWeapon[upgLevel - 1] * float(WeaponCount);
	}
}

defaultproperties
{

    // --- Localization (auto-generated by mass_localize_dk_upgrades.py) ---
    // Strings live in KFGame/Localization/<lang>/ZedternalRBPerkpackage.<langext>
    // Section: [DKUpgrade_Skill_OneManArmy]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalRBPerkpackage"
    LocSection="DKUpgrade_Skill_OneManArmy"

	UpgradeName="One Man Army"

	UpgradeDescription(0)="<font color=\"#DAA520\">One Man Army:</font> Gain <font color=\"#87CEEB\">+3% movement speed</font> per <font color=\"#FFFFFF\">weapon</font> in your inventory"
	UpgradeDescription(1)="<font color=\"#FFD700\">One Man Army:</font> Gain <font color=\"#87CEEB\">+5% movement speed</font> per <font color=\"#FFFFFF\">weapon</font> in your inventory"

	UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_OneManArmy'
	UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_OneManArmy_Deluxe'

	Name="Default__DKUpgrade_Skill_OneManArmy"
}
