    upgradeDescription(0)="<font color=\"#962ab9\">Decrease</font> your <font color=\"#962ab9\">Maximum Health</font> by <font color=\"#cb1b43\">5</font>. <font color=\"#42e087\">Increase</font> all <font color=\"#42e087\">Healing</font> by <font color=\"#84d6d0\">75%</font>."
    upgradeDescription(1)="<font color=\"#962ab9\">Decrease</font> your <font color=\"#962ab9\">Maximum Health</font> by <font color=\"#cb1b43\">5</font>. <font color=\"#42e087\">Increase</font> all <font color=\"#42e087\">Healing</font> by <font color=\"#84d6d0\">100%</font>."
	UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_PainSplit'
