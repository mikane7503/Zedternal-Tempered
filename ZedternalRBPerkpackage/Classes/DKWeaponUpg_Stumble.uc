	UpgradeDescription(0)="Increases your <font color=\"#15d7fa\">stumble power</font> by <font color=\"#77d914\">+%x%%</font> per level."
	WeaponBonus=(baseValue=0, incValue=20, maxValue=-1)
	Name="Default__DKWeaponUpg_Stumble"
}
