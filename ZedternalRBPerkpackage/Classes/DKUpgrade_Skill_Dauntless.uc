	UpgradeDescription(0)="Increase your <font color=\"#ff3399\">Maximum Armor</font> by <font color=\"#66cc00\">40%</font>."
	UpgradeDescription(1)="Increase your <font color=\"#ff3399\">Maximum Armor</font> by <font color=\"#66cc00\">80%</font>."
