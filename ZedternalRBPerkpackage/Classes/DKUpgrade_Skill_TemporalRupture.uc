// ===================================================================
// DKUpgrade_Skill_TemporalRupture - Corpse Detonation
// Theme: Temporal stress ruptures slain enemies, causing shrapnel
//        explosions on kill. Always on, but shines during ZED Time.
// Hooks: CouldBeZedShrapnel, ShouldShrapnel
// ===================================================================
class DKUpgrade_Skill_TemporalRupture extends DKUpgrade_Skill
	config(ZedternalUnlimited);

var config array<float> Chance;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.Chance[0] = 0.25f;
		default.Chance[1] = 0.5f;

		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


static function bool CouldBeZedShrapnel(int upgLevel, class<KFDamageType> KFDT)
{
	return True;
}

static function bool ShouldShrapnel(int upgLevel)
{
	return (FRand() <= default.Chance[upgLevel - 1]);
}

defaultproperties
{

    // --- Localization (auto-generated by mass_localize_dk_upgrades.py) ---
    // Strings live in KFGame/Localization/<lang>/ZedternalRBPerkpackage.<langext>
    // Section: [DKUpgrade_Skill_TemporalRupture]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalRBPerkpackage"
    LocSection="DKUpgrade_Skill_TemporalRupture"

	UpgradeName="Temporal Rupture"
	upgradeDescription(0)="<font color=\"#9632ff\">Temporal stress ruptures corpses</font>. Enemies killed have a <font color=\"#d8b0ff\">25%</font> chance to explode with <font color=\"#FFFFFF\">shrapnel damage</font>."
	upgradeDescription(1)="<font color=\"#9632ff\">Temporal stress ruptures corpses</font>. Enemies killed have a <font color=\"#d8b0ff\">50%</font> chance to explode with <font color=\"#FFFFFF\">shrapnel damage</font>."
	UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_TemporalRupture'
	UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_TemporalRupture_Deluxe'

	Name="Default__DKUpgrade_Skill_TemporalRupture"
}
