    // Section: [DKUpgrade_Skill_Timeburst]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalRBPerkpackage"
    LocSection="DKUpgrade_Skill_Timeburst"

    UpgradeName="Timeburst"
	upgradeDescription(0)="When <font color=\"#15d7fa\">ZED Time</font> starts, knock down ZEDs in a <font color=\"#77d914\">10 meter</font> radius."
	upgradeDescription(1)="When <font color=\"#15d7fa\">ZED Time</font> starts, knock down ZEDs in a <font color=\"#77d914\">20 meter</font> radius."
	UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_Timeburst'
	UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_Timeburst_Deluxe'

	Name="Default__DKUpgrade_Skill_Timeburst"
}
