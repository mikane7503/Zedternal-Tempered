    UpgradeDescription(1)="<font color=\"#8B008B\">Athena's Wrath (Deluxe):</font> Deal <font color=\"#FFFFFF\">+75% damage</font> to enemies that have <font color=\"#FF6666\">damaged you</font> in the last <font color=\"#FFFFFF\">10 seconds</font> + extends to <font color=\"#FFD700\">enemies of the same type</font>."
    
