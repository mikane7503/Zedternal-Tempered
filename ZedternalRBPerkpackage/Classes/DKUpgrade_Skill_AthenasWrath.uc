class DKUpgrade_Skill_AthenasWrath extends DKUpgrade_Skill
	config(ZedternalUnlimited);

var config array<float> DamageBonus;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.DamageBonus[0] = 0.5f;
		default.DamageBonus[1] = 0.75f;

		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


static function ModifyDamageGiven(out int InDamage, int DefaultDamage, int upgLevel, optional Actor DamageCauser, optional KFPawn_Monster MyKFPM, optional KFPlayerController DamageInstigator, optional class<KFDamageType> DamageType, optional int HitZoneIdx, optional KFWeapon MyKFW)
{
    local DKUpgrade_Skill_AthenasWrath_Helper WrathHelper;
    local bool bShouldGetBonus;
    
    if (DamageInstigator == None || DamageInstigator.Pawn == None || MyKFPM == None) return;
    
    // Get helper to check for revenge targets
    WrathHelper = GetHelper(DamageInstigator.Pawn);
    if (WrathHelper == None) return;
    
    // Check if we should get damage bonus against this enemy
    bShouldGetBonus = WrathHelper.ShouldGetRevengeBonus(MyKFPM, upgLevel);
    
    if (bShouldGetBonus)
    {
        // Apply revenge damage bonus
        InDamage += Round(float(DefaultDamage) * default.DamageBonus[upgLevel - 1]);
    }
}

static function ModifyDamageTaken(out int InDamage, int DefaultDamage, int upgLevel, KFPawn OwnerPawn, optional class<DamageType> DamageType, optional Controller InstigatedBy, optional KFWeapon MyKFW)
{
    local DKUpgrade_Skill_AthenasWrath_Helper WrathHelper;
    local KFPawn_Monster AttackingMonster;
    
    if (OwnerPawn == None || InstigatedBy == None) return;
    
    // Track damage sources for revenge
    AttackingMonster = KFPawn_Monster(InstigatedBy.Pawn);
    if (AttackingMonster != None)
    {
        WrathHelper = GetHelper(OwnerPawn);
        if (WrathHelper != None)
        {
            WrathHelper.TrackAttacker(AttackingMonster, upgLevel);
        }
    }
}

static simulated function InitiateWeapon(int upgLevel, KFWeapon KFW, KFPawn OwnerPawn)
{
    local DKUpgrade_Skill_AthenasWrath_Helper WrathHelper;
    local bool bFound;

    if (KFPawn_Human(OwnerPawn) != None && OwnerPawn.Role == Role_Authority)
    {
        bFound = False;
        foreach OwnerPawn.ChildActors(class'DKUpgrade_Skill_AthenasWrath_Helper', WrathHelper)
        {
            bFound = True;
            break;
        }

        if (!bFound)
        {
            WrathHelper = OwnerPawn.Spawn(class'DKUpgrade_Skill_AthenasWrath_Helper', OwnerPawn);
            WrathHelper.UpgradeLevel = upgLevel;
        }
    }
}

static function DKUpgrade_Skill_AthenasWrath_Helper GetHelper(Pawn OwnerPawn)
{
    local DKUpgrade_Skill_AthenasWrath_Helper WrathHelper;

    if (KFPawn_Human(OwnerPawn) != None)
    {
        foreach OwnerPawn.ChildActors(class'DKUpgrade_Skill_AthenasWrath_Helper', WrathHelper)
        {
            return WrathHelper;
        }

        // Create one if needed
        WrathHelper = OwnerPawn.Spawn(class'DKUpgrade_Skill_AthenasWrath_Helper', OwnerPawn);
    }

    return WrathHelper;
}

static simulated function DeleteHelperClass(Pawn OwnerPawn)
{
    local DKUpgrade_Skill_AthenasWrath_Helper WrathHelper;

    if (OwnerPawn != None)
    {
        foreach OwnerPawn.ChildActors(class'DKUpgrade_Skill_AthenasWrath_Helper', WrathHelper)
        {
            WrathHelper.Destroy();
        }
    }
}

