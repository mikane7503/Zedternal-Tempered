    bShouldLocalize=True
    LocPackage="ZedternalRBPerkpackage"
    LocSection="DKUpgrade_Skill_Arsonist"

    UpgradeName="Arsonist"
	UpgradeDescription(0)="<font color=\"#ff3399\">Burn Effects</font> of weapons last <font color=\"#66cc00\">500%</font> longer."
