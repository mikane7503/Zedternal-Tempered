    UpgradeName="Triskelion"
    upgradeDescription(0)="<font color=\"#962ab9\">Decrease</font> your <font color=\"#962ab9\">Maximum Health</font> by <font color=\"#cb1b43\">5</font>. <font color=\"#42e087\">Increase</font> all <font color=\"#42e087\">Elemental Damage</font> by <font color=\"#84d6d0\">30%</font> for all weapons."
    upgradeDescription(1)="<font color=\"#962ab9\">Decrease</font> your <font color=\"#962ab9\">Maximum Health</font> by <font color=\"#cb1b43\">10</font>. <font color=\"#42e087\">Increase</font> all <font color=\"#42e087\">Elemental Damage</font> by <font color=\"#84d6d0\">60%</font> for all weapons."
	UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_Triskelion'
	UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_Triskelion_Deluxe'
	Name="Default__DKUpgrade_Skill_Triskelion" 
}