class DKUpgrade_Skill_SuppressiveFire extends DKUpgrade_Skill
	config(ZedternalUnlimited);

var config array<float> RateOfFireInv;
var config array<float> SpreadReduction;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.RateOfFireInv[0] = 0.1071f;
		default.RateOfFireInv[1] = 0.1667f;
		default.SpreadReduction[0] = 0.20f;
		default.SpreadReduction[1] = 0.35f;

		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


static simulated function ModifyRateOfFire(out float InRate, float DefaultRate, int upgLevel, KFWeapon KFW)
{
	if (!IsRifleWeapon(KFW))
		return;

	InRate -= DefaultRate * default.RateOfFireInv[upgLevel - 1];
}

static simulated function ModifySpread(out float InSpreadModifier, float DefaultSpreadModifier, int upgLevel, KFWeapon KFW)
{
	if (!IsRifleWeapon(KFW))
		return;

	InSpreadModifier -= DefaultSpreadModifier * default.SpreadReduction[upgLevel - 1];
}

static function bool IsRifleWeapon(KFWeapon KFW)
{
	if (KFW == None)
		return False;

	if (IsWeaponOnSpecificPerk(KFW, class'KFGame.KFPerk_Commando'))
	{
		return (KFW.InstantHitDamage[0] >= 35 ||
				KFW.default.FireInterval[0] >= 0.08);
	}

	return (InStr(PathName(KFW.Class), "Rifle") != INDEX_NONE ||
			InStr(PathName(KFW.Class), "rifle") != INDEX_NONE);
}

defaultproperties
{
    // --- Localization (auto-generated by mass_localize_dk_upgrades.py) ---
    // Strings live in KFGame/Localization/<lang>/ZedternalRBPerkpackage.<langext>
    // Section: [DKUpgrade_Skill_SuppressiveFire]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalRBPerkpackage"
    LocSection="DKUpgrade_Skill_SuppressiveFire"

	// 12% ROF increase -> interval reduction = 0.12/1.12
	// 20% ROF increase -> interval reduction = 0.20/1.20


	UpgradeName="Suppressive Fire"
	UpgradeDescription(0)="Rifles gain <font color=\"#77d914\">+12%</font> <font color=\"#15d7fa\">rate of fire</font> and <font color=\"#77d914\">-20%</font> <font color=\"#15d7fa\">spread</font>."
	UpgradeDescription(1)="Rifles gain <font color=\"#77d914\">+20%</font> <font color=\"#15d7fa\">rate of fire</font> and <font color=\"#77d914\">-35%</font> <font color=\"#15d7fa\">spread</font>."

	UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_SuppressiveFire'
	UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_SuppressiveFire_Deluxe'

	Name="Default__DKUpgrade_Skill_SuppressiveFire"
}
