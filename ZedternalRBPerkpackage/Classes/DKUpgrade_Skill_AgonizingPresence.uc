    // Strings live in KFGame/Localization/<lang>/ZedternalRBPerkpackage.<langext>
    // Section: [DKUpgrade_Skill_AgonizingPresence]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalRBPerkpackage"
    LocSection="DKUpgrade_Skill_AgonizingPresence"

	UpgradeName="Agonizing Presence"
	upgradeDescription(0)="During <font color=\"#9632ff\">ZED Time</font>, your attacks have <font color=\"#d8b0ff\">+50%</font> <font color=\"#FFFFFF\">stumble</font> and <font color=\"#FFFFFF\">knockdown</font> power."
	upgradeDescription(1)="During <font color=\"#9632ff\">ZED Time</font>, your attacks have <font color=\"#d8b0ff\">+100%</font> <font color=\"#FFFFFF\">stumble</font> and <font color=\"#FFFFFF\">knockdown</font> power. Knockdown bonus persists at <font color=\"#d8b0ff\">+50%</font> outside ZED Time."
	UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_AgonizingPresence'
	UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_AgonizingPresence_Deluxe'

	Name="Default__DKUpgrade_Skill_AgonizingPresence"
}
