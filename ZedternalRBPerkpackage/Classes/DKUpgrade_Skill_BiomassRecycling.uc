class DKUpgrade_Skill_BiomassRecycling extends DKUpgrade_Skill
	abstract
	config(ZedternalUnlimited);

var config array<float> SpareAmmo;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.SpareAmmo[0] = 0.10f;
		default.SpareAmmo[1] = 0.20f;

		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


static simulated function ModifySpareAmmoAmount(out int InSpareAmmo, int DefaultSpareAmmo, int upgLevel, KFWeapon KFW, optional const out STraderItem TraderItem, optional bool bSecondary=false)
{
	InSpareAmmo += Round(float(DefaultSpareAmmo) * default.SpareAmmo[upgLevel - 1]);
}

defaultproperties
{
    // --- Localization (auto-generated by mass_localize_dk_upgrades.py) ---
    // Strings live in KFGame/Localization/<lang>/ZedternalRBPerkpackage.<langext>
    // Section: [DKUpgrade_Skill_BiomassRecycling]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalRBPerkpackage"
    LocSection="DKUpgrade_Skill_BiomassRecycling"

	UpgradeName="Biomass Recycling"
	UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_BiomassRecycling'
    UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_BiomassRecycling_Deluxe'
	UpgradeDescription(0)="The symbiote recycles biological matter from slain ZEDs. Gain <font color='#00FF7F'>75%</font> total <font color='#9370DB'>ammo capacity</font>."
	UpgradeDescription(1)="The symbiote recycles organic matter from slain ZEDs. Gain <font color='#00FF7F'>150%</font> total <font color='#9370DB'>ammo capacity</font>."
	Name="Default__DKUpgrade_Skill_BiomassRecycling"
}