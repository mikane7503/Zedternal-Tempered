    bShouldLocalize=True
    LocPackage="ZedternalRBPerkpackage"
    LocSection="DKUpgrade_Skill_Fanatic"

    upgradeName="Fanatic"
	upgradeDescription(0)="Increase <font color=\"#ff3399\">grenade capacity</font> by <font color=\"#66cc00\">5</font>."
	upgradeDescription(1)="Increase <font color=\"#ff3399\">grenade capacity</font> by <font color=\"#66cc00\">10</font>."
	upgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_Fanatic'
