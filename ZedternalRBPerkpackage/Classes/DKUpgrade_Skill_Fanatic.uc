class DKUpgrade_Skill_Fanatic extends DKUpgrade_Skill
	config(ZedternalUnlimited);

var config array<int> ExtraGrenades;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.ExtraGrenades[0] = 5;
		default.ExtraGrenades[1] = 10;

		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


static simulated function ModifySpareGrenadeAmount(out int SpareGrenade, int DefaultSpareGrenade, int upgLevel)
{
	SpareGrenade += default.ExtraGrenades[upgLevel - 1];
}

defaultproperties
{
    // --- Localization (auto-generated by mass_localize_dk_upgrades.py) ---
