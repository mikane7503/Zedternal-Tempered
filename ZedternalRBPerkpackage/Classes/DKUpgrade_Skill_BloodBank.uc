	UpgradeDescription(0)="<font color=\"#B40028\">Blood Bank:</font> Kills store <font color=\"#FFFFFF\">3</font> blood (max <font color=\"#FFFFFF\">50</font>). Stored blood absorbs <font color=\"#FFFFFF\">60%</font> of incoming damage before your HP"
	UpgradeDescription(1)="<font color=\"#FFD700\">[DELUXE]</font> <font color=\"#B40028\">Blood Bank:</font> Kills store <font color=\"#FFFFFF\">5</font> blood (max <font color=\"#FFFFFF\">100</font>). Stored blood absorbs <font color=\"#FFFFFF\">80%</font> of incoming damage before your HP"

	UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_BloodBank'
