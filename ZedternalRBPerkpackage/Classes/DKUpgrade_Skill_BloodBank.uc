// ===================================================================
// DKUpgrade_Skill_BloodBank - Stored Blood Shield
// Kills store blood points (capped). Stored blood absorbs damage
// before real HP is touched. Rewards sustained aggression with a
// secondary buffer that must be constantly replenished.
//
// Standard: +3 stored blood per kill, max 50, absorbs 60% of hit
// Deluxe:   +5 stored blood per kill, max 100, absorbs 80% of hit
// ===================================================================
class DKUpgrade_Skill_BloodBank extends DKUpgrade_Skill
	config(ZedternalUnlimited);

var config array<int> BloodPerKill;
var config array<int> MaxStoredBlood;
var config array<float> AbsorptionRate;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.BloodPerKill[0] = 3;
		default.BloodPerKill[1] = 5;
		default.MaxStoredBlood[0] = 50;
		default.MaxStoredBlood[1] = 100;
		default.AbsorptionRate[0] = 0.60f;
		default.AbsorptionRate[1] = 0.80f;

		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


// ===================================================================
// On Kill: Add stored blood via helper
// ===================================================================
static function AddVampireHealth(out int InHealth, int DefaultHealth, int upgLevel,
	KFPlayerController KFPC, class<DamageType> DT)
{
	local DKUpgrade_Skill_BloodBank_Helper Helper;

	if (KFPC != None && KFPC.Pawn != None)
	{
		Helper = GetHelper(KFPC.Pawn);
		if (Helper != None)
			Helper.AddStoredBlood(default.BloodPerKill[upgLevel - 1], default.MaxStoredBlood[upgLevel - 1]);
	}
}

// ===================================================================
// On Damage Taken: Consume stored blood before real HP
// ===================================================================
static function ModifyDamageTaken(out int InDamage, int DefaultDamage, int upgLevel,
	KFPawn OwnerPawn, optional class<DamageType> DamageType,
	optional Controller InstigatedBy, optional KFWeapon MyKFW)
{
	local DKUpgrade_Skill_BloodBank_Helper Helper;
	local int Absorbed;

	if (OwnerPawn == None || InDamage <= 0)
		return;

	Helper = GetHelper(OwnerPawn);
	if (Helper != None && Helper.StoredBlood > 0)
	{
		// Calculate how much damage stored blood can absorb
		Absorbed = Min(Helper.StoredBlood, Round(float(InDamage) * default.AbsorptionRate[upgLevel - 1]));
		Helper.ConsumeStoredBlood(Absorbed);
		InDamage -= Absorbed;

		if (InDamage < 1)
			InDamage = 1;
	}
}

// ===================================================================
// Helper Management
// ===================================================================
static simulated function InitiateWeapon(int upgLevel, KFWeapon KFW, KFPawn OwnerPawn)
{
	local DKUpgrade_Skill_BloodBank_Helper UPG;
	local bool bFound;

	if (KFPawn_Human(OwnerPawn) != None && OwnerPawn.Role == Role_Authority)
	{
		bFound = False;
		foreach OwnerPawn.ChildActors(class'DKUpgrade_Skill_BloodBank_Helper', UPG)
		{
			bFound = True;
			break;
		}

		if (!bFound)
			OwnerPawn.Spawn(class'DKUpgrade_Skill_BloodBank_Helper', OwnerPawn);
	}
}

static function DKUpgrade_Skill_BloodBank_Helper GetHelper(Pawn OwnerPawn)
{
	local DKUpgrade_Skill_BloodBank_Helper UPG;

	if (KFPawn_Human(OwnerPawn) != None)
	{
		foreach OwnerPawn.ChildActors(class'DKUpgrade_Skill_BloodBank_Helper', UPG)
			return UPG;

		if (OwnerPawn.Role == Role_Authority)
			UPG = OwnerPawn.Spawn(class'DKUpgrade_Skill_BloodBank_Helper', OwnerPawn);
	}

	return UPG;
}

static simulated function DeleteHelperClass(Pawn OwnerPawn)
{
	local DKUpgrade_Skill_BloodBank_Helper UPG;

	if (OwnerPawn != None)
	{
		foreach OwnerPawn.ChildActors(class'DKUpgrade_Skill_BloodBank_Helper', UPG)
			UPG.Destroy();
	}
}

