// Zed Time Focus weapon upgrade — base tier
// +5% damage per level during Zed Time.
// L1=5%, L5=25%, L10=50%
// Detected via WorldInfo.TimeDilation — Zed Time dilates world time to ~0.2
class DKWeaponUpg_ZedTimeFocus extends DKWeaponUpg_HollowBase
	abstract
	config(ZedternalUnlimited);

var config float ZedTimeBonus;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.ZedTimeBonus = 0.05f;
		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}

static function bool IsUpgradeCompatible(class<KFWeapon> KFW)
{
	return True;
}

static function ModifyDamageGiven(out int InDamage, int DefaultDamage, int upgLevel, optional Actor DamageCauser, optional KFPawn_Monster MyKFPM, optional KFPlayerController DamageInstigator, optional class<KFDamageType> DamageType, optional int HitZoneIdx, optional KFWeapon MyKFW)
{
	if (DamageInstigator == None || DamageInstigator.WorldInfo == None)
		return;

	// Zed Time is active when TimeDilation is significantly below 1.0
	// Standard Zed Time sets it to 0.2; threshold of 0.5 safely catches all variants
	if (DamageInstigator.WorldInfo.TimeDilation >= 0.5f)
		return;

	InDamage += Round(float(DefaultDamage) * default.ZedTimeBonus * upgLevel);
}

defaultproperties
{
    // --- Localization (auto-generated by mass_localize_dk_upgrades.py) ---
    // Strings live in KFGame/Localization/<lang>/ZedternalRBPerkpackage.<langext>
    // Section: [DKWeaponUpg_ZedTimeFocus]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalRBPerkpackage"
    LocSection="DKWeaponUpg_ZedTimeFocus"

	UpgradeName="Zed Time Focus"
	UpgradeDescription(0)="Deals <font color=\"#00CCFF\">+%x%%</font> additional damage during <font color=\"#6B0099\">Zed Time</font> per level."
	WeaponBonus=(baseValue=0, incValue=5, maxValue=-1)
	RequiredSkillClassPath="ZedternalRBPerkpackage.DKUpgrade_Skill_ZedTimeFocus"
	bRequiresDeluxe=False
	Name="Default__DKWeaponUpg_ZedTimeFocus"
}
