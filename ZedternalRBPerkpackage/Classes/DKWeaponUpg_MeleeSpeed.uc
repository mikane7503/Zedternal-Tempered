class DKWeaponUpg_MeleeSpeed extends DKUpgrade_Weapon
	abstract
	config(ZedternalUnlimited);

var config float SpeedBonus;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 2)
	{
		default.SpeedBonus = 0.15f;
		default.MODEVERSION = 2;
		static.StaticSaveConfig();
	}
}

static function bool IsUpgradeCompatible(class<KFWeapon> KFW)
{
	if (KFW.default.bMeleeWeapon)
		return True;
	return False;
}

static simulated function ModifyMeleeAttackSpeed(out float InDuration, float DefaultDuration, int upgLevel, KFWeapon KFW)
{
	local float Val;
	Val = default.SpeedBonus;
	if (Val <= 0.f) Val = 0.15f;
	InDuration = DefaultDuration / (DefaultDuration / InDuration + Val * upgLevel);
}

defaultproperties
{
    // --- Localization (auto-generated by mass_localize_dk_upgrades.py) ---
    // Strings live in KFGame/Localization/<lang>/ZedternalRBPerkpackage.<langext>
    // Section: [DKWeaponUpg_MeleeSpeed]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalRBPerkpackage"
    LocSection="DKWeaponUpg_MeleeSpeed"

	UpgradeName="Blade Dancer"
	UpgradeDescription(0)="Increases your <font color=\"#15d7fa\">melee attack speed</font> by <font color=\"#77d914\">+%x%%</font> per level."
	WeaponBonus=(baseValue=0, incValue=15, maxValue=-1)
	Name="Default__DKWeaponUpg_MeleeSpeed"
}
