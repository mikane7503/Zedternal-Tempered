// Outbreak: Periodically release a massive poison pulse affecting all ZEDs in a huge radius.
// Guarantees baseline poison coverage across the battlefield.
// Focus on exploiting poison synergies rather than manually poisoning.
class DKUpgrade_Skill_Outbreak extends DKUpgrade_Skill;

static simulated function InitiateWeapon(int upgLevel, KFWeapon KFW, KFPawn OwnerPawn)
{
	local DKUpgrade_Skill_Outbreak_Helper UPG;
	local bool bFound;

	if (KFPawn_Human(OwnerPawn) != None && OwnerPawn.Role == Role_Authority)
	{
		bFound = False;
		foreach OwnerPawn.ChildActors(class'DKUpgrade_Skill_Outbreak_Helper', UPG)
		{
			bFound = True;
			break;
		}

		if (!bFound)
		{
			UPG = OwnerPawn.Spawn(class'DKUpgrade_Skill_Outbreak_Helper', OwnerPawn);
			UPG.StartTimer(upgLevel > 1);
		}
	}
}

static simulated function DeleteHelperClass(Pawn OwnerPawn)
{
	local DKUpgrade_Skill_Outbreak_Helper UPG;

	if (OwnerPawn != None)
	{
		foreach OwnerPawn.ChildActors(class'DKUpgrade_Skill_Outbreak_Helper', UPG)
		{
			UPG.Destroy();
		}
	}
}

defaultproperties
{
    // --- Localization (auto-generated by mass_localize_dk_upgrades.py) ---
    // Strings live in KFGame/Localization/<lang>/ZedternalRBPerkpackage.<langext>
    // Section: [DKUpgrade_Skill_Outbreak]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalRBPerkpackage"
    LocSection="DKUpgrade_Skill_Outbreak"

	UpgradeDescription(0)="Every <font color=\"#ebd402\">15 seconds</font>, release a massive <font color=\"#399c0e\">toxic pulse</font> that <font color=\"#8fce00\">Poisons</font> all nearby ZEDs."
	UpgradeDescription(1)="Every <font color=\"#ebd402\">10 seconds</font>, release a massive <font color=\"#b346ea\">toxic pulse</font> that <font color=\"#8fce00\">Poisons</font> all nearby ZEDs."

	UpgradeName="Outbreak"
	UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_Outbreak'
	UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_Outbreak_Deluxe'

	Name="Default__DKUpgrade_Skill_Outbreak"
}
