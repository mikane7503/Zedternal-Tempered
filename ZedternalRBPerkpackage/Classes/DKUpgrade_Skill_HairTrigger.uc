// ===================================================================
// DKUpgrade_Skill_HairTrigger - Detonator Skill
//
// "Hair Trigger" - Reduces charge threshold and extends active window.
//
// Standard: Threshold -5 kills, window +3s.
// Deluxe:   Threshold -10 kills, window +6s.
//
// Pure signal skill -- all logic lives in the Detonator helper.
// ===================================================================
class DKUpgrade_Skill_HairTrigger extends DKUpgrade_Skill;

// Signal presence to Detonator Helper via ExtensionFuncInteger.
// Returns upgLevel (1=standard, 2=deluxe) when queried with "DetonatorHairTrigger".
static simulated function ExtensionFuncInteger(out int InValue, int DefaultValue, int upgLevel, string Identifier,
    KFWeapon MyKFW, KFPawn OwnerPawn, optional int InputInt, optional float InputFloat, optional name InputClassName,
    optional Object InputObject1, optional Object InputObject2, optional Object InputObject3)
{
    if (Identifier ~= "DetonatorHairTrigger")
        InValue = upgLevel;
}

defaultproperties
{
    // --- Localization (auto-generated by mass_localize_dk_upgrades.py) ---
    // Strings live in KFGame/Localization/<lang>/ZedternalRBPerkpackage.<langext>
    // Section: [DKUpgrade_Skill_HairTrigger]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalRBPerkpackage"
    LocSection="DKUpgrade_Skill_HairTrigger"

    UpgradeName="Hair Trigger"
    upgradeDescription(0)="Charge threshold reduced by <font color=\"#FFD700\">5</font> kills. Active window extended by <font color=\"#FFD700\">+3s</font>."
    upgradeDescription(1)="Charge threshold reduced by <font color=\"#FFD700\">10</font> kills. Active window extended by <font color=\"#FFD700\">+6s</font>."
    UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_HairTrigger'
    UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_HairTrigger_Deluxe'

    Name="Default__DKUpgrade_Skill_HairTrigger"
}
