// ===================================================================
// DKUpgrade_Skill_HotStreak - Gambit Skill
//
// "Hot Streak" - Consecutive gambit completions build a reward
// multiplier: 1x -> 1.25x -> 1.5x -> 1.75x -> 2x (over 4 streaks).
//
// Standard: Failure resets streak to 0.
// Deluxe:   Failure only drops streak by 1 instead of full reset.
//
// Pure signal skill -- all logic lives in the Gambit Helper.
// ===================================================================
class DKUpgrade_Skill_HotStreak extends DKUpgrade_Skill;

// Signal presence to Gambit Helper via ExtensionFuncInteger
// Returns upgLevel (1=standard, 2=deluxe) when queried with "GambitHotStreak"
static simulated function ExtensionFuncInteger(out int InValue, int DefaultValue, int upgLevel, string Identifier,
    KFWeapon MyKFW, KFPawn OwnerPawn, optional int InputInt, optional float InputFloat, optional name InputClassName,
    optional Object InputObject1, optional Object InputObject2, optional Object InputObject3)
{
    if (Identifier ~= "GambitHotStreak")
        InValue = upgLevel;
}

defaultproperties
{
    // --- Localization (auto-generated by mass_localize_dk_upgrades.py) ---
    // Strings live in KFGame/Localization/<lang>/ZedternalRBPerkpackage.<langext>
    // Section: [DKUpgrade_Skill_HotStreak]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalRBPerkpackage"
    LocSection="DKUpgrade_Skill_HotStreak"

    UpgradeName="Hot Streak"
    upgradeDescription(0)="Consecutive gambit completions build a reward multiplier up to <font color=\"#FFD700\">2x</font>. Failure resets the streak."
    upgradeDescription(1)="Consecutive gambit completions build a reward multiplier up to <font color=\"#FFD700\">2x</font>. Failure only drops the streak by <font color=\"#FFFFFF\">1</font>."
    UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_HotStreak'
    UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_HotStreak_Deluxe'

    Name="Default__DKUpgrade_Skill_HotStreak"
}
