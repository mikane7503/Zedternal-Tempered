    // Strings live in KFGame/Localization/<lang>/ZedternalRBPerkpackage.<langext>
    // Section: [DKUpgrade_Skill_NoSurrender]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalRBPerkpackage"
    LocSection="DKUpgrade_Skill_NoSurrender"

	UpgradeName="No Surrender"

	UpgradeDescription(0)="<font color=\"#edb82a\">No Surrender</font> When below <font color=\"#DC143C\">5% HP</font>:  <font color=\"#4169E1\">+50% Damage Resistance</font>  Melee kills <font color=\"#32CD32\">heal 25 HP</font> <font color=\"#AAAAAA\">They'll have to kill you twice.</font>"
	UpgradeDescription(1)="<font color=\"#edb82a\">No Surrender</font> When below <font color=\"#DC143C\">10% HP</font>:  <font color=\"#4169E1\">+70% Damage Resistance</font>  Melee kills <font color=\"#32CD32\">heal 40 HP</font> <font color=\"#AAAAAA\">They'll have to kill you twice.</font>"

	UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_NoSurrender'
	UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_NoSurrender_Deluxe'

	Name="Default__DKUpgrade_Skill_NoSurrender"
}
