	UpgradeDescription(1)="Gain <font color=\"#b346ea\">7% damage reduction</font> for each nearby <font color=\"#8fce00\">Poisoned</font> ZED. Max 50%."

	UpgradeName="Venomweave"
	UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_Venomweave'
