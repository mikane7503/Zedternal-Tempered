    UpgradeName="Weightless"
	upgradeDescription(0)="Gain <font color=\"#ff3399\">15%</font> more <font color=\"#66cc00\">Movement Speed</font> while you have <font color=\"#be4d25\">no armor</font>."
   	upgradeDescription(1)="Gain <font color=\"#ff3399\">30%</font> more <font color=\"#66cc00\">Movement Speed</font> while you have <font color=\"#be4d25\">no armor</font>."
