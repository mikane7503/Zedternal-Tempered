    LocSection="DKUpgrade_Skill_ParasiticBond"

	UpgradeName="Parasitic Bond"
	UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_ParasiticBond'
	UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_ParasiticBond_Deluxe'
	UpgradeDescription(0)="The symbiote forms a parasitic bond, enhancing the host's vitality. <font color='#00FF7F'>15%</font> <font color='#9370DB'>maximum health</font> and <font color='#00FF7F'>8%</font> <font color='#9370DB'>movement speed</font>."
	UpgradeDescription(1)="The symbiote forms a deeper parasitic bond enhancing the host's vitality. <font color='#00FF7F'>25%</font> <font color='#9370DB'>maximum health</font> and <font color='#00FF7F'>12%</font> <font color='#9370DB'>movement speed</font>."
	
	Name="Default__DKUpgrade_Skill_ParasiticBond"
}