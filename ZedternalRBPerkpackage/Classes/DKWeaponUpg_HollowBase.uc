// ===================================================================
// DKWeaponUpg_HollowBase
//
// Abstract base class for all Hollow Skill weapon upgrades.
// Subclasses are only visible in DKUI_UPGMenu to players who own
// the linked skill. Gating is purely client-side display — the
// upgrade slots exist server-wide in WeaponUpgradeSlotsList so all
// players share the same random seed assignment.
//
// RequiredSkillClassPath: full package.ClassName of the skill that
//   must be purchased (GetSkillUpgrade > 0) for this upgrade to show.
// bRequiresDeluxe: if True, the player must have purchased the
//   Deluxe version of the skill (IsSkillDeluxe == True).
// ===================================================================
class DKWeaponUpg_HollowBase extends DKUpgrade_Weapon
	abstract;

var string RequiredSkillClassPath;
var bool bRequiresDeluxe;

defaultproperties
{
    // --- Localization (auto-generated by mass_localize_dk_upgrades.py) ---
    // Strings live in KFGame/Localization/<lang>/ZedternalRBPerkpackage.<langext>
    // Section: [DKWeaponUpg_HollowBase]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalRBPerkpackage"
    LocSection="DKWeaponUpg_HollowBase"

	RequiredSkillClassPath=""
	bRequiresDeluxe=False
	Name="Default__DKWeaponUpg_HollowBase"
}
