	UpgradeName="No Woman No Cry"
	upgradeDescription(0)="Gain <font color=\"#ff3399\">50</font> extra dosh for every <font color=\"#66cc00\">Matriarch</font> you kill."
    upgradeDescription(1)="Gain <font color=\"#ff3399\">100</font> extra dosh for every <font color=\"#66cc00\">Matriarch</font> you kill."
	UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_NoWomanNoCry'
	UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_NoWomanNoCry_Deluxe'
    Name="Default__DKUpgrade_Skill_NoWomanNoCry"
}