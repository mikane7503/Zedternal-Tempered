class DKUpgrade_Skill_Resourceful extends DKUpgrade_Skill
	config(ZedternalUnlimited);

var config array<float> Ammo;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.Ammo[0] = 2.5f;
		default.Ammo[1] = 4.0f;

		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


static simulated function InitiateWeapon(int upgLevel, KFWeapon KFW, KFPawn OwnerPawn)
{
	local byte i;

	if (KFW != None)
	{
		for (i = 0; i <= 1; ++i)
		{
			KFW.AmmoPickupScale[i] = KFW.default.AmmoPickupScale[i] * default.Ammo[upgLevel - 1];
		}
	}

	if (KFWeap_Thrown_C4(KFW) != None)
		KFW.AmmoPickupScale[0] = FCeil(KFW.AmmoPickupScale[0]);
}

defaultproperties
{
    // --- Localization (auto-generated by mass_localize_dk_upgrades.py) ---
    // Strings live in KFGame/Localization/<lang>/ZedternalRBPerkpackage.<langext>
    // Section: [DKUpgrade_Skill_Resourceful]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalRBPerkpackage"
    LocSection="DKUpgrade_Skill_Resourceful"

    UpgradeName="Resourceful"
	upgradeDescription(0)="Increase <font color=\"#ff3399\">Ammunition</font> picked up from Ammo Crates by <font color=\"#66cc00\">250%</font>."
	upgradeDescription(1)="Increase <font color=\"#ff3399\">Ammunition</font> picked up from Ammo Crates by <font color=\"#66cc00\">400%</font>."
	UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_Resourceful'
	UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_Resourceful_Deluxe'
    Name="Default__DKUpgrade_Skill_Resourceful"
}