class DKHollowWeaponData extends Object
	abstract;

// ===================================================================
// HOLLOW WEAPON DATA - Per-Weapon Stat Bonuses + Behavior Mods
//
// Generated by Hollow Weapon Stat Generator.
// 128 weapons with 14 stat overrides + behavior mod assignments.
//
// Stat values are float multipliers applied to base weapon stats.
// Example: 1.25f on Damage = +125% bonus damage on Hollow variant.
// 0.00f = stat not applicable for this weapon (skipped).
// ===================================================================

// Per-weapon overrides: parallel arrays (NormName at index i -> bonus at index i)
var array<string> OverrideName;
var array<float> OverrideDamage;
var array<float> OverrideReload;
var array<float> OverrideMag;
var array<float> OverrideAmmo;
var array<float> OverrideRecoil;
var array<float> OverrideSpread;
var array<float> OverrideRateOfFire;
var array<float> OverridePenetration;
var array<float> OverrideStumble;
var array<float> OverrideMeleeSpeed;
var array<float> OverrideHardAttack;
var array<float> OverrideDoTScaler;
var array<float> OverrideMoveSpeed;
var array<float> OverrideDamageResist;

// Behavior mod registry: NormName -> mod type string
var array<string> BehaviorModName;
var array<string> BehaviorModType;

// Hollow weapon registry: maps NormName <-> WeapDef path
var array<string> HollowWeaponNormNames;
var array<string> HollowWeaponDefPaths;

// ===================================================================
// STAT GETTER FUNCTIONS
//
// Core stats: Universal flat bonuses for ALL Hollow weapons.
//   Damage:     +100% (doubles base damage)
//   Reload:     0.50  (halves reload time = doubles reload speed)
//   Recoil:     0.50  (halves recoil)
//   Spread:     0.50  (halves spread)
//   Mag Size:   +100% (doubles magazine capacity)
//   Spare Ammo: +100% (doubles spare ammo)
//
// Extended stats: Per-weapon via override arrays (0.0 if not set).
// ===================================================================

// --- CORE STATS (universal, no per-weapon lookup) ---

static function float GetDamageBonus(string NormName)
{
	return 1.0f;
}

static function float GetReloadBonus(string NormName)
{
	return 0.5f;
}

static function float GetMagBonus(string NormName)
{
	return 1.0f;
}

static function float GetAmmoBonus(string NormName)
{
	return 1.0f;
}

static function float GetRecoilBonus(string NormName)
{
	return 0.5f;
}

static function float GetSpreadBonus(string NormName)
{
	return 0.5f;
}

// --- EXTENDED STATS (per-weapon via override arrays) ---

static function float GetRateOfFireBonus(string NormName)
{
	local int Idx;

	Idx = FindOverrideIndex(NormName);
	if (Idx != INDEX_NONE && Idx < default.OverrideRateOfFire.Length)
		return default.OverrideRateOfFire[Idx] - 1.0f;

	return 0.0f;
}

static function float GetPenetrationBonus(string NormName)
{
	local int Idx;

	Idx = FindOverrideIndex(NormName);
	if (Idx != INDEX_NONE && Idx < default.OverridePenetration.Length)
		return default.OverridePenetration[Idx] - 1.0f;

	return 0.0f;
}

static function float GetStumbleBonus(string NormName)
{
	local int Idx;

	Idx = FindOverrideIndex(NormName);
	if (Idx != INDEX_NONE && Idx < default.OverrideStumble.Length)
		return default.OverrideStumble[Idx] - 1.0f;

	return 0.0f;
}

static function float GetMeleeSpeedBonus(string NormName)
{
	local int Idx;

	Idx = FindOverrideIndex(NormName);
	if (Idx != INDEX_NONE && Idx < default.OverrideMeleeSpeed.Length)
		return default.OverrideMeleeSpeed[Idx] - 1.0f;

	return 0.0f;
}

static function float GetHardAttackBonus(string NormName)
{
	local int Idx;

	Idx = FindOverrideIndex(NormName);
	if (Idx != INDEX_NONE && Idx < default.OverrideHardAttack.Length)
		return default.OverrideHardAttack[Idx] - 1.0f;

	return 0.0f;
}

static function float GetDoTScalerBonus(string NormName)
{
	local int Idx;

	Idx = FindOverrideIndex(NormName);
	if (Idx != INDEX_NONE && Idx < default.OverrideDoTScaler.Length)
		return default.OverrideDoTScaler[Idx] - 1.0f;

	return 0.0f;
}

static function float GetMoveSpeedBonus(string NormName)
{
	local int Idx;

	Idx = FindOverrideIndex(NormName);
	if (Idx != INDEX_NONE && Idx < default.OverrideMoveSpeed.Length)
		return default.OverrideMoveSpeed[Idx] - 1.0f;

	return 0.0f;
}

static function float GetDamageResistBonus(string NormName)
{
	local int Idx;

	Idx = FindOverrideIndex(NormName);
	if (Idx != INDEX_NONE && Idx < default.OverrideDamageResist.Length)
		return default.OverrideDamageResist[Idx] - 1.0f;

	return 0.0f;
}

// ===================================================================
// BEHAVIOR MOD LOOKUP
// ===================================================================

/** Get behavior mod type for a weapon. Returns empty string if none. */
static function string GetBehaviorMod(string NormName)
{
	local int i;

	for (i = 0; i < default.BehaviorModName.Length; ++i)
	{
		if (default.BehaviorModName[i] == NormName)
			return default.BehaviorModType[i];
	}

	return "";
}

/** Check if a weapon has a specific behavior mod. */
static function bool HasBehaviorMod(string NormName, string ModType)
{
	return GetBehaviorMod(NormName) == ModType;
}

// ===================================================================
// UTILITY FUNCTIONS
// ===================================================================

static function int FindOverrideIndex(string NormName)
{
	local int i;

	for (i = 0; i < default.OverrideName.Length; ++i)
	{
		if (default.OverrideName[i] == NormName)
			return i;
	}

	return INDEX_NONE;
}

static function int GetHollowWeaponCount()
{
	return default.HollowWeaponNormNames.Length;
}

static function string GetHollowNormName(int Index)
{
	if (Index >= 0 && Index < default.HollowWeaponNormNames.Length)
		return default.HollowWeaponNormNames[Index];
	return "";
}

static function string GetHollowDefPath(int Index)
{
	if (Index >= 0 && Index < default.HollowWeaponDefPaths.Length)
		return default.HollowWeaponDefPaths[Index];
	return "";
}

static function string FindHollowDefPath(string NormName)
{
	local int i;

	for (i = 0; i < default.HollowWeaponNormNames.Length; ++i)
	{
		if (default.HollowWeaponNormNames[i] == NormName)
		{
			if (i < default.HollowWeaponDefPaths.Length)
				return default.HollowWeaponDefPaths[i];
			return "";
		}
	}

	return "";
}

static function bool HasHollowVariant(string NormName)
{
	local int i;

	for (i = 0; i < default.HollowWeaponNormNames.Length; ++i)
	{
		if (default.HollowWeaponNormNames[i] == NormName)
			return True;
	}

	return False;
}

