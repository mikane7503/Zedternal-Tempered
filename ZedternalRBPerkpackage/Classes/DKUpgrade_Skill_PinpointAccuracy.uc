    bShouldLocalize=True
    LocPackage="ZedternalRBPerkpackage"
    LocSection="DKUpgrade_Skill_PinpointAccuracy"

    UpgradeName="PinpointAccuracy"
    upgradeDescription(0)="<font color=\"#962ab9\">Decrease</font> your <font color=\"#962ab9\">Maximum Health</font> by <font color=\"#cb1b43\">10</font>. <font color=\"#42e087\">Decrease</font> your <font color=\"#42e087\">Recoil</font> by <font color=\"#84d6d0\">50%</font> and <font color=\"#84d6d0\">reduce</font> <font color=\"#42e087\">Weapon Bob</font> for all weapons."
    upgradeDescription(1)="<font color=\"#962ab9\">Decrease</font> your <font color=\"#962ab9\">Maximum Health</font> by <font color=\"#cb1b43\">25</font>. <font color=\"#42e087\">Decrease</font> your <font color=\"#42e087\">Recoil</font> by <font color=\"#84d6d0\">75%</font> and <font color=\"#84d6d0\">negate</font> <font color=\"#42e087\">Weapon Bob</font> for all weapons."
	UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_PinpointAccuracy'
	UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_PinpointAccuracy_Deluxe'
	Name="Default__DKUpgrade_Skill_PinpointAccuracy"
}
