    upgradeDescription(1)="You deal <font color=\"#ff3399\">30%</font> extra <font color=\"#7ed8d5\">Damage</font> to <font color=\"#f923be\">Bloats</font> and all <font color=\"#f923be\">Bloat Variants</font>."
