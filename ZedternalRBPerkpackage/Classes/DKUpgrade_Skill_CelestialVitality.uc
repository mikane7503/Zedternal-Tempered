// Celestial Vitality
// Increases the effectiveness of self-healing (syringe self-heal surge)
// Standard: +15% self-healing surge
// Deluxe: +35% self-healing surge
class DKUpgrade_Skill_CelestialVitality extends DKUpgrade_Skill
	config(ZedternalUnlimited);

var config array<float> SelfHealBonus;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.SelfHealBonus[0] = 0.15f;
		default.SelfHealBonus[1] = 0.35f;

		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


static simulated function GetSelfHealingSurgePct(out float InHealingPct, int upgLevel)
{
	InHealingPct += default.SelfHealBonus[upgLevel - 1];
}

defaultproperties
{

    // --- Localization (auto-generated by mass_localize_dk_upgrades.py) ---
    // Strings live in KFGame/Localization/<lang>/ZedternalRBPerkpackage.<langext>
    // Section: [DKUpgrade_Skill_CelestialVitality]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalRBPerkpackage"
    LocSection="DKUpgrade_Skill_CelestialVitality"

	UpgradeName="Celestial Vitality"
	UpgradeDescription(0)="Increase <font color=\"#00ff7f\">self-healing surge</font> effectiveness by <font color=\"#eeeeff\">15%</font>"
	UpgradeDescription(1)="<font color=\"#ffd700\">Deluxe.</font> Increase <font color=\"#00ff7f\">self-healing surge</font> effectiveness by <font color=\"#eeeeff\">35%</font>"
	UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_CelestialVitality'
	UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_CelestialVitality_Deluxe'

	Name="Default__DKUpgrade_Skill_CelestialVitality"
}
