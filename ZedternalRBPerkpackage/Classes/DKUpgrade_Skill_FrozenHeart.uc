    // Section: [DKUpgrade_Skill_FrozenHeart]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalRBPerkpackage"
    LocSection="DKUpgrade_Skill_FrozenHeart"

	UpgradeName="Frozen Heart"
	upgradeDescription(0)="Once per wave, teammates can restock <font color=\"#15d7fa\">50%</font> of their <font color=\"#0bf1f1\">Maximum Ammunition</font> from you. Increase <font color=\"#0bf1f1\">Magazine size</font> for all weapons by <font color=\"#15d7fa\">50%</font>."
	upgradeDescription(1)="Once per wave, teammates can restock <font color=\"#15d7fa\">50%</font> of their <font color=\"#0bf1f1\">Maximum Ammunition</font> from you. Increase <font color=\"#0bf1f1\">Magazine size</font> for all weapons by <font color=\"#15d7fa\">75%</font>."
	UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_FrozenHeart'
	UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_FrozenHeart_Deluxe'
    Name="Default__DKUpgrade_Skill_FrozenHeart"
}
