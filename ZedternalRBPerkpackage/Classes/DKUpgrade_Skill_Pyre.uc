class DKUpgrade_Skill_Pyre extends DKUpgrade_Skill
	config(ZedternalUnlimited);

// Pyre: Increases heavy melee attack damage.
// Standard: +50% heavy melee damage.
// Deluxe:   +120% heavy melee damage.

var config array<float> Damage;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.Damage[0] = 0.5f;
		default.Damage[1] = 1.2f;

		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


static function ModifyHardAttackDamage(out int InDamage, int DefaultDamage, int upgLevel, KFPawn OwnerPawn)
{
	InDamage += Round(float(DefaultDamage) * default.Damage[upgLevel - 1]);
}

defaultproperties
{
    // --- Localization (auto-generated by mass_localize_dk_upgrades.py) ---
    // Strings live in KFGame/Localization/<lang>/ZedternalRBPerkpackage.<langext>
    // Section: [DKUpgrade_Skill_Pyre]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalRBPerkpackage"
    LocSection="DKUpgrade_Skill_Pyre"

	UpgradeName="Pyre"
	upgradeDescription(0)="<font color=\"#42e087\">Increase</font> <font color=\"#42e087\">heavy melee attack damage</font> by <font color=\"#84d6d0\">50%</font>."
	upgradeDescription(1)="<font color=\"#42e087\">Increase</font> <font color=\"#42e087\">heavy melee attack damage</font> by <font color=\"#84d6d0\">120%</font>."
	UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_Pyre'
	UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_Pyre_Deluxe'

	Name="Default__DKUpgrade_Skill_Pyre"
}
