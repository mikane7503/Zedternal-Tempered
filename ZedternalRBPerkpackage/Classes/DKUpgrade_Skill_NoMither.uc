    bShouldLocalize=True
    LocPackage="ZedternalRBPerkpackage"
    LocSection="DKUpgrade_Skill_NoMither"

    UpgradeName="NoMither"
	upgradeDescription(0)="Deal <font color=\"#ff3399\">25%</font> more <font color=\"#66cc00\">Damage</font> with all weapons while you have <font color=\"#be4d25\">no armor</font>."
   	upgradeDescription(1)="Deal <font color=\"#ff3399\">50%</font> more <font color=\"#66cc00\">Damage</font> with all weapons while you have <font color=\"#be4d25\">no armor</font>."
	UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_NoMither'
	UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_NoMither_Deluxe'
    Name="Default__DKUpgrade_Skill_NoMither"
}