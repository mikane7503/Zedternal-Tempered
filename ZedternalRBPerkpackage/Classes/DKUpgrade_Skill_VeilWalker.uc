    bShouldLocalize=True
    LocPackage="ZedternalRBPerkpackage"
    LocSection="DKUpgrade_Skill_VeilWalker"

	UpgradeName="Veil Walker"
	UpgradeDescription(0)="<font color=\"#CC0000\">Veil Walker:</font> <font color=\"#FFFFFF\">+30%</font> <font color=\"#66CCFF\">iron sight speed</font> and <font color=\"#FFFFFF\">+20%</font> <font color=\"#FFAA00\">crouch speed</font>. Move like a phantom between the living."
	UpgradeDescription(1)="<font color=\"#CC0000\">Veil Walker:</font> <font color=\"#FFFFFF\">+75%</font> <font color=\"#66CCFF\">iron sight speed</font> and <font color=\"#FFFFFF\">+50%</font> <font color=\"#FFAA00\">crouch speed</font>. Move like a phantom between the living."

	UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_VeilWalker'
	UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_VeilWalker_Deluxe'

	Name="Default__DKUpgrade_Skill_VeilWalker"
