class DKUpgrade_Skill_VeilWalker extends DKUpgrade_Skill
	config(ZedternalUnlimited);

// Veil Walker: The Reaper moves between the living and dead with ghostly agility.
// Faster iron sight movement and increased crouch speed for tactical repositioning.

var config array<float> IronSightBonus;
var config array<float> CrouchBonus;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.IronSightBonus[0] = 0.30f;
		default.IronSightBonus[1] = 0.75f;
		default.CrouchBonus[0] = 0.20f;
		default.CrouchBonus[1] = 0.50f;

		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


static simulated function GetIronSightSpeedModifier(out float InSpeed, float DefaultSpeed, int upgLevel)
{
	InSpeed += DefaultSpeed * default.IronSightBonus[upgLevel - 1];
}

static simulated function GetCrouchSpeedModifier(out float InSpeed, float DefaultSpeed, int upgLevel)
{
	InSpeed += DefaultSpeed * default.CrouchBonus[upgLevel - 1];
}

defaultproperties
{

