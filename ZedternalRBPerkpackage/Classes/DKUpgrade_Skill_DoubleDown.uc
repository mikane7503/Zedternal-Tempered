class DKUpgrade_Skill_DoubleDown extends DKUpgrade_Skill
	config(ZedternalUnlimited);

var config array<float> HeadshotBonus, BodyPenalty;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.HeadshotBonus[0] = 0.30f;
		default.HeadshotBonus[1] = 0.60f;
		default.BodyPenalty[0] = 0.10f;
		default.BodyPenalty[1] = 0.15f;

		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


static function ModifyDamageGiven(out int InDamage, int DefaultDamage, int upgLevel, optional Actor DamageCauser, optional KFPawn_Monster MyKFPM, optional KFPlayerController DamageInstigator, optional class<KFDamageType> DamageType, optional int HitZoneIdx, optional KFWeapon MyKFW)
{
    if (HitZoneIdx == HZI_HEAD)
    {
        // Headshot: bonus damage
        InDamage += Round(float(DefaultDamage) * default.HeadshotBonus[upgLevel - 1]);
    }
    else
    {
        // Body shot: penalty damage
        InDamage -= Round(float(DefaultDamage) * default.BodyPenalty[upgLevel - 1]);
    }
}

defaultproperties
{

    // --- Localization (auto-generated by mass_localize_dk_upgrades.py) ---
    // Strings live in KFGame/Localization/<lang>/ZedternalRBPerkpackage.<langext>
    // Section: [DKUpgrade_Skill_DoubleDown]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalRBPerkpackage"
    LocSection="DKUpgrade_Skill_DoubleDown"

    UpgradeName="Double Down"
    upgradeDescription(0)="<font color=\"#ff3399\">Headshots</font> deal <font color=\"#66cc00\">+30%</font> damage, but <font color=\"#be4d25\">body shots</font> deal <font color=\"#ff0000\">-10%</font> damage."
    upgradeDescription(1)="<font color=\"#ff3399\">Headshots</font> deal <font color=\"#66cc00\">+60%</font> damage, but <font color=\"#be4d25\">body shots</font> deal <font color=\"#ff0000\">-15%</font> damage."
    UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_DoubleDown'
    UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_DoubleDown_Deluxe'

    Name="Default__DKUpgrade_Skill_DoubleDown"
}
