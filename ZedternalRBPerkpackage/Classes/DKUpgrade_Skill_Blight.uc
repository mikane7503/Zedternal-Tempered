// Blight: Your Neurotoxin devastates ZED nervous systems.
// Massive passive snare boost makes ALL your attacks slow ZEDs significantly.
// Also boosts snare power specifically for toxic damage.
// Your poison becomes crowd control - the team's CC specialist.
class DKUpgrade_Skill_Blight extends DKUpgrade_Skill
	config(ZedternalUnlimited);

var config array<float> PassiveSnare;
var config float ToxicSnare;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.PassiveSnare[0] = 15.0f;
		default.PassiveSnare[1] = 30.0f;
		default.ToxicSnare = 20.0f;

		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


// Passive snare boost to all your attacks
static function ModifySnarePowerPassive(out float snarePowerFactor, int upgLevel)
{
	snarePowerFactor += default.PassiveSnare[upgLevel - 1];
}

// Extra snare specifically for toxic damage (DoT weapons, poison procs)
static function ModifySnarePower(out float InSnarePower, float DefaultSnarePower, int upgLevel, optional class<DamageType> DamageType, optional byte BodyPart)
{
	if (DamageType != None && ClassIsChildOf(DamageType, class'KFDT_Toxic'))
		InSnarePower += DefaultSnarePower * default.ToxicSnare;
}

defaultproperties
{
    // --- Localization (auto-generated by mass_localize_dk_upgrades.py) ---
    // Strings live in KFGame/Localization/<lang>/ZedternalRBPerkpackage.<langext>
    // Section: [DKUpgrade_Skill_Blight]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalRBPerkpackage"
    LocSection="DKUpgrade_Skill_Blight"

	// L1: +15 passive snare, L2: +30 passive snare

	// Additional x20 snare multiplier for toxic damage specifically

	UpgradeDescription(0)="Your attacks gain <font color=\"#399c0e\">15 increased snare power</font>. Toxic damage has <font color=\"#8fce00\">massively increased snare</font>."
	UpgradeDescription(1)="Your attacks gain <font color=\"#b346ea\">30 increased snare power</font>. Toxic damage has <font color=\"#8fce00\">massively increased snare</font>."

	UpgradeName="Blight"
	UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_Blight'
	UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_Blight_Deluxe'

	Name="Default__DKUpgrade_Skill_Blight"
}
