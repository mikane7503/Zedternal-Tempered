class DKUpgrade_Skill_ThermalLance extends DKUpgrade_Skill
	config(ZedternalUnlimited);

// Thermal Lance: Increased penetration for fire damage.
// Standard: +40% penetration on fire attacks.
// Deluxe:   +100% penetration on fire attacks.

var config array<float> Penetration;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.Penetration[0] = 0.4f;
		default.Penetration[1] = 1.0f;

		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


static simulated function ModifyPenetration(out float InPenetration, float DefaultPenetration, int upgLevel, class<KFDamageType> DamageType, KFPawn OwnerPawn, optional bool bForce)
{
	if (DamageType != None && ClassIsChildOf(DamageType, class'KFDT_Fire'))
		InPenetration += DefaultPenetration * default.Penetration[upgLevel - 1];
}

defaultproperties
{
    // --- Localization (auto-generated by mass_localize_dk_upgrades.py) ---
    // Strings live in KFGame/Localization/<lang>/ZedternalRBPerkpackage.<langext>
    // Section: [DKUpgrade_Skill_ThermalLance]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalRBPerkpackage"
    LocSection="DKUpgrade_Skill_ThermalLance"

	UpgradeName="ThermalLance"
	upgradeDescription(0)="<font color=\"#42e087\">Increase</font> <font color=\"#42e087\">penetration</font> of <font color=\"#42e087\">fire attacks</font> by <font color=\"#84d6d0\">40%</font>."
	upgradeDescription(1)="<font color=\"#42e087\">Increase</font> <font color=\"#42e087\">penetration</font> of <font color=\"#42e087\">fire attacks</font> by <font color=\"#84d6d0\">100%</font>."
	UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_ThermalLance'
	UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_ThermalLance_Deluxe'

	Name="Default__DKUpgrade_Skill_ThermalLance"
}
