class DKUpgrade_Skill_PowerTransfer extends DKUpgrade_Skill
	config(ZedternalUnlimited);

var config array<float> Health;
var config array<float> Damage;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.Health[0] = 0.05f;
		default.Health[1] = 0.10f;
		default.Damage[0] = 0.15f;
		default.Damage[1] = 0.30f;

		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}



static function ModifyHealth(out int InHealth, int DefaultHealth, int upgLevel)
{
	InHealth -= (DefaultHealth * default.Health[upgLevel - 1]);
}

static function ModifyDamageGiven(out int InDamage, int DefaultDamage, int upgLevel, optional Actor DamageCauser, optional KFPawn_Monster MyKFPM, optional KFPlayerController DamageInstigator, optional Class<KFDamageType> DamageType, optional int HitZoneIdx, optional KFWeapon MyKFW)
{      
    if(MyKFW != None && ClassIsChildOf(MyKFW.class, class'KFWeap_RifleBase'))
    {
        InDamage += Round((float(DefaultDamage) * (default.Damage[upgLevel - 1])));
    }    
}

defaultproperties
{
    // --- Localization (auto-generated by mass_localize_dk_upgrades.py) ---
    // Strings live in KFGame/Localization/<lang>/ZedternalRBPerkpackage.<langext>
    // Section: [DKUpgrade_Skill_PowerTransfer]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalRBPerkpackage"
    LocSection="DKUpgrade_Skill_PowerTransfer"

    UpgradeName="Power Transfer"
    upgradeDescription(0)="<font color=\"#962ab9\">Decrease</font> your <font color=\"#962ab9\">Maximum Health</font> by <font color=\"#cb1b43\">5</font>. <font color=\"#42e087\">Increase</font> Damage from <font color=\"#42e087\">Rifles</font> by <font color=\"#84d6d0\">15%</font>."
    upgradeDescription(1)="<font color=\"#962ab9\">Decrease</font> your <font color=\"#962ab9\">Maximum Health</font> by <font color=\"#cb1b43\">10</font>. <font color=\"#42e087\">Increase</font> Damage from <font color=\"#42e087\">Rifles</font> by <font color=\"#84d6d0\">30%</font>."
	UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_PowerTransfer'
	UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_PowerTransfer_Deluxe'
	Name="Default__DKUpgrade_Skill_PowerTransfer" 
}