    upgradeDescription(1)="<font color=\"#ffff00\">5 kills</font> within <font color=\"#aaaaaa\">10 seconds</font> grants <font color=\"#00ffff\">+50% movement speed</font> for <font color=\"#ffff00\">8 seconds</font>."
