class ZTUpgrade_Skill_ThreadTheNeedle extends ZTUpgrade_Skill config(ZedternalUnlimited);

var config array<float> Recoil;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.Recoil[0] = 0.5f;
		default.Recoil[1] = 1.0f;

		// BEGIN TEMPERED INI DEFAULTS (generated; do not edit by hand)
		default.Recoil.Length = 2;
		default.Recoil[0] = 0.250000f;
		default.Recoil[1] = 0.500000f;
		// END TEMPERED INI DEFAULTS
		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


static simulated function ModifyRecoil(out float InRecoilModifier, float DefaultRecoilModifier, int upgLevel, KFWeapon KFW)
{
	if (KFW != None && upgLevel > 0 && upgLevel <= default.Recoil.Length)
		InRecoilModifier -= DefaultRecoilModifier * default.Recoil[upgLevel - 1];
}

