    // --- Localization (auto-generated by mass_localize_dk_upgrades.py) ---
    // Strings live in KFGame/Localization/<lang>/ZedternalTempered.<langext>
    // Section: [ZTUpgrade_Skill_Inferno]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalTempered"
    LocSection="ZTUpgrade_Skill_Inferno"

	// Cooldown values stored in defaultproperties
	
	// Fire damage bonuses during Inferno
	
	UpgradeName="Inferno"
	
	upgradeDescription(0)="Unlocks <font color=\"#FF6400\">Inferno</font> active ability: Instantly set <font color=\"#FFB464\">all enemies in line of sight</font> on fire with a powerful DoT effect. Cooldown: <font color=\"#FF9900\">60 seconds</font>."
	
	upgradeDescription(1)="Unlocks <font color=\"#FF6400\">Inferno (Deluxe)</font> active ability: Instantly set <font color=\"#FFB464\">all enemies in line of sight</font> on fire with a powerful DoT effect. <font color=\"#FFFFFF\">+50%</font> fire damage while on cooldown. Cooldown: <font color=\"#FF9900\">45 seconds</font>."
	
	UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_Inferno'
	UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_Inferno_Deluxe'
	
	Name="Default__ZTUpgrade_Skill_Inferno"
}
