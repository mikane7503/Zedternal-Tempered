// ===================================================================
// ZTUpgrade_Skill_DaisyChain - Detonator Skill
//
// "Daisy Chain" - When a detonation kills, surviving zeds in the
// explosion radius get tagged. A tagged zed dying anywhere triggers
// a standard-tier detonation at its location. Tags decay over time.
//
// Standard: Tag up to 8 zeds. Tags decay after 20s. Chain detonations
//           do NOT re-tag survivors (one chain per origin).
// Deluxe:   Tag radius x1.5, up to 12 zeds. Tags decay after 30s.
//           Chain detonations CAN re-tag once (one bounce; no further
//           chains beyond that).
//
// Pure signal skill -- all logic lives in the Detonator helper.
// ===================================================================
class ZTUpgrade_Skill_DaisyChain extends ZTUpgrade_Skill;

// Signal presence to Detonator Helper via ExtensionFuncInteger.
// Returns upgLevel (1=standard, 2=deluxe) when queried with "DetonatorDaisyChain".
static simulated function ExtensionFuncInteger(out int InValue, int DefaultValue, int upgLevel, string Identifier,
    KFWeapon MyKFW, KFPawn OwnerPawn, optional int InputInt, optional float InputFloat, optional name InputClassName,
    optional Object InputObject1, optional Object InputObject2, optional Object InputObject3)
{
    if (Identifier ~= "DetonatorDaisyChain")
        InValue = upgLevel;
}

defaultproperties
{
    // --- Localization (auto-generated by mass_localize_dk_upgrades.py) ---
    // Strings live in KFGame/Localization/<lang>/ZedternalTempered.<langext>
    // Section: [ZTUpgrade_Skill_DaisyChain]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalTempered"
    LocSection="ZTUpgrade_Skill_DaisyChain"

    UpgradeName="Daisy Chain"
    upgradeDescription(0)="Detonations tag up to <font color=\"#FFD700\">8</font> survivors in radius. Tagged kills detonate (standard tier). Tags decay after <font color=\"#FFFFFF\">20s</font>."
    upgradeDescription(1)="Tag radius <font color=\"#FFD700\">x1.5</font>, up to <font color=\"#FFD700\">12</font> survivors. Tags decay after <font color=\"#FFFFFF\">30s</font>. Chains can re-tag <font color=\"#FF4444\">once</font>."
    UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_DaisyChain'
    UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_DaisyChain_Deluxe'

    Name="Default__ZTUpgrade_Skill_DaisyChain"
}
