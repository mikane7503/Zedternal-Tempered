// ===================================================================
// ZTUpgrade_Skill_SymbioticReload - Heal to Reload
// Healing a teammate instantly restores a portion of your current
// weapon's magazine from spare ammo. Creates a dart→shoot→dart→shoot
// combat rhythm where you never fully reload manually.
//
// Standard: Restores 30% of magazine capacity on healing a teammate
// Deluxe:   Restores 50% of magazine capacity on healing a teammate
//
// Uses MagicBullet_Helper pattern for server/client ammo sync.
// ===================================================================
class ZTUpgrade_Skill_SymbioticReload extends ZTUpgrade_Skill config(ZedternalUnlimited);

var config array<float> MagRestorePercent;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.MagRestorePercent[0] = 0.30f;
		default.MagRestorePercent[1] = 0.50f;

		// BEGIN TEMPERED INI DEFAULTS (generated; do not edit by hand)
		default.MagRestorePercent.Length = 2;
		default.MagRestorePercent[0] = 0.150000f;
		default.MagRestorePercent[1] = 0.300000f;
		// END TEMPERED INI DEFAULTS
		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


// ===================================================================
// On Heal: Restore magazine ammo to the healer
// ===================================================================
static function HealingDamage(int upgLevel, int HealAmount, KFPawn HealedPawn,
	KFPawn InstigatorPawn, class<DamageType> DamageType)
{
	local ZTUpgrade_Skill_SymbioticReload_Helper Helper;
	local int AmmoToRestore;

	// Don't trigger on self-heal
	if (InstigatorPawn == None || HealedPawn == None || InstigatorPawn == HealedPawn)
		return;

	if (KFPawn_Human(InstigatorPawn) == None)
		return;

	Helper = GetHelper(InstigatorPawn);
	if (Helper == None)
		return;

	// Calculate ammo to restore based on current weapon's magazine capacity
	if (KFWeapon(InstigatorPawn.Weapon) != None)
	{
		AmmoToRestore = Max(1, Round(float(KFWeapon(InstigatorPawn.Weapon).MagazineCapacity[0]) * default.MagRestorePercent[upgLevel - 1]));

		if (InstigatorPawn.WorldInfo.NetMode == NM_Standalone)
			Helper.StandaloneUpdateAmmo(AmmoToRestore);
		else
			Helper.ServerUpdateAmmo(AmmoToRestore);
	}
}

// ===================================================================
// Helper Management
// ===================================================================
static simulated function InitiateWeapon(int upgLevel, KFWeapon KFW, KFPawn OwnerPawn)
{
	local ZTUpgrade_Skill_SymbioticReload_Helper UPG;
	local bool bFound;

	if (KFPawn_Human(OwnerPawn) != None && OwnerPawn.Role == Role_Authority)
	{
		bFound = False;
		foreach OwnerPawn.ChildActors(class'ZTUpgrade_Skill_SymbioticReload_Helper', UPG)
		{
			bFound = True;
			break;
		}

		if (!bFound)
			OwnerPawn.Spawn(class'ZTUpgrade_Skill_SymbioticReload_Helper', OwnerPawn);
	}
}

static function ZTUpgrade_Skill_SymbioticReload_Helper GetHelper(Pawn OwnerPawn)
{
	local ZTUpgrade_Skill_SymbioticReload_Helper UPG;

	if (KFPawn_Human(OwnerPawn) != None)
	{
		foreach OwnerPawn.ChildActors(class'ZTUpgrade_Skill_SymbioticReload_Helper', UPG)
			return UPG;

		if (OwnerPawn.Role == Role_Authority)
			UPG = OwnerPawn.Spawn(class'ZTUpgrade_Skill_SymbioticReload_Helper', OwnerPawn);
	}

	return UPG;
}

static simulated function DeleteHelperClass(Pawn OwnerPawn)
{
	local ZTUpgrade_Skill_SymbioticReload_Helper UPG;

	if (OwnerPawn != None)
	{
		foreach OwnerPawn.ChildActors(class'ZTUpgrade_Skill_SymbioticReload_Helper', UPG)
			UPG.Destroy();
	}
}

