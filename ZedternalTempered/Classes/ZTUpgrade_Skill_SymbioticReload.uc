    // Strings live in KFGame/Localization/<lang>/ZedternalTempered.<langext>
    // Section: [ZTUpgrade_Skill_SymbioticReload]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalTempered"
    LocSection="ZTUpgrade_Skill_SymbioticReload"

	UpgradeName="Symbiotic Reload"
	UpgradeDescription(0)="<font color=\"#B40028\">Symbiotic Reload:</font> Healing a teammate restores <font color=\"#FFFFFF\">30%</font> of your current weapon's magazine from spare ammo"
	UpgradeDescription(1)="<font color=\"#FFD700\">[DELUXE]</font> <font color=\"#B40028\">Symbiotic Reload:</font> Healing a teammate restores <font color=\"#FFFFFF\">50%</font> of your current weapon's magazine from spare ammo"

	UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_SymbioticReload'
	UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_SymbioticReload_Deluxe'

	Name="Default__ZTUpgrade_Skill_SymbioticReload"
}
