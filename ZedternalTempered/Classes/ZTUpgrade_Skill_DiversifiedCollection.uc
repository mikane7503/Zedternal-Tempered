// ===================================================================
// ZTUpgrade_Skill_DiversifiedCollection - Variety Is Power
//
// Gain a damage bonus for each unique trophy category currently held.
// Normal: +4% per unique category | Deluxe: +8% per unique category
// Max 5 types in set phase = +20%/+40%. Stacking phase can have more.
//
// Tension: Hold diverse trophies for damage vs. complete sets.
// ===================================================================
class ZTUpgrade_Skill_DiversifiedCollection extends ZTUpgrade_Skill config(ZedternalUnlimited);

var config array<float> DamagePerCategory;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.DamagePerCategory[0] = 0.04f;
		default.DamagePerCategory[1] = 0.08f;

		// BEGIN TEMPERED INI DEFAULTS (generated; do not edit by hand)
		default.DamagePerCategory.Length = 2;
		default.DamagePerCategory[0] = 0.040000f;
		default.DamagePerCategory[1] = 0.080000f;
		// END TEMPERED INI DEFAULTS
		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


static function ModifyDamageGiven(out int InDamage, int DefaultDamage, int upgLevel,
    optional Actor DamageCauser, optional KFPawn_Monster MyKFPM,
    optional KFPlayerController DamageInstigator, optional class<KFDamageType> DamageType,
    optional int HitZoneIdx, optional KFWeapon MyKFW)
{
    local ZTUpgrade_Perk_Predator_Helper H;
    local KFPawn_Human KFPH;
    local int UniqueCount;
    local float Bonus;

    if (DamageInstigator != None)
        KFPH = KFPawn_Human(DamageInstigator.Pawn);

    if (KFPH == None)
        return;

    H = class'ZTUpgrade_Perk_Predator'.static.GetHelper(KFPH);
    if (H == None)
        return;

    UniqueCount = H.CountUniqueTrophyCategories();
    if (UniqueCount > 0)
    {
        Bonus = default.DamagePerCategory[upgLevel - 1] * float(UniqueCount);
        InDamage += Round(float(DefaultDamage) * Bonus);
    }
}

defaultproperties
{

    // --- Localization (auto-generated by mass_localize_dk_upgrades.py) ---
    // Strings live in KFGame/Localization/<lang>/ZedternalTempered.<langext>
    // Section: [ZTUpgrade_Skill_DiversifiedCollection]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalTempered"
    LocSection="ZTUpgrade_Skill_DiversifiedCollection"

    UpgradeName="Diversified Collection"
    UpgradeDescription(0)="<font color=\"#FFD700\">Diversified Collection:</font> <font color=\"#FFFFFF\">+4%</font> <font color=\"#FF6666\">damage</font> per <font color=\"#87CEEB\">unique trophy category</font> in your inventory"
    UpgradeDescription(1)="<font color=\"#FFD700\">Diversified Collection:</font> <font color=\"#FFFFFF\">+8%</font> <font color=\"#FF6666\">damage</font> per <font color=\"#87CEEB\">unique trophy category</font> in your inventory"
    UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_DiversifiedCollection'
    UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_DiversifiedCollection_Deluxe'

    Name="Default__ZTUpgrade_Skill_DiversifiedCollection"
}
