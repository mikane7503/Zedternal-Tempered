// Martyr's Blessing
// Healing allies grants you temporary damage resistance (uses existing HealingShield framework)
// Standard: +5% shield per heal, max 10%
// Deluxe: +10% shield per heal, max 25%
class ZTUpgrade_Skill_MartyrBlessing extends ZTUpgrade_Skill config(ZedternalUnlimited);

var config array<byte> ShieldPerHeal, MaxShield;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.ShieldPerHeal[0] = 5;
		default.ShieldPerHeal[1] = 10;
		default.MaxShield[0] = 10;
		default.MaxShield[1] = 25;

		// BEGIN TEMPERED INI DEFAULTS (generated; do not edit by hand)
		default.ShieldPerHeal.Length = 2;
		default.ShieldPerHeal[0] = 5;
		default.ShieldPerHeal[1] = 8;
		default.MaxShield.Length = 2;
		default.MaxShield[0] = 10;
		default.MaxShield[1] = 20;
		// END TEMPERED INI DEFAULTS
		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


static simulated function GetHealingShield(out byte InHealingShield, int upgLevel)
{
	InHealingShield += default.ShieldPerHeal[upgLevel - 1];
}

static simulated function GetMaxHealingShield(out byte InMaxHealingShield, int upgLevel)
{
	InMaxHealingShield = Max(InMaxHealingShield, default.MaxShield[upgLevel - 1]);
}

