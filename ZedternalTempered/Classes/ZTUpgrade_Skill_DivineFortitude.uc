// Divine Fortitude
// Increases both max health and max armor
// Standard: +10% health, +10% armor
// Deluxe: +25% health, +25% armor
class ZTUpgrade_Skill_DivineFortitude extends ZTUpgrade_Skill config(ZedternalUnlimited);

var config array<float> HealthBonus, ArmorBonus;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.HealthBonus[0] = 0.1f;
		default.HealthBonus[1] = 0.25f;
		default.ArmorBonus[0] = 0.1f;
		default.ArmorBonus[1] = 0.25f;

		// BEGIN TEMPERED INI DEFAULTS (generated; do not edit by hand)
		default.HealthBonus.Length = 2;
		default.HealthBonus[0] = 0.100000f;
		default.HealthBonus[1] = 0.250000f;
		default.ArmorBonus.Length = 2;
		default.ArmorBonus[0] = 0.100000f;
		default.ArmorBonus[1] = 0.250000f;
		// END TEMPERED INI DEFAULTS
		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


static function ModifyHealth(out int InHealth, int DefaultHealth, int upgLevel)
{
	InHealth += Round(float(DefaultHealth) * default.HealthBonus[upgLevel - 1]);
}

static function ModifyArmor(out int MaxArmor, int DefaultArmor, int upgLevel)
{
	MaxArmor += Round(float(DefaultArmor) * default.ArmorBonus[upgLevel - 1]);
}

