	UpgradeDescription(0)="Increase <font color=\"#ff6666\">Max Health</font> and <font color=\"#4444ff\">Max Armor</font> by <font color=\"#eeeeff\">10%</font>"
	UpgradeDescription(1)="<font color=\"#ffd700\">Deluxe.</font> Increase <font color=\"#ff6666\">Max Health</font> and <font color=\"#4444ff\">Max Armor</font> by <font color=\"#eeeeff\">25%</font>"
	UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_DivineFortitude'
