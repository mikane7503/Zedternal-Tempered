class ZTUpgrade_Skill_Arsonist extends ZTUpgrade_Skill config(ZedternalUnlimited);

var config array<float> DamageOverTime;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.DamageOverTime[0] = 5.0f;
		default.DamageOverTime[1] = 10.0f;

		// BEGIN TEMPERED INI DEFAULTS (generated; do not edit by hand)
		default.DamageOverTime.Length = 2;
		default.DamageOverTime[0] = 1.500000f;
		default.DamageOverTime[1] = 3.000000f;
		// END TEMPERED INI DEFAULTS
		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


static function ModifyDoTScaler(out float InDoTScaler, float DefaultDotScaler, int upgLevel, optional class<KFDamageType> KFDT, optional bool bNapalmInfected)
{
	InDoTScaler += DefaultDotScaler * default.DamageOverTime[upgLevel - 1];
}

