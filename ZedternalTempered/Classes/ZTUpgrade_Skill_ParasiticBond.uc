class ZTUpgrade_Skill_ParasiticBond extends ZTUpgrade_Skill abstract config(ZedternalUnlimited);

var config array<float> HealthBonus;
var config array<float> SpeedBonus;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.HealthBonus[0] = 0.15f;
		default.HealthBonus[1] = 0.25f;
		default.SpeedBonus[0] = 0.08f;
		default.SpeedBonus[1] = 0.12f;

		// BEGIN TEMPERED INI DEFAULTS (generated; do not edit by hand)
		default.HealthBonus.Length = 2;
		default.HealthBonus[0] = 0.150000f;
		default.HealthBonus[1] = 0.250000f;
		default.SpeedBonus.Length = 2;
		default.SpeedBonus[0] = 0.080000f;
		default.SpeedBonus[1] = 0.120000f;
		// END TEMPERED INI DEFAULTS
		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


static function ModifyHealth(out int InHealth, int DefaultHealth, int upgLevel)
{
	InHealth += Round(float(DefaultHealth) * default.HealthBonus[upgLevel - 1]);
}

static simulated function ModifySpeed(out float InSpeed, float DefaultSpeed, int upgLevel, KFPawn OwnerPawn)
{
	InSpeed *= (1.0f + default.SpeedBonus[upgLevel - 1]);
}

