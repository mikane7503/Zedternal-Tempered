    UpgradeName="High Risk Investment"
    
    upgradeDescription(0)="Whenever you spend <font color=\"#ff3399\">4000+</font> dosh in a single purchase, <font color=\"#ffaa33\">10% chance</font> to get the purchase cost back as <font color=\"#00ff00\">bonus dosh</font>."
    upgradeDescription(1)="Whenever you spend <font color=\"#ff3399\">3000+</font> dosh in a single purchase, <font color=\"#ffaa33\">10% chance</font> to get the purchase cost back as <font color=\"#00ff00\">bonus dosh</font>."
    
    UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_HighRiskInvestment'
    UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_HighRiskInvestment_Deluxe'

    Name="Default__ZTUpgrade_Skill_HighRiskInvestment"
}