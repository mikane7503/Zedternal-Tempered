class ZTUpgrade_Skill_HighRiskInvestment extends ZTUpgrade_Skill config(ZedternalUnlimited);

var config array<int> MinPurchaseAmount;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.MinPurchaseAmount[0] = 2500;
		default.MinPurchaseAmount[1] = 1500;

		// BEGIN TEMPERED INI DEFAULTS (generated; do not edit by hand)
		default.MinPurchaseAmount.Length = 2;
		default.MinPurchaseAmount[0] = 4000;
		default.MinPurchaseAmount[1] = 3000;
		// END TEMPERED INI DEFAULTS
		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


static simulated function InitiateWeapon(int upgLevel, KFWeapon KFW, KFPawn OwnerPawn)
{
    local ZTUpgrade_Skill_HighRiskInvestment_Helper UPG;
    local bool bFound;

    if (KFPawn_Human(OwnerPawn) != None && OwnerPawn.Role == Role_Authority)
    {
        bFound = False;
        foreach OwnerPawn.ChildActors(class'ZTUpgrade_Skill_HighRiskInvestment_Helper', UPG)
        {
            bFound = True;
            break;
        }

        if (!bFound)
        {
            UPG = OwnerPawn.Spawn(class'ZTUpgrade_Skill_HighRiskInvestment_Helper', OwnerPawn);
            UPG.bDeluxe = (upgLevel > 1);
            UPG.UpgradeLevel = upgLevel;
        }
    }
}

static simulated function DeleteHelperClass(Pawn OwnerPawn)
{
    local ZTUpgrade_Skill_HighRiskInvestment_Helper UPG;

    if (OwnerPawn != None)
    {
        foreach OwnerPawn.ChildActors(class'ZTUpgrade_Skill_HighRiskInvestment_Helper', UPG)
        {
            UPG.Destroy();
        }
    }
}

