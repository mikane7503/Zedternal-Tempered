// ===================================================================
// ZTUpgrade_Skill_TrophyMagnetism - Magnetic Pull
//
// Trophies within range are pulled toward the player automatically.
// Also doubles trophy pickup lifespan before cleanup.
// Normal: 5m range | Deluxe: 10m range
//
// QoL: Reduces missed pickups in chaotic fights.
// ===================================================================
class ZTUpgrade_Skill_TrophyMagnetism extends ZTUpgrade_Skill config(ZedternalUnlimited);

var config array<float> MagnetRange;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.MagnetRange[0] = 500.0f;
		default.MagnetRange[1] = 1000.0f;

		// BEGIN TEMPERED INI DEFAULTS (generated; do not edit by hand)
		default.MagnetRange.Length = 2;
		default.MagnetRange[0] = 500.000000f;
		default.MagnetRange[1] = 1000.000000f;
		// END TEMPERED INI DEFAULTS
		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


static simulated function InitiateWeapon(int upgLevel, KFWeapon KFW, KFPawn OwnerPawn)
{
    local ZTUpgrade_Perk_Predator_Helper H;

    if (KFPawn_Human(OwnerPawn) != None && OwnerPawn.Role == Role_Authority)
    {
        H = class'ZTUpgrade_Perk_Predator'.static.GetHelper(OwnerPawn);
        if (H != None)
        {
            H.SkillMagnetRange = default.MagnetRange[upgLevel - 1];
            H.bSkillExtendPickupLife = True;
            H.StartMagnetismTimer();
            `log("[DK_PREDATOR] TrophyMagnetism: range" @ H.SkillMagnetRange @ "+ extended lifespan");
        }
    }
}

defaultproperties
{

    // --- Localization (auto-generated by mass_localize_dk_upgrades.py) ---
    // Strings live in KFGame/Localization/<lang>/ZedternalTempered.<langext>
    // Section: [ZTUpgrade_Skill_TrophyMagnetism]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalTempered"
    LocSection="ZTUpgrade_Skill_TrophyMagnetism"

    UpgradeName="Trophy Magnetism"
    UpgradeDescription(0)="<font color=\"#FFD700\">Trophy Magnetism:</font> Trophies within <font color=\"#FFFFFF\">5m</font> are <font color=\"#87CEEB\">pulled</font> toward you. Trophies last <font color=\"#FFFFFF\">2x</font> longer"
    UpgradeDescription(1)="<font color=\"#FFD700\">Trophy Magnetism:</font> Trophies within <font color=\"#FFFFFF\">10m</font> are <font color=\"#87CEEB\">pulled</font> toward you. Trophies last <font color=\"#FFFFFF\">2x</font> longer"
    UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_TrophyMagnetism'
    UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_TrophyMagnetism_Deluxe'

    Name="Default__ZTUpgrade_Skill_TrophyMagnetism"
}
