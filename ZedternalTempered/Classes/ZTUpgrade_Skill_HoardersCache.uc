class ZTUpgrade_Skill_HoardersCache extends ZTUpgrade_Skill config(ZedternalUnlimited);

// Theme: The Wendigo prepares thoroughly, stashing extra rounds before the hunt
var config array<float> MagBonus;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.MagBonus[0] = 0.15f;
		default.MagBonus[1] = 0.35f;

		// BEGIN TEMPERED INI DEFAULTS (generated; do not edit by hand)
		default.MagBonus.Length = 2;
		default.MagBonus[0] = 0.200000f;
		default.MagBonus[1] = 0.350000f;
		// END TEMPERED INI DEFAULTS
		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


static simulated function ModifyMagSizeAndNumberPassive(out float magazineCapacityFactor, int upgLevel)
{
	magazineCapacityFactor += default.MagBonus[upgLevel - 1];
}

