class ZTUpgrade_Skill_Dominance extends ZTUpgrade_Skill config(ZedternalUnlimited);

var config array<float> Damage;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.Damage[0] = 0.25f;
		default.Damage[1] = 0.5f;

		// BEGIN TEMPERED INI DEFAULTS (generated; do not edit by hand)
		default.Damage.Length = 2;
		default.Damage[0] = 0.250000f;
		default.Damage[1] = 0.500000f;
		// END TEMPERED INI DEFAULTS
		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


static function ModifyDamageGivenPassive(out float damageFactor, int upgLevel)
{
	if (upgLevel > 0 && upgLevel <= default.Damage.Length)
		damageFactor += default.Damage[upgLevel - 1];
}

