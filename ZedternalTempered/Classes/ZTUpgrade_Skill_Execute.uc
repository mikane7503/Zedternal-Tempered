// ===================================================================
// ZTUpgrade_Skill_Execute
// Hollow Skill — unlocks the Execute weapon upgrade in the trader.
// Execute: bonus damage to zeds below 35% HP.
// Deluxe: stronger variant of the same upgrade.
// ===================================================================
class ZTUpgrade_Skill_Execute extends ZTUpgrade_Skill config(ZedternalUnlimited);

var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}

