	PerkBonus(3)=(baseValue=0, incValue=2, maxValue=-1)
	PerkBonus(4)=(baseValue=0, incValue=2, maxValue=-1)
	PerkBonus(5)=(baseValue=0, incValue=1, maxValue=-1)
	PerkBonus(6)=(baseValue=0, incValue=1, maxValue=-1)
	
	// Legacy (hand-made) artwork icons

	Name="Default__ZTUpgrade_Perk_Warlord"
}