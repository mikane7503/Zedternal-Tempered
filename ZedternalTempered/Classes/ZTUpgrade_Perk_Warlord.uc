	UpgradeDescription(0)="Increase <font color=\"#15d7fa\">Rifle Damage</font> by <font color=\"#77d914\">%x%%</font>."
	UpgradeDescription(1)="Increase <font color=\"#15d7fa\">Headshot Damage</font> with rifles by <font color=\"#77d914\">%x%%</font>."
	UpgradeDescription(2)="Increase <font color=\"#15d7fa\">Reload Speed</font> by <font color=\"#77d914\">%x%%</font>."
	UpgradeDescription(3)="Reduce <font color=\"#15d7fa\">Recoil</font> by <font color=\"#77d914\">%x%%</font>."
	UpgradeDescription(4)="Increase <font color=\"#15d7fa\">Weapon Switch Speed</font> by <font color=\"#77d914\">%x%%</font>."
	UpgradeDescription(5)="Increase <font color=\"#15d7fa\">Ammunition Capacity</font> by <font color=\"#77d914\">%x%%</font>."
	UpgradeDescription(6)="Increase <font color=\"#15d7fa\">Grenade Capacity</font> by <font color=\"#77d914\">+1</font> every <font color=\"#FFFFFF\">5 levels</font>."
	
	PerkBonus(0)=(baseValue=0, incValue=2, maxValue=-1)
	PerkBonus(1)=(baseValue=0, incValue=2, maxValue=-1)
