Class ZTUpgrade_Perk_Warlord extends ZTUpgrade_Perk
	config(ZedternalUnlimited);

var config float RifleDamage, HeadshotDamage, ReloadSpeed, RecoilReduction, WeaponSwitchSpeed, AmmoCapacity;
var config int GrenadeCapacity;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.RifleDamage = 0.02f;
		default.HeadshotDamage = 0.02f;
		default.ReloadSpeed = 0.02f;
		default.RecoilReduction = 0.02f;
		default.WeaponSwitchSpeed = 0.02f;
		default.AmmoCapacity = 0.02f;
		default.GrenadeCapacity = 1;

		// BEGIN TEMPERED INI DEFAULTS (generated; do not edit by hand)
		default.RifleDamage = 0.015000f;
		default.HeadshotDamage = 0.015000f;
		default.ReloadSpeed = 0.010000f;
		default.RecoilReduction = 0.020000f;
		default.WeaponSwitchSpeed = 0.020000f;
		default.AmmoCapacity = 0.010000f;
		default.GrenadeCapacity = 1;
		// END TEMPERED INI DEFAULTS
		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


static function ModifyDamageGiven(out int InDamage, int DefaultDamage, int upgLevel, optional Actor DamageCauser, optional KFPawn_Monster MyKFPM, optional KFPlayerController DamageInstigator, optional class<KFDamageType> DamageType, optional int HitZoneIdx, optional KFWeapon MyKFW)
{
	if (IsRifleWeapon(MyKFW))
	{
		// Base rifle damage bonus
		InDamage += Round(float(DefaultDamage) * default.RifleDamage * upgLevel);
		
		// Additional headshot damage bonus
		if (HitZoneIdx == HZI_HEAD)
			InDamage += Round(float(DefaultDamage) * default.HeadshotDamage * upgLevel);
	}
}

static simulated function GetReloadRateScalePassive(out float reloadRateFactor, int upgLevel)
{
	// BUGFIX: reloadRateFactor is a TIME scale (smaller = faster). The old
	// += INCREASED it, making reloads slower per level. Composed like
	// ZR's Commando perk instead.
	reloadRateFactor = 1.0f / (1.0f / reloadRateFactor + default.ReloadSpeed * upgLevel);
}

static simulated function ModifyRecoilPassive(out float recoilFactor, int upgLevel)
{
	recoilFactor -= default.RecoilReduction * upgLevel;
}

static simulated function ModifyWeaponSwitchTimePassive(out float switchTimeFactor, int upgLevel)
{
	// Composed harmonically like ZR's QuickDraw so high levels cannot push
	// the factor to zero or negative (the old linear subtraction went
	// negative past level 50).
	switchTimeFactor = 1.0f / (1.0f / switchTimeFactor + default.WeaponSwitchSpeed * upgLevel);
}

static simulated function ModifySpareAmmoAmountPassive(out float spareAmmoFactor, int upgLevel)
{
	spareAmmoFactor += default.AmmoCapacity * upgLevel;
}

static simulated function ModifyMagSizeAndNumberPassive(out float magazineCapacityFactor, int upgLevel)
{
	magazineCapacityFactor += default.AmmoCapacity * upgLevel;
}

static simulated function ModifySpareGrenadeAmount(out int SpareGrenade, int DefaultSpareGrenade, int upgLevel)
{
	if (upgLevel >= 5)
		SpareGrenade += default.GrenadeCapacity * (upgLevel / 5);
}

static function bool IsRifleWeapon(KFWeapon KFW)
{
	if (KFW == None)
		return False;
		
	if (IsWeaponOnSpecificPerk(KFW, class'KFGame.KFPerk_Commando'))
	{
		return (KFW.InstantHitDamage[0] >= 35 || 
				KFW.default.FireInterval[0] >= 0.08);
	}
	return (InStr(PathName(KFW.Class), "Rifle") != INDEX_NONE ||
			InStr(PathName(KFW.Class), "rifle") != INDEX_NONE);
}

defaultproperties
