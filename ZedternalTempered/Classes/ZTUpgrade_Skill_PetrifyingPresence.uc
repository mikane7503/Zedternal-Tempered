class ZTUpgrade_Skill_PetrifyingPresence extends ZTUpgrade_Skill config(ZedternalUnlimited);

var config array<float> PetrifyChance;
var config array<float> StumbleMultiplier;
var config array<float> DamageMultiplier;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.PetrifyChance[0] = 0.1f;
		default.PetrifyChance[1] = 0.2f;
		default.StumbleMultiplier[0] = 2.0f;
		default.StumbleMultiplier[1] = 2.0f;
		default.DamageMultiplier[0] = 0.0f;
		default.DamageMultiplier[1] = 0.5f;

		// BEGIN TEMPERED INI DEFAULTS (generated; do not edit by hand)
		default.PetrifyChance.Length = 2;
		default.PetrifyChance[0] = 0.100000f;
		default.PetrifyChance[1] = 0.200000f;
		default.StumbleMultiplier.Length = 2;
		default.StumbleMultiplier[0] = 2.000000f;
		default.StumbleMultiplier[1] = 2.000000f;
		default.DamageMultiplier.Length = 2;
		default.DamageMultiplier[0] = 0.000000f;
		default.DamageMultiplier[1] = 0.500000f;
		// END TEMPERED INI DEFAULTS
		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


static function ModifyStumblePowerPassive(out float stumblePowerFactor, int upgLevel)
{
    // Intentionally empty. Stumble is applied as a real, gated special-move on proc in
    // the helper (ApplyPetrificationEffects), not as a global passive scalar -- a
    // passive here would scale stumble on ALL hits/targets, not just petrified ones.
}

static function ModifyDamageGiven(out int InDamage, int DefaultDamage, int upgLevel, optional Actor DamageCauser, optional KFPawn_Monster MyKFPM, optional KFPlayerController DamageInstigator, optional class<KFDamageType> DamageType, optional int HitZoneIdx, optional KFWeapon MyKFW)
{
    local ZTUpgrade_Skill_PetrifyingPresence_Helper PetrifyHelper;
    local float RandValue;
    local bool bPetrify;
    
    if (DamageInstigator == None || DamageInstigator.Pawn == None || MyKFPM == None) return;
    
    // Get helper to manage petrification effects
    PetrifyHelper = GetHelper(DamageInstigator.Pawn);
    if (PetrifyHelper == None) return;
    
    // Roll for petrification chance
    RandValue = FRand();
    bPetrify = (RandValue <= default.PetrifyChance[upgLevel - 1]);
    
    if (bPetrify)
    {
        // Apply petrification effect to the monster
        PetrifyHelper.PetrifyMonster(MyKFPM, upgLevel);
    }
    
    // Apply bonus damage if monster is petrified
    if (PetrifyHelper.IsMonsterPetrified(MyKFPM) && upgLevel == 2)
    {
        InDamage += Round(float(DefaultDamage) * default.DamageMultiplier[upgLevel - 1]);
    }
}

static simulated function InitiateWeapon(int upgLevel, KFWeapon KFW, KFPawn OwnerPawn)
{
    local ZTUpgrade_Skill_PetrifyingPresence_Helper PetrifyHelper;
    local bool bFound;

    if (KFPawn_Human(OwnerPawn) != None && OwnerPawn.Role == Role_Authority)
    {
        bFound = False;
        foreach OwnerPawn.ChildActors(class'ZTUpgrade_Skill_PetrifyingPresence_Helper', PetrifyHelper)
        {
            bFound = True;
            break;
        }

        if (!bFound)
        {
            PetrifyHelper = OwnerPawn.Spawn(class'ZTUpgrade_Skill_PetrifyingPresence_Helper', OwnerPawn);
            PetrifyHelper.UpgradeLevel = upgLevel;
        }
    }
}

static function ZTUpgrade_Skill_PetrifyingPresence_Helper GetHelper(Pawn OwnerPawn)
{
    local ZTUpgrade_Skill_PetrifyingPresence_Helper PetrifyHelper;

    if (KFPawn_Human(OwnerPawn) != None)
    {
        foreach OwnerPawn.ChildActors(class'ZTUpgrade_Skill_PetrifyingPresence_Helper', PetrifyHelper)
        {
            return PetrifyHelper;
        }

        // Create one if needed
        PetrifyHelper = OwnerPawn.Spawn(class'ZTUpgrade_Skill_PetrifyingPresence_Helper', OwnerPawn);
    }

    return PetrifyHelper;
}

static simulated function DeleteHelperClass(Pawn OwnerPawn)
{
    local ZTUpgrade_Skill_PetrifyingPresence_Helper PetrifyHelper;

    if (OwnerPawn != None)
    {
        foreach OwnerPawn.ChildActors(class'ZTUpgrade_Skill_PetrifyingPresence_Helper', PetrifyHelper)
        {
            PetrifyHelper.Destroy();
        }
    }
}

