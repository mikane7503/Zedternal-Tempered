class ZTUpgrade_Skill_EmberHarvest extends ZTUpgrade_Skill config(ZedternalUnlimited);

// Ember Harvest: At wave end, receive bonus grenades and partial ammo restoration
// Normal: +1 grenade | Deluxe: +3 grenades + 15% ammo restoration

var config array<int> ExtraGrenades;
var config array<float> AmmoRestore;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.ExtraGrenades[0] = 1;
		default.ExtraGrenades[1] = 3;
		default.AmmoRestore[0] = 0.0f;
		default.AmmoRestore[1] = 0.15f;

		// BEGIN TEMPERED INI DEFAULTS (generated; do not edit by hand)
		default.ExtraGrenades.Length = 2;
		default.ExtraGrenades[0] = 1;
		default.ExtraGrenades[1] = 3;
		default.AmmoRestore.Length = 2;
		default.AmmoRestore[0] = 0.000000f;
		default.AmmoRestore[1] = 0.150000f;
		// END TEMPERED INI DEFAULTS
		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


static function WaveEnd(int upgLevel, KFPlayerController KFPC)
{
	local KFPawn Player;
	local KFInventoryManager KFIM;
	local KFWeapon KFW;
	local byte i;
	local int ExtraAmmo;

	Player = KFPawn(KFPC.Pawn);

	if (Player == None || Player.Health <= 0 || Player.InvManager == None)
		return;

	KFIM = KFInventoryManager(Player.InvManager);
	if (KFIM == None)
		return;

	// Add grenades
	KFIM.AddGrenades(default.ExtraGrenades[upgLevel - 1]);

	// Add ammo (Deluxe only, Normal has 0.0 factor)
	if (default.AmmoRestore[upgLevel - 1] > 0.0f)
	{
		foreach Player.InvManager.InventoryActors(class'KFWeapon', KFW)
		{
			for (i = 0; i < 2; ++i)
			{
				ExtraAmmo = Min(FCeil(float(KFW.GetMaxAmmoAmount(i)) * default.AmmoRestore[upgLevel - 1]), KFW.GetMaxAmmoAmount(i) - KFW.GetTotalAmmoAmount(i));
				if (ExtraAmmo > 0)
				{
					if (i == 0)
						KFW.AddAmmo(ExtraAmmo);
					else
						KFW.AddSecondaryAmmo(ExtraAmmo);
				}
			}
		}
	}
}

defaultproperties
{

    // --- Localization (auto-generated by mass_localize_dk_upgrades.py) ---
    // Strings live in KFGame/Localization/<lang>/ZedternalTempered.<langext>
    // Section: [ZTUpgrade_Skill_EmberHarvest]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalTempered"
    LocSection="ZTUpgrade_Skill_EmberHarvest"

	UpgradeName="Ember Harvest"
	UpgradeDescription(0)="At wave end, receive <font color=\"#e85009\">+1</font> grenade."
	UpgradeDescription(1)="At wave end, receive <font color=\"#e85009\">+3</font> grenades and restore <font color=\"#e85009\">15%</font> <font color=\"#e80948\">ammo</font> for all weapons."
	UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_EmberHarvest'
	UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_EmberHarvest_Deluxe'

	Name="Default__ZTUpgrade_Skill_EmberHarvest"
}
