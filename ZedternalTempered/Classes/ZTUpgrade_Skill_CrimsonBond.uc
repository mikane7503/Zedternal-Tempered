    // Strings live in KFGame/Localization/<lang>/ZedternalTempered.<langext>
    // Section: [ZTUpgrade_Skill_CrimsonBond]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalTempered"
    LocSection="ZTUpgrade_Skill_CrimsonBond"

	UpgradeName="Crimson Bond"
	UpgradeDescription(0)="<font color=\"#B40028\">Crimson Bond:</font> Healing a teammate creates a <font color=\"#FFFFFF\">10s</font> blood bond. Your life steal also heals bonded ally for <font color=\"#FFFFFF\">15%</font>"
	UpgradeDescription(1)="<font color=\"#FFD700\">[DELUXE]</font> <font color=\"#B40028\">Crimson Bond:</font> Healing a teammate creates a <font color=\"#FFFFFF\">15s</font> blood bond. Your life steal also heals bonded ally for <font color=\"#FFFFFF\">30%</font>"

	UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_CrimsonBond'
	UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_CrimsonBond_Deluxe'

	Name="Default__ZTUpgrade_Skill_CrimsonBond"
}
