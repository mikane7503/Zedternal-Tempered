class ZTUpgrade_Skill_Mimicry extends ZTUpgrade_Skill config(ZedternalUnlimited);

// Theme: After not taking damage, the Wendigo forms an icy shield that absorbs one hit
var config array<float> RechargeTime;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.RechargeTime[0] = 20.0f;
		default.RechargeTime[1] = 12.0f;

		// BEGIN TEMPERED INI DEFAULTS (generated; do not edit by hand)
		default.RechargeTime.Length = 2;
		default.RechargeTime[0] = 20.000000f;
		default.RechargeTime[1] = 12.000000f;
		// END TEMPERED INI DEFAULTS
		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


static function ModifyDamageTaken(out int InDamage, int DefaultDamage, int upgLevel, KFPawn OwnerPawn, optional class<DamageType> DamageType, optional Controller InstigatedBy, optional KFWeapon MyKFW)
{
	local ZTUpgrade_Skill_Mimicry_Helper UPG;

	if (OwnerPawn == None)
		return;

	UPG = GetHelper(OwnerPawn);
	if (UPG == None)
		return;

	if (UPG.bShieldActive)
	{
		// Absorb the hit entirely
		InDamage = 0;
		UPG.ConsumeShield(default.RechargeTime[upgLevel - 1]);
	}
	else
	{
		// Reset recharge timer since we took damage
		UPG.ResetRecharge(default.RechargeTime[upgLevel - 1]);
	}
}

static simulated function InitiateWeapon(int upgLevel, KFWeapon KFW, KFPawn OwnerPawn)
{
	local ZTUpgrade_Skill_Mimicry_Helper UPG;
	local bool bFound;

	if (KFPawn_Human(OwnerPawn) != None && OwnerPawn.Role == Role_Authority)
	{
		bFound = False;
		foreach OwnerPawn.ChildActors(class'ZTUpgrade_Skill_Mimicry_Helper', UPG)
		{
			bFound = True;
			break;
		}

		if (!bFound)
		{
			UPG = OwnerPawn.Spawn(class'ZTUpgrade_Skill_Mimicry_Helper', OwnerPawn);
			if (UPG != None)
				UPG.StartRecharge(default.RechargeTime[upgLevel - 1]);
		}
	}
}

static function ZTUpgrade_Skill_Mimicry_Helper GetHelper(KFPawn OwnerPawn)
{
	local ZTUpgrade_Skill_Mimicry_Helper UPG;

	if (KFPawn_Human(OwnerPawn) != None)
	{
		foreach OwnerPawn.ChildActors(class'ZTUpgrade_Skill_Mimicry_Helper', UPG)
		{
			return UPG;
		}

		// Should have one
		UPG = OwnerPawn.Spawn(class'ZTUpgrade_Skill_Mimicry_Helper', OwnerPawn);
	}

	return UPG;
}

static simulated function DeleteHelperClass(Pawn OwnerPawn)
{
	local ZTUpgrade_Skill_Mimicry_Helper UPG;

	if (OwnerPawn != None)
	{
		foreach OwnerPawn.ChildActors(class'ZTUpgrade_Skill_Mimicry_Helper', UPG)
		{
			UPG.Destroy();
		}
	}
}

defaultproperties
