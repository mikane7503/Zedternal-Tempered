    // --- Localization (auto-generated by mass_localize_dk_upgrades.py) ---
    // Strings live in KFGame/Localization/<lang>/ZedternalTempered.<langext>
    // Section: [ZTUpgrade_Skill_Mimicry]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalTempered"
    LocSection="ZTUpgrade_Skill_Mimicry"

	UpgradeName="Mimicry"
	UpgradeDescription(0)="<font color=\"#4682B4\">Mimicry:</font> After <font color=\"#FFFFFF\">20 seconds</font> without taking damage, form an <font color=\"#87CEEB\">icy shield</font> that <font color=\"#F0F8FF\">absorbs one hit</font>"
	UpgradeDescription(1)="<font color=\"#4682B4\">Mimicry:</font> After <font color=\"#FFFFFF\">12 seconds</font> without taking damage, form an <font color=\"#87CEEB\">icy shield</font> that <font color=\"#F0F8FF\">absorbs one hit</font>"

	UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_Mimicry'
	UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_Mimicry_Deluxe'

	Name="Default__ZTUpgrade_Skill_Mimicry"
}
