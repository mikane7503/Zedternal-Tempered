    bShouldLocalize=True
    LocPackage="ZedternalTempered"
    LocSection="ZTUpgrade_Skill_Resilience"

    UpgradeName="Resilience"
	upgradeDescription(0)="You have take <font color=\"#ff3399\">12%</font> less <font color=\"#66cc00\">Damage</font> from <font color=\"#be4d25\">Melee Attacks</font>."
	upgradeDescription(1)="You have take <font color=\"#ff3399\">24%</font> less <font color=\"#66cc00\">Damage</font> from <font color=\"#be4d25\">Melee Attacks</font>."
	UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_Resilience'
	UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_Resilience_Deluxe'
    Name="Default__ZTUpgrade_Skill_Resilience"
}