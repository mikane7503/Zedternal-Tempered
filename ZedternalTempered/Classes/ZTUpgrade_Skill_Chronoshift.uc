// ===================================================================
// ZTUpgrade_Skill_Chronoshift - Active ability: trigger ZED time on demand
// Standard: 5 seconds of ZED time
// Deluxe: 8 seconds of ZED time
// Cooldown: 90 seconds
// ===================================================================
class ZTUpgrade_Skill_Chronoshift extends ZTUpgrade_Skill config(ZedternalUnlimited);

// Store duration values in defaultproperties
var config array<float> ZedTimeDurations;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.ZedTimeDurations[0] = 5.0f;
		default.ZedTimeDurations[1] = 8.0f;

		// BEGIN TEMPERED INI DEFAULTS (generated; do not edit by hand)
		default.ZedTimeDurations.Length = 2;
		default.ZedTimeDurations[0] = 5.000000f;
		default.ZedTimeDurations[1] = 8.000000f;
		// END TEMPERED INI DEFAULTS
		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


// Called when skill is purchased - spawn the helper
static simulated function InitiateWeapon(int upgLevel, KFWeapon KFW, KFPawn OwnerPawn)
{
	local ZTUpgrade_Skill_Chronoshift_Helper Helper;
	local ZTPlayerController DKPC;
	local bool bFound;
	
	if (KFPawn_Human(OwnerPawn) == None || OwnerPawn.Role != Role_Authority)
		return;
	
	DKPC = ZTPlayerController(OwnerPawn.Controller);
	if (DKPC == None)
	{
		`log("ZTUpgrade_Skill_Chronoshift: ERROR - Player does not have ZTPlayerController!");
		return;
	}
	
	// Check if helper already exists
	bFound = false;
	foreach OwnerPawn.ChildActors(class'ZTUpgrade_Skill_Chronoshift_Helper', Helper)
	{
		bFound = true;
		// Update to new tier if upgrading Standard -> Deluxe
		Helper.SetTier(upgLevel);
		`log("ZTUpgrade_Skill_Chronoshift: Updated existing helper to tier" @ upgLevel);
		break;
	}
	
	// Spawn new helper if not found
	if (!bFound)
	{
		Helper = OwnerPawn.Spawn(class'ZTUpgrade_Skill_Chronoshift_Helper', OwnerPawn);
		if (Helper != None)
		{
			Helper.Initialize(upgLevel, KFPawn_Human(OwnerPawn), DKPC);
			`log("ZTUpgrade_Skill_Chronoshift: Spawned helper for" @ OwnerPawn.PlayerReplicationInfo.PlayerName);
		}
		else
		{
			`log("ZTUpgrade_Skill_Chronoshift: ERROR - Failed to spawn helper!");
		}
	}
}

// Called when skill is removed - cleanup
static simulated function DeleteHelperClass(Pawn OwnerPawn)
{
	local ZTUpgrade_Skill_Chronoshift_Helper Helper;
	
	if (OwnerPawn == None)
		return;
	
	foreach OwnerPawn.ChildActors(class'ZTUpgrade_Skill_Chronoshift_Helper', Helper)
	{
		Helper.Cleanup();
		Helper.Destroy();
		`log("ZTUpgrade_Skill_Chronoshift: Cleaned up helper");
	}
}

defaultproperties
