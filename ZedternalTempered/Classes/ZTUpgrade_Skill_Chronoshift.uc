    // --- Localization (auto-generated by mass_localize_dk_upgrades.py) ---
    // Strings live in KFGame/Localization/<lang>/ZedternalTempered.<langext>
    // Section: [ZTUpgrade_Skill_Chronoshift]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalTempered"
    LocSection="ZTUpgrade_Skill_Chronoshift"

	// Duration values stored in defaultproperties
	
	UpgradeName="Chronoshift"
	
	upgradeDescription(0)="Unlocks <font color=\"#66cc00\">Chronoshift</font> active ability: Instantly trigger <font color=\"#00ffff\">5 seconds</font> of <font color=\"#ffaa33\">ZED time</font> on demand. Cooldown: <font color=\"#ff9900\">90 seconds</font>."
	
	upgradeDescription(1)="Unlocks <font color=\"#66cc00\">Chronoshift (Deluxe)</font> active ability: Instantly trigger <font color=\"#00ffff\">8 seconds</font> of <font color=\"#ffaa33\">ZED time</font> on demand. Cooldown: <font color=\"#ff9900\">90 seconds</font>."
	
	UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_Chronoshift'
	UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_Chronoshift_Deluxe'
	
	Name="Default__ZTUpgrade_Skill_Chronoshift"
}