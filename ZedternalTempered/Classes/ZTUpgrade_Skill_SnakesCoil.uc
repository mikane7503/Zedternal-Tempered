class ZTUpgrade_Skill_SnakesCoil extends ZTUpgrade_Skill config(ZedternalUnlimited);

var config array<float> MovementSpeed;
var config array<float> MeleeDamage;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.MovementSpeed[0] = 0.15f;
		default.MovementSpeed[1] = 0.3f;
		default.MeleeDamage[0] = 0.25f;
		default.MeleeDamage[1] = 0.5f;

		// BEGIN TEMPERED INI DEFAULTS (generated; do not edit by hand)
		default.MovementSpeed.Length = 2;
		default.MovementSpeed[0] = 0.150000f;
		default.MovementSpeed[1] = 0.300000f;
		default.MeleeDamage.Length = 2;
		default.MeleeDamage[0] = 0.150000f;
		default.MeleeDamage[1] = 0.300000f;
		// END TEMPERED INI DEFAULTS
		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


static simulated function ModifySpeed(out float InSpeed, float DefaultSpeed, int upgLevel, KFPawn OwnerPawn)
{
    local ZTUpgrade_Skill_SnakesCoil_Helper SnakeHelper;
    local float SpeedBonus;
    
    // Base movement speed bonus
    SpeedBonus = default.MovementSpeed[upgLevel - 1];
    
    // Check for temporary speed boost from melee kills (Deluxe only)
    if (upgLevel == 2 && OwnerPawn != None)
    {
        SnakeHelper = GetHelper(OwnerPawn);
        if (SnakeHelper != None && SnakeHelper.bSpeedBoostActive)
        {
            SpeedBonus += 0.5f; // Additional 50% speed boost
        }
    }
    
    InSpeed += DefaultSpeed * SpeedBonus;
}

static simulated function ModifyMeleeAttackSpeed(out float InDuration, float DefaultDuration, int upgLevel, KFWeapon KFW)
{
    // Melee damage bonus is handled through ModifyDamageGiven
    // This function could be used for attack speed if needed
}

static function ModifyDamageGiven(out int InDamage, int DefaultDamage, int upgLevel, optional Actor DamageCauser, optional KFPawn_Monster MyKFPM, optional KFPlayerController DamageInstigator, optional class<KFDamageType> DamageType, optional int HitZoneIdx, optional KFWeapon MyKFW)
{
    local ZTUpgrade_Skill_SnakesCoil_Helper SnakeHelper;
    
    // Check if this is melee damage
    if (DamageType != None && ClassIsChildOf(DamageType, class'KFDT_Slashing'))
    {
        // Apply melee damage bonus
        InDamage += Round(float(DefaultDamage) * default.MeleeDamage[upgLevel - 1]);
        
        // Track melee kills for Deluxe version speed boost
        if (upgLevel == 2 && InDamage >= MyKFPM.Health && DamageInstigator != None && DamageInstigator.Pawn != None)
        {
            SnakeHelper = GetHelper(DamageInstigator.Pawn);
            if (SnakeHelper != None)
            {
                SnakeHelper.TriggerSpeedBoost();
            }
        }
    }
}

static simulated function InitiateWeapon(int upgLevel, KFWeapon KFW, KFPawn OwnerPawn)
{
    local ZTUpgrade_Skill_SnakesCoil_Helper SnakeHelper;
    local bool bFound;

    // Only create helper for Deluxe version
    if (upgLevel == 2 && KFPawn_Human(OwnerPawn) != None && OwnerPawn.Role == Role_Authority)
    {
        bFound = False;
        foreach OwnerPawn.ChildActors(class'ZTUpgrade_Skill_SnakesCoil_Helper', SnakeHelper)
        {
            bFound = True;
            break;
        }

        if (!bFound)
            SnakeHelper = OwnerPawn.Spawn(class'ZTUpgrade_Skill_SnakesCoil_Helper', OwnerPawn);
    }
}

static function ZTUpgrade_Skill_SnakesCoil_Helper GetHelper(Pawn OwnerPawn)
{
    local ZTUpgrade_Skill_SnakesCoil_Helper SnakeHelper;

    if (KFPawn_Human(OwnerPawn) != None)
    {
        foreach OwnerPawn.ChildActors(class'ZTUpgrade_Skill_SnakesCoil_Helper', SnakeHelper)
        {
            return SnakeHelper;
        }

        // Create one if needed
        SnakeHelper = OwnerPawn.Spawn(class'ZTUpgrade_Skill_SnakesCoil_Helper', OwnerPawn);
    }

    return SnakeHelper;
}

static simulated function DeleteHelperClass(Pawn OwnerPawn)
{
    local ZTUpgrade_Skill_SnakesCoil_Helper SnakeHelper;

    if (OwnerPawn != None)
    {
        foreach OwnerPawn.ChildActors(class'ZTUpgrade_Skill_SnakesCoil_Helper', SnakeHelper)
        {
            SnakeHelper.Destroy();
        }
    }
}

