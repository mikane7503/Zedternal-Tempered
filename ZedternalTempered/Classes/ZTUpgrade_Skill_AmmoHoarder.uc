    bShouldLocalize=True
    LocPackage="ZedternalTempered"
    LocSection="ZTUpgrade_Skill_AmmoHoarder"

    UpgradeName="Ammo Hoarder"
	upgradeDescription(0)="<font color=\"#962ab9\">Decrease</font> your <font color=\"#962ab9\">Maximum Health</font> by <font color=\"#cb1b43\">15</font> and your <font color=\"#962ab9\">Damage</font> by <font color=\"#cb1b43\">15%</font>. <font color=\"#42e087\">Increase</font> your <font color=\"#42e087\">Maximum Ammunition</font> by <font color=\"#84d6d0\">100%</font> and your <font color=\"#42e087\">Magazine Size</font> for all weapons by <font color=\"#84d6d0\">50%</font>."
	upgradeDescription(1)="<font color=\"#962ab9\">Decrease</font> your <font color=\"#962ab9\">Maximum Health</font> by <font color=\"#cb1b43\">30</font> and your <font color=\"#962ab9\">Damage</font> by <font color=\"#cb1b43\">30%</font>. <font color=\"#42e087\">Increase</font> your <font color=\"#42e087\">Maximum Ammunition</font> by <font color=\"#84d6d0\">200%</font> and your <font color=\"#42e087\">Magazine Size</font> for all weapons by <font color=\"#84d6d0\">100%</font>."
    UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_AmmoHoarder'
	UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_AmmoHoarder_Deluxe'
	Name="Default__ZTUpgrade_Skill_AmmoHoarder"
}