	upgradeDescription(0)="Your <font color=\"#66cc00\">first shot</font> after <font color=\"#66cc00\">reloading</font> or <font color=\"#66cc00\">switching weapons</font> deals <font color=\"#ff3399\">25%</font> more <font color=\"#66cc00\">Damage</font>."
	upgradeDescription(1)="Your <font color=\"#66cc00\">first shot</font> after <font color=\"#66cc00\">reloading</font> or <font color=\"#66cc00\">switching weapons</font> deals <font color=\"#ff3399\">50%</font> more <font color=\"#66cc00\">Damage</font>."
	UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_Primed'
	UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_Primed_Deluxe'
	Name="Default__ZTUpgrade_Skill_Primed"
}
