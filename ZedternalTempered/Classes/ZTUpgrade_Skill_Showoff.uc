class ZTUpgrade_Skill_Showoff extends ZTUpgrade_Skill config(ZedternalUnlimited);

var config array<float> DamagePerZed;
var const byte MaxZedBonus;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.DamagePerZed[0] = 0.05f;
		default.DamagePerZed[1] = 0.10f;

		// BEGIN TEMPERED INI DEFAULTS (generated; do not edit by hand)
		default.DamagePerZed.Length = 2;
		default.DamagePerZed[0] = 0.050000f;
		default.DamagePerZed[1] = 0.100000f;
		// END TEMPERED INI DEFAULTS
		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


static function ModifyDamageGiven(out int InDamage, int DefaultDamage, int upgLevel, optional Actor DamageCauser, optional KFPawn_Monster MyKFPM, optional KFPlayerController DamageInstigator, optional class<KFDamageType> DamageType, optional int HitZoneIdx, optional KFWeapon MyKFW)
{
	local ZTUpgrade_Skill_Showoff_Helper UPG;
	local byte BonusCount;

	if (DamageInstigator != None && DamageInstigator.Pawn != None)
	{
		UPG = GetHelper(KFPawn(DamageInstigator.Pawn));
		if (UPG != None && UPG.NearbyZedCount > 0)
		{
			BonusCount = Min(UPG.NearbyZedCount, default.MaxZedBonus);
			InDamage += Round(float(DefaultDamage) * default.DamagePerZed[upgLevel - 1] * float(BonusCount));
		}
	}
}

static simulated function InitiateWeapon(int upgLevel, KFWeapon KFW, KFPawn OwnerPawn)
{
	local ZTUpgrade_Skill_Showoff_Helper UPG;
	local bool bFound;

	if (KFPawn_Human(OwnerPawn) != None && OwnerPawn.Role == Role_Authority)
	{
		bFound = False;
		foreach OwnerPawn.ChildActors(class'ZTUpgrade_Skill_Showoff_Helper', UPG)
		{
			bFound = True;
			break;
		}

		if (!bFound)
			UPG = OwnerPawn.Spawn(class'ZTUpgrade_Skill_Showoff_Helper', OwnerPawn);
	}
}

static function ZTUpgrade_Skill_Showoff_Helper GetHelper(KFPawn OwnerPawn)
{
	local ZTUpgrade_Skill_Showoff_Helper UPG;

	if (KFPawn_Human(OwnerPawn) != None)
	{
		foreach OwnerPawn.ChildActors(class'ZTUpgrade_Skill_Showoff_Helper', UPG)
		{
			return UPG;
		}

		//Should have one
		UPG = OwnerPawn.Spawn(class'ZTUpgrade_Skill_Showoff_Helper', OwnerPawn);
	}

	return UPG;
}

static simulated function DeleteHelperClass(Pawn OwnerPawn)
{
	local ZTUpgrade_Skill_Showoff_Helper UPG;

	if (OwnerPawn != None)
	{
		foreach OwnerPawn.ChildActors(class'ZTUpgrade_Skill_Showoff_Helper', UPG)
		{
			UPG.Destroy();
		}
	}
}

defaultproperties
{
    // --- Localization (auto-generated by mass_localize_dk_upgrades.py) ---
    // Strings live in KFGame/Localization/<lang>/ZedternalTempered.<langext>
    // Section: [ZTUpgrade_Skill_Showoff]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalTempered"
    LocSection="ZTUpgrade_Skill_Showoff"

	MaxZedBonus=10
	UpgradeName="Showoff"
	upgradeDescription(0)="Deal <font color=\"#ff3399\">+5%</font> more <font color=\"#66cc00\">Damage</font> for each <font color=\"#66cc00\">nearby enemy</font> (max <font color=\"#ff3399\">+50%</font> at 10 enemies)."
	upgradeDescription(1)="Deal <font color=\"#ff3399\">+10%</font> more <font color=\"#66cc00\">Damage</font> for each <font color=\"#66cc00\">nearby enemy</font> (max <font color=\"#ff3399\">+100%</font> at 10 enemies)."
	UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_Showoff'
	UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_Showoff_Deluxe'
	Name="Default__ZTUpgrade_Skill_Showoff"
}
