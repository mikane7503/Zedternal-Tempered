class ZTUpgrade_Skill_GlacialEndurance extends ZTUpgrade_Skill config(ZedternalUnlimited);

var config array<float> ZedTimeExtension;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.ZedTimeExtension[0] = 2.0f;
		default.ZedTimeExtension[1] = 4.0f;

		// BEGIN TEMPERED INI DEFAULTS (generated; do not edit by hand)
		default.ZedTimeExtension.Length = 2;
		default.ZedTimeExtension[0] = 1.000000f;
		default.ZedTimeExtension[1] = 2.000000f;
		// END TEMPERED INI DEFAULTS
		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


static simulated function InitiateWeapon(int upgLevel, KFWeapon KFW, KFPawn OwnerPawn)
{
    local ZTUpgrade_Skill_GlacialEndurance_Helper UPG;
    local bool bFound;

    if (KFPawn_Human(OwnerPawn) != None && OwnerPawn.Role == Role_Authority)
    {
        bFound = False;
        foreach OwnerPawn.ChildActors(class'ZTUpgrade_Skill_GlacialEndurance_Helper', UPG)
        {
            bFound = True;
            break;
        }

        if (!bFound)
        {
            UPG = OwnerPawn.Spawn(class'ZTUpgrade_Skill_GlacialEndurance_Helper', OwnerPawn);
            UPG.bDeluxe = (upgLevel > 1);
            UPG.UpgradeLevel = upgLevel;
        }
    }
}

static simulated function GetZedTimeExtension(out float InExtension, float DefaultExtension, int upgLevel)
{
    // Use += so we compose with any other zed-time extenders (e.g. Commando perk
    // upgrades). Old code did `InExtension = DefaultExtension + value` which
    // discarded any prior contribution to InExtension.
    InExtension += default.ZedTimeExtension[upgLevel - 1];
}

static function ModifyDamageGiven(out int InDamage, int DefaultDamage, int upgLevel, optional Actor DamageCauser, optional KFPawn_Monster MyKFPM, optional KFPlayerController DamageInstigator, optional class<KFDamageType> DamageType, optional int HitZoneIdx, optional KFWeapon MyKFW)
{
    local ZTUpgrade_Skill_GlacialEndurance_Helper UPG;

    if (DamageInstigator != None && DamageInstigator.Pawn != None)
    {
        foreach DamageInstigator.Pawn.ChildActors(class'ZTUpgrade_Skill_GlacialEndurance_Helper', UPG)
        {
            if (UPG.bInExtendedZedTime)
            {
                // Use += against DefaultDamage so this composes with any other
                // damage contributors. Old code did `InDamage = DefaultDamage * 2.0f`
                // which discarded any prior contribution to InDamage.
                InDamage += DefaultDamage; // +100% damage during extended time
                break;
            }
        }
    }
}

static simulated function DeleteHelperClass(Pawn OwnerPawn)
{
    local ZTUpgrade_Skill_GlacialEndurance_Helper UPG;

    if (OwnerPawn != None)
    {
        foreach OwnerPawn.ChildActors(class'ZTUpgrade_Skill_GlacialEndurance_Helper', UPG)
        {
            UPG.Destroy();
        }
    }
}

defaultproperties
{
    // --- Localization (auto-generated by mass_localize_dk_upgrades.py) ---
    // Strings live in KFGame/Localization/<lang>/ZedternalTempered.<langext>
    // Section: [ZTUpgrade_Skill_GlacialEndurance]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalTempered"
    LocSection="ZTUpgrade_Skill_GlacialEndurance"

    UpgradeName="Glacial Endurance"
    upgradeDescription(0)="Extend <font color=\"#15d7fa\">Zed Time Duration</font> by <font color=\"#87CEEB\">1 seconds</font> and gain <font color=\"#77d914\">100% Damage</font> during extended time."
    upgradeDescription(1)="Extend <font color=\"#15d7fa\">Zed Time Duration</font> by <font color=\"#87CEEB\">2 seconds</font> and gain <font color=\"#77d914\">100% Damage</font> during extended time."
    UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_GlacialEndurance'
    UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_GlacialEndurance_Deluxe'

    Name="Default__ZTUpgrade_Skill_GlacialEndurance"
}
