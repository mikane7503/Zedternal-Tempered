	UpgradeDescription(0)="The symbiote's acidic blood enhances circulation and metabolism. Gain <font color='#00FF7F'>25%</font> less <font color='#FF6347'>Recoil</font> and <font color='#00FF7F'>20%</font> better <font color='#87CEEB'>Accuracy</font>."
	UpgradeDescription(1)="The symbiote's acidic blood enhances circulation and metabolism. Gain <font color='#00FF7F'>40%</font> less <font color='#FF6347'>Recoil</font> and <font color='#00FF7F'>35%</font> better <font color='#87CEEB'>Accuracy</font>."
	
	Name="Default__ZTUpgrade_Skill_AcidicBlood"
