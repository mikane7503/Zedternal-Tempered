// ===================================================================
// ZTUpgrade_Skill_PheromoneTrail
// Each kill releases a burst of chemical signals through the
// hivemind's neural pathways, flooding the host with adrenaline
// and quickening every step.
//
// Normal: Kills grant +15% movement speed for 3 seconds (refreshes)
// Deluxe: Kills grant +30% movement speed for 3 seconds (refreshes)
//         and +15% reload speed during the buff
// ===================================================================
class ZTUpgrade_Skill_PheromoneTrail extends ZTUpgrade_Skill config(ZedternalUnlimited);

var config array<float> SpeedBonus;
var config float DeluxeReloadBonus;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.SpeedBonus[0] = 0.15f;
		default.SpeedBonus[1] = 0.30f;
		default.DeluxeReloadBonus = 0.15f;

		// BEGIN TEMPERED INI DEFAULTS (generated; do not edit by hand)
		default.SpeedBonus.Length = 2;
		default.SpeedBonus[0] = 0.150000f;
		default.SpeedBonus[1] = 0.300000f;
		default.DeluxeReloadBonus = 0.075000f;
		// END TEMPERED INI DEFAULTS
		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


// AddVampireHealth is called on every kill - use it for kill tracking
static function AddVampireHealth(out int InHealth, int DefaultHealth, int upgLevel, KFPlayerController KFPC, class<DamageType> DT)
{
	local ZTUpgrade_Skill_PheromoneTrail_Helper UPG;

	if (KFPC == None || KFPC.Pawn == None)
		return;

	UPG = GetHelper(KFPC.Pawn, upgLevel);
	if (UPG != None)
		UPG.OnKill();
}

static simulated function ModifySpeed(out float InSpeed, float DefaultSpeed, int upgLevel, KFPawn OwnerPawn)
{
	local ZTUpgrade_Skill_PheromoneTrail_Helper UPG;

	if (KFPawn_Human(OwnerPawn) == None)
		return;

	foreach OwnerPawn.ChildActors(class'ZTUpgrade_Skill_PheromoneTrail_Helper', UPG)
	{
		if (UPG.bActive)
		{
			InSpeed += DefaultSpeed * default.SpeedBonus[upgLevel - 1];
		}
		return;
	}
}

// Deluxe: reload speed bonus during buff
static simulated function GetReloadRateScale(out float InReloadRateScale, int upgLevel, KFWeapon KFW, KFPawn OwnerPawn)
{
	local ZTUpgrade_Skill_PheromoneTrail_Helper UPG;

	if (upgLevel < 2 || OwnerPawn == None)
		return;

	foreach OwnerPawn.ChildActors(class'ZTUpgrade_Skill_PheromoneTrail_Helper', UPG)
	{
		if (UPG.bActive)
		{
			InReloadRateScale -= InReloadRateScale * default.DeluxeReloadBonus;
		}
		return;
	}
}

static function ZTUpgrade_Skill_PheromoneTrail_Helper GetHelper(Pawn OwnerPawn, int upgLevel)
{
	local ZTUpgrade_Skill_PheromoneTrail_Helper UPG;

	if (KFPawn_Human(OwnerPawn) != None)
	{
		foreach OwnerPawn.ChildActors(class'ZTUpgrade_Skill_PheromoneTrail_Helper', UPG)
		{
			return UPG;
		}

		// Should have one - spawn it
		UPG = OwnerPawn.Spawn(class'ZTUpgrade_Skill_PheromoneTrail_Helper', OwnerPawn);
		UPG.bDeluxe = (upgLevel > 1);
	}

	return UPG;
}

static simulated function DeleteHelperClass(Pawn OwnerPawn)
{
	local ZTUpgrade_Skill_PheromoneTrail_Helper UPG;

	if (OwnerPawn != None)
	{
		foreach OwnerPawn.ChildActors(class'ZTUpgrade_Skill_PheromoneTrail_Helper', UPG)
		{
			UPG.Destroy();
		}
	}
}

defaultproperties
{

    // --- Localization (auto-generated by mass_localize_dk_upgrades.py) ---
    // Strings live in KFGame/Localization/<lang>/ZedternalTempered.<langext>
    // Section: [ZTUpgrade_Skill_PheromoneTrail]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalTempered"
    LocSection="ZTUpgrade_Skill_PheromoneTrail"

	UpgradeName="Pheromone Trail"
	UpgradeDescription(0)="Each kill releases a <font color=\"#9370DB\">chemical signal</font>. Gain <font color=\"#FFFFFF\">+7.5%</font> <font color=\"#84d6d0\">movement speed</font> for <font color=\"#FFAA00\">3 seconds</font>. Refreshes on subsequent kills."
	UpgradeDescription(1)="Each kill releases a <font color=\"#9370DB\">chemical signal</font>. Gain <font color=\"#FFFFFF\">+30%</font> <font color=\"#84d6d0\">movement speed</font> and <font color=\"#FFFFFF\">+7.5%</font> <font color=\"#42e087\">reload speed</font> for <font color=\"#FFAA00\">3 seconds</font>. Refreshes on subsequent kills."
	UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_PheromoneTrail'
	UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_PheromoneTrail_Deluxe'

	Name="Default__ZTUpgrade_Skill_PheromoneTrail"
}
