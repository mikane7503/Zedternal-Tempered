// ===================================================================
// ZTUpgrade_Skill_ResidualForm
//
// "The old shape lingers beneath the new."
//
// When buffs roll at wave start, the PREVIOUS wave's buffs persist
// at reduced effectiveness for a brief overlap period. Creates smooth
// transitions between forms and a brief dual-power spike.
//
// Works through GetBuffEffectiveness() on the helper - buffs that
// exist in PreviousBuffMask but NOT in ReplicatedBuffMask are treated
// as residual echoes with the configured multiplier and duration.
//
// Standard: 25% effectiveness of previous buffs for 10s
// Deluxe:   50% effectiveness of previous buffs for 15s
// ===================================================================
class ZTUpgrade_Skill_ResidualForm extends ZTUpgrade_Skill config(ZedternalUnlimited);

var config array<float> ResidualPower;
var config array<float> ResidualTime;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.ResidualPower[0] = 0.25f;
		default.ResidualPower[1] = 0.50f;
		default.ResidualTime[0] = 10.0f;
		default.ResidualTime[1] = 15.0f;

		// BEGIN TEMPERED INI DEFAULTS (generated; do not edit by hand)
		default.ResidualPower.Length = 2;
		default.ResidualPower[0] = 0.250000f;
		default.ResidualPower[1] = 0.500000f;
		default.ResidualTime.Length = 2;
		default.ResidualTime[0] = 10.000000f;
		default.ResidualTime[1] = 15.000000f;
		// END TEMPERED INI DEFAULTS
		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


// Helper lookup - reuses the Shapeshifter perk's static GetHelper
static simulated function ZTUpgrade_Perk_Shapeshifter_Helper GetShapeshifterHelper(Pawn OwnerPawn)
{
    return class'ZTUpgrade_Perk_Shapeshifter'.static.GetHelper(OwnerPawn);
}

// Configure the helper's residual multipliers on weapon init (server-side)
static simulated function InitiateWeapon(int upgLevel, KFWeapon KFW, KFPawn OwnerPawn)
{
    local ZTUpgrade_Perk_Shapeshifter_Helper Helper;

    if (OwnerPawn == None || OwnerPawn.Role != Role_Authority)
        return;

    Helper = GetShapeshifterHelper(OwnerPawn);
    if (Helper == None)
        return;

    Helper.ResidualMultiplier = default.ResidualPower[upgLevel - 1];
    Helper.ResidualDuration = default.ResidualTime[upgLevel - 1];
    Helper.bNetDirty = true;
}

defaultproperties
{

    // --- Localization (auto-generated by mass_localize_dk_upgrades.py) ---
    // Strings live in KFGame/Localization/<lang>/ZedternalTempered.<langext>
    // Section: [ZTUpgrade_Skill_ResidualForm]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalTempered"
    LocSection="ZTUpgrade_Skill_ResidualForm"

    UpgradeName="Residual Form"
    UpgradeDescription(0)="<font color=\"#c77dff\">Residual Form:</font> Previous wave's buffs <font color=\"#e0aaff\">linger</font> at <font color=\"#FFFFFF\">25%</font> effectiveness for <font color=\"#FFFFFF\">10</font> seconds after new buffs roll"
    UpgradeDescription(1)="<font color=\"#c77dff\">Residual Form:</font> Previous wave's buffs <font color=\"#e0aaff\">linger</font> at <font color=\"#FFFFFF\">50%</font> effectiveness for <font color=\"#FFFFFF\">15</font> seconds after new buffs roll"
    UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_ResidualForm'
    UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_ResidualForm_Deluxe'

    Name="Default__ZTUpgrade_Skill_ResidualForm"
}
