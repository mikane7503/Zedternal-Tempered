	upgradeDescription(0)="Unlocks <font color=\"#66cc00\">Bullseye</font> active ability: <font color=\"#00ffff\">PERFECT ACCURACY</font> for <font color=\"#ffaa33\">10 seconds</font>. No recoil, no spread, no weapon sway - your shots go exactly where you aim. Cooldown: <font color=\"#ff9900\">60 seconds</font>."
	
	upgradeDescription(1)="Unlocks <font color=\"#66cc00\">Bullseye</font> active ability: <font color=\"#00ffff\">PERFECT ACCURACY</font> for <font color=\"#ffaa33\">10 seconds</font>. No recoil, no spread, no weapon sway - your shots go exactly where you aim. Cooldown: <font color=\"#ff9900\">60 seconds</font>."
	
