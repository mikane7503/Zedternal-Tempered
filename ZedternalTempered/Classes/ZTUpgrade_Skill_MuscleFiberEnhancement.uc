	UpgradeDescription(0)="The symbiote reinforces muscle tissue with bio-fibers. <font color='#00FF7F'>+40%</font> <font color='#9370DB'>melee damage</font>, <font color='#00FF7F'>+5</font> <font color='#9370DB'>weight capacity</font>, and <font color='#00FF7F'>+3%</font> <font color='#9370DB'>movement speed</font>."
