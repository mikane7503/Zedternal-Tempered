class ZTUpgrade_Skill_MuscleFiberEnhancement extends ZTUpgrade_Skill abstract config(ZedternalUnlimited);

var config array<float> MeleeDamageBoost;
var config array<int> WeightLimitIncrease;
var array<float> MeleeSpeedBoost;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.MeleeDamageBoost[0] = 0.40f;
		default.MeleeDamageBoost[1] = 0.80f;
		default.WeightLimitIncrease[0] = 5;
		default.WeightLimitIncrease[1] = 10;

		// BEGIN TEMPERED INI DEFAULTS (generated; do not edit by hand)
		default.MeleeDamageBoost.Length = 2;
		default.MeleeDamageBoost[0] = 0.400000f;
		default.MeleeDamageBoost[1] = 0.800000f;
		default.WeightLimitIncrease.Length = 2;
		default.WeightLimitIncrease[0] = 5;
		default.WeightLimitIncrease[1] = 10;
		// END TEMPERED INI DEFAULTS
		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


static function ModifyHardAttackDamage(out int InDamage, int DefaultDamage, int upgLevel, KFPawn OwnerPawn)
{
	InDamage = Round(float(InDamage) * (1.0f + default.MeleeDamageBoost[upgLevel - 1]));
}

static function ApplyWeightLimits(out int InWeightLimit, int DefaultWeightLimit, int upgLevel)
{
	InWeightLimit += default.WeightLimitIncrease[upgLevel - 1];
}

static simulated function ModifySpeed(out float InSpeed, float DefaultSpeed, int upgLevel, KFPawn OwnerPawn)
{
	// Small speed boost from enhanced muscle fibers
	if (upgLevel == 1)
		InSpeed *= 1.03f; // 3% speed boost
	else
		InSpeed *= 1.05f; // 5% speed boost
}

