	upgradeDescription(0)="Kills on <font color=\"#a0c1cb\">Fleshpounds</font> have a <font color=\"#15d7fa\">25% Chance</font> to cause a <font color=\"#0bf1f1\">Firestorm</font>."
	upgradeDescription(1)="Kills on <font color=\"#a0c1cb\">Fleshpounds</font> have a <font color=\"#15d7fa\">50% Chance</font> to cause a <font color=\"#0bf1f1\">massive Firestorm</font>."
