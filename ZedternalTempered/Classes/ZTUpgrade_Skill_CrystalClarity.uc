class ZTUpgrade_Skill_CrystalClarity extends ZTUpgrade_Skill config(ZedternalUnlimited);

var config array<float> CloakDetectionRange;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.CloakDetectionRange[0] = 2000.0f;
		default.CloakDetectionRange[1] = 4000.0f;

		// BEGIN TEMPERED INI DEFAULTS (generated; do not edit by hand)
		default.CloakDetectionRange.Length = 2;
		default.CloakDetectionRange[0] = 2000.000000f;
		default.CloakDetectionRange[1] = 4000.000000f;
		// END TEMPERED INI DEFAULTS
		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


static simulated function bool HasNightVision(int upgLevel)
{
    return True;
}

static simulated function bool CanSeeCloaked(int upgLevel, KFWeapon KFW, KFPawn OwnerPawn)
{
    return True;
}

static simulated function ModifyCloakDetectionRange(out float InRange, float DefaultRange, int upgLevel)
{
    InRange = default.CloakDetectionRange[upgLevel - 1];
}

