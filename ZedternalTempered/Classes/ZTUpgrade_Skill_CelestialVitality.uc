// Celestial Vitality
// Increases the effectiveness of self-healing (syringe self-heal surge)
// Standard: +15% self-healing surge
// Deluxe: +35% self-healing surge
class ZTUpgrade_Skill_CelestialVitality extends ZTUpgrade_Skill config(ZedternalUnlimited);

var config array<float> SelfHealBonus;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.SelfHealBonus[0] = 0.15f;
		default.SelfHealBonus[1] = 0.35f;

		// BEGIN TEMPERED INI DEFAULTS (generated; do not edit by hand)
		default.SelfHealBonus.Length = 2;
		default.SelfHealBonus[0] = 0.080000f;
		default.SelfHealBonus[1] = 0.160000f;
		// END TEMPERED INI DEFAULTS
		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


static simulated function GetSelfHealingSurgePct(out float InHealingPct, int upgLevel)
{
	InHealingPct += default.SelfHealBonus[upgLevel - 1];
}

