class ZTUpgrade_Skill_IceArmor extends ZTUpgrade_Skill config(ZedternalUnlimited);

var config array<int> ArmorBonus;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.ArmorBonus[0] = 10;
		default.ArmorBonus[1] = 20;

		// BEGIN TEMPERED INI DEFAULTS (generated; do not edit by hand)
		default.ArmorBonus.Length = 2;
		default.ArmorBonus[0] = 10;
		default.ArmorBonus[1] = 20;
		// END TEMPERED INI DEFAULTS
		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


static simulated function InitiateWeapon(int upgLevel, KFWeapon KFW, KFPawn OwnerPawn)
{
    local ZTUpgrade_Skill_IceArmor_Helper UPG;
    local bool bFound;

    if (KFPawn_Human(OwnerPawn) != None && OwnerPawn.Role == Role_Authority)
    {
        bFound = False;
        foreach OwnerPawn.ChildActors(class'ZTUpgrade_Skill_IceArmor_Helper', UPG)
        {
            bFound = True;
            break;
        }

        if (!bFound)
        {
            UPG = OwnerPawn.Spawn(class'ZTUpgrade_Skill_IceArmor_Helper', OwnerPawn);
            UPG.bDeluxe = (upgLevel > 1);
            UPG.UpgradeLevel = upgLevel;
        }
    }
}

static function ModifyArmor(out int InArmor, int DefaultArmor, int upgLevel)
{
    InArmor += default.ArmorBonus[upgLevel - 1];
}

static function ModifyDamageTaken(out int InDamage, int DefaultDamage, int upgLevel, KFPawn OwnerPawn, optional class<DamageType> DamageType, optional Controller InstigatedBy, optional KFWeapon MyKFW)
{
    local ZTUpgrade_Skill_IceArmor_Helper UPG;

    if (OwnerPawn != None && InDamage > 0)
    {
        foreach OwnerPawn.ChildActors(class'ZTUpgrade_Skill_IceArmor_Helper', UPG)
        {
            UPG.OnDamageTaken();
            break;
        }
    }
}

static simulated function DeleteHelperClass(Pawn OwnerPawn)
{
    local ZTUpgrade_Skill_IceArmor_Helper UPG;

    if (OwnerPawn != None)
    {
        foreach OwnerPawn.ChildActors(class'ZTUpgrade_Skill_IceArmor_Helper', UPG)
        {
            UPG.Destroy();
        }
    }
}

