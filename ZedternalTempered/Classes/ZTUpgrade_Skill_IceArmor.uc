    upgradeDescription(1)="Gain <font color=\"#87CEEB\">20</font> additional <font color=\"#77d914\">Armor Points</font> that regenerate <font color=\"#15d7fa\">1 point</font> every <font color=\"#FFAA33\">3 seconds</font> out of combat."
