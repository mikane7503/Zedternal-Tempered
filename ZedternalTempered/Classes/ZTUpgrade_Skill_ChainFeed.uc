	UpgradeDescription(0)="<font color=\"#DAA520\">Chain Feed:</font> Kills add <font color=\"#87CEEB\">+1 round</font> to your magazine, even <font color=\"#FFFFFF\">beyond capacity</font>. Max <font color=\"#FF4444\">150%</font> magazine"
	UpgradeDescription(1)="<font color=\"#FFD700\">Chain Feed:</font> Kills add <font color=\"#87CEEB\">+1 round</font> to your magazine, even <font color=\"#FFFFFF\">beyond capacity</font>. Max <font color=\"#FF4444\">200%</font> magazine"

	UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_ChainFeed'
