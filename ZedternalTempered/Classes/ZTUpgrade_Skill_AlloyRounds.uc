// ===================================================================
// ZTUpgrade_Skill_AlloyRounds — Artificer Skill
//
// "★ Reforged weapons gain bonus penetration and stumble power.
//  Your refined ammunition punches through multiple targets."
//
// Normal:  +40% penetration, +30% stumble power (Reforged only)
// Deluxe:  +80% penetration, +60% stumble power (Reforged only)
//
// Hooks: ModifyPenetration, ModifyStumblePower
// Helper: None
//
// NOTE: These hooks don't receive KFWeapon directly, so we pull
//       the current weapon from OwnerPawn.Weapon.
// ===================================================================
class ZTUpgrade_Skill_AlloyRounds extends ZTUpgrade_Skill config(ZedternalUnlimited);

var config array<float> PenetrationBonus;
var config array<float> StumbleBonus;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.PenetrationBonus[0] = 0.40f;
		default.PenetrationBonus[1] = 0.80f;
		default.StumbleBonus[0] = 0.30f;
		default.StumbleBonus[1] = 0.60f;

		// BEGIN TEMPERED INI DEFAULTS (generated; do not edit by hand)
		default.PenetrationBonus.Length = 2;
		default.PenetrationBonus[0] = 0.400000f;
		default.PenetrationBonus[1] = 0.800000f;
		default.StumbleBonus.Length = 2;
		default.StumbleBonus[0] = 0.150000f;
		default.StumbleBonus[1] = 0.300000f;
		// END TEMPERED INI DEFAULTS
		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


static simulated function ModifyPenetration(out float InPenetration, float DefaultPenetration, int upgLevel, class<KFDamageType> DamageType, KFPawn OwnerPawn, optional bool bForce)
{
    local KFWeapon KFW;

    if (OwnerPawn != None)
    {
        KFW = KFWeapon(OwnerPawn.Weapon);
        if (KFW != None && class'ZTUpgrade_Perk_Artificer'.static.IsReforgedWeapon(KFW))
            InPenetration += DefaultPenetration * default.PenetrationBonus[upgLevel - 1];
    }
}

static function ModifyStumblePower(out float InStumblePower, float DefaultStumblePower, int upgLevel, optional KFPawn KFP, optional class<KFDamageType> DamageType, optional out float CooldownModifier, optional byte BodyPart, optional KFPawn OwnerPawn)
{
    local KFWeapon KFW;

    if (OwnerPawn != None)
    {
        KFW = KFWeapon(OwnerPawn.Weapon);
        if (KFW != None && class'ZTUpgrade_Perk_Artificer'.static.IsReforgedWeapon(KFW))
            InStumblePower += DefaultStumblePower * default.StumbleBonus[upgLevel - 1];
    }
}

defaultproperties
{

    // --- Localization (auto-generated by mass_localize_dk_upgrades.py) ---
    // Strings live in KFGame/Localization/<lang>/ZedternalTempered.<langext>
    // Section: [ZTUpgrade_Skill_AlloyRounds]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalTempered"
    LocSection="ZTUpgrade_Skill_AlloyRounds"

    UpgradeName="Alloy Rounds"
    UpgradeDescription(0)="<font color=\"#FFD700\"> Reforged</font> weapons gain <font color=\"#FFFFFF\">+40%</font> penetration and <font color=\"#FFFFFF\">+15%</font> stumble power"
    UpgradeDescription(1)="<font color=\"#FFD700\"> Reforged</font> weapons gain <font color=\"#FFFFFF\">+80%</font> penetration and <font color=\"#FFFFFF\">+30%</font> stumble power"
    UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_AlloyRounds'
    UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_AlloyRounds_Deluxe'

    Name="Default__ZTUpgrade_Skill_AlloyRounds"
}
