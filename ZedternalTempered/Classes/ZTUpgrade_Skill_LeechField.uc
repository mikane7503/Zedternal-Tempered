	UpgradeDescription(0)="<font color=\"#B40028\">Leech Field:</font> Stand still <font color=\"#FFFFFF\">2s</font> to create a <font color=\"#FFFFFF\">3m</font> drain aura. Enemies take <font color=\"#FFFFFF\">8</font> damage/s. You heal for <font color=\"#FFFFFF\">50%</font> of damage dealt. Moving cancels"
	UpgradeDescription(1)="<font color=\"#FFD700\">[DELUXE]</font> <font color=\"#B40028\">Leech Field:</font> Stand still <font color=\"#FFFFFF\">2s</font> to create an <font color=\"#FFFFFF\">4m</font> drain aura. Enemies take <font color=\"#FFFFFF\">15</font> damage/s. You heal for <font color=\"#FFFFFF\">100%</font>. Moving cancels"

	UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_LeechField'
