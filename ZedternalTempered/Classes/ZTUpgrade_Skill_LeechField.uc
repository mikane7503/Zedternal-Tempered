// ===================================================================
// ZTUpgrade_Skill_LeechField - Stationary Drain Aura
// Standing still for 2+ seconds creates a damage aura around you.
// Enemies inside take tick damage and you heal from it. Moving
// cancels the field. Holdout-style defensive vampire turret.
//
// Standard: 6m radius, 8 damage/tick (1s), heal 50% of damage dealt
// Deluxe:   8m radius, 15 damage/tick (1s), heal 100% of damage dealt
//
// All logic handled by helper class.
// ===================================================================
class ZTUpgrade_Skill_LeechField extends ZTUpgrade_Skill config(ZedternalUnlimited);

var config array<float> FieldRadius;
var config array<int> DamagePerTick;
var config array<float> HealPercent;
var config float StationaryDelay;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.FieldRadius[0] = 600.0f;
		default.FieldRadius[1] = 800.0f;
		default.DamagePerTick[0] = 8;
		default.DamagePerTick[1] = 15;
		default.HealPercent[0] = 0.50f;
		default.HealPercent[1] = 1.00f;
		default.StationaryDelay = 2.0f;

		// BEGIN TEMPERED INI DEFAULTS (generated; do not edit by hand)
		default.FieldRadius.Length = 2;
		default.FieldRadius[0] = 300.000000f;
		default.FieldRadius[1] = 400.000000f;
		default.DamagePerTick.Length = 2;
		default.DamagePerTick[0] = 8;
		default.DamagePerTick[1] = 15;
		default.HealPercent.Length = 2;
		default.HealPercent[0] = 0.500000f;
		default.HealPercent[1] = 1.000000f;
		default.StationaryDelay = 2.000000f;
		// END TEMPERED INI DEFAULTS
		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


// ===================================================================
// Helper Management
// ===================================================================
static simulated function InitiateWeapon(int upgLevel, KFWeapon KFW, KFPawn OwnerPawn)
{
	local ZTUpgrade_Skill_LeechField_Helper UPG;
	local bool bFound;

	if (KFPawn_Human(OwnerPawn) != None && OwnerPawn.Role == Role_Authority)
	{
		bFound = False;
		foreach OwnerPawn.ChildActors(class'ZTUpgrade_Skill_LeechField_Helper', UPG)
		{
			bFound = True;
			break;
		}

		if (!bFound)
		{
			UPG = OwnerPawn.Spawn(class'ZTUpgrade_Skill_LeechField_Helper', OwnerPawn);
			if (UPG != None)
			{
				UPG.FieldRadius = default.FieldRadius[upgLevel - 1];
				UPG.DamagePerTick = default.DamagePerTick[upgLevel - 1];
				UPG.HealPercent = default.HealPercent[upgLevel - 1];
				UPG.StationaryDelay = default.StationaryDelay;
			}
		}
	}
}

static simulated function DeleteHelperClass(Pawn OwnerPawn)
{
	local ZTUpgrade_Skill_LeechField_Helper UPG;

	if (OwnerPawn != None)
	{
		foreach OwnerPawn.ChildActors(class'ZTUpgrade_Skill_LeechField_Helper', UPG)
			UPG.Destroy();
	}
}

