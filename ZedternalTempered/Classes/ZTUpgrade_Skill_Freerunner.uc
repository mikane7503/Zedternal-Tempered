class ZTUpgrade_Skill_Freerunner extends ZTUpgrade_Skill config(ZedternalUnlimited);

var config array<float> Speed;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.Speed[0] = 0.20f;
		default.Speed[1] = 0.40f;

		// BEGIN TEMPERED INI DEFAULTS (generated; do not edit by hand)
		default.Speed.Length = 2;
		default.Speed[0] = 0.200000f;
		default.Speed[1] = 0.400000f;
		// END TEMPERED INI DEFAULTS
		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


static simulated function ModifySpeed(out float InSpeed, float DefaultSpeed, int upgLevel, KFPawn OwnerPawn)
{
	if (WMPawn_Human(OwnerPawn) != None && WMPawn_Human(OwnerPawn).ZedternalArmor <= 0)
		InSpeed += DefaultSpeed * default.Speed[upgLevel - 1];
}

