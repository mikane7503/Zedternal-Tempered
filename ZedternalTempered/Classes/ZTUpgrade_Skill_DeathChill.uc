class ZTUpgrade_Skill_DeathChill extends ZTUpgrade_Skill config(ZedternalUnlimited);

// Theme: Each kill builds freezing energy. At threshold, unleash a freeze explosion.
var config array<int> KillThreshold;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.KillThreshold[0] = 5;
		default.KillThreshold[1] = 3;

		// BEGIN TEMPERED INI DEFAULTS (generated; do not edit by hand)
		default.KillThreshold.Length = 2;
		default.KillThreshold[0] = 10;
		default.KillThreshold[1] = 6;
		// END TEMPERED INI DEFAULTS
		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


static function ModifyDamageGiven(out int InDamage, int DefaultDamage, int upgLevel, optional Actor DamageCauser, optional KFPawn_Monster MyKFPM, optional KFPlayerController DamageInstigator, optional class<KFDamageType> DamageType, optional int HitZoneIdx, optional KFWeapon MyKFW)
{
	local ZTUpgrade_Skill_DeathChill_Helper UPG;
	local rotator Rot;
	local vector Loc;

	if (MyKFPM == None || DamageInstigator == None || DamageInstigator.Pawn == None)
		return;

	// Check if this hit kills the zed
	if (MyKFPM.IsAliveAndWell() && (MyKFPM.Health - InDamage) <= 0)
	{
		UPG = GetHelper(DamageInstigator.Pawn);
		if (UPG == None)
			return;

		UPG.AddKill();

		// Check if threshold is reached
		if (UPG.KillCount >= default.KillThreshold[upgLevel - 1])
		{
			UPG.ResetKills();

			// Spawn freeze explosion at the killed zed's location
			Rot = rotator(MyKFPM.Velocity);
			Loc = MyKFPM.Location;
			Loc.Z -= MyKFPM.GetCollisionHeight();
			Rot.Pitch = 0;

			if (upgLevel > 1)
				DamageInstigator.Spawn(class'ZedternalReborn.WMProj_FreezeExplosion_Deluxe', DamageInstigator, , Loc, Rot, , True);
			else
				DamageInstigator.Spawn(class'ZedternalReborn.WMProj_FreezeExplosion', DamageInstigator, , Loc, Rot, , True);
		}
	}
}

static simulated function InitiateWeapon(int upgLevel, KFWeapon KFW, KFPawn OwnerPawn)
{
	local ZTUpgrade_Skill_DeathChill_Helper UPG;
	local bool bFound;

	if (KFPawn_Human(OwnerPawn) != None && OwnerPawn.Role == Role_Authority)
	{
		bFound = False;
		foreach OwnerPawn.ChildActors(class'ZTUpgrade_Skill_DeathChill_Helper', UPG)
		{
			bFound = True;
			break;
		}

		if (!bFound)
			UPG = OwnerPawn.Spawn(class'ZTUpgrade_Skill_DeathChill_Helper', OwnerPawn);
	}
}

static function ZTUpgrade_Skill_DeathChill_Helper GetHelper(Pawn OwnerPawn)
{
	local ZTUpgrade_Skill_DeathChill_Helper UPG;

	if (KFPawn_Human(OwnerPawn) != None)
	{
		foreach OwnerPawn.ChildActors(class'ZTUpgrade_Skill_DeathChill_Helper', UPG)
		{
			return UPG;
		}

		// Should have one
		UPG = OwnerPawn.Spawn(class'ZTUpgrade_Skill_DeathChill_Helper', OwnerPawn);
	}

	return UPG;
}

static simulated function DeleteHelperClass(Pawn OwnerPawn)
{
	local ZTUpgrade_Skill_DeathChill_Helper UPG;

	if (OwnerPawn != None)
	{
		foreach OwnerPawn.ChildActors(class'ZTUpgrade_Skill_DeathChill_Helper', UPG)
		{
			UPG.Destroy();
		}
	}
}

