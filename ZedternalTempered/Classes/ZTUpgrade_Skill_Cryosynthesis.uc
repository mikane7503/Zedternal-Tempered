class ZTUpgrade_Skill_Cryosynthesis extends ZTUpgrade_Skill config(ZedternalUnlimited);

var config array<float> SpareAmmo;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.SpareAmmo[0] = 0.20f;
		default.SpareAmmo[1] = 0.40f;

		// BEGIN TEMPERED INI DEFAULTS (generated; do not edit by hand)
		default.SpareAmmo.Length = 2;
		default.SpareAmmo[0] = 0.200000f;
		default.SpareAmmo[1] = 0.400000f;
		// END TEMPERED INI DEFAULTS
		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


static function WaveEnd(int upgLevel, KFPlayerController KFPC)
{
	local KFPawn Player;
	local KFInventoryManager KFIM;
	local int NewCount;
    
	Player = KFPawn(KFPC.Pawn);
	if (Player == None || !Player.IsAliveAndWell())
		return;

	KFIM = KFInventoryManager(Player.InvManager);
	if (KFIM == None)
		return;

	if (upgLevel == 1)
		NewCount = int(KFIM.GrenadeCount) + 2;
	else
		NewCount = int(KFIM.GrenadeCount) + 4;

	// AddGrenades clamps at the ordinary maximum and loses this bonus.
	KFIM.GrenadeCount = byte(Min(255, NewCount));
}

static simulated function ModifySpareAmmoAmount(out int InSpareAmmo, int DefaultSpareAmmo, int upgLevel, KFWeapon KFW, const optional out STraderItem TraderItem, optional bool bSecondary)
{
    if(!bSecondary)
    {
        InSpareAmmo += Round((float(DefaultSpareAmmo) * default.SpareAmmo[upgLevel - 1]));
    }
}

defaultproperties
{
    // --- Localization (auto-generated by mass_localize_dk_upgrades.py) ---
    // Strings live in KFGame/Localization/<lang>/ZedternalTempered.<langext>
    // Section: [ZTUpgrade_Skill_Cryosynthesis]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalTempered"
    LocSection="ZTUpgrade_Skill_Cryosynthesis"

    UpgradeName="Cryosynthesis"
	upgradeDescription(0)="At the start of each wave, you gain <font color=\"#0bf1f1\">2 Grenades</font>. Your <font color=\"#15d7fa\">Spare Ammunition</font> is increased by <font color=\"#15d7fa\">20%</font>."
	upgradeDescription(1)="At the start of each wave, you gain <font color=\"#0bf1f1\">4 Grenades</font>. Your <font color=\"#15d7fa\">Spare Ammunition</font> is increased by <font color=\"#15d7fa\">40%</font>."
	UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_Cryosynthesis'
	UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_Cryosynthesis_Deluxe'

	Name="Default__ZTUpgrade_Skill_Cryosynthesis"
}
