    LocSection="ZTUpgrade_Skill_HuntersInstinct"

    UpgradeName="Hunter's Instinct"
    UpgradeDescription(0)="Rifle kills mark nearby zeds within <font color=\"#15d7fa\">8 meters</font> for <font color=\"#ff3399\">6 seconds</font>. Marked zeds take <font color=\"#77d914\">+30%</font> damage from all sources."
    UpgradeDescription(1)="Rifle kills mark nearby zeds within <font color=\"#15d7fa\">12 meters</font> for <font color=\"#ff3399\">8 seconds</font>. Marked zeds take <font color=\"#77d914\">+40%</font> damage from all sources."
    
    UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_HuntersInstinct'
    UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_HuntersInstinct_Deluxe'
    
    Name="Default__ZTUpgrade_Skill_HuntersInstinct"
}
