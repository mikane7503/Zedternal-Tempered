class ZTUpgrade_Skill_QuickHands extends ZTUpgrade_Skill config(ZedternalUnlimited);

// After completing a reload, gain increased fire rate for a short duration
// Encourages aggressive reload timing and burst damage windows

var config array<float> FireRateBonus;  // Fire rate increase during boost
var config array<float> BoostDuration;  // Duration of boost in seconds
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.FireRateBonus[0] = 0.25f;
		default.FireRateBonus[1] = 0.50f;
		default.BoostDuration[0] = 3.0f;
		default.BoostDuration[1] = 4.0f;

		// BEGIN TEMPERED INI DEFAULTS (generated; do not edit by hand)
		default.FireRateBonus.Length = 2;
		default.FireRateBonus[0] = 0.300000f;
		default.FireRateBonus[1] = 0.300000f;
		default.BoostDuration.Length = 2;
		default.BoostDuration[0] = 1.500000f;
		default.BoostDuration[1] = 3.000000f;
		// END TEMPERED INI DEFAULTS
		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


static simulated function ModifyRateOfFire(out float InRate, float DefaultRate, int upgLevel, KFWeapon KFW)
{
	local ZTUpgrade_Skill_QuickHands_Helper UPG;

	if (KFW != None && KFW.Instigator != None)
	{
		UPG = GetHelper(KFPawn(KFW.Instigator));
		if (UPG != None && UPG.bBoosted)
			InRate -= DefaultRate * default.FireRateBonus[upgLevel - 1];
	}
}

static simulated function InitiateWeapon(int upgLevel, KFWeapon KFW, KFPawn OwnerPawn)
{
	local ZTUpgrade_Skill_QuickHands_Helper UPG;
	local bool bFound;

	if (KFPawn_Human(OwnerPawn) != None && OwnerPawn.Role == Role_Authority)
	{
		bFound = False;
		foreach OwnerPawn.ChildActors(class'ZTUpgrade_Skill_QuickHands_Helper', UPG)
		{
			bFound = True;
			break;
		}

		if (!bFound)
		{
			UPG = OwnerPawn.Spawn(class'ZTUpgrade_Skill_QuickHands_Helper', OwnerPawn);
			UPG.BoostTime = default.BoostDuration[upgLevel - 1];
		}
	}
}

static simulated function ZTUpgrade_Skill_QuickHands_Helper GetHelper(KFPawn OwnerPawn)
{
	local ZTUpgrade_Skill_QuickHands_Helper UPG;

	if (KFPawn_Human(OwnerPawn) != None)
	{
		foreach OwnerPawn.ChildActors(class'ZTUpgrade_Skill_QuickHands_Helper', UPG)
		{
			return UPG;
		}

		if (OwnerPawn.Role == Role_Authority)
			UPG = OwnerPawn.Spawn(class'ZTUpgrade_Skill_QuickHands_Helper', OwnerPawn);
	}

	return UPG;
}

static simulated function DeleteHelperClass(Pawn OwnerPawn)
{
	local ZTUpgrade_Skill_QuickHands_Helper UPG;

	if (OwnerPawn != None)
	{
		foreach OwnerPawn.ChildActors(class'ZTUpgrade_Skill_QuickHands_Helper', UPG)
		{
			UPG.Destroy();
		}
	}
}

