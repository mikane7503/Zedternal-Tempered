class ZTUpgrade_Skill_JuryRig extends ZTUpgrade_Skill config(ZedternalUnlimited);

// After switching weapons, your first few shots deal bonus damage
// Encourages rapid weapon rotation mid-fight

var config array<float> DamageBonus;   // Damage bonus per boosted shot
var config array<int> BonusShots;      // Number of boosted shots after switch
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.DamageBonus[0] = 0.20f;
		default.DamageBonus[1] = 0.40f;
		default.BonusShots[0] = 3;
		default.BonusShots[1] = 5;

		// BEGIN TEMPERED INI DEFAULTS (generated; do not edit by hand)
		default.DamageBonus.Length = 2;
		default.DamageBonus[0] = 0.200000f;
		default.DamageBonus[1] = 0.300000f;
		default.BonusShots.Length = 2;
		default.BonusShots[0] = 3;
		default.BonusShots[1] = 5;
		// END TEMPERED INI DEFAULTS
		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


static function ModifyDamageGiven(out int InDamage, int DefaultDamage, int upgLevel, optional Actor DamageCauser, optional KFPawn_Monster MyKFPM, optional KFPlayerController DamageInstigator, optional class<KFDamageType> DamageType, optional int HitZoneIdx, optional KFWeapon MyKFW)
{
	local ZTUpgrade_Skill_JuryRig_Helper UPG;

	if (MyKFPM != None && DamageInstigator != None && DamageInstigator.Pawn != None && MyKFW != None)
	{
		UPG = GetHelper(DamageInstigator.Pawn);
		if (UPG != None)
		{
			// Check if weapon changed since last damage event
			if (UPG.LastWeapon != MyKFW)
			{
				UPG.LastWeapon = MyKFW;
				UPG.RemainingBonusShots = default.BonusShots[upgLevel - 1];
			}

			// Apply bonus damage if we have shots remaining
			if (UPG.RemainingBonusShots > 0)
			{
				InDamage += Round(float(DefaultDamage) * default.DamageBonus[upgLevel - 1]);

				// Only decrement once per frame (handles shotgun pellets)
				if (UPG.LastBonusShotTime != UPG.Player.WorldInfo.TimeSeconds)
				{
					UPG.LastBonusShotTime = UPG.Player.WorldInfo.TimeSeconds;
					UPG.RemainingBonusShots -= 1;
				}
			}
		}
	}
}

static simulated function InitiateWeapon(int upgLevel, KFWeapon KFW, KFPawn OwnerPawn)
{
	local ZTUpgrade_Skill_JuryRig_Helper UPG;
	local bool bFound;

	if (KFPawn_Human(OwnerPawn) != None && OwnerPawn.Role == Role_Authority)
	{
		bFound = False;
		foreach OwnerPawn.ChildActors(class'ZTUpgrade_Skill_JuryRig_Helper', UPG)
		{
			bFound = True;
			break;
		}

		if (!bFound)
			UPG = OwnerPawn.Spawn(class'ZTUpgrade_Skill_JuryRig_Helper', OwnerPawn);
	}
}

static function ZTUpgrade_Skill_JuryRig_Helper GetHelper(Pawn OwnerPawn)
{
	local ZTUpgrade_Skill_JuryRig_Helper UPG;

	if (KFPawn_Human(OwnerPawn) != None)
	{
		foreach OwnerPawn.ChildActors(class'ZTUpgrade_Skill_JuryRig_Helper', UPG)
		{
			return UPG;
		}

		UPG = OwnerPawn.Spawn(class'ZTUpgrade_Skill_JuryRig_Helper', OwnerPawn);
	}

	return UPG;
}

static simulated function DeleteHelperClass(Pawn OwnerPawn)
{
	local ZTUpgrade_Skill_JuryRig_Helper UPG;

	if (OwnerPawn != None)
	{
		foreach OwnerPawn.ChildActors(class'ZTUpgrade_Skill_JuryRig_Helper', UPG)
		{
			UPG.Destroy();
		}
	}
}

