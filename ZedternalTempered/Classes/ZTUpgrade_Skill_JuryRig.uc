	UpgradeDescription(1)="<font color=\"#FFD700\">Jury Rig:</font> First <font color=\"#FFFFFF\">5 shots</font> after switching weapons deal <font color=\"#FF4444\">+30%</font> <font color=\"#87CEEB\">damage</font>"

	UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_JuryRig'
