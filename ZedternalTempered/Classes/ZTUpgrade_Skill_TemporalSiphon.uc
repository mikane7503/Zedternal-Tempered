// ===================================================================
// ZTUpgrade_Skill_TemporalSiphon - Chrono-Vampirism
// Theme: Feed on temporal energy released by dying enemies during
//        ZED Time. Melee kills restore more health.
// Hooks: AddVampireHealth (ZED Time gated via KFPC.WorldInfo)
// ===================================================================
class ZTUpgrade_Skill_TemporalSiphon extends ZTUpgrade_Skill config(ZedternalUnlimited);

var config array<int> MeleeVampire;
var config array<int> WeapVampire;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.WeapVampire[0] = 2;
		default.WeapVampire[1] = 4;
		default.MeleeVampire[0] = 4;
		default.MeleeVampire[1] = 8;

		// BEGIN TEMPERED INI DEFAULTS (generated; do not edit by hand)
		default.MeleeVampire.Length = 2;
		default.MeleeVampire[0] = 4;
		default.MeleeVampire[1] = 8;
		default.WeapVampire.Length = 2;
		default.WeapVampire[0] = 2;
		default.WeapVampire[1] = 4;
		// END TEMPERED INI DEFAULTS
		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


static function AddVampireHealth(out int InHealth, int DefaultHealth, int upgLevel, KFPlayerController KFPC, class<DamageType> DT)
{
	// Only active during ZED Time
	if (KFPC == None || KFPC.WorldInfo == None || KFPC.WorldInfo.TimeDilation >= 1.0)
		return;

	if (DT != None && static.IsMeleeDamageType(DT))
		InHealth += default.MeleeVampire[upgLevel - 1];
	else
		InHealth += default.WeapVampire[upgLevel - 1];
}

defaultproperties
{

    // --- Localization (auto-generated by mass_localize_dk_upgrades.py) ---
    // Strings live in KFGame/Localization/<lang>/ZedternalTempered.<langext>
    // Section: [ZTUpgrade_Skill_TemporalSiphon]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalTempered"
    LocSection="ZTUpgrade_Skill_TemporalSiphon"

	UpgradeName="Temporal Siphon"
	upgradeDescription(0)="During <font color=\"#9632ff\">ZED Time</font>, kills heal <font color=\"#d8b0ff\">2</font> HP. <font color=\"#FFFFFF\">Melee</font> kills heal <font color=\"#d8b0ff\">4</font> HP instead."
	upgradeDescription(1)="During <font color=\"#9632ff\">ZED Time</font>, kills heal <font color=\"#d8b0ff\">4</font> HP. <font color=\"#FFFFFF\">Melee</font> kills heal <font color=\"#d8b0ff\">8</font> HP instead."
	UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_TemporalSiphon'
	UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_TemporalSiphon_Deluxe'

	Name="Default__ZTUpgrade_Skill_TemporalSiphon"
}
