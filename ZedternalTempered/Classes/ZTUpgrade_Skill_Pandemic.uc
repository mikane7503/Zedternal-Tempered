class ZTUpgrade_Skill_Pandemic extends ZTUpgrade_Skill config(ZedternalUnlimited);

var const class<KFDamageType> WMDT;

var config float PandemicProbability;
var config float PandemicDamageCap;
var config array<float> DamageFactor;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.PandemicProbability = 1.0f;
		default.PandemicDamageCap = 75.0f;
		default.DamageFactor[0] = 0.2f;
		default.DamageFactor[1] = 0.5f;

		// BEGIN TEMPERED INI DEFAULTS (generated; do not edit by hand)
		default.PandemicProbability = 0.500000f;
		default.PandemicDamageCap = 50.000000f;
		default.DamageFactor.Length = 2;
		default.DamageFactor[0] = 0.200000f;
		default.DamageFactor[1] = 0.500000f;
		// END TEMPERED INI DEFAULTS
		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


static function ModifyDamageGiven(out int InDamage, int DefaultDamage, int upgLevel, optional Actor DamageCauser, optional KFPawn_Monster MyKFPM, optional KFPlayerController DamageInstigator, optional class<KFDamageType> DamageType, optional int HitZoneIdx, optional KFWeapon MyKFW)
{
	if (DamageType != None && DamageType != default.WMDT && DamageInstigator != None && MyKFPM != None && !MyKFPM.bIsPoisoned && FRand() < (float(DefaultDamage) * default.PandemicProbability / default.PandemicDamageCap))
	{
		//add poison effects on zed
		MyKFPM.ApplyDamageOverTime(int(float(DefaultDamage) * default.DamageFactor[upgLevel - 1]), DamageInstigator, default.WMDT);
	}
}

defaultproperties
{
    // --- Localization (auto-generated by mass_localize_dk_upgrades.py) ---
    // Strings live in KFGame/Localization/<lang>/ZedternalTempered.<langext>
    // Section: [ZTUpgrade_Skill_Pandemic]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalTempered"
    LocSection="ZTUpgrade_Skill_Pandemic"

	WMDT=class'ZedternalReborn.WMDT_AcidicRounds_DoT'
    UpgradeName="Pandemic"
	upgradeDescription(0)="Your weapons spread a dangerous <font color=\"#15d7fa\">Poison</font> to all ZEDs."
	upgradeDescription(1)="Your weapons spread a lethal <font color=\"#15d7fa\">Poison</font> to all ZEDs."
	UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_Pandemic'
	UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_Pandemic_Deluxe'

	Name="Default__ZTUpgrade_Skill_Pandemic"
}

