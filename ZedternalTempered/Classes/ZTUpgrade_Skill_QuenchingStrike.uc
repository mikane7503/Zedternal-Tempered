// ===================================================================
// ZTUpgrade_Skill_QuenchingStrike — Artificer Skill
//
// "The first 3 shots of each magazine deal bonus damage.
//  Heat, shape, quench — the forge cycle yields maximum hardness."
//
// Works with ALL weapons (not Reforged-only).
//
// Normal:  +25% damage on first 3 shots of magazine
// Deluxe:  +50% damage on first 3 shots of magazine
//
// Hook: ModifyDamageGiven
// Helper: None
//
// IMPLEMENTATION: By the time ModifyDamageGiven fires, the shot's
// ammo has already been consumed. So first shot = AmmoCount[0]
// equals MagazineCapacity[0] - 1. We check if we're within the
// first 3 shots: AmmoCount[0] >= MagazineCapacity[0] - 3.
//
// Edge cases:
//   - Small magazines (<=3): every shot gets the bonus — intentional,
//     since every shot IS one of the first 3.
//   - Melee weapons: no AmmoCount, safely skipped via null checks.
// ===================================================================
class ZTUpgrade_Skill_QuenchingStrike extends ZTUpgrade_Skill config(ZedternalUnlimited);

var config array<float> BonusDamage;
var config int BonusShotCount;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.BonusDamage[0] = 0.25f;
		default.BonusDamage[1] = 0.50f;
		default.BonusShotCount = 3;

		// BEGIN TEMPERED INI DEFAULTS (generated; do not edit by hand)
		default.BonusDamage.Length = 2;
		default.BonusDamage[0] = 0.250000f;
		default.BonusDamage[1] = 0.500000f;
		default.BonusShotCount = 3;
		// END TEMPERED INI DEFAULTS
		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


static function ModifyDamageGiven(out int InDamage, int DefaultDamage, int upgLevel, optional Actor DamageCauser, optional KFPawn_Monster MyKFPM, optional KFPlayerController DamageInstigator, optional class<KFDamageType> DamageType, optional int HitZoneIdx, optional KFWeapon MyKFW)
{
    if (MyKFW == None)
        return;

    // MagazineCapacity[0] is primary fire mode max ammo in magazine
    // AmmoCount[0] is current ammo remaining in magazine (already decremented)
    // First 3 shots: AmmoCount >= MagCap - BonusShotCount
    if (MyKFW.MagazineCapacity[0] > 0 && MyKFW.AmmoCount[0] >= (MyKFW.MagazineCapacity[0] - default.BonusShotCount))
        InDamage += Round(float(DefaultDamage) * default.BonusDamage[upgLevel - 1]);
}

defaultproperties
{

    // --- Localization (auto-generated by mass_localize_dk_upgrades.py) ---
    // Strings live in KFGame/Localization/<lang>/ZedternalTempered.<langext>
    // Section: [ZTUpgrade_Skill_QuenchingStrike]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalTempered"
    LocSection="ZTUpgrade_Skill_QuenchingStrike"

    UpgradeName="Quenching Strike"
    UpgradeDescription(0)="The <font color=\"#FFFFFF\">first 3 shots</font> of each magazine deal <font color=\"#FFFFFF\">+25%</font> <font color=\"#FFD700\">bonus damage</font>"
    UpgradeDescription(1)="The <font color=\"#FFFFFF\">first 3 shots</font> of each magazine deal <font color=\"#FFFFFF\">+50%</font> <font color=\"#FFD700\">bonus damage</font>"
    UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_QuenchingStrike'
    UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_QuenchingStrike_Deluxe'

    Name="Default__ZTUpgrade_Skill_QuenchingStrike"
}
