	upgradeDescription(0)="You take <font color=\"#ff3399\">5%</font> less <font color=\"#66cc00\">Damage</font> while you have <font color=\"#be4d25\">no armor</font> and you cannot be grabbed by Clots."
	upgradeDescription(1)="You take <font color=\"#ff3399\">10%</font> less <font color=\"#66cc00\">Damage</font> while you have <font color=\"#be4d25\">no armor</font> and you cannot be grabbed by Clots."
	UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_ImpenetrableSkin'
