class ZTUpgrade_Skill_HippocraticOath extends ZTUpgrade_Skill config(ZedternalUnlimited);

var config array<float> Healing;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.Healing[0] = 0.5f;
		default.Healing[1] = 1.0f;

		// BEGIN TEMPERED INI DEFAULTS (generated; do not edit by hand)
		default.Healing.Length = 2;
		default.Healing[0] = 0.250000f;
		default.Healing[1] = 0.500000f;
		// END TEMPERED INI DEFAULTS
		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


static function ModifyHealAmount(out float InHealAmount, float DefaultHealAmount, int upgLevel)
{
	InHealAmount += DefaultHealAmount * (default.Healing[upgLevel - 1]);
}

