Class ZTUpgrade_Perk_Pyrokinetic extends ZTUpgrade_Perk
	config(ZedternalUnlimited);

var const class<KFDamageType> DKDT;

var config float Chance;
var config float DamageFactor;
var config float Damage;
var config float BurnDuration;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.Chance = 0.01f;
		default.DamageFactor = 0.10f;
		default.Damage = 0.10f;
		default.BurnDuration = 0.50f;

		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}

	// v2: Thermite proc chance 1%->2% per level (max 20%->40% at L20). Mirrors the
	// sibling Venomancer change -- the base 1%/level left the perk's signature burn
	// landing on only ~1 in 5 hits at max investment; with the long Burn DoT this is
	// an uptime/feel bump, not a damage spike. PerkBonus[0].incValue bumped to 2 to
	// keep the displayed chance in sync. Revert: Chance back to 0.01 + incValue to 1.
	if (default.MODEVERSION < 2)
	{
		default.Chance = 0.02f;

		// BEGIN TEMPERED INI DEFAULTS (generated; do not edit by hand)
		default.Chance = 0.010000f;
		default.DamageFactor = 0.012500f;
		default.Damage = 0.012500f;
		default.BurnDuration = 0.250000f;
		// END TEMPERED INI DEFAULTS
		default.MODEVERSION = 2;
		static.StaticSaveConfig();
	}
}



static function ModifyDamageGiven(out int InDamage, int DefaultDamage, int upgLevel, optional Actor DamageCauser, optional KFPawn_Monster MyKFPM, optional KFPlayerController DamageInstigator, optional class<KFDamageType> DamageType, optional int HitZoneIdx, optional KFWeapon MyKFW)
{
	if (DamageType != None && DamageType != default.DKDT && DamageInstigator != None && MyKFPM != None && (FRand() <= (default.Chance * upgLevel)))
    {
	  MyKFPM.ApplyDamageOverTime(int(float(DefaultDamage) * default.DamageFactor * upgLevel), DamageInstigator, default.DKDT);
	}
	
    if (DamageType != None && ClassIsChildOf(DamageType, class'KFDT_Fire'))
	{
		InDamage += Round(float(DefaultDamage) * default.Damage * upgLevel);
	}
}

static function ModifyDoTScaler(out float InDoTScaler, float DefaultDotScaler, int upgLevel, optional class<KFDamageType> KFDT, optional bool bNapalmInfected)
{
	InDoTScaler += DefaultDotScaler * default.BurnDuration * upgLevel;
}



