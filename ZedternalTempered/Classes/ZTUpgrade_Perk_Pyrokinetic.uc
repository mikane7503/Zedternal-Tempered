    LocalizeDescriptionLineCount=3

	DKDT=class'ZedternalTempered.ZTDT_Thermite'
    UpgradeName="Pyrokinetic"
	upgradeDescription(0)="All weapons have a <font color=\"#77d914\">%x%%</font> chance to fire <font color=\"#ffa000\">Thermite Rounds</font>."
	upgradeDescription(1)="Your <font color=\"#ff1f0f\">Burn</font> effects deal <font color=\"#77d914\">%x%%</font> more damage."
	upgradeDescription(2)="Your <font color=\"#ff1f0f\">Burn</font> effects last <font color=\"#77d914\">%x%%</font> longer."
	PerkBonus(0)=(baseValue=0, incValue=1, maxValue=-1)
	PerkBonus(1)=(baseValue=0, incValue=1, maxValue=-1)
	PerkBonus(2)=(baseValue=0, incValue=25, maxValue=-1)
