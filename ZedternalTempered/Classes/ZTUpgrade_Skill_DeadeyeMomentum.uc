    // --- Localization (auto-generated by mass_localize_dk_upgrades.py) ---
    // Strings live in KFGame/Localization/<lang>/ZedternalTempered.<langext>
    // Section: [ZTUpgrade_Skill_DeadeyeMomentum]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalTempered"
    LocSection="ZTUpgrade_Skill_DeadeyeMomentum"

	UpgradeName="Deadeye Momentum"
	upgradeDescription(0)="Consecutive <font color=\"#66cc00\">Headshot Kills</font> grant <font color=\"#ff3399\">+5%</font> <font color=\"#66cc00\">Damage</font> per stack (max 5). <font color=\"#be4d25\">Non-headshot kills reset the streak</font>."
	upgradeDescription(1)="Consecutive <font color=\"#66cc00\">Headshot Kills</font> grant <font color=\"#ff3399\">+10%</font> <font color=\"#66cc00\">Damage</font> per stack (max 5). <font color=\"#be4d25\">Non-headshot kills reset the streak</font>."
	UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_DeadeyeMomentum'
	UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_DeadeyeMomentum_Deluxe'
	Name="Default__ZTUpgrade_Skill_DeadeyeMomentum"
}
