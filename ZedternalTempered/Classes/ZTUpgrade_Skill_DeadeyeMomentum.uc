class ZTUpgrade_Skill_DeadeyeMomentum extends ZTUpgrade_Skill config(ZedternalUnlimited);

var config array<float> DamagePerStack;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.DamagePerStack[0] = 0.10f;
		default.DamagePerStack[1] = 0.20f;

		// BEGIN TEMPERED INI DEFAULTS (generated; do not edit by hand)
		default.DamagePerStack.Length = 2;
		default.DamagePerStack[0] = 0.050000f;
		default.DamagePerStack[1] = 0.100000f;
		// END TEMPERED INI DEFAULTS
		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


static function ModifyDamageGiven(out int InDamage, int DefaultDamage, int upgLevel, optional Actor DamageCauser, optional KFPawn_Monster MyKFPM, optional KFPlayerController DamageInstigator, optional class<KFDamageType> DamageType, optional int HitZoneIdx, optional KFWeapon MyKFW)
{
	local ZTUpgrade_Skill_DeadeyeMomentum_Helper UPG;

	if (DamageInstigator != None && DamageInstigator.Pawn != None && MyKFPM != None)
	{
		UPG = GetHelper(KFPawn(DamageInstigator.Pawn));
		if (UPG != None)
		{
			// Apply current streak bonus
			if (UPG.Streak > 0)
				InDamage += Round(float(DefaultDamage) * default.DamagePerStack[upgLevel - 1] * float(UPG.Streak));

			// On kill: headshot increments streak, body shot resets it
			if ((MyKFPM.Health - InDamage) <= 0)
			{
				if (HitZoneIdx == HZI_HEAD)
					UPG.IncreaseCounter();
				else
					UPG.ResetCounter();
			}
		}
	}
}

static function ZTUpgrade_Skill_DeadeyeMomentum_Helper GetHelper(KFPawn OwnerPawn)
{
	local ZTUpgrade_Skill_DeadeyeMomentum_Helper UPG;

	if (KFPawn_Human(OwnerPawn) != None)
	{
		foreach OwnerPawn.ChildActors(class'ZTUpgrade_Skill_DeadeyeMomentum_Helper', UPG)
		{
			return UPG;
		}

		//Should have one
		UPG = OwnerPawn.Spawn(class'ZTUpgrade_Skill_DeadeyeMomentum_Helper', OwnerPawn);
	}

	return UPG;
}

static simulated function DeleteHelperClass(Pawn OwnerPawn)
{
	local ZTUpgrade_Skill_DeadeyeMomentum_Helper UPG;

	if (OwnerPawn != None)
	{
		foreach OwnerPawn.ChildActors(class'ZTUpgrade_Skill_DeadeyeMomentum_Helper', UPG)
		{
			UPG.Destroy();
		}
	}
}

defaultproperties
