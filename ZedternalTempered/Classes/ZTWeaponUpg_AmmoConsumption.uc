class ZTWeaponUpg_AmmoConsumption extends ZTUpgrade_Weapon abstract config(ZedternalUnlimited);

var config float ConsumptionBonus;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 2)
	{
		default.ConsumptionBonus = 0.1f;
		// BEGIN TEMPERED INI DEFAULTS (generated; do not edit by hand)
		default.ConsumptionBonus = 0.100000f;
		// END TEMPERED INI DEFAULTS
		default.MODEVERSION = 2;
		static.StaticSaveConfig();
	}
}

static function bool IsUpgradeCompatible(class<KFWeapon> KFW)
{
	if (class<KFWeap_AssaultRifle_LazerCutter>(KFW) != None)
		return False;
	if (class<KFWeap_FlameBase>(KFW) != None)
		return True;
	return False;
}

static simulated function ModifyRateOfFire(out float InRate, float DefaultRate, int upgLevel, KFWeapon KFW)
{
	local float Val;
	Val = default.ConsumptionBonus;
	if (Val <= 0.f) Val = 0.1f;
	InRate = DefaultRate / (DefaultRate / InRate - Val * upgLevel);
}

defaultproperties
{
    // --- Localization (auto-generated by mass_localize_dk_upgrades.py) ---
    // Strings live in KFGame/Localization/<lang>/ZedternalTempered.<langext>
    // Section: [ZTWeaponUpg_AmmoConsumption]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalTempered"
    LocSection="ZTWeaponUpg_AmmoConsumption"

	UpgradeName="Fuel Efficiency"
	UpgradeDescription(0)="Reduces <font color=\"#15d7fa\">ammo consumption</font> by <font color=\"#77d914\">%x%%</font> per level. (flame weapons)"
	WeaponBonus=(baseValue=0, incValue=10, maxValue=-1)
	Name="Default__ZTWeaponUpg_AmmoConsumption"
}
