class ZTUpgrade_Skill_Elmo extends ZTUpgrade_Skill config(ZedternalUnlimited);

var config array<float> Damage;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.Damage[0] = 0.50f;
		default.Damage[1] = 1.00f;

		// BEGIN TEMPERED INI DEFAULTS (generated; do not edit by hand)
		default.Damage.Length = 2;
		default.Damage[0] = 0.300000f;
		default.Damage[1] = 0.500000f;
		// END TEMPERED INI DEFAULTS
		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


static function ModifyDamageGiven(out int InDamage, int DefaultDamage, int upgLevel, optional Actor DamageCauser, optional KFPawn_Monster MyKFPM, optional KFPlayerController DamageInstigator, optional class<KFDamageType> DamageType, optional int HitZoneIdx, optional KFWeapon MyKFW)
{
	// Standard/Deluxe values are already absolute (0.50 / 1.00), so we should
	// NOT multiply by upgLevel. Old code did `... * upgLevel` which doubled
	// the deluxe tier (1.00 * 2 = 200% instead of the advertised 100%).
	if (DamageType != None && (ClassIsChildOf(DamageType, class'KFDT_Fire')))
		InDamage += Round(float(DefaultDamage) * default.Damage[upgLevel - 1]);
}

defaultproperties
{
    // --- Localization (auto-generated by mass_localize_dk_upgrades.py) ---
    // Strings live in KFGame/Localization/<lang>/ZedternalTempered.<langext>
    // Section: [ZTUpgrade_Skill_Elmo]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalTempered"
    LocSection="ZTUpgrade_Skill_Elmo"

    UpgradeName="Elmo"
	UpgradeDescription(0)="Increase <font color=\"#ff3399\">Fire Damage</font> of weapons by <font color=\"#66cc00\">30%</font>."
	UpgradeDescription(1)="Increase <font color=\"#ff3399\">Fire Damage</font> of weapons by <font color=\"#66cc00\">50%</font>."
	UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_Elmo'
	UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_Elmo_Deluxe'

	Name="Default__ZTUpgrade_Skill_Elmo"
}