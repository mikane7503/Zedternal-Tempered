    UpgradeDescription(1)="<font color=\"#8B008B\">Serpentine Reflexes (Deluxe):</font> <font color=\"#FFFFFF\">+100%</font> <font color=\"#66FF66\">weapon switch speed</font> + <font color=\"#FFFFFF\">+25%</font> <font color=\"#66FF66\">reload speed</font> <font color=\"#FFAA00\">when moving</font>."
    
