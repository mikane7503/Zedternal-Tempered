class ZTUpgrade_Skill_SerpentineReflexes extends ZTUpgrade_Skill config(ZedternalUnlimited);

var config array<float> WeaponSwitchBonus;
var config array<float> ReloadSpeedBonus;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.WeaponSwitchBonus[0] = 0.5f;
		default.WeaponSwitchBonus[1] = 1.0f;
		default.ReloadSpeedBonus[0] = 0.25f;
		default.ReloadSpeedBonus[1] = 0.5f;

		// BEGIN TEMPERED INI DEFAULTS (generated; do not edit by hand)
		default.WeaponSwitchBonus.Length = 2;
		default.WeaponSwitchBonus[0] = 0.500000f;
		default.WeaponSwitchBonus[1] = 1.000000f;
		default.ReloadSpeedBonus.Length = 2;
		default.ReloadSpeedBonus[0] = 0.125000f;
		default.ReloadSpeedBonus[1] = 0.250000f;
		// END TEMPERED INI DEFAULTS
		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


static simulated function ModifyWeaponSwitchTime(out float InSwitchTime, float DefaultSwitchTime, int upgLevel, KFWeapon KFW)
{
    local KFPawn OwnerPawn;
    local bool bIsMoving;
    
    if (KFW != None && KFW.Owner != None)
    {
        OwnerPawn = KFPawn(KFW.Owner);
        if (OwnerPawn != None)
        {
            // Check if player is moving (velocity magnitude > small threshold)
            bIsMoving = (VSize(OwnerPawn.Velocity) > 50.0f);
            
            if (bIsMoving)
            {
                // Apply weapon switch speed bonus when moving
                InSwitchTime = DefaultSwitchTime / (DefaultSwitchTime / InSwitchTime + default.WeaponSwitchBonus[upgLevel - 1]);
            }
        }
    }
}

static simulated function GetReloadRateScale(out float InReloadRateScale, int upgLevel, KFWeapon KFW, KFPawn OwnerPawn)
{
    local bool bIsMoving;
    
    if (OwnerPawn != None)
    {
        // Check if player is moving
        bIsMoving = (VSize(OwnerPawn.Velocity) > 50.0f);
        
        if (bIsMoving)
        {
            // Apply reload speed bonus when moving
            InReloadRateScale = 1.0f / (1.0f / InReloadRateScale + default.ReloadSpeedBonus[upgLevel - 1]);
        }
    }
}

