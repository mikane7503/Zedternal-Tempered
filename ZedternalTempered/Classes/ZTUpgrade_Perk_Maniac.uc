Class ZTUpgrade_Perk_Maniac extends ZTUpgrade_Perk
	config(ZedternalUnlimited);

var config float GrenadeDamage, ReloadRate;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.GrenadeDamage = 0.40f;
		default.ReloadRate = 0.10f;

		// BEGIN TEMPERED INI DEFAULTS (generated; do not edit by hand)
		default.GrenadeDamage = 0.200000f;
		default.ReloadRate = 0.025000f;
		// END TEMPERED INI DEFAULTS
		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


static function ModifyDamageGiven(out int InDamage, int DefaultDamage, int upgLevel, optional Actor DamageCauser, optional KFPawn_Monster MyKFPM, optional KFPlayerController DamageInstigator, optional class<KFDamageType> DamageType, optional int HitZoneIdx, optional KFWeapon MyKFW)
{
	if (DamageType != None && (ClassIsChildOf(DamageType, class'KFDT_Explosive') || static.IsGrenadeDTAdvance(DamageType, DamageInstigator)))
	InDamage += Round(float(DefaultDamage) * default.GrenadeDamage * upgLevel);
}

static simulated function GetReloadRateScalePassive(out float reloadRateFactor, int upgLevel)
{
	reloadRateFactor = 1.0f / (1.0f / reloadRateFactor + default.ReloadRate * upgLevel);
}


defaultproperties
{
	UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Perks.UI_Perk_Maniac_Rank_0'
    // --- Localization (auto-generated by mass_localize_dk_upgrades.py) ---
    // Strings live in KFGame/Localization/<lang>/ZedternalTempered.<langext>
    // Section: [ZTUpgrade_Perk_Maniac]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalTempered"
    LocSection="ZTUpgrade_Perk_Maniac"
    LocalizeDescriptionLineCount=2

	UpgradeName="Maniac"
	upgradeDescription(0)="Increase all <font color=\"#15d7fa\">Grenade Damage</font> by <font color=\"#77d914\">%x%%</font>."
	upgradeDescription(1)="Increase your <font color=\"#15d7fa\">Reload Speed</font> for all weapons by <font color=\"#77d914\">%x%%</font>."
	PerkBonus(0)=(baseValue=0, incValue=20, maxValue=-1)
	PerkBonus(1)=(baseValue=0, incValue=3, maxValue=-1)

	// Legacy (hand-made) artwork icons

	Name="Default__ZTUpgrade_Perk_Maniac"
}