    LocSection="ZTUpgrade_Skill_TemporalRupture"

	UpgradeName="Temporal Rupture"
	upgradeDescription(0)="<font color=\"#9632ff\">Temporal stress ruptures corpses</font>. Enemies killed have a <font color=\"#d8b0ff\">4%</font> chance to explode with <font color=\"#FFFFFF\">shrapnel damage</font>."
	upgradeDescription(1)="<font color=\"#9632ff\">Temporal stress ruptures corpses</font>. Enemies killed have a <font color=\"#d8b0ff\">7%</font> chance to explode with <font color=\"#FFFFFF\">shrapnel damage</font>."
	UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_TemporalRupture'
	UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_TemporalRupture_Deluxe'

	Name="Default__ZTUpgrade_Skill_TemporalRupture"
}
