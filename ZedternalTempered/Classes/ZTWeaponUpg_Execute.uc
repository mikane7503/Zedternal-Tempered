    // Section: [ZTWeaponUpg_Execute]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalTempered"
    LocSection="ZTWeaponUpg_Execute"

	UpgradeName="Execute"
	UpgradeDescription(0)="Deals <font color=\"#00CCFF\">+%x%%</font> additional damage to enemies below <font color=\"#6B0099\">35% HP</font> per level."
	WeaponBonus=(baseValue=0, incValue=5, maxValue=-1)
	RequiredSkillClassPath="ZedternalTempered.ZTUpgrade_Skill_Execute"
	bRequiresDeluxe=False
	Name="Default__ZTWeaponUpg_Execute"
}
