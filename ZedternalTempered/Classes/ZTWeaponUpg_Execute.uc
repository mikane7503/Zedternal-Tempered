// Execute weapon upgrade — base tier
// +5% bonus damage per level to zeds below 35% HP.
// L1=5%, L5=25%, L10=50%
// Requires skill: ZTUpgrade_Skill_Execute (non-deluxe)
class ZTWeaponUpg_Execute extends ZTWeaponUpg_HollowBase abstract config(ZedternalUnlimited);

var config float DamageBonus;
var config float ExecuteThreshold;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.DamageBonus = 0.05f;
		default.ExecuteThreshold = 0.35f;
		// BEGIN TEMPERED INI DEFAULTS (generated; do not edit by hand)
		default.DamageBonus = 0.050000f;
		default.ExecuteThreshold = 0.350000f;
		// END TEMPERED INI DEFAULTS
		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}

static function bool IsUpgradeCompatible(class<KFWeapon> KFW)
{
	return True;
}

static function ModifyDamageGiven(out int InDamage, int DefaultDamage, int upgLevel, optional Actor DamageCauser, optional KFPawn_Monster MyKFPM, optional KFPlayerController DamageInstigator, optional class<KFDamageType> DamageType, optional int HitZoneIdx, optional KFWeapon MyKFW)
{
	if (MyKFPM == None || MyKFPM.HealthMax <= 0)
		return;

	if (float(MyKFPM.Health) / float(MyKFPM.HealthMax) > default.ExecuteThreshold)
		return;

	InDamage += Round(float(DefaultDamage) * default.DamageBonus * upgLevel);
}

defaultproperties
{
    // --- Localization (auto-generated by mass_localize_dk_upgrades.py) ---
