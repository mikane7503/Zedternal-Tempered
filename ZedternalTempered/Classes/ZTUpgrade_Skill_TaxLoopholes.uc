    bShouldLocalize=True
    LocPackage="ZedternalTempered"
    LocSection="ZTUpgrade_Skill_TaxLoopholes"

    UpgradeName="Tax Loopholes"
    
    upgradeDescription(0)="Every <font color=\"#ff6600\">6000 dosh spent</font>, get <font color=\"#00ff00\">150 dosh</font> tax refund."
    upgradeDescription(1)="Every <font color=\"#ff6600\">6000 dosh spent</font>, get <font color=\"#00ff00\">300 dosh</font> tax refund."
    
    UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_TaxLoopholes'
    UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_TaxLoopholes_Deluxe'

    Name="Default__ZTUpgrade_Skill_TaxLoopholes"
}