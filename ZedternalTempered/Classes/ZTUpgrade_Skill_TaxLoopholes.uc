class ZTUpgrade_Skill_TaxLoopholes extends ZTUpgrade_Skill config(ZedternalUnlimited);

var config array<int> TaxRefundAmount;
var config int SpendingThreshold;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.TaxRefundAmount[0] = 150;
		default.TaxRefundAmount[1] = 300;
		default.SpendingThreshold = 5000;

		// BEGIN TEMPERED INI DEFAULTS (generated; do not edit by hand)
		default.TaxRefundAmount.Length = 2;
		default.TaxRefundAmount[0] = 150;
		default.TaxRefundAmount[1] = 300;
		default.SpendingThreshold = 6000;
		// END TEMPERED INI DEFAULTS
		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


static simulated function InitiateWeapon(int upgLevel, KFWeapon KFW, KFPawn OwnerPawn)
{
    local ZTUpgrade_Skill_TaxLoopholes_Helper UPG;
    local bool bFound;

    if (KFPawn_Human(OwnerPawn) != None && OwnerPawn.Role == Role_Authority)
    {
        bFound = False;
        foreach OwnerPawn.ChildActors(class'ZTUpgrade_Skill_TaxLoopholes_Helper', UPG)
        {
            bFound = True;
            break;
        }

        if (!bFound)
        {
            UPG = OwnerPawn.Spawn(class'ZTUpgrade_Skill_TaxLoopholes_Helper', OwnerPawn);
            UPG.bDeluxe = (upgLevel > 1);
            UPG.UpgradeLevel = upgLevel;
        }
    }
}

static simulated function DeleteHelperClass(Pawn OwnerPawn)
{
    local ZTUpgrade_Skill_TaxLoopholes_Helper UPG;

    if (OwnerPawn != None)
    {
        foreach OwnerPawn.ChildActors(class'ZTUpgrade_Skill_TaxLoopholes_Helper', UPG)
        {
            UPG.Destroy();
        }
    }
}

defaultproperties
