// Void Sustain weapon upgrade — base tier
// +2% chance per level on kill to refill magazine.
// L1=2%, L5=10%, L10=20%
class ZTWeaponUpg_VoidSustain extends ZTWeaponUpg_HollowBase abstract config(ZedternalUnlimited);

var config float RefillChancePerLevel;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.RefillChancePerLevel = 0.02f;
		// BEGIN TEMPERED INI DEFAULTS (generated; do not edit by hand)
		default.RefillChancePerLevel = 0.020000f;
		// END TEMPERED INI DEFAULTS
		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}

static function bool IsUpgradeCompatible(class<KFWeapon> KFW)
{
	return True;
}

static function ModifyDamageGiven(out int InDamage, int DefaultDamage, int upgLevel, optional Actor DamageCauser, optional KFPawn_Monster MyKFPM, optional KFPlayerController DamageInstigator, optional class<KFDamageType> DamageType, optional int HitZoneIdx, optional KFWeapon MyKFW)
{
	local float Chance;

	if (MyKFW == None || MyKFPM == None)
		return;

	// Only on lethal hits
	if (InDamage < MyKFPM.Health)
		return;

	Chance = default.RefillChancePerLevel * upgLevel;
	if (FRand() >= Chance)
		return;

	// Refill primary magazine
	if (MyKFW.MagazineCapacity[0] > 0)
		MyKFW.AmmoCount[0] = MyKFW.MagazineCapacity[0];
}

defaultproperties
{
    // --- Localization (auto-generated by mass_localize_dk_upgrades.py) ---
    // Strings live in KFGame/Localization/<lang>/ZedternalTempered.<langext>
    // Section: [ZTWeaponUpg_VoidSustain]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalTempered"
    LocSection="ZTWeaponUpg_VoidSustain"

	UpgradeName="Void Sustain"
	UpgradeDescription(0)="<font color=\"#00CCFF\">%x%%</font> chance on kill to <font color=\"#6B0099\">instantly refill your magazine</font> per level."
	WeaponBonus=(baseValue=0, incValue=2, maxValue=-1)
	RequiredSkillClassPath="ZedternalTempered.ZTUpgrade_Skill_VoidSustain"
	bRequiresDeluxe=False
	Name="Default__ZTWeaponUpg_VoidSustain"
}
