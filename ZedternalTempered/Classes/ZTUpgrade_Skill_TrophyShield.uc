    // Strings live in KFGame/Localization/<lang>/ZedternalTempered.<langext>
    // Section: [ZTUpgrade_Skill_TrophyShield]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalTempered"
    LocSection="ZTUpgrade_Skill_TrophyShield"

    UpgradeName="Trophy Shield"
    UpgradeDescription(0)="<font color=\"#FFD700\">Trophy Shield:</font> <font color=\"#FFFFFF\">8%</font> <font color=\"#87CEEB\">damage reduction</font> with 3+ trophies. <font color=\"#FF6666\">Grab immunity</font> at 5+ trophies"
    UpgradeDescription(1)="<font color=\"#FFD700\">Trophy Shield:</font> <font color=\"#FFFFFF\">16%</font> <font color=\"#87CEEB\">damage reduction</font> with 3+ trophies. <font color=\"#FF6666\">Grab immunity</font> at 5+ trophies"
    UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_TrophyShield'
    UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_TrophyShield_Deluxe'

    Name="Default__ZTUpgrade_Skill_TrophyShield"
}
