// ===================================================================
// ZTUpgrade_Skill_TrophyShield - Trophies as Armor
//
// Gain damage reduction while holding 3+ trophies.
// Gain clot grab immunity at 5+ trophies.
// Normal: 16% DR at 3+ | Deluxe: 25% DR at 3+
//
// Tension: Hold trophies for defense vs. complete sets for bonuses.
// Scales in stacking phase (higher counts = always active).
// ===================================================================
class ZTUpgrade_Skill_TrophyShield extends ZTUpgrade_Skill config(ZedternalUnlimited);

var config array<float> DamageReduction;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.DamageReduction[0] = 0.15f;
		default.DamageReduction[1] = 0.25f;

		// BEGIN TEMPERED INI DEFAULTS (generated; do not edit by hand)
		default.DamageReduction.Length = 2;
		default.DamageReduction[0] = 0.080000f;
		default.DamageReduction[1] = 0.160000f;
		// END TEMPERED INI DEFAULTS
		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


static function ModifyDamageTaken(out int InDamage, int DefaultDamage, int upgLevel,
    KFPawn OwnerPawn, optional class<DamageType> DamageType,
    optional Controller InstigatedBy, optional KFWeapon MyKFW)
{
    local ZTUpgrade_Perk_Predator_Helper H;

    H = class'ZTUpgrade_Perk_Predator'.static.GetHelper(OwnerPawn);
    if (H != None && H.TotalTrophies >= 3)
    {
        InDamage -= Round(float(DefaultDamage) * default.DamageReduction[upgLevel - 1]);
        if (InDamage < 0)
            InDamage = 0;
    }
}

static function bool CanNotBeGrabbed(int upgLevel, KFPawn OwnerPawn)
{
    local ZTUpgrade_Perk_Predator_Helper H;

    H = class'ZTUpgrade_Perk_Predator'.static.GetHelper(OwnerPawn);
    if (H != None && H.TotalTrophies >= 5)
        return True;

    return False;
}

