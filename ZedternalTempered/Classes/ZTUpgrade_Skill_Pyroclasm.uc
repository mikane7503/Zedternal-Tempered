class ZTUpgrade_Skill_Pyroclasm extends ZTUpgrade_Skill config(ZedternalUnlimited);

// Pyroclasm: Every X seconds, your next fire or explosive attack deals bonus damage
// Normal: +50% damage, 30s cooldown | Deluxe: +125% damage, 18s cooldown

var config array<float> DamageBonus;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.DamageBonus[0] = 0.5f;
		default.DamageBonus[1] = 1.25f;

		// BEGIN TEMPERED INI DEFAULTS (generated; do not edit by hand)
		default.DamageBonus.Length = 2;
		default.DamageBonus[0] = 0.500000f;
		default.DamageBonus[1] = 1.250000f;
		// END TEMPERED INI DEFAULTS
		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


static function ModifyDamageGiven(out int InDamage, int DefaultDamage, int upgLevel, optional Actor DamageCauser, optional KFPawn_Monster MyKFPM, optional KFPlayerController DamageInstigator, optional class<KFDamageType> DamageType, optional int HitZoneIdx, optional KFWeapon MyKFW)
{
	local ZTUpgrade_Skill_Pyroclasm_Helper UPG;

	if (DamageType != None && DamageInstigator != None
		&& (ClassIsChildOf(DamageType, class'KFDT_Fire') || ClassIsChildOf(DamageType, class'KFDT_Explosive')))
	{
		UPG = GetHelper(KFPawn(DamageInstigator.Pawn), upgLevel);
		if (UPG != None && UPG.bEnable)
		{
			InDamage += Round(float(DefaultDamage) * default.DamageBonus[upgLevel - 1]);
			UPG.ConsumeCharge();
		}
	}
}

static function WaveEnd(int upgLevel, KFPlayerController KFPC)
{
	local ZTUpgrade_Skill_Pyroclasm_Helper UPG;

	if (KFPC.Pawn != None)
	{
		UPG = GetHelper(KFPawn(KFPC.Pawn), upgLevel);
		if (UPG != None)
			UPG.EndWaveReset();
	}
}

static function ZTUpgrade_Skill_Pyroclasm_Helper GetHelper(KFPawn OwnerPawn, int upgLevel)
{
	local ZTUpgrade_Skill_Pyroclasm_Helper UPG;

	if (KFPawn_Human(OwnerPawn) != None)
	{
		foreach OwnerPawn.ChildActors(class'ZTUpgrade_Skill_Pyroclasm_Helper', UPG)
		{
			return UPG;
		}

		// Should have one
		if (OwnerPawn.Role == Role_Authority)
		{
			UPG = OwnerPawn.Spawn(class'ZTUpgrade_Skill_Pyroclasm_Helper', OwnerPawn);
			UPG.StartTimer(upgLevel > 1);
		}
	}

	return UPG;
}

static simulated function DeleteHelperClass(Pawn OwnerPawn)
{
	local ZTUpgrade_Skill_Pyroclasm_Helper UPG;

	if (OwnerPawn != None)
	{
		foreach OwnerPawn.ChildActors(class'ZTUpgrade_Skill_Pyroclasm_Helper', UPG)
		{
			UPG.Destroy();
		}
	}
}

defaultproperties
{

    // --- Localization (auto-generated by mass_localize_dk_upgrades.py) ---
    // Strings live in KFGame/Localization/<lang>/ZedternalTempered.<langext>
    // Section: [ZTUpgrade_Skill_Pyroclasm]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalTempered"
    LocSection="ZTUpgrade_Skill_Pyroclasm"

	UpgradeName="Pyroclasm"
	UpgradeDescription(0)="Every <font color=\"#e85009\">30</font>s, your next <font color=\"#e80948\">fire or explosive</font> attack deals <font color=\"#e85009\">+50%</font> damage."
	UpgradeDescription(1)="Every <font color=\"#e85009\">18</font>s, your next <font color=\"#e80948\">fire or explosive</font> attack deals <font color=\"#e85009\">+125%</font> damage."
	UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_Pyroclasm'
	UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_Pyroclasm_Deluxe'

	Name="Default__ZTUpgrade_Skill_Pyroclasm"
}
