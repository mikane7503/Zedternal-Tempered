    UpgradeDescription(1)="Rifle hits on the same target build <font color=\"#ff3399\">Heat Stacks</font>. Each stack increases rifle damage by <font color=\"#ff3399\">12%</font> against that target. Max <font color=\"#ff3399\">8</font> stacks, lasting <font color=\"#ff3399\">6</font> seconds."
    
    UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_ThermalDrill'
