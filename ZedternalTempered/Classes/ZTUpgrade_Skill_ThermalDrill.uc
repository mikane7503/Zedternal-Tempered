class ZTUpgrade_Skill_ThermalDrill extends ZTUpgrade_Skill config(ZedternalUnlimited);

var config array<float> DamagePerStack;
var config array<int> MaxStacks;
var config array<float> StackDuration;

struct ThermalTarget
{
    var KFPawn_Monster Target;
    var int HeatStacks;
    var float LastHitTime;
};

var ZTUpgrade_Skill_ThermalDrill_Helper HelperClass;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.DamagePerStack[0] = 0.08f;
		default.DamagePerStack[1] = 0.12f;
		default.MaxStacks[0] = 5;
		default.MaxStacks[1] = 8;
		default.StackDuration[0] = 4.0f;
		default.StackDuration[1] = 6.0f;

		// BEGIN TEMPERED INI DEFAULTS (generated; do not edit by hand)
		default.DamagePerStack.Length = 2;
		default.DamagePerStack[0] = 0.080000f;
		default.DamagePerStack[1] = 0.120000f;
		default.MaxStacks.Length = 2;
		default.MaxStacks[0] = 5;
		default.MaxStacks[1] = 8;
		default.StackDuration.Length = 2;
		default.StackDuration[0] = 4.000000f;
		default.StackDuration[1] = 6.000000f;
		// END TEMPERED INI DEFAULTS
		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


static function ModifyDamageGiven(out int InDamage, int DefaultDamage, int upgLevel, optional Actor DamageCauser, optional KFPawn_Monster MyKFPM, optional KFPlayerController DamageInstigator, optional class<KFDamageType> DamageType, optional int HitZoneIdx, optional KFWeapon MyKFW)
{
    local ZTUpgrade_Skill_ThermalDrill_Helper Helper;
    local int HeatStacks;
    
    if (IsRifleWeapon(MyKFW) && MyKFPM != None && DamageInstigator != None)
    {
        Helper = GetOrCreateHelper(DamageInstigator.Pawn);
        if (Helper != None)
        {
            // Get current heat stacks for this target and add damage
            HeatStacks = Helper.GetHeatStacks(MyKFPM);
            if (HeatStacks > 0)
            {
                InDamage += Round(float(DefaultDamage) * default.DamagePerStack[upgLevel - 1] * float(HeatStacks));
            }
            
            // Add a heat stack to this target
            Helper.AddHeatStack(MyKFPM, upgLevel);
        }
    }
}

static function ZTUpgrade_Skill_ThermalDrill_Helper GetOrCreateHelper(Pawn OwnerPawn)
{
    local ZTUpgrade_Skill_ThermalDrill_Helper Helper;
    
    if (OwnerPawn == None)
        return None;
        
    foreach OwnerPawn.ChildActors(class'ZTUpgrade_Skill_ThermalDrill_Helper', Helper)
    {
        if (Helper != None)
            return Helper;
    }
    
    // Create new helper if none exists
    Helper = OwnerPawn.Spawn(class'ZTUpgrade_Skill_ThermalDrill_Helper', OwnerPawn);
    return Helper;
}

static simulated function DeleteHelperClass(Pawn OwnerPawn)
{
    local ZTUpgrade_Skill_ThermalDrill_Helper Helper;
    
    if (OwnerPawn == None)
        return;
        
    foreach OwnerPawn.ChildActors(class'ZTUpgrade_Skill_ThermalDrill_Helper', Helper)
    {
        if (Helper != None)
            Helper.Destroy();
    }
}

// Helper function to determine if a weapon is a rifle
static function bool IsRifleWeapon(KFWeapon KFW)
{
    if (KFW == None)
        return False;
        
    // Check if weapon is in the assault rifle category (Commando weapons)
    if (IsWeaponOnSpecificPerk(KFW, class'KFGame.KFPerk_Commando'))
    {
        // Exclude SMGs and other non-rifle weapons by checking damage characteristics
        // Most rifles have higher damage per shot than SMGs
        return (KFW.InstantHitDamage[0] >= 35 || 
                KFW.default.FireInterval[0] >= 0.08);
    }
    
    // Also include weapons that might be rifle-like but under other categories
    return (InStr(PathName(KFW.Class), "Rifle") != INDEX_NONE ||
            InStr(PathName(KFW.Class), "rifle") != INDEX_NONE);
}

