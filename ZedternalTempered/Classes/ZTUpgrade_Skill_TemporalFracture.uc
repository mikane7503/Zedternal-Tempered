class ZTUpgrade_Skill_TemporalFracture extends ZTUpgrade_Skill;

var array<float> Speed;

static simulated function bool IsUnAffectedByZedTime(int upgLevel, KFPawn OwnerPawn)
{
    return true;
    //return ReturnValue;    
}

static simulated function bool ShouldKnockDownOnBump(int upgLevel, KFPawn_Monster KFPM, KFPawn OwnerPawn)
{
    return OwnerPawn.Controller.WorldInfo.TimeDilation < 1.0000000;
    //return ReturnValue;    
}

static simulated function ModifySpeed(out float InSpeed, float DefaultSpeed, int upgLevel, KFPawn OwnerPawn)
{
    // End:0xB3
    if((OwnerPawn != none) && OwnerPawn.Controller != none)
    {
        // End:0xB3
        if(OwnerPawn.Controller.WorldInfo.TimeDilation < 1.0000000)
        {
            InSpeed += (DefaultSpeed * default.Speed[upgLevel - 1]);
        }
    }
    //return;    
}

static simulated function RevertUpgradeChanges(Pawn OwnerPawn)
{
    // End:0x42
    if(KFPawn_Human(OwnerPawn) != none)
    {
        KFPawn_Human(OwnerPawn).bMovesFastInZedTime = false;
    }
    //return;    
}

defaultproperties
{
    // --- Localization (auto-generated by mass_localize_dk_upgrades.py) ---
    // Strings live in KFGame/Localization/<lang>/ZedternalTempered.<langext>
    // Section: [ZTUpgrade_Skill_TemporalFracture]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalTempered"
    LocSection="ZTUpgrade_Skill_TemporalFracture"

    Speed[0]=0.2500000
    Speed[1]=0.5000000
    UpgradeName="Temporal Fracture"
	upgradeDescription(0)="During <font color=\"#15d7fa\">ZED Time</font> you move <font color=\"#77d914\">25%</font> faster and knock down ZEDs on contact."
	upgradeDescription(1)="During <font color=\"#15d7fa\">ZED Time</font> you move <font color=\"#77d914\">50%</font> faster and knock down ZEDs on contact."
	UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_TemporalFracture'
	UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_TemporalFracture_Deluxe'

	Name="Default__ZTUpgrade_Skill_TemporalFracture"
}

