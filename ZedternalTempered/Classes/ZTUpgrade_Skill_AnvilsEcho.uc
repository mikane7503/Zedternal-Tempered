// ===================================================================
// ZTUpgrade_Skill_AnvilsEcho — Artificer Skill
//
// "Every Nth hit fires a phantom echo — an additional damage
//  instance. The weapon resonates with such perfection that
//  it strikes twice."
//
// Works with ALL weapons.
//
// Normal:  Every 5th hit deals +50% phantom bonus damage
// Deluxe:  Every 3rd hit deals +50% phantom bonus damage
//
// The counter persists across weapon switches (total hits tracked).
// No penalty for missing — purely additive.
//
// Hook: ModifyDamageGiven
// Helper: ZTUpgrade_Skill_AnvilsEcho_Helper (tracks hit counter)
// ===================================================================
class ZTUpgrade_Skill_AnvilsEcho extends ZTUpgrade_Skill config(ZedternalUnlimited);

var config array<int> HitInterval;     // Every Nth hit triggers echo
var config float EchoDamage;           // +50% phantom damage on proc
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.HitInterval[0] = 5;
		default.HitInterval[1] = 3;
		default.EchoDamage = 0.50f;

		// BEGIN TEMPERED INI DEFAULTS (generated; do not edit by hand)
		default.HitInterval.Length = 2;
		default.HitInterval[0] = 5;
		default.HitInterval[1] = 3;
		default.EchoDamage = 0.500000f;
		// END TEMPERED INI DEFAULTS
		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


static function ModifyDamageGiven(out int InDamage, int DefaultDamage, int upgLevel, optional Actor DamageCauser, optional KFPawn_Monster MyKFPM, optional KFPlayerController DamageInstigator, optional class<KFDamageType> DamageType, optional int HitZoneIdx, optional KFWeapon MyKFW)
{
    local ZTUpgrade_Skill_AnvilsEcho_Helper H;

    if (DamageInstigator == None || DamageInstigator.Pawn == None || MyKFPM == None || MyKFW == None)
        return;

    H = GetHelper(DamageInstigator.Pawn, upgLevel);
    if (H == None)
        return;

    H.OnHit(InDamage, DefaultDamage, upgLevel);
}

// ===================================================================
// HELPER MANAGEMENT
// ===================================================================

static simulated function InitiateWeapon(int upgLevel, KFWeapon KFW, KFPawn OwnerPawn)
{
    if (KFPawn_Human(OwnerPawn) != None && OwnerPawn.Role == ROLE_Authority)
        GetHelper(OwnerPawn, upgLevel);
}

static function ZTUpgrade_Skill_AnvilsEcho_Helper GetHelper(Pawn OwnerPawn, int upgLevel)
{
    local ZTUpgrade_Skill_AnvilsEcho_Helper H;

    if (KFPawn_Human(OwnerPawn) == None)
        return None;

    foreach OwnerPawn.ChildActors(class'ZTUpgrade_Skill_AnvilsEcho_Helper', H)
    {
        H.UpgradeLevel = upgLevel;
        return H;
    }

    // Spawn if not found
    if (OwnerPawn.Role == ROLE_Authority)
    {
        H = OwnerPawn.Spawn(class'ZTUpgrade_Skill_AnvilsEcho_Helper', OwnerPawn);
        if (H != None)
            H.UpgradeLevel = upgLevel;
    }

    return H;
}

static simulated function DeleteHelperClass(Pawn OwnerPawn)
{
    local ZTUpgrade_Skill_AnvilsEcho_Helper H;

    if (OwnerPawn != None)
    {
        foreach OwnerPawn.ChildActors(class'ZTUpgrade_Skill_AnvilsEcho_Helper', H)
        {
            H.Destroy();
        }
    }
}

