    UpgradeName="Anvil's Echo"
    UpgradeDescription(0)="Every <font color=\"#FFFFFF\">5th hit</font> fires a <font color=\"#FFD700\">phantom echo</font> dealing <font color=\"#FFFFFF\">+50%</font> bonus damage"
    UpgradeDescription(1)="Every <font color=\"#FFFFFF\">3rd hit</font> fires a <font color=\"#FFD700\">phantom echo</font> dealing <font color=\"#FFFFFF\">+50%</font> bonus damage"
    UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_AnvilsEcho'
