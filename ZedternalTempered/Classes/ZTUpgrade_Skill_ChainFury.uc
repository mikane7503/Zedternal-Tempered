class ZTUpgrade_Skill_ChainFury extends ZTUpgrade_Skill config(ZedternalUnlimited);

// Never stop swinging
// Consecutive melee hits within 2s increase damage per stack
// Chain resets if you go 2s without hitting. At 10+ chain: bonus penetration.

var config array<float> DamagePerStack;        // +3% / +5% per chain hit
var config array<int> PenetrationThreshold;    // Chain count to unlock penetration (10 / 7)
var config array<float> PenetrationBonus;      // Extra penetration at threshold
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.DamagePerStack[0] = 0.03f;
		default.DamagePerStack[1] = 0.05f;
		default.PenetrationThreshold[0] = 10;
		default.PenetrationThreshold[1] = 7;
		default.PenetrationBonus[0] = 2;
		default.PenetrationBonus[1] = 3;

		// BEGIN TEMPERED INI DEFAULTS (generated; do not edit by hand)
		default.DamagePerStack.Length = 2;
		default.DamagePerStack[0] = 0.010000f;
		default.DamagePerStack[1] = 0.015000f;
		default.PenetrationThreshold.Length = 2;
		default.PenetrationThreshold[0] = 10;
		default.PenetrationThreshold[1] = 10;
		default.PenetrationBonus.Length = 2;
		default.PenetrationBonus[0] = 2.000000f;
		default.PenetrationBonus[1] = 3.000000f;
		// END TEMPERED INI DEFAULTS
		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


static function ModifyDamageGiven(out int InDamage, int DefaultDamage, int upgLevel, optional Actor DamageCauser, optional KFPawn_Monster MyKFPM, optional KFPlayerController DamageInstigator, optional class<KFDamageType> DamageType, optional int HitZoneIdx, optional KFWeapon MyKFW)
{
	local ZTUpgrade_Skill_ChainFury_Helper UPG;

	if (DamageType != None && static.IsMeleeDamageType(DamageType) && DamageInstigator != None && DamageInstigator.Pawn != None)
	{
		UPG = GetHelper(KFPawn(DamageInstigator.Pawn));
		if (UPG != None)
		{
			// Apply current chain damage bonus before incrementing
			if (UPG.ChainCount > 0)
				InDamage += Round(float(DefaultDamage) * default.DamagePerStack[upgLevel - 1] * float(UPG.ChainCount));

			// Register this hit (increments chain, resets decay timer)
			UPG.RegisterHit();
		}
	}
}

static simulated function ModifyPenetration(out float InPenetration, float DefaultPenetration, int upgLevel, class<KFDamageType> DamageType, KFPawn OwnerPawn, optional bool bForce)
{
	local ZTUpgrade_Skill_ChainFury_Helper UPG;

	if (DamageType != None && static.IsMeleeDamageType(DamageType) && OwnerPawn != None)
	{
		UPG = GetHelperSimulated(OwnerPawn);
		if (UPG != None && UPG.RepChainCount >= default.PenetrationThreshold[upgLevel - 1])
		{
			InPenetration += default.PenetrationBonus[upgLevel - 1];
		}
	}
}

static simulated function InitiateWeapon(int upgLevel, KFWeapon KFW, KFPawn OwnerPawn)
{
	local ZTUpgrade_Skill_ChainFury_Helper UPG;
	local bool bFound;

	if (KFPawn_Human(OwnerPawn) != None && OwnerPawn.Role == Role_Authority)
	{
		bFound = False;
		foreach OwnerPawn.ChildActors(class'ZTUpgrade_Skill_ChainFury_Helper', UPG)
		{
			bFound = True;
			break;
		}

		if (!bFound)
			OwnerPawn.Spawn(class'ZTUpgrade_Skill_ChainFury_Helper', OwnerPawn);
	}
}

static function ZTUpgrade_Skill_ChainFury_Helper GetHelper(KFPawn OwnerPawn)
{
	local ZTUpgrade_Skill_ChainFury_Helper UPG;

	if (KFPawn_Human(OwnerPawn) != None)
	{
		foreach OwnerPawn.ChildActors(class'ZTUpgrade_Skill_ChainFury_Helper', UPG)
		{
			return UPG;
		}

		if (OwnerPawn.Role == Role_Authority)
			UPG = OwnerPawn.Spawn(class'ZTUpgrade_Skill_ChainFury_Helper', OwnerPawn);
	}

	return UPG;
}

static simulated function ZTUpgrade_Skill_ChainFury_Helper GetHelperSimulated(KFPawn OwnerPawn)
{
	local ZTUpgrade_Skill_ChainFury_Helper UPG;

	if (KFPawn_Human(OwnerPawn) != None)
	{
		foreach OwnerPawn.ChildActors(class'ZTUpgrade_Skill_ChainFury_Helper', UPG)
		{
			return UPG;
		}
	}

	return None;
}

static simulated function DeleteHelperClass(Pawn OwnerPawn)
{
	local ZTUpgrade_Skill_ChainFury_Helper UPG;

	if (OwnerPawn != None)
	{
		foreach OwnerPawn.ChildActors(class'ZTUpgrade_Skill_ChainFury_Helper', UPG)
		{
			UPG.Destroy();
		}
	}
}

