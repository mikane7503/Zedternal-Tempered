class ZTWeaponUpg_TurretLimit extends ZTUpgrade_Weapon abstract config(ZedternalUnlimited);

var config int ExtraTurrets;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 2)
	{
		default.ExtraTurrets = 1;
		// BEGIN TEMPERED INI DEFAULTS (generated; do not edit by hand)
		default.ExtraTurrets = 1;
		// END TEMPERED INI DEFAULTS
		default.MODEVERSION = 2;
		static.StaticSaveConfig();
	}
}

static function bool IsUpgradeCompatible(class<KFWeapon> KFW)
{
	if (class<KFWeap_AutoTurret>(KFW) != None)
		return True;
	if (class<KFWeap_HRG_Warthog>(KFW) != None)
		return True;
	if (WMTurret_Interface(KFW) != None)
		return True;
	return False;
}

static simulated function ModifyMaxDeployed(out int CurrentMaxDeployed, int DefaultMaxDeployed, int upgLevel, KFWeapon KFW)
{
	local int Val;
	Val = default.ExtraTurrets;
	if (Val <= 0) Val = 1;
	CurrentMaxDeployed += Val * upgLevel;
}

