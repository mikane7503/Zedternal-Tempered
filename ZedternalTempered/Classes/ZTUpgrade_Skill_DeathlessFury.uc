class ZTUpgrade_Skill_DeathlessFury extends ZTUpgrade_Skill config(ZedternalUnlimited);

// Deathless Fury: The Reaper thrives when time slows. Massively increased weapon speed
// during Zed Time and extends its duration with each triggering kill.

var config array<float> ZedTimeBonus;
var config array<float> ZedTimeExtension;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.ZedTimeBonus[0] = 0.30f;
		default.ZedTimeBonus[1] = 0.75f;
		default.ZedTimeExtension[0] = 1.0f;
		default.ZedTimeExtension[1] = 3.0f;

		// BEGIN TEMPERED INI DEFAULTS (generated; do not edit by hand)
		default.ZedTimeBonus.Length = 2;
		default.ZedTimeBonus[0] = 0.300000f;
		default.ZedTimeBonus[1] = 0.750000f;
		default.ZedTimeExtension.Length = 2;
		default.ZedTimeExtension[0] = 0.500000f;
		default.ZedTimeExtension[1] = 1.500000f;
		// END TEMPERED INI DEFAULTS
		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


static simulated function GetZedTimeModifier(out float InModifier, int upgLevel, KFWeapon KFW)
{
	InModifier += default.ZedTimeBonus[upgLevel - 1];
}

static simulated function GetZedTimeExtension(out float InExtension, float DefaultExtension, int upgLevel)
{
	InExtension += default.ZedTimeExtension[upgLevel - 1];
}

