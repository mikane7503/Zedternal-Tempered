// ===================================================================
// ZTUpgrade_Skill_ShatterPoint — Artificer Skill
//
// "Your hits accumulate Stress Fractures on each target. When total
//  damage dealt to a single zed exceeds a threshold of its max HP,
//  your next hit finds the Shatter Point — dealing a massive burst
//  equal to a percentage of the target's maximum health.
//  The fracture tracker then resets and can trigger again."
//
// Works with ALL weapons.
//
// Normal:  Threshold = 30% of target's max HP dealt
//          Burst     = 15% of target's max HP as bonus damage
// Deluxe:  Threshold = 25% of target's max HP dealt
//          Burst     = 25% of target's max HP as bonus damage
//
// Against trash (low HP): procs almost instantly, essentially overkill.
// Against large zeds/bosses: a real investment → payoff cycle.
// Can trigger multiple times on the same target (e.g., boss fights).
//
// Hook: ModifyDamageGiven
// Helper: ZTUpgrade_Skill_ShatterPoint_Helper (damage tracking per target)
// ===================================================================
class ZTUpgrade_Skill_ShatterPoint extends ZTUpgrade_Skill config(ZedternalUnlimited);

var config array<float> DamageThreshold;   // % of max HP that must be dealt before Shatter triggers
var config array<float> BurstPercent;      // % of max HP dealt as bonus damage on Shatter
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.DamageThreshold[0] = 0.30f;
		default.DamageThreshold[1] = 0.25f;
		default.BurstPercent[0] = 0.15f;
		default.BurstPercent[1] = 0.25f;

		// BEGIN TEMPERED INI DEFAULTS (generated; do not edit by hand)
		default.DamageThreshold.Length = 2;
		default.DamageThreshold[0] = 0.300000f;
		default.DamageThreshold[1] = 0.250000f;
		default.BurstPercent.Length = 2;
		default.BurstPercent[0] = 0.150000f;
		default.BurstPercent[1] = 0.250000f;
		// END TEMPERED INI DEFAULTS
		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


static function ModifyDamageGiven(out int InDamage, int DefaultDamage, int upgLevel, optional Actor DamageCauser, optional KFPawn_Monster MyKFPM, optional KFPlayerController DamageInstigator, optional class<KFDamageType> DamageType, optional int HitZoneIdx, optional KFWeapon MyKFW)
{
    local ZTUpgrade_Skill_ShatterPoint_Helper H;

    if (DamageInstigator == None || DamageInstigator.Pawn == None || MyKFPM == None || MyKFW == None)
        return;

    H = GetHelper(DamageInstigator.Pawn, upgLevel);
    if (H == None)
        return;

    H.OnHit(MyKFPM, InDamage, DefaultDamage, upgLevel);
}

// ===================================================================
// HELPER MANAGEMENT
// ===================================================================

static simulated function InitiateWeapon(int upgLevel, KFWeapon KFW, KFPawn OwnerPawn)
{
    if (KFPawn_Human(OwnerPawn) != None && OwnerPawn.Role == ROLE_Authority)
        GetHelper(OwnerPawn, upgLevel);
}

static function ZTUpgrade_Skill_ShatterPoint_Helper GetHelper(Pawn OwnerPawn, int upgLevel)
{
    local ZTUpgrade_Skill_ShatterPoint_Helper H;

    if (KFPawn_Human(OwnerPawn) == None)
        return None;

    foreach OwnerPawn.ChildActors(class'ZTUpgrade_Skill_ShatterPoint_Helper', H)
    {
        H.UpgradeLevel = upgLevel;
        return H;
    }

    // Spawn if not found
    if (OwnerPawn.Role == ROLE_Authority)
    {
        H = OwnerPawn.Spawn(class'ZTUpgrade_Skill_ShatterPoint_Helper', OwnerPawn);
        if (H != None)
            H.UpgradeLevel = upgLevel;
    }

    return H;
}

static simulated function DeleteHelperClass(Pawn OwnerPawn)
{
    local ZTUpgrade_Skill_ShatterPoint_Helper H;

    if (OwnerPawn != None)
    {
        foreach OwnerPawn.ChildActors(class'ZTUpgrade_Skill_ShatterPoint_Helper', H)
        {
            H.Destroy();
        }
    }
}

defaultproperties
