    // --- Localization (auto-generated by mass_localize_dk_upgrades.py) ---
    // Strings live in KFGame/Localization/<lang>/ZedternalTempered.<langext>
    // Section: [ZTUpgrade_Skill_ShatterPoint]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalTempered"
    LocSection="ZTUpgrade_Skill_ShatterPoint"

    UpgradeName="Shatter Point"
    UpgradeDescription(0)="Hits build <font color=\"#FFD700\">Stress Fractures</font>. After dealing <font color=\"#FFFFFF\">30%</font> of a target's max HP, trigger a <font color=\"#FFD700\">Shatter</font> for <font color=\"#FFFFFF\">15%</font> max HP bonus damage"
    UpgradeDescription(1)="Hits build <font color=\"#FFD700\">Stress Fractures</font>. After dealing <font color=\"#FFFFFF\">25%</font> of a target's max HP, trigger a <font color=\"#FFD700\">Shatter</font> for <font color=\"#FFFFFF\">25%</font> max HP bonus damage"
    UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_ShatterPoint'
    UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_ShatterPoint_Deluxe'

    Name="Default__ZTUpgrade_Skill_ShatterPoint"
}
