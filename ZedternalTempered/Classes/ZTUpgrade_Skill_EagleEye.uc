// ===================================================================
// ZTUpgrade_Skill_EagleEye - Active ability: temporary headshot damage boost
// Standard: +25% headshot damage for 10s
// Deluxe: +40% headshot damage for 10s
// Cooldown: 60s after effect ends
//
// RENAMED from ZTUpgrade_Skill_DeadEye so the class/INI name matches the
// display name and no longer collides with ZR's WMUpgrade_Skill_DeadEye on
// the same perk. The old class remains as a config stub for one release so
// admin-tuned values migrate; old SkillPath entries in the ZR skill list are
// rewritten automatically by the GameInfo boot migration.
// ===================================================================
class ZTUpgrade_Skill_EagleEye extends ZTUpgrade_Skill
	config(ZedternalUnlimited);

var config array<float> HeadshotDamageBonus;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		// Carry over admin tuning from the pre-rename section
		// [ZedternalTempered.ZTUpgrade_Skill_DeadEye] if it exists,
		// otherwise seed the standard defaults.
		if (class'ZTUpgrade_Skill_DeadEye'.default.HeadshotDamageBonus.Length >= 2)
		{
			default.HeadshotDamageBonus[0] = class'ZTUpgrade_Skill_DeadEye'.default.HeadshotDamageBonus[0];
			default.HeadshotDamageBonus[1] = class'ZTUpgrade_Skill_DeadEye'.default.HeadshotDamageBonus[1];
		}
		else
		{
			default.HeadshotDamageBonus[0] = 0.25f;
			default.HeadshotDamageBonus[1] = 0.4f;
		}

		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


static simulated function InitiateWeapon(int upgLevel, KFWeapon KFW, KFPawn OwnerPawn)
{
	local ZTUpgrade_Skill_EagleEye_Helper Helper;
	local ZTPlayerController ZTPC;
	local bool bFound;
	
	if (KFPawn_Human(OwnerPawn) == None || OwnerPawn.Role != Role_Authority)
		return;
	
	ZTPC = ZTPlayerController(OwnerPawn.Controller);
	if (ZTPC == None)
	{
		`log("ZTUpgrade_Skill_EagleEye: ERROR - Player does not have ZTPlayerController!");
		return;
	}
	
	bFound = false;
	foreach OwnerPawn.ChildActors(class'ZTUpgrade_Skill_EagleEye_Helper', Helper)
	{
		bFound = true;
		Helper.SetTier(upgLevel);
		`log("ZTUpgrade_Skill_EagleEye: Updated existing helper to tier" @ upgLevel);
		break;
	}
	
	if (!bFound)
	{
		Helper = OwnerPawn.Spawn(class'ZTUpgrade_Skill_EagleEye_Helper', OwnerPawn);
		if (Helper != None)
		{
			Helper.Initialize(upgLevel, KFPawn_Human(OwnerPawn), ZTPC);
			`log("ZTUpgrade_Skill_EagleEye: Spawned helper for" @ OwnerPawn.PlayerReplicationInfo.PlayerName);
		}
		else
		{
			`log("ZTUpgrade_Skill_EagleEye: ERROR - Failed to spawn helper!");
		}
	}
}

static simulated function DeleteHelperClass(Pawn OwnerPawn)
{
	local ZTUpgrade_Skill_EagleEye_Helper Helper;
	
	if (OwnerPawn == None)
		return;
	
	foreach OwnerPawn.ChildActors(class'ZTUpgrade_Skill_EagleEye_Helper', Helper)
	{
		Helper.Cleanup();
		Helper.Destroy();
		`log("ZTUpgrade_Skill_EagleEye: Cleaned up helper");
	}
}

static function ModifyDamageGiven(out int InDamage, int DefaultDamage, int upgLevel,
	optional Actor DamageCauser, optional KFPawn_Monster MyKFPM,
	optional KFPlayerController DamageInstigator, optional class<KFDamageType> DamageType,
	optional int HitZoneIdx, optional KFWeapon MyKFW)
{
	local ZTUpgrade_Skill_EagleEye_Helper Helper;
	local KFPawn OwnerPawn;
	
	if (DamageInstigator == None || DamageInstigator.Pawn == None)
		return;
	
	// Only apply to headshots (HitZoneIdx 0 = head in KF2)
	if (HitZoneIdx != 0)
		return;
	
	OwnerPawn = KFPawn(DamageInstigator.Pawn);
	if (OwnerPawn == None)
		return;
	
	foreach OwnerPawn.ChildActors(class'ZTUpgrade_Skill_EagleEye_Helper', Helper)
	{
		if (Helper.bActive)
		{
			InDamage += Round(float(DefaultDamage) * default.HeadshotDamageBonus[upgLevel - 1]);
		}
		break;
	}
}

defaultproperties
{
	
    // --- Localization (auto-generated by mass_localize_dk_upgrades.py) ---
    // Strings live in KFGame/Localization/<lang>/ZedternalTempered.<langext>
    // Section: [ZTUpgrade_Skill_EagleEye]  -- see ZTUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalTempered"
    LocSection="ZTUpgrade_Skill_EagleEye"

	UpgradeName="Eagle Eye"
	
	upgradeDescription(0)="Unlocks <font color=\"#66cc00\">Eagle Eye</font> active ability: <font color=\"#00ffff\">+25% headshot damage</font> for <font color=\"#ffaa33\">10 seconds</font>. Cooldown: <font color=\"#ff9900\">60 seconds</font>."
	
	upgradeDescription(1)="Unlocks <font color=\"#66cc00\">Eagle Eye (Deluxe)</font> active ability: <font color=\"#00ffff\">+40% headshot damage</font> for <font color=\"#ffaa33\">10 seconds</font>. Cooldown: <font color=\"#ff9900\">60 seconds</font>."
	
	UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_DeadEye'
	UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_DeadEye_Deluxe'
	
	Name="Default__ZTUpgrade_Skill_EagleEye"
}
