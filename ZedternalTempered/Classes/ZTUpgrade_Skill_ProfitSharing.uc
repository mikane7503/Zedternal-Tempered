class ZTUpgrade_Skill_ProfitSharing extends ZTUpgrade_Skill config(ZedternalUnlimited);

var config array<int> DoshPerTeammate;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.DoshPerTeammate[0] = 10;
		default.DoshPerTeammate[1] = 20;

		// BEGIN TEMPERED INI DEFAULTS (generated; do not edit by hand)
		default.DoshPerTeammate.Length = 2;
		default.DoshPerTeammate[0] = 10;
		default.DoshPerTeammate[1] = 20;
		// END TEMPERED INI DEFAULTS
		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


static simulated function InitiateWeapon(int upgLevel, KFWeapon KFW, KFPawn OwnerPawn)
{
    local ZTUpgrade_Skill_ProfitSharing_Helper UPG;
    local bool bFound;

    if (KFPawn_Human(OwnerPawn) != None && OwnerPawn.Role == Role_Authority)
    {
        bFound = False;
        foreach OwnerPawn.ChildActors(class'ZTUpgrade_Skill_ProfitSharing_Helper', UPG)
        {
            bFound = True;
            break;
        }

        if (!bFound)
        {
            UPG = OwnerPawn.Spawn(class'ZTUpgrade_Skill_ProfitSharing_Helper', OwnerPawn);
            UPG.bDeluxe = (upgLevel > 1);
            UPG.UpgradeLevel = upgLevel;
        }
    }
}

static function ModifyDamageGiven(out int InDamage, int DefaultDamage, int upgLevel, optional Actor DamageCauser, optional KFPawn_Monster MyKFPM, optional KFPlayerController DamageInstigator, optional class<KFDamageType> DamageType, optional int HitZoneIdx, optional KFWeapon MyKFW)
{
    local ZTUpgrade_Skill_ProfitSharing_Helper UPG;

    // Check if this damage will kill the target
    if (MyKFPM != None && MyKFPM.IsAliveAndWell() && 
        DamageInstigator != None && DamageInstigator.Pawn != None &&
        (MyKFPM.Health - InDamage) <= 0)
    {
        foreach DamageInstigator.Pawn.ChildActors(class'ZTUpgrade_Skill_ProfitSharing_Helper', UPG)
        {
            UPG.OnEnemyKilled();
            break;
        }
    }
}

static simulated function DeleteHelperClass(Pawn OwnerPawn)
{
    local ZTUpgrade_Skill_ProfitSharing_Helper UPG;

    if (OwnerPawn != None)
    {
        foreach OwnerPawn.ChildActors(class'ZTUpgrade_Skill_ProfitSharing_Helper', UPG)
        {
            UPG.Destroy();
        }
    }
}

defaultproperties
{
    // --- Localization (auto-generated by mass_localize_dk_upgrades.py) ---
    // Strings live in KFGame/Localization/<lang>/ZedternalTempered.<langext>
    // Section: [ZTUpgrade_Skill_ProfitSharing]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalTempered"
    LocSection="ZTUpgrade_Skill_ProfitSharing"

    UpgradeName="Profit Sharing"
    
    upgradeDescription(0)="Every <font color=\"#ffaa33\">25 kills</font>, all teammates get <font color=\"#00ff00\">+10 dosh</font>."
    upgradeDescription(1)="Every <font color=\"#ffaa33\">25 kills</font>, all teammates get <font color=\"#00ff00\">+20 dosh</font>."
    
    UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_ProfitSharing'
    UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_ProfitSharing_Deluxe'

