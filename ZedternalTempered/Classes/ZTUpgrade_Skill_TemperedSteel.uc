class ZTUpgrade_Skill_TemperedSteel extends ZTUpgrade_Skill config(ZedternalUnlimited);

// Tempered Steel: Increased maximum armor
// Normal: +25% armor | Deluxe: +60% armor

var config array<float> Armor;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.Armor[0] = 0.25f;
		default.Armor[1] = 0.6f;

		// BEGIN TEMPERED INI DEFAULTS (generated; do not edit by hand)
		default.Armor.Length = 2;
		default.Armor[0] = 0.250000f;
		default.Armor[1] = 0.600000f;
		// END TEMPERED INI DEFAULTS
		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


static function ModifyArmor(out int MaxArmor, int DefaultArmor, int upgLevel)
{
	MaxArmor += Round(float(DefaultArmor) * default.Armor[upgLevel - 1]);
}

