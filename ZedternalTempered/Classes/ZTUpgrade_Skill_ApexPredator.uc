class ZTUpgrade_Skill_ApexPredator extends ZTUpgrade_Skill config(ZedternalUnlimited);

var config array<float> DamageBonus;
var config float HealthThreshold;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.DamageBonus[0] = 0.50f;
		default.DamageBonus[1] = 1.00f;
		default.HealthThreshold = 0.30f;

		// BEGIN TEMPERED INI DEFAULTS (generated; do not edit by hand)
		default.DamageBonus.Length = 2;
		default.DamageBonus[0] = 0.500000f;
		default.DamageBonus[1] = 1.000000f;
		default.HealthThreshold = 0.200000f;
		// END TEMPERED INI DEFAULTS
		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


static function ModifyDamageGiven(out int InDamage, int DefaultDamage, int upgLevel, optional Actor DamageCauser, optional KFPawn_Monster MyKFPM, optional KFPlayerController DamageInstigator, optional class<KFDamageType> DamageType, optional int HitZoneIdx, optional KFWeapon MyKFW)
{
    local float TargetHealthPercent;
    
    if (MyKFPM == None || !MyKFPM.IsAliveAndWell())
        return;
    
    // Calculate target's health percentage
    TargetHealthPercent = float(MyKFPM.Health) / float(MyKFPM.HealthMax);
    
    // Bonus damage if target is below threshold (30% health)
    if (TargetHealthPercent <= default.HealthThreshold)
    {
        InDamage += Round(float(DefaultDamage) * default.DamageBonus[upgLevel - 1]);
    }
}

defaultproperties
{

    // --- Localization (auto-generated by mass_localize_dk_upgrades.py) ---
    // Strings live in KFGame/Localization/<lang>/ZedternalTempered.<langext>
    // Section: [ZTUpgrade_Skill_ApexPredator]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalTempered"
    LocSection="ZTUpgrade_Skill_ApexPredator"

    UpgradeName="Apex Predator"
    upgradeDescription(0)="Deal <font color=\"#ff3399\">+50%</font> bonus damage to enemies below <font color=\"#ff0000\">30% health</font>."
    upgradeDescription(1)="Deal <font color=\"#ff3399\">+100%</font> bonus damage to enemies below <font color=\"#ff0000\">30% health</font>."
    UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_ApexPredator'
    UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_ApexPredator_Deluxe'

    Name="Default__ZTUpgrade_Skill_ApexPredator"
}
