    // Section: [ZTWeaponUpg_ReloadSpeed]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalTempered"
    LocSection="ZTWeaponUpg_ReloadSpeed"

	UpgradeName="Trigger Happy"
	UpgradeDescription(0)="Increases your <font color=\"#15d7fa\">reload speed</font> by <font color=\"#77d914\">+%x%%</font> per level."
	WeaponBonus=(baseValue=0, incValue=7.5, maxValue=-1)
	Name="Default__ZTWeaponUpg_ReloadSpeed"
}
