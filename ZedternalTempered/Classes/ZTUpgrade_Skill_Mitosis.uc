	UpgradeDescription(0)="<font color=\"#9370DB\">Mitosis:</font> Every <font color=\"#FFFFFF\">30 kills</font>, <font color=\"#15d7fa\">instantly refill</font> your current magazine."
	UpgradeDescription(1)="<font color=\"#9370DB\">Mitosis:</font> Every <font color=\"#FFFFFF\">20 kills</font>, <font color=\"#15d7fa\">instantly refill</font> your current magazine."
	UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_Mitosis'
	UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_Mitosis_Deluxe'

	Name="Default__ZTUpgrade_Skill_Mitosis"
}
