class ZTUpgrade_Skill_WarProfiteer extends ZTUpgrade_Skill config(ZedternalUnlimited);

// Kills scored while in the last 25% of your magazine grant bonus dosh
// Rewards efficient ammo usage and fighting to the bottom of the mag

var config array<int> DoshPerKill;        // Bonus dosh awarded per qualifying kill
var config float MagThreshold;            // Magazine percentage threshold (0.25 = last 25%)
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.DoshPerKill[0] = 1;
		default.DoshPerKill[1] = 2;
		default.MagThreshold = 0.25f;

		// BEGIN TEMPERED INI DEFAULTS (generated; do not edit by hand)
		default.DoshPerKill.Length = 2;
		default.DoshPerKill[0] = 1;
		default.DoshPerKill[1] = 2;
		default.MagThreshold = 0.250000f;
		// END TEMPERED INI DEFAULTS
		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


static function AddVampireHealth(out int InHealth, int DefaultHealth, int upgLevel, KFPlayerController KFPC, class<DamageType> DT)
{
	local KFWeapon KFW;
	local KFPlayerReplicationInfo KFPRI;

	if (KFPC != None && KFPC.Pawn != None)
	{
		KFW = KFWeapon(KFPC.Pawn.Weapon);
		KFPRI = KFPlayerReplicationInfo(KFPC.PlayerReplicationInfo);

		if (KFW != None && KFPRI != None && KFW.MagazineCapacity[0] > 0)
		{
			// Check if current ammo is in the last 25% of magazine
			if (float(KFW.AmmoCount[0]) / float(KFW.MagazineCapacity[0]) <= default.MagThreshold)
			{
				KFPRI.AddDosh(default.DoshPerKill[upgLevel - 1]);
			}
		}
	}
}

defaultproperties
{

    // --- Localization (auto-generated by mass_localize_dk_upgrades.py) ---
    // Strings live in KFGame/Localization/<lang>/ZedternalTempered.<langext>
    // Section: [ZTUpgrade_Skill_WarProfiteer]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalTempered"
    LocSection="ZTUpgrade_Skill_WarProfiteer"

	UpgradeName="War Profiteer"

	UpgradeDescription(0)="<font color=\"#DAA520\">War Profiteer:</font> Kills scored with the <font color=\"#FFFFFF\">last 25%</font> of your magazine grant <font color=\"#87CEEB\">+1 dosh</font> per kill"
	UpgradeDescription(1)="<font color=\"#FFD700\">War Profiteer:</font> Kills scored with the <font color=\"#FFFFFF\">last 25%</font> of your magazine grant <font color=\"#87CEEB\">+2 dosh</font> per kill"

	UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_WarProfiteer'
	UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_WarProfiteer_Deluxe'

	Name="Default__ZTUpgrade_Skill_WarProfiteer"
}
