class ZTUpgrade_Skill_BulkPurchasing extends ZTUpgrade_Skill config(ZedternalUnlimited);

var config array<float> RefundPercentage;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.RefundPercentage[0] = 0.025f;
		default.RefundPercentage[1] = 0.04f;

		// BEGIN TEMPERED INI DEFAULTS (generated; do not edit by hand)
		default.RefundPercentage.Length = 2;
		default.RefundPercentage[0] = 0.010000f;
		default.RefundPercentage[1] = 0.020000f;
		// END TEMPERED INI DEFAULTS
		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


static simulated function InitiateWeapon(int upgLevel, KFWeapon KFW, KFPawn OwnerPawn)
{
    local ZTUpgrade_Skill_BulkPurchasing_Helper UPG;
    local bool bFound;

    if (KFPawn_Human(OwnerPawn) != None && OwnerPawn.Role == Role_Authority)
    {
        bFound = False;
        foreach OwnerPawn.ChildActors(class'ZTUpgrade_Skill_BulkPurchasing_Helper', UPG)
        {
            bFound = True;
            break;
        }

        if (!bFound)
        {
            UPG = OwnerPawn.Spawn(class'ZTUpgrade_Skill_BulkPurchasing_Helper', OwnerPawn);
            UPG.bDeluxe = (upgLevel > 1);
            UPG.UpgradeLevel = upgLevel;
        }
    }
}

static simulated function DeleteHelperClass(Pawn OwnerPawn)
{
    local ZTUpgrade_Skill_BulkPurchasing_Helper UPG;

    if (OwnerPawn != None)
    {
        foreach OwnerPawn.ChildActors(class'ZTUpgrade_Skill_BulkPurchasing_Helper', UPG)
        {
            UPG.Destroy();
        }
    }
}

defaultproperties
