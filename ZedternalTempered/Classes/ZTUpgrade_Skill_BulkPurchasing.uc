    // --- Localization (auto-generated by mass_localize_dk_upgrades.py) ---
    // Strings live in KFGame/Localization/<lang>/ZedternalTempered.<langext>
    // Section: [ZTUpgrade_Skill_BulkPurchasing]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalTempered"
    LocSection="ZTUpgrade_Skill_BulkPurchasing"

    UpgradeName="Bulk Purchasing"
    
    upgradeDescription(0)="Buying multiple items in one trader visit grants <font color=\"#00ff00\">2.5% dosh refund</font> per <font color=\"#ffaa33\">additional item</font>."
    upgradeDescription(1)="Buying multiple items in one trader visit grants <font color=\"#00ff00\">4% dosh refund</font> per <font color=\"#ffaa33\">additional item</font>."
    
    UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_BulkPurchasing'
    UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_BulkPurchasing_Deluxe'

    Name="Default__ZTUpgrade_Skill_BulkPurchasing"
}