class ZTUpgrade_Skill_Isolation extends ZTUpgrade_Skill config(ZedternalUnlimited);

// Theme: The lone predator thrives in solitude
var config array<float> Resistance;
var const float NearbyDistanceSq;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.Resistance[0] = 0.15f;
		default.Resistance[1] = 0.4f;

		// BEGIN TEMPERED INI DEFAULTS (generated; do not edit by hand)
		default.Resistance.Length = 2;
		default.Resistance[0] = 0.100000f;
		default.Resistance[1] = 0.200000f;
		// END TEMPERED INI DEFAULTS
		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


static function ModifyDamageTaken(out int InDamage, int DefaultDamage, int upgLevel, KFPawn OwnerPawn, optional class<DamageType> DamageType, optional Controller InstigatedBy, optional KFWeapon MyKFW)
{
	local KFPawn_Human KFPH;
	local bool bTeammateNearby;

	if (OwnerPawn == None)
		return;

	bTeammateNearby = False;
	foreach OwnerPawn.WorldInfo.AllPawns(class'KFPawn_Human', KFPH)
	{
		if (KFPH != OwnerPawn && KFPH.IsAliveAndWell() && VSizeSq(KFPH.Location - OwnerPawn.Location) < default.NearbyDistanceSq)
		{
			bTeammateNearby = True;
			break;
		}
	}

	if (!bTeammateNearby)
		InDamage -= Round(float(DefaultDamage) * default.Resistance[upgLevel - 1]);
}

defaultproperties
{
    // --- Localization (auto-generated by mass_localize_dk_upgrades.py) ---
    // Strings live in KFGame/Localization/<lang>/ZedternalTempered.<langext>
    // Section: [ZTUpgrade_Skill_Isolation]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalTempered"
    LocSection="ZTUpgrade_Skill_Isolation"

	NearbyDistanceSq=2250000.0f  // 1500 units (~15m) squared

	UpgradeName="Isolation"
	UpgradeDescription(0)="<font color=\"#4682B4\">Isolation:</font> Take <font color=\"#FFFFFF\">10%</font> <font color=\"#87CEEB\">less damage</font> when no teammates are within <font color=\"#F0F8FF\">10 meters</font>"
	UpgradeDescription(1)="<font color=\"#4682B4\">Isolation:</font> Take <font color=\"#FFFFFF\">30%</font> <font color=\"#87CEEB\">less damage</font> when no teammates are within <font color=\"#F0F8FF\">15 meters</font>"

	UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_Isolation'
	UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_Isolation_Deluxe'

	Name="Default__ZTUpgrade_Skill_Isolation"
}
