// Toxic Absorption: Immune to all toxic/poison damage. Heal from it instead.
// Bloats become walking health packs. Stand in bile to heal.
// Completely changes threat assessment and positioning priorities.
class ZTUpgrade_Skill_ToxicAbsorption extends ZTUpgrade_Skill config(ZedternalUnlimited);

var config array<float> HealFactor;
var config array<float> Resistance;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.HealFactor[0] = 0.50f;
		default.HealFactor[1] = 1.00f;
		default.Resistance[0] = 0.30f;
		default.Resistance[1] = 0.50f;

		// BEGIN TEMPERED INI DEFAULTS (generated; do not edit by hand)
		default.HealFactor.Length = 2;
		default.HealFactor[0] = 0.500000f;
		default.HealFactor[1] = 1.000000f;
		default.Resistance.Length = 2;
		default.Resistance[0] = 0.300000f;
		default.Resistance[1] = 0.500000f;
		// END TEMPERED INI DEFAULTS
		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


static function ModifyDamageTaken(out int InDamage, int DefaultDamage, int upgLevel, KFPawn OwnerPawn, optional class<DamageType> DamageType, optional Controller InstigatedBy, optional KFWeapon MyKFW)
{
	local int BlockedDamage, HealAmount;

	if (InDamage > 0 && DamageType != None && ClassIsChildOf(DamageType, class'KFDT_Toxic'))
	{
		BlockedDamage = Round(float(InDamage) * default.Resistance[upgLevel - 1]);
		HealAmount = Round(float(BlockedDamage) * default.HealFactor[upgLevel - 1]);
		InDamage -= BlockedDamage;
		if (InDamage < 1)
			InDamage = 1;

		if (HealAmount > 0 && OwnerPawn != None)
			OwnerPawn.HealDamage(HealAmount, OwnerPawn.Controller, class'KFDT_Healing');
	}
}

defaultproperties
{
    // --- Localization (auto-generated by mass_localize_dk_upgrades.py) ---
    // Strings live in KFGame/Localization/<lang>/ZedternalTempered.<langext>
    // Section: [ZTUpgrade_Skill_ToxicAbsorption]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalTempered"
    LocSection="ZTUpgrade_Skill_ToxicAbsorption"

	// L1: Convert 50% of incoming toxic damage to healing
	// L2: Convert 100% of incoming toxic damage to healing

	UpgradeDescription(0)="Reduce toxic damage by <font color=\"#399c0e\">30%</font> and convert <font color=\"#399c0e\">50%</font> of the blocked amount into <font color=\"#00e5ff\">healing</font>."
	UpgradeDescription(1)="Reduce toxic damage by <font color=\"#b346ea\">50%</font> and convert <font color=\"#b346ea\">100%</font> of the blocked amount into <font color=\"#00e5ff\">healing</font>."

	UpgradeName="Toxic Absorption"
	UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_ToxicAbsorption'
	UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_ToxicAbsorption_Deluxe'

	Name="Default__ZTUpgrade_Skill_ToxicAbsorption"
}
