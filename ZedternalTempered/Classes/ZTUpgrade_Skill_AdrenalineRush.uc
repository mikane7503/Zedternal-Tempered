class ZTUpgrade_Skill_AdrenalineRush extends ZTUpgrade_Skill config(ZedternalUnlimited);

// Pain is fuel
// Each time you take damage, gain a stack of Adrenaline
// Stacks increase attack speed and movement speed, decay over time

var config array<int> MaxStacks;
var config array<float> SpeedPerStack;
var config array<float> AttackSpeedPerStack;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.MaxStacks[0] = 5;
		default.MaxStacks[1] = 8;
		default.SpeedPerStack[0] = 0.03f;
		default.SpeedPerStack[1] = 0.04f;
		default.AttackSpeedPerStack[0] = 0.04f;
		default.AttackSpeedPerStack[1] = 0.05f;

		// BEGIN TEMPERED INI DEFAULTS (generated; do not edit by hand)
		default.MaxStacks.Length = 2;
		default.MaxStacks[0] = 5;
		default.MaxStacks[1] = 7;
		default.SpeedPerStack.Length = 2;
		default.SpeedPerStack[0] = 0.020000f;
		default.SpeedPerStack[1] = 0.030000f;
		default.AttackSpeedPerStack.Length = 2;
		default.AttackSpeedPerStack[0] = 0.020000f;
		default.AttackSpeedPerStack[1] = 0.030000f;
		// END TEMPERED INI DEFAULTS
		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


static function ModifyDamageTaken(out int InDamage, int DefaultDamage, int upgLevel, KFPawn OwnerPawn, optional class<DamageType> DamageType, optional Controller InstigatedBy, optional KFWeapon MyKFW)
{
	local ZTUpgrade_Skill_AdrenalineRush_Helper UPG;

	if (InDamage > 0 && OwnerPawn != None)
	{
		UPG = GetHelper(OwnerPawn, upgLevel);
		if (UPG != None)
			UPG.AddStack(default.MaxStacks[upgLevel - 1]);
	}
}

static simulated function ModifyMeleeAttackSpeed(out float InDuration, float DefaultDuration, int upgLevel, KFWeapon KFW)
{
	local ZTUpgrade_Skill_AdrenalineRush_Helper UPG;

	if (KFW != None && KFW.Instigator != None)
	{
		UPG = GetHelperSimulated(KFPawn(KFW.Instigator));
		if (UPG != None && UPG.RepStacks > 0)
		{
			InDuration = InDuration / (1.0f + (default.AttackSpeedPerStack[upgLevel - 1] * float(UPG.RepStacks)));
		}
	}
}

static simulated function ModifySpeed(out float InSpeed, float DefaultSpeed, int upgLevel, KFPawn OwnerPawn)
{
	local ZTUpgrade_Skill_AdrenalineRush_Helper UPG;

	if (OwnerPawn != None)
	{
		UPG = GetHelperSimulated(OwnerPawn);
		if (UPG != None && UPG.RepStacks > 0)
		{
			InSpeed += DefaultSpeed * default.SpeedPerStack[upgLevel - 1] * float(UPG.RepStacks);
		}
	}
}

static simulated function InitiateWeapon(int upgLevel, KFWeapon KFW, KFPawn OwnerPawn)
{
	local ZTUpgrade_Skill_AdrenalineRush_Helper UPG;
	local bool bFound;

	if (KFPawn_Human(OwnerPawn) != None && OwnerPawn.Role == Role_Authority)
	{
		bFound = False;
		foreach OwnerPawn.ChildActors(class'ZTUpgrade_Skill_AdrenalineRush_Helper', UPG)
		{
			bFound = True;
			break;
		}

		if (!bFound)
		{
			UPG = OwnerPawn.Spawn(class'ZTUpgrade_Skill_AdrenalineRush_Helper', OwnerPawn);
			UPG.SetDeluxe(upgLevel > 1);
		}
	}
}

static function ZTUpgrade_Skill_AdrenalineRush_Helper GetHelper(KFPawn OwnerPawn, int upgLevel)
{
	local ZTUpgrade_Skill_AdrenalineRush_Helper UPG;

	if (KFPawn_Human(OwnerPawn) != None)
	{
		foreach OwnerPawn.ChildActors(class'ZTUpgrade_Skill_AdrenalineRush_Helper', UPG)
		{
			return UPG;
		}

		if (OwnerPawn.Role == Role_Authority)
		{
			UPG = OwnerPawn.Spawn(class'ZTUpgrade_Skill_AdrenalineRush_Helper', OwnerPawn);
			UPG.SetDeluxe(upgLevel > 1);
		}
	}

	return UPG;
}

// For simulated (client-side) functions - don't spawn, just find
static simulated function ZTUpgrade_Skill_AdrenalineRush_Helper GetHelperSimulated(KFPawn OwnerPawn)
{
	local ZTUpgrade_Skill_AdrenalineRush_Helper UPG;

	if (KFPawn_Human(OwnerPawn) != None)
	{
		foreach OwnerPawn.ChildActors(class'ZTUpgrade_Skill_AdrenalineRush_Helper', UPG)
		{
			return UPG;
		}
	}

	return None;
}

static simulated function DeleteHelperClass(Pawn OwnerPawn)
{
	local ZTUpgrade_Skill_AdrenalineRush_Helper UPG;

	if (OwnerPawn != None)
	{
		foreach OwnerPawn.ChildActors(class'ZTUpgrade_Skill_AdrenalineRush_Helper', UPG)
		{
			UPG.Destroy();
		}
	}
}

