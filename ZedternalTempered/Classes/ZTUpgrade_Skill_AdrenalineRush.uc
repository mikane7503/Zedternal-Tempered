	UpgradeDescription(1)="<font color=\"#edb82a\">Adrenaline Rush</font> Taking damage grants <font color=\"#FFFFFF\">Adrenaline</font> stacks (max <font color=\"#FFFFFF\">7</font>). Per stack: <font color=\"#32CD32\">+3% Move Speed</font>, <font color=\"#FFD700\">+3% Attack Speed</font> Stacks decay over time. <font color=\"#AAAAAA\">Pain is fuel.</font>"

	UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_AdrenalineRush'
