class ZTUpgrade_Skill_Conflagration extends ZTUpgrade_Skill config(ZedternalUnlimited);

// Conflagration: Massively increases fire damage over time (DoT).
// Standard: +300% fire DoT scaling.
// Deluxe:   +750% fire DoT scaling.

var config array<float> DoTBonus;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.DoTBonus[0] = 3.0f;
		default.DoTBonus[1] = 7.5f;

		// BEGIN TEMPERED INI DEFAULTS (generated; do not edit by hand)
		default.DoTBonus.Length = 2;
		default.DoTBonus[0] = 1.500000f;
		default.DoTBonus[1] = 3.000000f;
		// END TEMPERED INI DEFAULTS
		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


static function ModifyDoTScaler(out float InDoTScaler, float DefaultDotScaler, int upgLevel, optional class<KFDamageType> KFDT, optional bool bNapalmInfected)
{
	if (KFDT != None && ClassIsChildOf(KFDT, class'KFDT_Fire'))
		InDoTScaler += DefaultDotScaler * default.DoTBonus[upgLevel - 1];
}

defaultproperties
{
