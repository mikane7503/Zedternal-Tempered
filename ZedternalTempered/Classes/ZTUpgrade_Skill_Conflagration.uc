    bShouldLocalize=True
    LocPackage="ZedternalTempered"
    LocSection="ZTUpgrade_Skill_Conflagration"

	UpgradeName="Conflagration"
	upgradeDescription(0)="<font color=\"#42e087\">Increase</font> <font color=\"#42e087\">fire damage over time</font> by <font color=\"#84d6d0\">150%</font>."
	upgradeDescription(1)="<font color=\"#42e087\">Increase</font> <font color=\"#42e087\">fire damage over time</font> by <font color=\"#84d6d0\">300%</font>."
	UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_Conflagration'
	UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_Conflagration_Deluxe'

	Name="Default__ZTUpgrade_Skill_Conflagration"
}
