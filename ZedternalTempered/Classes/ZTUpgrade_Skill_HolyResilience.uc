// Holy Resilience
// Gain damage resistance that scales with missing health
// Formula: Resistance = MissingHealthPct * MaxResistance
// Standard: Up to 10% damage resistance at critical health
// Deluxe: Up to 25% damage resistance at critical health
class ZTUpgrade_Skill_HolyResilience extends ZTUpgrade_Skill config(ZedternalUnlimited);

var config array<float> MaxResistance;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.MaxResistance[0] = 0.1f;
		default.MaxResistance[1] = 0.25f;

		// BEGIN TEMPERED INI DEFAULTS (generated; do not edit by hand)
		default.MaxResistance.Length = 2;
		default.MaxResistance[0] = 0.050000f;
		default.MaxResistance[1] = 0.100000f;
		// END TEMPERED INI DEFAULTS
		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


static function ModifyDamageTaken(out int InDamage, int DefaultDamage, int upgLevel, KFPawn OwnerPawn, optional class<DamageType> DamageType, optional Controller InstigatedBy, optional KFWeapon MyKFW)
{
	local float MissingHealthPct;

	if (OwnerPawn != None && OwnerPawn.HealthMax > 0)
	{
		MissingHealthPct = 1.0f - (float(OwnerPawn.Health) / float(OwnerPawn.HealthMax));
		MissingHealthPct = FClamp(MissingHealthPct, 0.0f, 1.0f);
		InDamage -= Round(float(DefaultDamage) * default.MaxResistance[upgLevel - 1] * MissingHealthPct);
	}
}

defaultproperties
{

    // --- Localization (auto-generated by mass_localize_dk_upgrades.py) ---
    // Strings live in KFGame/Localization/<lang>/ZedternalTempered.<langext>
    // Section: [ZTUpgrade_Skill_HolyResilience]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalTempered"
    LocSection="ZTUpgrade_Skill_HolyResilience"

	UpgradeName="Holy Resilience"
	UpgradeDescription(0)="Gain up to <font color=\"#eeeeff\">5%</font> <font color=\"#87ceeb\">damage resistance</font> that scales with missing health"
	UpgradeDescription(1)="<font color=\"#ffd700\">Deluxe.</font> Gain up to <font color=\"#eeeeff\">10%</font> <font color=\"#87ceeb\">damage resistance</font> that scales with missing health"
	UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_HolyResilience'
	UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_HolyResilience_Deluxe'

	Name="Default__ZTUpgrade_Skill_HolyResilience"
}
