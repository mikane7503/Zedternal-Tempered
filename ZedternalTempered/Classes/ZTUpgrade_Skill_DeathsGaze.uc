class ZTUpgrade_Skill_DeathsGaze extends ZTUpgrade_Skill config(ZedternalUnlimited);

// Death's Gaze: The Reaper perceives all living things and their remaining life force.
// See cloaked enemies with increased detection range. Deluxe adds enemy health bars.

var config array<float> DetectionRange;
var const float HealthBarLength, HealthBarHeight;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.DetectionRange.Length = 2;
		default.DetectionRange[0] = 0.50f;
		default.DetectionRange[1] = 1.00f;

		// BEGIN TEMPERED INI DEFAULTS (generated; do not edit by hand)
		default.DetectionRange.Length = 2;
		default.DetectionRange[0] = 0.500000f;
		default.DetectionRange[1] = 1.000000f;
		// END TEMPERED INI DEFAULTS
		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}

	// Safety: if DetectionRange is somehow empty despite version being current, repopulate
	if (default.DetectionRange.Length < 2)
	{
		default.DetectionRange.Length = 2;
		default.DetectionRange[0] = 0.50f;
		default.DetectionRange[1] = 1.00f;
		static.StaticSaveConfig();
	}
}


static simulated function bool IsCallOutActive(int upgLevel, KFPawn OwnerPawn)
{
	return True;
}

static simulated function ModifyCloakDetectionRange(out float InRange, float DefaultRange, int upgLevel)
{
	if (default.DetectionRange.Length > 0 && upgLevel > 0 && upgLevel <= default.DetectionRange.Length)
		InRange += DefaultRange * default.DetectionRange[upgLevel - 1];
}

static simulated function DrawOnHUD(int upgLevel, canvas C, KFPawn OwnerPawn)
{
	local KFPawn_Monster KFPM;
	local vector ScreenPos, TargetLocation;
	local float HealthPct, BarWidth;

	// Health bars only on Deluxe
	if (upgLevel < 2 || C == None || OwnerPawn == None)
		return;

	foreach OwnerPawn.WorldInfo.AllPawns(class'KFPawn_Monster', KFPM)
	{
		if (!KFPM.IsAliveAndWell())
			continue;

		// Only draw for recently rendered monsters (visible on screen)
		if ((OwnerPawn.WorldInfo.TimeSeconds - KFPM.Mesh.LastRenderTime) > 0.2f)
			continue;

		// Project position above the zed's head
		if (KFPM.bCrawler && KFPM.Floor.Z <= -0.7f && KFPM.Physics == PHYS_Spider)
			TargetLocation = KFPM.Location + vect(0, 0, -1) * KFPM.GetCollisionHeight() * 1.2f * KFPM.CurrentBodyScale;
		else
			TargetLocation = KFPM.Location + vect(0, 0, 1) * KFPM.GetCollisionHeight() * 1.2f * KFPM.CurrentBodyScale;

		ScreenPos = C.Project(TargetLocation);

		// Verify on screen
		if (ScreenPos.X < 0 || ScreenPos.X > C.SizeX || ScreenPos.Y < 0 || ScreenPos.Y > C.SizeY)
			continue;

		HealthPct = FClamp(float(KFPM.Health) / float(KFPM.HealthMax), 0.0f, 1.0f);
		BarWidth = default.HealthBarLength * (float(C.SizeX) / 1920.0f);

		// Draw background (dark)
		C.SetDrawColor(0, 0, 0, 160);
		C.SetPos(ScreenPos.X - BarWidth * 0.5f, ScreenPos.Y - 10.0f);
		C.DrawRect(BarWidth, default.HealthBarHeight);

		// Draw health bar (red to green gradient based on health)
		C.SetDrawColor(255 * (1.0f - HealthPct), 255 * HealthPct, 0, 200);
		C.SetPos(ScreenPos.X - BarWidth * 0.5f, ScreenPos.Y - 10.0f);
		C.DrawRect(BarWidth * HealthPct, default.HealthBarHeight);
	}
}

defaultproperties
{

    // --- Localization (auto-generated by mass_localize_dk_upgrades.py) ---
    // Strings live in KFGame/Localization/<lang>/ZedternalTempered.<langext>
    // Section: [ZTUpgrade_Skill_DeathsGaze]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalTempered"
    LocSection="ZTUpgrade_Skill_DeathsGaze"

	HealthBarLength=40.0f
	HealthBarHeight=4.0f

	UpgradeName="Death's Gaze"
	UpgradeDescription(0)="<font color=\"#CC0000\">Death's Gaze:</font> <font color=\"#9966FF\">See cloaked enemies</font>. <font color=\"#FFFFFF\">+50%</font> <font color=\"#FFAA00\">detection range</font>. The Reaper perceives all living things."
	UpgradeDescription(1)="<font color=\"#CC0000\">Death's Gaze:</font> <font color=\"#9966FF\">See cloaked enemies</font>. <font color=\"#FFFFFF\">+100%</font> <font color=\"#FFAA00\">detection range</font>. Additionally see <font color=\"#FF6666\">enemy health bars</font> on visible enemies."

	UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_DeathsGaze'
	UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_DeathsGaze_Deluxe'

	Name="Default__ZTUpgrade_Skill_DeathsGaze"
}
