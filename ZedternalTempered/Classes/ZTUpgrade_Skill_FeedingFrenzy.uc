// ===================================================================
// ZTUpgrade_Skill_FeedingFrenzy - The Thrill of the Hunt
//
// Collecting a trophy grants a fire rate buff for 6 seconds.
// Normal: +30% fire rate | Deluxe: +60% fire rate
//
// Kill → collect → shoot faster → kill more.
// ===================================================================
class ZTUpgrade_Skill_FeedingFrenzy extends ZTUpgrade_Skill config(ZedternalUnlimited);

var config array<float> FireRateBonus;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.FireRateBonus[0] = 0.30f;
		default.FireRateBonus[1] = 0.60f;

		// BEGIN TEMPERED INI DEFAULTS (generated; do not edit by hand)
		default.FireRateBonus.Length = 2;
		default.FireRateBonus[0] = 0.300000f;
		default.FireRateBonus[1] = 0.600000f;
		// END TEMPERED INI DEFAULTS
		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


static simulated function InitiateWeapon(int upgLevel, KFWeapon KFW, KFPawn OwnerPawn)
{
    local ZTUpgrade_Perk_Predator_Helper H;

    if (KFPawn_Human(OwnerPawn) != None && OwnerPawn.Role == Role_Authority)
    {
        H = class'ZTUpgrade_Perk_Predator'.static.GetHelper(OwnerPawn);
        if (H != None)
        {
            H.SkillFeedingFrenzyBonus = default.FireRateBonus[upgLevel - 1];
            H.SkillFeedingFrenzyDuration = 6.0f;
            `log("[DK_PREDATOR] FeedingFrenzy: +" $ int(H.SkillFeedingFrenzyBonus * 100.0f) $ "% fire rate on collect");
        }
    }
}

static simulated function ModifyRateOfFire(out float InRate, float DefaultRate, int upgLevel, KFWeapon KFW)
{
    local ZTUpgrade_Perk_Predator_Helper H;

    if (KFW != None && KFW.Owner != None)
    {
        H = class'ZTUpgrade_Perk_Predator'.static.GetHelper(KFPawn(KFW.Owner));
        if (H != None && H.bFeedingFrenzyActive)
            InRate = DefaultRate / (DefaultRate / InRate + H.SkillFeedingFrenzyBonus);
    }
}

static simulated function ModifyMeleeAttackSpeed(out float InDuration, float DefaultDuration, int upgLevel, KFWeapon KFW)
{
    local ZTUpgrade_Perk_Predator_Helper H;

    if (KFW != None && KFW.Owner != None)
    {
        H = class'ZTUpgrade_Perk_Predator'.static.GetHelper(KFPawn(KFW.Owner));
        if (H != None && H.bFeedingFrenzyActive)
            InDuration = DefaultDuration / (DefaultDuration / InDuration + H.SkillFeedingFrenzyBonus);
    }
}

defaultproperties
{

    // --- Localization (auto-generated by mass_localize_dk_upgrades.py) ---
    // Strings live in KFGame/Localization/<lang>/ZedternalTempered.<langext>
    // Section: [ZTUpgrade_Skill_FeedingFrenzy]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalTempered"
    LocSection="ZTUpgrade_Skill_FeedingFrenzy"

    UpgradeName="Feeding Frenzy"
    UpgradeDescription(0)="<font color=\"#FFD700\">Feeding Frenzy:</font> Collecting a trophy grants <font color=\"#FFFFFF\">+30%</font> <font color=\"#FF6666\">fire rate</font> for <font color=\"#87CEEB\">6</font> seconds"
    UpgradeDescription(1)="<font color=\"#FFD700\">Feeding Frenzy:</font> Collecting a trophy grants <font color=\"#FFFFFF\">+60%</font> <font color=\"#FF6666\">fire rate</font> for <font color=\"#87CEEB\">6</font> seconds"
    UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_FeedingFrenzy'
    UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_FeedingFrenzy_Deluxe'

    Name="Default__ZTUpgrade_Skill_FeedingFrenzy"
}
