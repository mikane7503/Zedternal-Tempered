    upgradeDescription(1)="<font color=\"#962ab9\">Decrease</font> your <font color=\"#962ab9\">Maximum Health</font> by <font color=\"#cb1b43\">60%</font>. Gain <font color=\"#84d6d0\">20% Movement Speed</font>."
