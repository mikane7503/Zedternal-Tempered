class ZTUpgrade_Skill_ToxicAura extends ZTUpgrade_Skill config(ZedternalUnlimited);

var config array<float> AuraRange;
var config array<int> AuraDamage;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.AuraRange[0] = 300.0f;
		default.AuraRange[1] = 500.0f;
		default.AuraDamage[0] = 2;
		default.AuraDamage[1] = 4;

		// BEGIN TEMPERED INI DEFAULTS (generated; do not edit by hand)
		default.AuraRange.Length = 2;
		default.AuraRange[0] = 300.000000f;
		default.AuraRange[1] = 500.000000f;
		default.AuraDamage.Length = 2;
		default.AuraDamage[0] = 2;
		default.AuraDamage[1] = 4;
		// END TEMPERED INI DEFAULTS
		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


static simulated function InitiateWeapon(int upgLevel, KFWeapon KFW, KFPawn OwnerPawn)
{
    local ZTUpgrade_Skill_ToxicAura_Helper AuraHelper;
    local bool bFound;

    if (KFPawn_Human(OwnerPawn) != None && OwnerPawn.Role == Role_Authority)
    {
        bFound = False;
        foreach OwnerPawn.ChildActors(class'ZTUpgrade_Skill_ToxicAura_Helper', AuraHelper)
        {
            bFound = True;
            break;
        }

        if (!bFound)
        {
            AuraHelper = OwnerPawn.Spawn(class'ZTUpgrade_Skill_ToxicAura_Helper', OwnerPawn);
            AuraHelper.UpgradeLevel = upgLevel;
        }
    }
}

static function ZTUpgrade_Skill_ToxicAura_Helper GetHelper(Pawn OwnerPawn)
{
    local ZTUpgrade_Skill_ToxicAura_Helper AuraHelper;

    if (KFPawn_Human(OwnerPawn) != None)
    {
        foreach OwnerPawn.ChildActors(class'ZTUpgrade_Skill_ToxicAura_Helper', AuraHelper)
        {
            return AuraHelper;
        }

        // Create one if needed
        AuraHelper = OwnerPawn.Spawn(class'ZTUpgrade_Skill_ToxicAura_Helper', OwnerPawn);
    }

    return AuraHelper;
}

static simulated function DeleteHelperClass(Pawn OwnerPawn)
{
    local ZTUpgrade_Skill_ToxicAura_Helper AuraHelper;

    if (OwnerPawn != None)
    {
        foreach OwnerPawn.ChildActors(class'ZTUpgrade_Skill_ToxicAura_Helper', AuraHelper)
        {
            AuraHelper.Destroy();
        }
    }
}

