    bShouldLocalize=True
    LocPackage="ZedternalTempered"
    LocSection="ZTUpgrade_Skill_ToxicImmunity"

    UpgradeName="Toxic Immunity"
    UpgradeDescription(0)="<font color=\"#8B008B\">Toxic Immunity:</font> <font color=\"#FFFFFF\">15%</font> <font color=\"#00FF00\">poison damage resistance</font>."
    UpgradeDescription(1)="<font color=\"#8B008B\">Toxic Immunity (Deluxe):</font> <font color=\"#FFFFFF\">30%</font> <font color=\"#00FF00\">poison damage resistance</font>."
    
    UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_ToxicImmunity'
    UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_ToxicImmunity_Deluxe'
    
    Name="Default__ZTUpgrade_Skill_ToxicImmunity"
