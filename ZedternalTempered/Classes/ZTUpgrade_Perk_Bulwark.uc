	upgradeDescription(0)="Increase <font color=\"#15d7fa\">Damage</font> of <font color=\"#476d5c\">Berserker</font> and <font color=\"#476d5c\">Firebug</font> weapons by <font color=\"#77d914\">%x%%</font>."
	upgradeDescription(1)="Increase <font color=\"#15d7fa\">Maximum Health</font> by <font color=\"#77d914\">%x%%</font>."
	upgradeDescription(2)="Increase <font color=\"#15d7fa\">Maximum Armor</font> by <font color=\"#77d914\">%x%%</font>."
