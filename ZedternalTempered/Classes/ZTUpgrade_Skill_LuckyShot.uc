class ZTUpgrade_Skill_LuckyShot extends ZTUpgrade_Skill config(ZedternalUnlimited);

var config array<float> LuckyChance;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.LuckyChance[0] = 0.10f;
		default.LuckyChance[1] = 0.20f;

		// BEGIN TEMPERED INI DEFAULTS (generated; do not edit by hand)
		default.LuckyChance.Length = 2;
		default.LuckyChance[0] = 0.100000f;
		default.LuckyChance[1] = 0.200000f;
		// END TEMPERED INI DEFAULTS
		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


static function ModifyDamageGiven(out int InDamage, int DefaultDamage, int upgLevel, optional Actor DamageCauser, optional KFPawn_Monster MyKFPM, optional KFPlayerController DamageInstigator, optional class<KFDamageType> DamageType, optional int HitZoneIdx, optional KFWeapon MyKFW)
{
    // Only process rifle headshots
    if (MyKFPM == None || MyKFW == None || DamageInstigator == None || HitZoneIdx != HZI_HEAD)
        return;
    
    // Check if weapon is a rifle
    if (!IsRifleWeapon(MyKFW))
        return;
    
    // Lucky shot chance - refund the round that was just consumed. Route through
    // the controller so the magazine write reaches the owning client; a bare
    // server-side AmmoCount write does not replicate to a predicting client, so
    // the refund did nothing on dedicated/remote clients.
    if (FRand() < default.LuckyChance[upgLevel - 1] && ZTPlayerController(DamageInstigator) != None)
        ZTPlayerController(DamageInstigator).RefundWeaponAmmo(MyKFW, 1, 0);
}

static function bool IsRifleWeapon(KFWeapon KFW)
{
    if (KFW == None)
        return False;
    
    // Match the "_Rifle_" class-name segment (KFWeap_Rifle_*, DKWeap_Rifle_*) so
    // this targets Sharpshooter rifles as the description states. The old bare
    // "Rifle" substring also matched KFWeap_AssaultRifle_* and friends, which
    // wrongly let assault rifles trigger the refund once it started working.
    return InStr(PathName(KFW.Class), "_Rifle_") != INDEX_NONE;
}

defaultproperties
{
    
