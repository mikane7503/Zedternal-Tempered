    // Strings live in KFGame/Localization/<lang>/ZedternalTempered.<langext>
    // Section: [ZTUpgrade_Skill_LuckyShot]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalTempered"
    LocSection="ZTUpgrade_Skill_LuckyShot"

    UpgradeName="Lucky Shot"
    UpgradeDescription(0)="Rifle headshots have a <font color=\"#77d914\">10%</font> chance to <font color=\"#15d7fa\">not consume ammo</font> from your magazine."
    UpgradeDescription(1)="Rifle headshots have a <font color=\"#77d914\">20%</font> chance to <font color=\"#15d7fa\">not consume ammo</font> from your magazine."
    
    UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_LuckyShot'
    UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_LuckyShot_Deluxe'
    
    Name="Default__ZTUpgrade_Skill_LuckyShot"
}