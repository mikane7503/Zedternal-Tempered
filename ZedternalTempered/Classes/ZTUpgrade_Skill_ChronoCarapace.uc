// ===================================================================
// ZTUpgrade_Skill_ChronoCarapace - Temporal Exoskeleton
// Theme: Symbiote hardens into a temporal shell during ZED Time,
//        reducing damage taken. Deluxe: lingering protection for
//        3 seconds after ZED Time ends.
// Hooks: ModifyDamageTaken (ZED Time gated + helper for lingering)
// ===================================================================
class ZTUpgrade_Skill_ChronoCarapace extends ZTUpgrade_Skill config(ZedternalUnlimited);

var config array<float> ZedTimeDR;
var config float LingeringDR;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.ZedTimeDR[0] = 0.3f;
		default.ZedTimeDR[1] = 0.5f;
		default.LingeringDR = 0.15f;

		// BEGIN TEMPERED INI DEFAULTS (generated; do not edit by hand)
		default.ZedTimeDR.Length = 2;
		default.ZedTimeDR[0] = 0.200000f;
		default.ZedTimeDR[1] = 0.350000f;
		default.LingeringDR = 0.120000f;
		// END TEMPERED INI DEFAULTS
		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


static function ModifyDamageTaken(out int InDamage, int DefaultDamage, int upgLevel, KFPawn OwnerPawn, optional class<DamageType> DamageType, optional Controller InstigatedBy, optional KFWeapon MyKFW)
{
	local ZTUpgrade_Skill_ChronoCarapace_Helper Helper;

	if (OwnerPawn == None)
		return;

	// Full damage reduction during ZED Time
	if (OwnerPawn.WorldInfo.TimeDilation < 1.0)
	{
		InDamage -= Round(float(DefaultDamage) * default.ZedTimeDR[upgLevel - 1]);
	}
	else if (upgLevel > 1)
	{
		// Deluxe: lingering damage reduction after ZED Time
		Helper = GetHelper(OwnerPawn);
		if (Helper != None && Helper.bLingeringProtection)
			InDamage -= Round(float(DefaultDamage) * default.LingeringDR);
	}
}

// ===================================================================
// Helper Management (only spawned for Deluxe)
// ===================================================================
static simulated function InitiateWeapon(int upgLevel, KFWeapon KFW, KFPawn OwnerPawn)
{
	local ZTUpgrade_Skill_ChronoCarapace_Helper UPG;
	local bool bFound;

	// Only spawn helper for Deluxe (lingering effect)
	if (upgLevel > 1 && KFPawn_Human(OwnerPawn) != None && OwnerPawn.Role == Role_Authority)
	{
		bFound = False;
		foreach OwnerPawn.ChildActors(class'ZTUpgrade_Skill_ChronoCarapace_Helper', UPG)
		{
			bFound = True;
			break;
		}

		if (!bFound)
			OwnerPawn.Spawn(class'ZTUpgrade_Skill_ChronoCarapace_Helper', OwnerPawn);
	}
}

static function ZTUpgrade_Skill_ChronoCarapace_Helper GetHelper(KFPawn OwnerPawn)
{
	local ZTUpgrade_Skill_ChronoCarapace_Helper UPG;

	if (KFPawn_Human(OwnerPawn) != None)
	{
		foreach OwnerPawn.ChildActors(class'ZTUpgrade_Skill_ChronoCarapace_Helper', UPG)
		{
			return UPG;
		}
	}

	return None;
}

static simulated function DeleteHelperClass(Pawn OwnerPawn)
{
	local ZTUpgrade_Skill_ChronoCarapace_Helper UPG;

	if (OwnerPawn != None)
	{
		foreach OwnerPawn.ChildActors(class'ZTUpgrade_Skill_ChronoCarapace_Helper', UPG)
		{
			UPG.Destroy();
		}
	}
}

defaultproperties
{

    // --- Localization (auto-generated by mass_localize_dk_upgrades.py) ---
    // Strings live in KFGame/Localization/<lang>/ZedternalTempered.<langext>
    // Section: [ZTUpgrade_Skill_ChronoCarapace]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalTempered"
    LocSection="ZTUpgrade_Skill_ChronoCarapace"

	UpgradeName="Chrono-Carapace"
	upgradeDescription(0)="During <font color=\"#9632ff\">ZED Time</font>, take <font color=\"#d8b0ff\">20%</font> less damage from all sources."
	upgradeDescription(1)="During <font color=\"#9632ff\">ZED Time</font>, take <font color=\"#d8b0ff\">35%</font> less damage. <font color=\"#FFFFFF\">Lingering Protection</font>: take <font color=\"#d8b0ff\">12%</font> less damage for <font color=\"#d8b0ff\">3</font> seconds after ZED Time ends."
	UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_ChronoCarapace'
	UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_ChronoCarapace_Deluxe'

	Name="Default__ZTUpgrade_Skill_ChronoCarapace"
}
