class ZTUpgrade_Skill_HammerShot extends ZTUpgrade_Skill config(ZedternalUnlimited);

var config array<float> Spread;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.Spread[0] = 0.5f;
		default.Spread[1] = 1.0f;

		// BEGIN TEMPERED INI DEFAULTS (generated; do not edit by hand)
		default.Spread.Length = 2;
		default.Spread[0] = 0.200000f;
		default.Spread[1] = 0.500000f;
		// END TEMPERED INI DEFAULTS
		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


static simulated function ModifyTightChokePassive(out float tightChokeFactor, int upgLevel)
{
	if (upgLevel > 0 && upgLevel <= default.Spread.Length)
		tightChokeFactor -= default.Spread[upgLevel - 1];
}

