// ===================================================================
// ZTUpgrade_Skill_WildCard - Gambit Skill
//
// "Wild Card" - Each kill during an active gambit has a small chance
// to instantly complete the gambit, regardless of progress.
//
// Standard: 1% chance per kill.
// Deluxe:   2% chance per kill.
//
// Pure signal skill -- all logic lives in the Gambit Helper.
// ===================================================================
class ZTUpgrade_Skill_WildCard extends ZTUpgrade_Skill;

// Signal presence to Gambit Helper via ExtensionFuncInteger
// Returns upgLevel (1=standard, 2=deluxe) when queried with "GambitWildCard"
static simulated function ExtensionFuncInteger(out int InValue, int DefaultValue, int upgLevel, string Identifier,
    KFWeapon MyKFW, KFPawn OwnerPawn, optional int InputInt, optional float InputFloat, optional name InputClassName,
    optional Object InputObject1, optional Object InputObject2, optional Object InputObject3)
{
    if (Identifier ~= "GambitWildCard")
        InValue = upgLevel;
}

defaultproperties
{
    // --- Localization (auto-generated by mass_localize_dk_upgrades.py) ---
    // Strings live in KFGame/Localization/<lang>/ZedternalTempered.<langext>
    // Section: [ZTUpgrade_Skill_WildCard]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalTempered"
    LocSection="ZTUpgrade_Skill_WildCard"

    UpgradeName="Wild Card"
    upgradeDescription(0)="Each kill during an active gambit has a <font color=\"#FFD700\">1%</font> chance to instantly complete it."
    upgradeDescription(1)="Each kill during an active gambit has a <font color=\"#FFD700\">2%</font> chance to instantly complete it."
    UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_WildCard'
    UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_WildCard_Deluxe'

    Name="Default__ZTUpgrade_Skill_WildCard"
}
