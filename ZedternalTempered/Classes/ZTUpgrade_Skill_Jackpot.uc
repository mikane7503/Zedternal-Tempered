class ZTUpgrade_Skill_Jackpot extends ZTUpgrade_Skill config(ZedternalUnlimited);

var config array<float> Chance;
var config array<int> Jackpot;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.Chance[0] = 0.005f;
		default.Chance[1] = 0.010f;
		default.Jackpot[0] = 300;
		default.Jackpot[1] = 600;

		// BEGIN TEMPERED INI DEFAULTS (generated; do not edit by hand)
		default.Chance.Length = 2;
		default.Chance[0] = 0.005000f;
		default.Chance[1] = 0.005000f;
		default.Jackpot.Length = 2;
		default.Jackpot[0] = 350;
		default.Jackpot[1] = 700;
		// END TEMPERED INI DEFAULTS
		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


static function ModifyDamageGiven(out int InDamage, int DefaultDamage, int upgLevel, optional Actor DamageCauser, optional KFPawn_Monster MyKFPM, optional KFPlayerController DamageInstigator, optional class<KFDamageType> DamageType, optional int HitZoneIdx, optional KFWeapon MyKFW)
{
    local KFPawn_Human KFPH;

    if((DamageInstigator != none) && DamageInstigator.Pawn != none)
    {
        KFPH = KFPawn_Human(DamageInstigator.Pawn);
        
        if((KFPH != none) && KFPH.IsAliveAndWell())
        {
            if(((FRand() <= (default.Chance[upgLevel - 1]) && MyKFPM != none) && MyKFPM.IsAliveAndWell()) && (MyKFPM.Health - InDamage) <= 0)
            {
              KFPlayerReplicationInfo(DamageInstigator.PlayerReplicationInfo).AddDosh(default.Jackpot[upgLevel - 1]);
            }
	    }
	}
}

defaultproperties
{
    // --- Localization (auto-generated by mass_localize_dk_upgrades.py) ---
    // Strings live in KFGame/Localization/<lang>/ZedternalTempered.<langext>
    // Section: [ZTUpgrade_Skill_Jackpot]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalTempered"
    LocSection="ZTUpgrade_Skill_Jackpot"

    UpgradeName="Jackpot"
	upgradeDescription(0)="Every ZED you kill has a <font color=\"#ff3399\">0.05% Chance</font> to <font color=\"#66cc00\">hit the Jackpot</font> and grant <font color=\"#be4d25\">350 Dosh</font>."
	upgradeDescription(1)="Every ZED you kill has a <font color=\"#ff3399\">0.5% Chance</font> to <font color=\"#66cc00\">hit the Jackpot</font> and grant <font color=\"#be4d25\">700 Dosh</font>."
	UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_Jackpot'
	UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_Jackpot_Deluxe'
    Name="Default__ZTUpgrade_Skill_Jackpot"
}