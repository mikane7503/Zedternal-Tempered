// ===================================================================
// ZTUpgrade_Skill_Perfectionist
//
// "Perfectionist"
// Gain permanent stacking damage for each prophecy completed
// without ever suffering doom (since purchasing this skill).
// The first doom permanently destroys the entire bonus.
//
// Standard: +3% damage per perfect wave
// Deluxe:   +4% damage per perfect wave
// ===================================================================
class ZTUpgrade_Skill_Perfectionist extends ZTUpgrade_Skill config(ZedternalUnlimited);

var config float DamagePerWave;         // Standard: 3%
var config float DamagePerWaveDeluxe;   // Deluxe: 4%
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.DamagePerWave = 0.03f;
		default.DamagePerWaveDeluxe = 0.04f;

		// BEGIN TEMPERED INI DEFAULTS (generated; do not edit by hand)
		default.DamagePerWave = 0.030000f;
		default.DamagePerWaveDeluxe = 0.040000f;
		// END TEMPERED INI DEFAULTS
		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


static function ModifyDamageGiven(out int InDamage, int DefaultDamage, int upgLevel,
    optional Actor DamageCauser, optional KFPawn_Monster MyKFPM,
    optional KFPlayerController DamageInstigator, optional class<KFDamageType> DamageType,
    optional int HitZoneIdx, optional KFWeapon MyKFW)
{
    local ZTUpgrade_Skill_Perfectionist_Helper H;
    local float BonusPerWave;

    if (DamageInstigator == None || DamageInstigator.Pawn == None)
        return;

    foreach DamageInstigator.Pawn.ChildActors(class'ZTUpgrade_Skill_Perfectionist_Helper', H)
    {
        if (H.bPerfectRecord && H.PerfectWaveCount > 0)
        {
            if (upgLevel >= 2)
                BonusPerWave = default.DamagePerWaveDeluxe;
            else
                BonusPerWave = default.DamagePerWave;

            InDamage += Round(float(DefaultDamage) * BonusPerWave * float(H.PerfectWaveCount));
        }
        break;
    }
}

// --- Helper spawning ---
static simulated function InitiateWeapon(int upgLevel, KFWeapon KFW, KFPawn OwnerPawn)
{
    local ZTUpgrade_Skill_Perfectionist_Helper H;
    local bool bFound;

    if (KFPawn_Human(OwnerPawn) != None && OwnerPawn.Role == ROLE_Authority)
    {
        bFound = false;
        foreach OwnerPawn.ChildActors(class'ZTUpgrade_Skill_Perfectionist_Helper', H)
        {
            bFound = true;
            H.Initialize(upgLevel);
            break;
        }

        if (!bFound)
        {
            H = OwnerPawn.Spawn(class'ZTUpgrade_Skill_Perfectionist_Helper', OwnerPawn);
            if (H != None)
                H.Initialize(upgLevel);
        }
    }
}

static simulated function DeleteHelperClass(Pawn OwnerPawn)
{
    local ZTUpgrade_Skill_Perfectionist_Helper H;

    if (OwnerPawn != None)
    {
        foreach OwnerPawn.ChildActors(class'ZTUpgrade_Skill_Perfectionist_Helper', H)
        {
            H.Cleanup();
            H.Destroy();
        }
    }
}

defaultproperties
{

    // --- Localization (auto-generated by mass_localize_dk_upgrades.py) ---
    // Strings live in KFGame/Localization/<lang>/ZedternalTempered.<langext>
    // Section: [ZTUpgrade_Skill_Perfectionist]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalTempered"
    LocSection="ZTUpgrade_Skill_Perfectionist"

    UpgradeName="Perfectionist"
    UpgradeDescription(0)="Gain <font color=\"#15d7fa\">+3% permanent damage</font> per completed prophecy. Your first <font color=\"#ff0000\">doom permanently destroys</font> the entire bonus."
    UpgradeDescription(1)="Gain <font color=\"#15d7fa\">+4% permanent damage</font> per completed prophecy. Your first <font color=\"#ff0000\">doom permanently destroys</font> the entire bonus."

    UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_Perfectionist_Deluxe'

    Name="Default__ZTUpgrade_Skill_Perfectionist"
}
