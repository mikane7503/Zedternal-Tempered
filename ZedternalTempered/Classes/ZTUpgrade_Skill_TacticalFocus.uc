	upgradeDescription(0)="Unlocks <font color=\"#66cc00\">Tactical Focus</font> active ability: <font color=\"#00ffff\">+20% reload speed</font> for <font color=\"#ffaa33\">10 seconds</font>. Cooldown: <font color=\"#ff9900\">60 seconds</font>."
	
	upgradeDescription(1)="Unlocks <font color=\"#66cc00\">Tactical Focus (Deluxe)</font> active ability: <font color=\"#00ffff\">+30% reload speed</font> for <font color=\"#ffaa33\">10 seconds</font>. Cooldown: <font color=\"#ff9900\">30 seconds</font>."
	
	UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_TacticalFocus'
	UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_TacticalFocus_Deluxe'
	
	Name="Default__ZTUpgrade_Skill_TacticalFocus"
}