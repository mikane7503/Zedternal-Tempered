// Miasma: Passive toxic aura that constantly poisons nearby ZEDs.
// Walking area-denial zone. Trash melts from proximity.
// Pattern based on HotPepper.
class ZTUpgrade_Skill_Miasma extends ZTUpgrade_Skill;

static simulated function InitiateWeapon(int upgLevel, KFWeapon KFW, KFPawn OwnerPawn)
{
	local ZTUpgrade_Skill_Miasma_Helper UPG;
	local bool bFound;

	if (KFPawn_Human(OwnerPawn) != None && OwnerPawn.Role == Role_Authority)
	{
		bFound = False;
		foreach OwnerPawn.ChildActors(class'ZTUpgrade_Skill_Miasma_Helper', UPG)
		{
			bFound = True;
			break;
		}

		if (!bFound)
			UPG = OwnerPawn.Spawn(class'ZTUpgrade_Skill_Miasma_Helper', OwnerPawn);

		// Refresh tier every init so upgrading Standard -> Deluxe mid-game raises
		// the aura damage. The helper persists across the upgrade, so setting
		// bDeluxe only on spawn left already-spawned helpers stuck on Standard.
		if (UPG != None)
			UPG.bDeluxe = (upgLevel > 1);
	}
}

static simulated function DeleteHelperClass(Pawn OwnerPawn)
{
	local ZTUpgrade_Skill_Miasma_Helper UPG;

	if (OwnerPawn != None)
	{
		foreach OwnerPawn.ChildActors(class'ZTUpgrade_Skill_Miasma_Helper', UPG)
		{
			UPG.Destroy();
		}
	}
}

defaultproperties
{
    // --- Localization (auto-generated by mass_localize_dk_upgrades.py) ---
    // Strings live in KFGame/Localization/<lang>/ZedternalTempered.<langext>
    // Section: [ZTUpgrade_Skill_Miasma]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalTempered"
    LocSection="ZTUpgrade_Skill_Miasma"

	UpgradeDescription(0)="Emit a <font color=\"#399c0e\">toxic aura</font> that constantly <font color=\"#8fce00\">Poisons</font> nearby ZEDs, dealing up to <font color=\"#399c0e\">1.5% max HP</font> per second (reduced vs giants and bosses)."
	UpgradeDescription(1)="Emit a <font color=\"#b346ea\">toxic aura</font> that constantly <font color=\"#8fce00\">Poisons</font> nearby ZEDs, dealing up to <font color=\"#b346ea\">3% max HP</font> per second (reduced vs giants and bosses)."

	UpgradeName="Miasma"
	UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_Miasma'
	UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_Miasma_Deluxe'

	Name="Default__ZTUpgrade_Skill_Miasma"
}
