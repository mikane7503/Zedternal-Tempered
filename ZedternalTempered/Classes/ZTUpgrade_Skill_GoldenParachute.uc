class ZTUpgrade_Skill_GoldenParachute extends ZTUpgrade_Skill config(ZedternalUnlimited);

var config array<int> DoshAmount;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.DoshAmount[0] = 250;
		default.DoshAmount[1] = 500;

		// BEGIN TEMPERED INI DEFAULTS (generated; do not edit by hand)
		default.DoshAmount.Length = 2;
		default.DoshAmount[0] = 400;
		default.DoshAmount[1] = 800;
		// END TEMPERED INI DEFAULTS
		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


static function PlayerDied(int upgLevel, KFPlayerController KFPC)
{
    local KFPlayerController TeammatePCs;
    local KFPlayerReplicationInfo TeammatePRI, DeadPlayerPRI;
    local int DoshToGive, LowestDosh;
    local KFPlayerController TargetPC;
    local bool bDeluxe;
    
    if (KFPC == None || upgLevel <= 0) return;
    
    DeadPlayerPRI = KFPlayerReplicationInfo(KFPC.PlayerReplicationInfo);
    if (DeadPlayerPRI == None) return;
    
    bDeluxe = (upgLevel > 1);
    DoshToGive = default.DoshAmount[upgLevel - 1];
    
    if (bDeluxe)
    {
        // Deluxe: Give to teammate with least dosh
        LowestDosh = 999999;
        TargetPC = None;
        
        foreach KFPC.WorldInfo.AllControllers(class'KFPlayerController', TeammatePCs)
        {
            if (TeammatePCs != KFPC) // Don't give to self (dead player)
            {
                TeammatePRI = KFPlayerReplicationInfo(TeammatePCs.PlayerReplicationInfo);
                if (TeammatePRI != None && TeammatePRI.Score < LowestDosh)
                {
                    LowestDosh = TeammatePRI.Score;
                    TargetPC = TeammatePCs;
                }
            }
        }
        
        if (TargetPC != None)
        {
            TeammatePRI = KFPlayerReplicationInfo(TargetPC.PlayerReplicationInfo);
            TeammatePRI.AddDosh(DoshToGive);
            
            // Critical - recipient gets major death benefit
            class'ZTMessageManager'.static.SendCritical(TargetPC, "GOLDEN PARACHUTE! Received " $ DoshToGive $ " Dosh from " $ DeadPlayerPRI.PlayerName $ "'s death");
            
            // Minor - inform other teammates
            foreach KFPC.WorldInfo.AllControllers(class'KFPlayerController', TeammatePCs)
            {
                if (TeammatePCs != TargetPC && TeammatePCs != KFPC)
                {
                    class'ZTMessageManager'.static.SendMinor(TeammatePCs, DeadPlayerPRI.PlayerName $ "'s golden parachute gave " $ DoshToGive $ " Dosh to " $ TeammatePRI.PlayerName);
                }
            }
        }
    }
    else
    {
        // Basic: Give to random teammate
        foreach KFPC.WorldInfo.AllControllers(class'KFPlayerController', TeammatePCs)
        {
            if (TeammatePCs != KFPC) // Don't give to self (dead player)
            {
                TeammatePRI = KFPlayerReplicationInfo(TeammatePCs.PlayerReplicationInfo);
                if (TeammatePRI != None)
                {
                    // Simple random selection using first available teammate
                    if (FRand() > 0.5f || TargetPC == None)
                    {
                        TargetPC = TeammatePCs;
                    }
                }
            }
        }
        
        if (TargetPC != None)
        {
            TeammatePRI = KFPlayerReplicationInfo(TargetPC.PlayerReplicationInfo);
            TeammatePRI.AddDosh(DoshToGive);
            
            // Critical - recipient gets major death benefit
            class'ZTMessageManager'.static.SendCritical(TargetPC, "GOLDEN PARACHUTE! Received " $ DoshToGive $ " Dosh from " $ DeadPlayerPRI.PlayerName $ "'s death");
            
            // Minor - inform other teammates
            foreach KFPC.WorldInfo.AllControllers(class'KFPlayerController', TeammatePCs)
            {
                if (TeammatePCs != TargetPC && TeammatePCs != KFPC)
                {
                    class'ZTMessageManager'.static.SendMinor(TeammatePCs, DeadPlayerPRI.PlayerName $ "'s golden parachute gave " $ DoshToGive $ " Dosh to " $ TeammatePRI.PlayerName);
                }
            }
        }
    }
}

defaultproperties
{
    // --- Localization (auto-generated by mass_localize_dk_upgrades.py) ---
    // Strings live in KFGame/Localization/<lang>/ZedternalTempered.<langext>
    // Section: [ZTUpgrade_Skill_GoldenParachute]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalTempered"
    LocSection="ZTUpgrade_Skill_GoldenParachute"

    UpgradeName="Golden Parachute"
    
    upgradeDescription(0)="Dying grants <font color=\"#00ff00\">400 dosh</font> to a <font color=\"#ffaa33\">random teammate</font>."
    upgradeDescription(1)="Dying grants <font color=\"#00ff00\">800 dosh</font> to the teammate with <font color=\"#ffaa33\">least dosh</font>."
    
    UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_GoldenParachute'
    UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_GoldenParachute_Deluxe'

    Name="Default__ZTUpgrade_Skill_GoldenParachute"
}