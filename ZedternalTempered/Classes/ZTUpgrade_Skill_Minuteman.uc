	upgradeDescription(0)="You can see <font color=\"#15d7fa\">Enemy Health</font> and deal <font color=\"#77d914\">35%</font> more damage to ZEDs below 35% health."
	upgradeDescription(1)="You can see <font color=\"#15d7fa\">Enemy Health</font> and deal <font color=\"#77d914\">70%</font> more damage to ZEDs below 35% health."
