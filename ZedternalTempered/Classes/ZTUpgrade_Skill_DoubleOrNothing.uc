// ===================================================================
// ZTUpgrade_Skill_DoubleOrNothing - Gambit Skill
//
// "Double or Nothing" - When a gambit is completed, a coin is flipped.
// Heads: rewards are doubled. Tails: rewards are lost entirely.
//
// Standard: 50/50 odds.
// Deluxe:   60/40 odds in the player's favor.
//
// Pure signal skill -- all logic lives in the Gambit Helper.
// ===================================================================
class ZTUpgrade_Skill_DoubleOrNothing extends ZTUpgrade_Skill;

// Signal presence to Gambit Helper via ExtensionFuncInteger
// Returns upgLevel (1=standard, 2=deluxe) when queried with "GambitDoubleOrNothing"
static simulated function ExtensionFuncInteger(out int InValue, int DefaultValue, int upgLevel, string Identifier,
    KFWeapon MyKFW, KFPawn OwnerPawn, optional int InputInt, optional float InputFloat, optional name InputClassName,
    optional Object InputObject1, optional Object InputObject2, optional Object InputObject3)
{
    if (Identifier ~= "GambitDoubleOrNothing")
        InValue = upgLevel;
}

defaultproperties
{
    // --- Localization (auto-generated by mass_localize_dk_upgrades.py) ---
    // Strings live in KFGame/Localization/<lang>/ZedternalTempered.<langext>
    // Section: [ZTUpgrade_Skill_DoubleOrNothing]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalTempered"
    LocSection="ZTUpgrade_Skill_DoubleOrNothing"

    UpgradeName="Double or Nothing"
    upgradeDescription(0)="Completed gambits flip a coin. <font color=\"#FFD700\">Heads</font>: rewards doubled. <font color=\"#FF4444\">Tails</font>: rewards lost. Odds: <font color=\"#FFFFFF\">50/50</font>."
    upgradeDescription(1)="Completed gambits flip a coin. <font color=\"#FFD700\">Heads</font>: rewards doubled. <font color=\"#FF4444\">Tails</font>: rewards lost. Odds: <font color=\"#FFFFFF\">60/40</font> in your favor."
    UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_DoubleOrNothing'
    UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_DoubleOrNothing_Deluxe'

    Name="Default__ZTUpgrade_Skill_DoubleOrNothing"
}
