    LocSection="ZTUpgrade_Skill_FleshWeaving"

	UpgradeName="Flesh Weaving"
	UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_FleshWeaving'
    UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_FleshWeaving_Deluxe'
	UpgradeDescription(0)="The symbiote rapidly repairs tissue damage. <font color='#00FF7F'>2%</font> chance to heal <font color='#00FF7F'>2 HP</font> when taking <font color='#00FF7F'>2+</font> <font color='#9370DB'>damage</font>. <font color='#00FF7F'>+2%</font> <font color='#9370DB'>healing received</font>."
	UpgradeDescription(1)="The symbiote weaves flesh with enhanced efficiency. <font color='#00FF7F'>5%</font> chance to heal <font color='#00FF7F'>4 HP</font> when taking <font color='#00FF7F'>5+</font> <font color='#9370DB'>damage</font>. <font color='#00FF7F'>+5%</font> <font color='#9370DB'>healing received</font>. Reduces incoming damage by <font color='#00FF7F'>2</font>."
	
	Name="Default__ZTUpgrade_Skill_FleshWeaving"
}
