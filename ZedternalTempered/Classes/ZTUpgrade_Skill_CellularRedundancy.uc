class ZTUpgrade_Skill_CellularRedundancy extends ZTUpgrade_Skill abstract config(ZedternalUnlimited);

var config array<float> SurvivalChance;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.SurvivalChance[0] = 0.08f;
		default.SurvivalChance[1] = 0.15f;

		// BEGIN TEMPERED INI DEFAULTS (generated; do not edit by hand)
		default.SurvivalChance.Length = 2;
		default.SurvivalChance[0] = 0.040000f;
		default.SurvivalChance[1] = 0.075000f;
		// END TEMPERED INI DEFAULTS
		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


static function ModifyDamageTaken(out int InDamage, int DefaultDamage, int upgLevel, KFPawn OwnerPawn, optional class<DamageType> DamageType, optional Controller InstigatedBy, optional KFWeapon MyKFW)
{
	local KFPawn_Human KFPawnHuman;
	local KFPlayerController KFPC;
	local bool bWouldDie;
	
	if (OwnerPawn == None)
		return;
		
	KFPawnHuman = KFPawn_Human(OwnerPawn);
	if (KFPawnHuman == None)
		return;
		
	KFPC = KFPlayerController(KFPawnHuman.Controller);
	if (KFPC == None)
		return;
		
	// Check if this damage would be fatal
	bWouldDie = (KFPawnHuman.Health - InDamage) <= 0;
	
	if (!bWouldDie)
		return;
	
	if (FRand() < default.SurvivalChance[upgLevel - 1])
	{
		// Reduce damage to leave player at 1 HP
		InDamage = KFPawnHuman.Health - 1;
	}
}

defaultproperties
{
	
    // --- Localization (auto-generated by mass_localize_dk_upgrades.py) ---
    // Strings live in KFGame/Localization/<lang>/ZedternalTempered.<langext>
    // Section: [ZTUpgrade_Skill_CellularRedundancy]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalTempered"
    LocSection="ZTUpgrade_Skill_CellularRedundancy"

	UpgradeName="Cellular Redundancy"
	UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_CellularRedundancy'
    UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_CellularRedundancy_Deluxe'
	UpgradeDescription(0)="The symbiote establishes multiple redundant organ systems. <font color='#00FF7F'>4%</font> chance to survive fatal damage with <font color='#00FF7F'>1 HP</font>."
	UpgradeDescription(1)="The symbiote establishes multiple redundant organ systems. <font color='#00FF7F'>7.5%</font> chance to survive fatal damage with <font color='#00FF7F'>1 HP</font>."
	
	Name="Default__ZTUpgrade_Skill_CellularRedundancy"
}