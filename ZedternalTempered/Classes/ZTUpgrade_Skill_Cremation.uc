    bShouldLocalize=True
    LocPackage="ZedternalTempered"
    LocSection="ZTUpgrade_Skill_Cremation"

	UpgradeName="Cremation"
	upgradeDescription(0)="Deal <font color=\"#84d6d0\">30%</font> more <font color=\"#42e087\">damage</font> to enemies below <font color=\"#84d6d0\">40%</font> health."
	upgradeDescription(1)="Deal <font color=\"#84d6d0\">75%</font> more <font color=\"#42e087\">damage</font> to enemies below <font color=\"#84d6d0\">50%</font> health."
	UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_Cremation'
	UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_Cremation_Deluxe'

	Name="Default__ZTUpgrade_Skill_Cremation"
}
