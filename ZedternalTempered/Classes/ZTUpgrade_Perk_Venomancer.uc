    UpgradeName="Venomancer"
	upgradeDescription(0)="All weapons have a <font color=\"#77d914\">%x%%</font> chance to poison ZEDs with <font color=\"#8fce00\">Neurotoxin</font>."
	upgradeDescription(1)="Your <font color=\"#8fce00\">Poison</font> effects deal <font color=\"#77d914\">%x%%</font> more damage."
	upgradeDescription(2)="Your <font color=\"#8fce00\">Poison</font> effects last <font color=\"#77d914\">%x%%</font> longer."
	PerkBonus(0)=(baseValue=0, incValue=1, maxValue=-1)
	PerkBonus(1)=(baseValue=0, incValue=1, maxValue=-1)
