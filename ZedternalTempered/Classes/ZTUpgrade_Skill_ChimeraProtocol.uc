// ===================================================================
// ZTUpgrade_Skill_ChimeraProtocol
//
// "True power comes from being many things at once."
//
// Gain bonus damage for each unique buff category currently active.
// Categories: Offense (0-4), Defense (5-6), Handling (7-10), Utility (11-14).
// Rewards diverse rolls; scales powerfully with Mimicry progression.
//
// Standard: +5% damage per active category (max +20% with all 4)
// Deluxe:   +8% damage per active category (max +32% with all 4)
// ===================================================================
class ZTUpgrade_Skill_ChimeraProtocol extends ZTUpgrade_Skill config(ZedternalUnlimited);

var config array<float> DamagePerCategory;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.DamagePerCategory[0] = 0.05f;
		default.DamagePerCategory[1] = 0.08f;

		// BEGIN TEMPERED INI DEFAULTS (generated; do not edit by hand)
		default.DamagePerCategory.Length = 2;
		default.DamagePerCategory[0] = 0.050000f;
		default.DamagePerCategory[1] = 0.080000f;
		// END TEMPERED INI DEFAULTS
		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


// Helper lookup - reuses the Shapeshifter perk's static GetHelper
static simulated function ZTUpgrade_Perk_Shapeshifter_Helper GetShapeshifterHelper(Pawn OwnerPawn)
{
    return class'ZTUpgrade_Perk_Shapeshifter'.static.GetHelper(OwnerPawn);
}

static function ModifyDamageGiven(out int InDamage, int DefaultDamage, int upgLevel, optional Actor DamageCauser, optional KFPawn_Monster MyKFPM, optional KFPlayerController DamageInstigator, optional class<KFDamageType> DamageType, optional int HitZoneIdx, optional KFWeapon MyKFW)
{
    local ZTUpgrade_Perk_Shapeshifter_Helper Helper;
    local int Categories;
    local float Bonus;

    if (MyKFPM == None || DamageInstigator == None || DamageInstigator.Pawn == None)
        return;

    Helper = GetShapeshifterHelper(DamageInstigator.Pawn);
    if (Helper == None)
        return;

    // Count unique categories from the current buff mask
    Categories = Helper.CountActiveCategories(Helper.ReplicatedBuffMask);
    if (Categories <= 0)
        return;

    Bonus = default.DamagePerCategory[upgLevel - 1] * float(Categories);
    InDamage += Round(float(DefaultDamage) * Bonus);
}

defaultproperties
{

    // --- Localization (auto-generated by mass_localize_dk_upgrades.py) ---
    // Strings live in KFGame/Localization/<lang>/ZedternalTempered.<langext>
    // Section: [ZTUpgrade_Skill_ChimeraProtocol]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalTempered"
    LocSection="ZTUpgrade_Skill_ChimeraProtocol"

    UpgradeName="Chimera Protocol"
    UpgradeDescription(0)="<font color=\"#c77dff\">Chimera Protocol:</font> Gain <font color=\"#FFFFFF\">+5%</font> <font color=\"#e0aaff\">damage</font> per active buff category (max <font color=\"#FFFFFF\">+20%</font> with all 4)"
    UpgradeDescription(1)="<font color=\"#c77dff\">Chimera Protocol:</font> Gain <font color=\"#FFFFFF\">+8%</font> <font color=\"#e0aaff\">damage</font> per active buff category (max <font color=\"#FFFFFF\">+32%</font> with all 4)"
    UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_ChimeraProtocol'
    UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_ChimeraProtocol_Deluxe'

    Name="Default__ZTUpgrade_Skill_ChimeraProtocol"
}
