class ZTUpgrade_Skill_SearingGaze extends ZTUpgrade_Skill config(ZedternalUnlimited);

var config array<float> HeadshotDamage;
var config array<float> CloakRange;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.HeadshotDamage[0] = 0.30f;
		default.HeadshotDamage[1] = 0.60f;
		default.CloakRange[0] = 0.50f;
		default.CloakRange[1] = 1.50f;

		// BEGIN TEMPERED INI DEFAULTS (generated; do not edit by hand)
		default.HeadshotDamage.Length = 2;
		default.HeadshotDamage[0] = 0.300000f;
		default.HeadshotDamage[1] = 0.600000f;
		default.CloakRange.Length = 2;
		default.CloakRange[0] = 0.500000f;
		default.CloakRange[1] = 1.500000f;
		// END TEMPERED INI DEFAULTS
		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


static simulated function bool IsCallOutActive(int upgLevel, KFPawn OwnerPawn)
{
	return True;
}

static simulated function bool CanSeeEnemyHealth(int upgLevel, KFPawn OwnerPawn)
{
	return True;
}

static simulated function ModifyCloakDetectionRange(out float InRange, float DefaultRange, int upgLevel)
{
	local float Mult;

	if (upgLevel < 1)
		return;

	// CloakRange is config-seeded server-side via UpdateConfig(). This dispatch
	// runs CLIENT-SIDE (WMPerk.GetCloakDetectionRange is simulated), where the
	// config array is empty -- reading default.CloakRange[upgLevel-1] there hit
	// an out-of-bounds (0/0) every cloak-detection check (129k log spam) and
	// silently dropped the bonus. Guard the index and fall back to the known
	// UpdateConfig defaults so the effect still applies on clients.
	if (default.CloakRange.Length >= upgLevel)
		Mult = default.CloakRange[upgLevel - 1];
	else if (upgLevel >= 2)
		Mult = 1.50f;
	else
		Mult = 0.50f;

	InRange += DefaultRange * Mult;
}

static function ModifyDamageGiven(out int InDamage, int DefaultDamage, int upgLevel, optional Actor DamageCauser, optional KFPawn_Monster MyKFPM, optional KFPlayerController DamageInstigator, optional class<KFDamageType> DamageType, optional int HitZoneIdx, optional KFWeapon MyKFW)
{
	if (HitZoneIdx == HZI_HEAD)
		InDamage += Round(float(DefaultDamage) * default.HeadshotDamage[upgLevel - 1]);
}

