// ===================================================================
// ZTUpgrade_Skill_TrophyHoarder - Expand Your Collection
//
// Increases trophy inventory capacity (extra carrying slots).
// Normal: 5 → 6 slots | Deluxe: 5 → 7 slots
//
// Strategic value: Hold more trophies at once, making it easier
// to complete multi-piece sets (especially Tier 2 triples and
// Tier 3+ boss combos).
// ===================================================================
class ZTUpgrade_Skill_TrophyHoarder extends ZTUpgrade_Skill config(ZedternalUnlimited);

var config array<int> ExtraSlots;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.ExtraSlots[0] = 1;
		default.ExtraSlots[1] = 2;

		// BEGIN TEMPERED INI DEFAULTS (generated; do not edit by hand)
		default.ExtraSlots.Length = 2;
		default.ExtraSlots[0] = 1;
		default.ExtraSlots[1] = 1;
		// END TEMPERED INI DEFAULTS
		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


static simulated function InitiateWeapon(int upgLevel, KFWeapon KFW, KFPawn OwnerPawn)
{
    local ZTUpgrade_Perk_Predator_Helper H;

    if (KFPawn_Human(OwnerPawn) != None && OwnerPawn.Role == Role_Authority)
    {
        H = class'ZTUpgrade_Perk_Predator'.static.GetHelper(OwnerPawn);
        if (H != None)
        {
            H.SkillExtraSlots = default.ExtraSlots[upgLevel - 1];
            `log("[DK_PREDATOR] TrophyHoarder: MaxInventory now" @ H.GetMaxInventory());

            // Refresh HUD to show extra slot(s)
            H.SendDisplayUpdate();
        }
    }
}

defaultproperties
{

    // --- Localization (auto-generated by mass_localize_dk_upgrades.py) ---
    // Strings live in KFGame/Localization/<lang>/ZedternalTempered.<langext>
    // Section: [ZTUpgrade_Skill_TrophyHoarder]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalTempered"
    LocSection="ZTUpgrade_Skill_TrophyHoarder"

    UpgradeName="Trophy Hoarder"
    UpgradeDescription(0)="<font color=\"#FFD700\">Trophy Hoarder:</font> Trophy inventory expanded to <font color=\"#FFFFFF\">6</font> slots. Carry more trophies to complete harder sets"
    UpgradeDescription(1)="<font color=\"#FFD700\">Trophy Hoarder:</font> Trophy inventory expanded to <font color=\"#FFFFFF\">7</font> slots. Carry more trophies to complete harder sets"
    UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_TrophyHoarder'
    UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_TrophyHoarder_Deluxe'

    Name="Default__ZTUpgrade_Skill_TrophyHoarder"
}
