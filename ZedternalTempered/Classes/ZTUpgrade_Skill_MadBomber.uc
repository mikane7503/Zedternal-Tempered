	UpgradeDescription(0)="Increase Damage of <font color=\"#ff3399\">Firebug</font> and <font color=\"#ff3399\">Demolitionist</font> weapons by <font color=\"#66cc00\">20%</font>."
	UpgradeDescription(1)="Increase Damage of <font color=\"#ff3399\">Firebug</font> and <font color=\"#ff3399\">Demolitionist</font> weapons by <font color=\"#66cc00\">35%</font>."
	UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_MadBomber'
