class ZTUpgrade_Skill_LastBreath extends ZTUpgrade_Skill config(ZedternalUnlimited);

// Last Breath: When your health drops below a critical threshold, gain a massive
// temporary damage boost. Once per wave cooldown. A desperate last stand mechanic.

var config array<float> DamageBonus;
var config array<float> HealthThreshold;
var config array<float> BuffDuration;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.DamageBonus[0] = 0.50f;
		default.DamageBonus[1] = 1.00f;
		default.HealthThreshold[0] = 0.30f;
		default.HealthThreshold[1] = 0.40f;
		default.BuffDuration[0] = 8.0f;
		default.BuffDuration[1] = 10.0f;

		// BEGIN TEMPERED INI DEFAULTS (generated; do not edit by hand)
		default.DamageBonus.Length = 2;
		default.DamageBonus[0] = 0.500000f;
		default.DamageBonus[1] = 1.000000f;
		default.HealthThreshold.Length = 2;
		default.HealthThreshold[0] = 0.300000f;
		default.HealthThreshold[1] = 0.400000f;
		default.BuffDuration.Length = 2;
		default.BuffDuration[0] = 8.000000f;
		default.BuffDuration[1] = 10.000000f;
		// END TEMPERED INI DEFAULTS
		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


static function ModifyDamageTaken(out int InDamage, int DefaultDamage, int upgLevel, KFPawn OwnerPawn, optional class<DamageType> DamageType, optional Controller InstigatedBy, optional KFWeapon MyKFW)
{
	local ZTUpgrade_Skill_LastBreath_Helper UPG;

	if (OwnerPawn != None)
	{
		UPG = GetHelper(OwnerPawn);
		if (UPG != None && !UPG.bUsedThisWave && !UPG.bBuffActive)
		{
			// Check if this damage would bring us below threshold
			if (float(OwnerPawn.Health - InDamage) / float(OwnerPawn.HealthMax) <= default.HealthThreshold[upgLevel - 1])
				UPG.ActivateBuff(default.BuffDuration[upgLevel - 1]);
		}
	}
}

static function ModifyDamageGiven(out int InDamage, int DefaultDamage, int upgLevel, optional Actor DamageCauser, optional KFPawn_Monster MyKFPM, optional KFPlayerController DamageInstigator, optional class<KFDamageType> DamageType, optional int HitZoneIdx, optional KFWeapon MyKFW)
{
	local ZTUpgrade_Skill_LastBreath_Helper UPG;

	if (DamageInstigator != None && DamageInstigator.Pawn != None)
	{
		UPG = GetHelper(KFPawn(DamageInstigator.Pawn));
		if (UPG != None && UPG.bBuffActive)
			InDamage += Round(float(DefaultDamage) * default.DamageBonus[upgLevel - 1]);
	}
}

static function WaveEnd(int upgLevel, KFPlayerController KFPC)
{
	local ZTUpgrade_Skill_LastBreath_Helper UPG;

	if (KFPC != None && KFPC.Pawn != None)
	{
		UPG = GetHelper(KFPawn(KFPC.Pawn));
		if (UPG != None)
			UPG.ResetForNewWave();
	}
}

static simulated function InitiateWeapon(int upgLevel, KFWeapon KFW, KFPawn OwnerPawn)
{
	local ZTUpgrade_Skill_LastBreath_Helper UPG;
	local bool bFound;

	if (KFPawn_Human(OwnerPawn) != None && OwnerPawn.Role == Role_Authority)
	{
		bFound = False;
		foreach OwnerPawn.ChildActors(class'ZTUpgrade_Skill_LastBreath_Helper', UPG)
		{
			bFound = True;
			break;
		}

		if (!bFound)
			UPG = OwnerPawn.Spawn(class'ZTUpgrade_Skill_LastBreath_Helper', OwnerPawn);
	}
}

static function ZTUpgrade_Skill_LastBreath_Helper GetHelper(KFPawn OwnerPawn)
{
	local ZTUpgrade_Skill_LastBreath_Helper UPG;

	if (KFPawn_Human(OwnerPawn) != None)
	{
		foreach OwnerPawn.ChildActors(class'ZTUpgrade_Skill_LastBreath_Helper', UPG)
		{
			return UPG;
		}

		UPG = OwnerPawn.Spawn(class'ZTUpgrade_Skill_LastBreath_Helper', OwnerPawn);
	}

	return UPG;
}

static simulated function DeleteHelperClass(Pawn OwnerPawn)
{
	local ZTUpgrade_Skill_LastBreath_Helper UPG;

	if (OwnerPawn != None)
	{
		foreach OwnerPawn.ChildActors(class'ZTUpgrade_Skill_LastBreath_Helper', UPG)
		{
			UPG.Destroy();
		}
	}
}

