class ZTUpgrade_Skill_GlassCannon extends ZTUpgrade_Skill config(ZedternalUnlimited);

var config array<float> Health;
var config array<float> Damage;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.Health[0] = 0.30f;
		default.Health[1] = 0.50f;
		default.Damage[0] = 0.20f;
		default.Damage[1] = 0.40f;

		// BEGIN TEMPERED INI DEFAULTS (generated; do not edit by hand)
		default.Health.Length = 2;
		default.Health[0] = 0.300000f;
		default.Health[1] = 0.500000f;
		default.Damage.Length = 2;
		default.Damage[0] = 0.200000f;
		default.Damage[1] = 0.400000f;
		// END TEMPERED INI DEFAULTS
		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


static function ModifyHealth(out int InHealth, int DefaultHealth, int upgLevel)
{
	InHealth -= Round(float(DefaultHealth) * default.Health[upgLevel - 1]);
}

static function ModifyDamageGivenPassive(out float damageFactor, int upgLevel)
{
	damageFactor += default.Damage[upgLevel - 1];
}

