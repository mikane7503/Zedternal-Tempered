class ZTWeaponUpg_Recoil extends ZTUpgrade_Weapon abstract config(ZedternalUnlimited);

var config float RecoilReduction;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 2)
	{
		default.RecoilReduction = 0.15f;
		// BEGIN TEMPERED INI DEFAULTS (generated; do not edit by hand)
		default.RecoilReduction = 0.150000f;
		// END TEMPERED INI DEFAULTS
		default.MODEVERSION = 2;
		static.StaticSaveConfig();
	}
}

static function bool IsUpgradeCompatible(class<KFWeapon> KFW)
{
	if (!KFW.default.bMeleeWeapon && KFW.default.maxRecoilPitch > 0)
		return True;
	return False;
}

static simulated function ModifyRecoil(out float InRecoilModifier, float DefaultRecoilModifier, int upgLevel, KFWeapon KFW)
{
	local float Val;
	Val = default.RecoilReduction;
	if (Val <= 0.f) Val = 0.15f;
	InRecoilModifier -= Val * upgLevel;
}

defaultproperties
{
    // --- Localization (auto-generated by mass_localize_dk_upgrades.py) ---
    // Strings live in KFGame/Localization/<lang>/ZedternalTempered.<langext>
    // Section: [ZTWeaponUpg_Recoil]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalTempered"
    LocSection="ZTWeaponUpg_Recoil"

	UpgradeName="Concussion"
	UpgradeDescription(0)="Reduces <font color=\"#15d7fa\">weapon recoil</font> by <font color=\"#77d914\">%x%%</font> per level."
	WeaponBonus=(baseValue=0, incValue=15, maxValue=-1)
	Name="Default__ZTWeaponUpg_Recoil"
}
