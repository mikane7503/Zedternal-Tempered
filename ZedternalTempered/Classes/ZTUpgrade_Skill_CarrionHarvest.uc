// ===================================================================
// ZTUpgrade_Skill_CarrionHarvest - Feed on the Fallen
//
// Heal HP when collecting a trophy. If at full HP, gain armor instead.
// Normal: +10 HP (or +5 Armor) | Deluxe: +20 HP (or +10 Armor)
//
// Sustain: Rewards aggressive collection play.
// ===================================================================
class ZTUpgrade_Skill_CarrionHarvest extends ZTUpgrade_Skill config(ZedternalUnlimited);

var config array<int> HealHP;
var config array<int> HealArmor;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.HealHP[0] = 10;
		default.HealHP[1] = 20;
		default.HealArmor[0] = 5;
		default.HealArmor[1] = 10;

		// BEGIN TEMPERED INI DEFAULTS (generated; do not edit by hand)
		default.HealHP.Length = 2;
		default.HealHP[0] = 10;
		default.HealHP[1] = 20;
		default.HealArmor.Length = 2;
		default.HealArmor[0] = 5;
		default.HealArmor[1] = 10;
		// END TEMPERED INI DEFAULTS
		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


static simulated function InitiateWeapon(int upgLevel, KFWeapon KFW, KFPawn OwnerPawn)
{
    local ZTUpgrade_Perk_Predator_Helper H;

    if (KFPawn_Human(OwnerPawn) != None && OwnerPawn.Role == Role_Authority)
    {
        H = class'ZTUpgrade_Perk_Predator'.static.GetHelper(OwnerPawn);
        if (H != None)
        {
            H.SkillCarrionHealHP = default.HealHP[upgLevel - 1];
            H.SkillCarrionHealArmor = default.HealArmor[upgLevel - 1];
            `log("[DK_PREDATOR] CarrionHarvest: +" $ H.SkillCarrionHealHP $ " HP / +" $ H.SkillCarrionHealArmor $ " Armor per collect");
        }
    }
}

defaultproperties
{

    // --- Localization (auto-generated by mass_localize_dk_upgrades.py) ---
    // Strings live in KFGame/Localization/<lang>/ZedternalTempered.<langext>
    // Section: [ZTUpgrade_Skill_CarrionHarvest]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalTempered"
    LocSection="ZTUpgrade_Skill_CarrionHarvest"

    UpgradeName="Carrion Harvest"
    UpgradeDescription(0)="<font color=\"#FFD700\">Carrion Harvest:</font> Collecting a trophy <font color=\"#FF6666\">heals</font> <font color=\"#FFFFFF\">10 HP</font>. At full health, gain <font color=\"#87CEEB\">+5 Armor</font> instead"
    UpgradeDescription(1)="<font color=\"#FFD700\">Carrion Harvest:</font> Collecting a trophy <font color=\"#FF6666\">heals</font> <font color=\"#FFFFFF\">20 HP</font>. At full health, gain <font color=\"#87CEEB\">+10 Armor</font> instead"
    UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_CarrionHarvest'
    UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_CarrionHarvest_Deluxe'

    Name="Default__ZTUpgrade_Skill_CarrionHarvest"
}
