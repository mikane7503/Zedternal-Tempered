Class ZTUpgrade_Perk_SpecialAgent extends ZTUpgrade_Perk
	config(ZedternalUnlimited);

var config float Damage, Recoil, ReloadRate;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.Damage = 0.03f;
		default.Recoil = 0.03f;
		default.ReloadRate = 0.03f;

		// BEGIN TEMPERED INI DEFAULTS (generated; do not edit by hand)
		default.Damage = 0.015000f;
		default.Recoil = 0.015000f;
		default.ReloadRate = 0.015000f;
		// END TEMPERED INI DEFAULTS
		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


static function ModifyDamageGiven(out int InDamage, int DefaultDamage, int upgLevel, optional Actor DamageCauser, optional KFPawn_Monster MyKFPM, optional KFPlayerController DamageInstigator, optional class<KFDamageType> DamageType, optional int HitZoneIdx, optional KFWeapon MyKFW)
{
	if (IsWeaponOnSpecificPerk(MyKFW, class'KFGame.KFPerk_Commando') || IsDamageTypeOnSpecificPerk(DamageType, class'KFGame.KFPerk_Commando'))
		InDamage += Round(float(DefaultDamage) * default.Damage * upgLevel);
	if (IsWeaponOnSpecificPerk(MyKFW, class'KFGame.KFPerk_Sharpshooter') || IsDamageTypeOnSpecificPerk(DamageType, class'KFGame.KFPerk_Sharpshooter'))
		InDamage += Round(float(DefaultDamage) * default.Damage * upgLevel);

}

static simulated function ModifyRecoilPassive(out float recoilFactor, int upgLevel)
{
	recoilFactor -= recoilFactor * FMin(default.Recoil * upgLevel, 0.3f);
}

static simulated function GetReloadRateScalePassive(out float reloadRateFactor, int upgLevel)
{
	reloadRateFactor = 0.3f / (0.3f / reloadRateFactor + default.ReloadRate * upgLevel);
}

defaultproperties
{
	UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Perks.UI_Perk_SpecialAgent_Rank_0'
    // --- Localization (auto-generated by mass_localize_dk_upgrades.py) ---
    // Strings live in KFGame/Localization/<lang>/ZedternalTempered.<langext>
    // Section: [ZTUpgrade_Perk_SpecialAgent]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalTempered"
    LocSection="ZTUpgrade_Perk_SpecialAgent"
    LocalizeDescriptionLineCount=3

    UpgradeName="Special Agent"
	upgradeDescription(0)="Increase <font color=\"#15d7fa\">Damage</font> of <font color=\"#476d5c\">Commando</font> and <font color=\"#476d5c\">Sharpshooter</font> weapons by <font color=\"#77d914\">%x%%</font>."
	upgradeDescription(1)="Decrease your <font color=\"#15d7fa\">Recoil</font> by <font color=\"#77d914\">%x%%</font> (capped at <font color=\"#FFFFFF\">30%</font>)."
	upgradeDescription(2)="Increase your <font color=\"#15d7fa\">Reload Speed</font> by <font color=\"#77d914\">%x%%</font>."
	PerkBonus(0)=(baseValue=0, incValue=2, maxValue=-1)
	PerkBonus(1)=(baseValue=0, incValue=2, maxValue=-1)
	PerkBonus(2)=(baseValue=0, incValue=2, maxValue=-1)
	// Legacy (hand-made) artwork icons

	Name="Default__ZTUpgrade_Perk_SpecialAgent"
}