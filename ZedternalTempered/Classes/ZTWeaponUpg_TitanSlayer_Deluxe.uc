// Titan Slayer weapon upgrade — Deluxe tier
// +7% damage vs large zeds per level.
// L1=7%, L5=35%, L10=70%
class ZTWeaponUpg_TitanSlayer_Deluxe extends ZTWeaponUpg_HollowBase abstract config(ZedternalUnlimited);

var config float DamageBonus;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.DamageBonus = 0.07f;
		// BEGIN TEMPERED INI DEFAULTS (generated; do not edit by hand)
		default.DamageBonus = 0.070000f;
		// END TEMPERED INI DEFAULTS
		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}

static function bool IsUpgradeCompatible(class<KFWeapon> KFW)
{
	return True;
}

static function ModifyDamageGiven(out int InDamage, int DefaultDamage, int upgLevel, optional Actor DamageCauser, optional KFPawn_Monster MyKFPM, optional KFPlayerController DamageInstigator, optional class<KFDamageType> DamageType, optional int HitZoneIdx, optional KFWeapon MyKFW)
{
	if (MyKFPM == None)
		return;

	if (!MyKFPM.IsA('KFPawn_ZedScrake')
		&& !MyKFPM.IsA('KFPawn_ZedFleshpound')
		&& !MyKFPM.IsA('KFPawn_ZedFleshpoundMini'))
		return;

	InDamage += Round(float(DefaultDamage) * default.DamageBonus * upgLevel);
}

defaultproperties
{
    // --- Localization (auto-generated by mass_localize_dk_upgrades.py) ---
    // Strings live in KFGame/Localization/<lang>/ZedternalTempered.<langext>
    // Section: [ZTWeaponUpg_TitanSlayer_Deluxe]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalTempered"
    LocSection="ZTWeaponUpg_TitanSlayer_Deluxe"

	UpgradeName="Titan Slayer (Deluxe)"
	UpgradeDescription(0)="Deals <font color=\"#00CCFF\">+%x%%</font> additional damage to <font color=\"#6B0099\">Scrakes and Fleshpounds</font> per level."
	WeaponBonus=(baseValue=0, incValue=7, maxValue=-1)
	RequiredSkillClassPath="ZedternalTempered.ZTUpgrade_Skill_TitanSlayer"
	bRequiresDeluxe=True
	Name="Default__ZTWeaponUpg_TitanSlayer_Deluxe"
}
