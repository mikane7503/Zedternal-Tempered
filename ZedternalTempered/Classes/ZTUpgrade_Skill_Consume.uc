class ZTUpgrade_Skill_Consume extends ZTUpgrade_Skill config(ZedternalUnlimited);

// Theme: The Wendigo devours its prey to sustain itself
// Normal: 5 HP on Large Zed kill, 10 HP on Boss kill
// Deluxe: 10 HP on Large Zed kill, 20 HP on Boss kill
var config array<int> LargeZedHeal;
var config array<int> BossHeal;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.LargeZedHeal[0] = 5;
		default.LargeZedHeal[1] = 10;
		default.BossHeal[0] = 10;
		default.BossHeal[1] = 20;

		// BEGIN TEMPERED INI DEFAULTS (generated; do not edit by hand)
		default.LargeZedHeal.Length = 2;
		default.LargeZedHeal[0] = 20;
		default.LargeZedHeal[1] = 40;
		default.BossHeal.Length = 2;
		default.BossHeal[0] = 100;
		default.BossHeal[1] = 200;
		// END TEMPERED INI DEFAULTS
		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


static function ModifyDamageGiven(out int InDamage, int DefaultDamage, int upgLevel, optional Actor DamageCauser, optional KFPawn_Monster MyKFPM, optional KFPlayerController DamageInstigator, optional class<KFDamageType> DamageType, optional int HitZoneIdx, optional KFWeapon MyKFW)
{
	local int HealAmount;

	if (MyKFPM == None || DamageInstigator == None || DamageInstigator.Pawn == None)
		return;

	// Check if this hit kills the zed
	if (MyKFPM.IsAliveAndWell() && (MyKFPM.Health - InDamage) <= 0)
	{
		if (MyKFPM.static.IsABoss())
			HealAmount = default.BossHeal[upgLevel - 1];
		else if (MyKFPM.static.IsLargeZed())
			HealAmount = default.LargeZedHeal[upgLevel - 1];

		if (HealAmount > 0)
			DamageInstigator.Pawn.HealDamage(HealAmount, DamageInstigator, class'KFDT_Healing');
	}
}

defaultproperties
{

    // --- Localization (auto-generated by mass_localize_dk_upgrades.py) ---
    // Strings live in KFGame/Localization/<lang>/ZedternalTempered.<langext>
    // Section: [ZTUpgrade_Skill_Consume]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalTempered"
    LocSection="ZTUpgrade_Skill_Consume"

	UpgradeName="Consume"
	UpgradeDescription(0)="<font color=\"#4682B4\">Consume:</font> Heal <font color=\"#FFFFFF\">5 HP</font> on <font color=\"#87CEEB\">Large Zed</font> kill, <font color=\"#FFFFFF\">10 HP</font> on <font color=\"#F0F8FF\">Boss</font> kill"
	UpgradeDescription(1)="<font color=\"#4682B4\">Consume:</font> Heal <font color=\"#FFFFFF\">10 HP</font> on <font color=\"#87CEEB\">Large Zed</font> kill, <font color=\"#FFFFFF\">20 HP</font> on <font color=\"#F0F8FF\">Boss</font> kill"

	UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_Consume'
	UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_Consume_Deluxe'

	Name="Default__ZTUpgrade_Skill_Consume"
}
