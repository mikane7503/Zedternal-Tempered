class ZTUpgrade_Skill_GrenadeConjurer extends ZTUpgrade_Skill config(ZedternalUnlimited);

var config array<float> Chance;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.Chance[0] = 0.025f;
		default.Chance[1] = 0.050f;

		// BEGIN TEMPERED INI DEFAULTS (generated; do not edit by hand)
		default.Chance.Length = 2;
		default.Chance[0] = 0.025000f;
		default.Chance[1] = 0.050000f;
		// END TEMPERED INI DEFAULTS
		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


static function ModifyDamageGiven(out int InDamage, int DefaultDamage, int upgLevel, optional Actor DamageCauser, optional KFPawn_Monster MyKFPM, optional KFPlayerController DamageInstigator, optional class<KFDamageType> DamageType, optional int HitZoneIdx, optional KFWeapon MyKFW)
{
    local KFPawn_Human KFPH;
	local KFInventoryManager KFIM;

    if((DamageInstigator != none) && DamageInstigator.Pawn != none)
    {
        KFPH = KFPawn_Human(DamageInstigator.Pawn);
		KFIM = KFInventoryManager(KFPH.InvManager);
        
        if((KFPH != none) && KFPH.IsAliveAndWell())
        {
            if(((FRand() <= (default.Chance[upgLevel - 1]) && MyKFPM != none) && MyKFPM.IsAliveAndWell()) && (MyKFPM.Health - InDamage) <= 0)
            {
              KFIM.AddGrenades( 1 );
            }
	    }
	}
}

defaultproperties
{
    // --- Localization (auto-generated by mass_localize_dk_upgrades.py) ---
    // Strings live in KFGame/Localization/<lang>/ZedternalTempered.<langext>
    // Section: [ZTUpgrade_Skill_GrenadeConjurer]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalTempered"
    LocSection="ZTUpgrade_Skill_GrenadeConjurer"

	UpgradeName="GrenadeConjurer"
	upgradeDescription(0)="Every ZED you kill has a <font color=\"#ff3399\">2.5% Chance</font> to award <font color=\"#66cc00\">1</font> <font color=\"#be4d25\">Grenade</font>."
	upgradeDescription(1)="Every ZED you kill has a <font color=\"#ff3399\">5% Chance</font> to award <font color=\"#66cc00\">1</font> <font color=\"#be4d25\">Grenades</font>."
	UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_GrenadeConjurer'
	UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_GrenadeConjurer_Deluxe'
    Name="Default__ZTUpgrade_Skill_GrenadeConjurer"
}