    bShouldLocalize=True
    LocPackage="ZedternalTempered"
    LocSection="ZTUpgrade_Skill_OverflowingGrace"

	UpgradeName="Overflowing Grace"
	UpgradeDescription(0)="Healing allies also grants them <font color=\"#4444ff\">+3 armor</font>"
	UpgradeDescription(1)="<font color=\"#ffd700\">Deluxe.</font> Healing allies also grants them <font color=\"#4444ff\">+8 armor</font>"
	UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_OverflowingGrace'
	UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_OverflowingGrace_Deluxe'

	Name="Default__ZTUpgrade_Skill_OverflowingGrace"
}
