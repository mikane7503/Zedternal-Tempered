// Overflowing Grace
// When you heal an ally, also grant them bonus armor
// Standard: +3 armor per heal
// Deluxe: +8 armor per heal
class ZTUpgrade_Skill_OverflowingGrace extends ZTUpgrade_Skill config(ZedternalUnlimited);

var config array<int> ArmorGrant;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.ArmorGrant[0] = 3;
		default.ArmorGrant[1] = 8;

		// BEGIN TEMPERED INI DEFAULTS (generated; do not edit by hand)
		default.ArmorGrant.Length = 2;
		default.ArmorGrant[0] = 1;
		default.ArmorGrant[1] = 2;
		// END TEMPERED INI DEFAULTS
		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


static function HealingDamage(int upgLevel, int HealAmount, KFPawn HealedPawn, KFPawn InstigatorPawn, class<DamageType> DamageType)
{
	local WMPawn_Human WMPH;

	if (HealedPawn != None && InstigatorPawn != None && HealAmount > 0 && HealedPawn != InstigatorPawn)
	{
		WMPH = WMPawn_Human(HealedPawn);
		if (WMPH != None && WMPH.IsAliveAndWell())
			WMPH.AddArmor(default.ArmorGrant[upgLevel - 1]);
	}
}

defaultproperties
{

