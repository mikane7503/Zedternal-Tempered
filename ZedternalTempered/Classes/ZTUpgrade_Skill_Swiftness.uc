// ===================================================================
// ZTUpgrade_Skill_Swiftness - Active ability: temporary speed boost
// Standard: +25% speed for 10s
// Deluxe: +50% speed for 10s
// Cooldown: 60s after effect ends (70s total between uses)
// ===================================================================
class ZTUpgrade_Skill_Swiftness extends ZTUpgrade_Skill config(ZedternalUnlimited);

// Store bonus values in defaultproperties (accessible everywhere)
var config array<float> SpeedBonus;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.SpeedBonus[0] = 0.25f;
		default.SpeedBonus[1] = 0.5f;

		// BEGIN TEMPERED INI DEFAULTS (generated; do not edit by hand)
		default.SpeedBonus.Length = 2;
		default.SpeedBonus[0] = 0.250000f;
		default.SpeedBonus[1] = 0.500000f;
		// END TEMPERED INI DEFAULTS
		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


// Called when skill is purchased - spawn the helper
static simulated function InitiateWeapon(int upgLevel, KFWeapon KFW, KFPawn OwnerPawn)
{
	local ZTUpgrade_Skill_Swiftness_Helper Helper;
	local ZTPlayerController DKPC;
	local bool bFound;
	
	if (KFPawn_Human(OwnerPawn) == None || OwnerPawn.Role != Role_Authority)
		return;
	
	DKPC = ZTPlayerController(OwnerPawn.Controller);
	if (DKPC == None)
	{
		`log("ZTUpgrade_Skill_Swiftness: ERROR - Player does not have ZTPlayerController!");
		return;
	}
	
	// Check if helper already exists
	bFound = false;
	foreach OwnerPawn.ChildActors(class'ZTUpgrade_Skill_Swiftness_Helper', Helper)
	{
		bFound = true;
		// Update to new tier if upgrading Standard -> Deluxe
		Helper.SetTier(upgLevel);
		`log("ZTUpgrade_Skill_Swiftness: Updated existing helper to tier" @ upgLevel);
		break;
	}
	
	// Spawn new helper if not found
	if (!bFound)
	{
		Helper = OwnerPawn.Spawn(class'ZTUpgrade_Skill_Swiftness_Helper', OwnerPawn);
		if (Helper != None)
		{
			Helper.Initialize(upgLevel, KFPawn_Human(OwnerPawn), DKPC);
			`log("ZTUpgrade_Skill_Swiftness: Spawned helper for" @ OwnerPawn.PlayerReplicationInfo.PlayerName);
		}
		else
		{
			`log("ZTUpgrade_Skill_Swiftness: ERROR - Failed to spawn helper!");
		}
	}
}

// Called when skill is removed - cleanup
static simulated function DeleteHelperClass(Pawn OwnerPawn)
{
	local ZTUpgrade_Skill_Swiftness_Helper Helper;
	
	if (OwnerPawn == None)
		return;
	
	foreach OwnerPawn.ChildActors(class'ZTUpgrade_Skill_Swiftness_Helper', Helper)
	{
		Helper.Cleanup();
		Helper.Destroy();
		`log("ZTUpgrade_Skill_Swiftness: Cleaned up helper");
	}
}

// Apply speed bonus when Swiftness is active
static simulated function ModifySpeed(out float InSpeed, float DefaultSpeed, int upgLevel, KFPawn OwnerPawn)
{
	local ZTUpgrade_Skill_Swiftness_Helper Helper;
	
	if (OwnerPawn == None)
		return;
	
	// Find the helper
	foreach OwnerPawn.ChildActors(class'ZTUpgrade_Skill_Swiftness_Helper', Helper)
	{
		// Check replicated bActive flag
		if (Helper.bActive)
		{
			// Add bonus based on tier (stored in static defaultproperties)
			InSpeed += DefaultSpeed * default.SpeedBonus[upgLevel - 1];
		}
		break;
	}
}

defaultproperties
{
    // --- Localization (auto-generated by mass_localize_dk_upgrades.py) ---
    // Strings live in KFGame/Localization/<lang>/ZedternalTempered.<langext>
    // Section: [ZTUpgrade_Skill_Swiftness]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalTempered"
    LocSection="ZTUpgrade_Skill_Swiftness"

	// Bonus values stored in defaultproperties (accessible on all sides)
	
	UpgradeName="Swiftness"
	
	upgradeDescription(0)="Unlocks <font color=\"#66cc00\">Swiftness</font> active ability: <font color=\"#00ffff\">+25% movement speed</font> for <font color=\"#ffaa33\">10 seconds</font>. Cooldown: <font color=\"#ff9900\">60 seconds</font>."
	
	upgradeDescription(1)="Unlocks <font color=\"#66cc00\">Swiftness (Deluxe)</font> active ability: <font color=\"#00ffff\">+50% movement speed</font> for <font color=\"#ffaa33\">10 seconds</font>. Cooldown: <font color=\"#ff9900\">60 seconds</font>."
	
	UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_Swiftness'
	UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_Swiftness_Deluxe'
	
	Name="Default__ZTUpgrade_Skill_Swiftness"
}