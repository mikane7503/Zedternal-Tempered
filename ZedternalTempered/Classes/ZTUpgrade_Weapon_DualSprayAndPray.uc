class ZTUpgrade_Weapon_DualSprayAndPray extends ZTUpgrade_Weapon abstract hidecategories(Navigation,Movement,Collision,Navigation,Movement,Collision);

var float Damage, ReloadRate;

static function bool IsUpgradeCompatible(Class<KFWeapon> KFW)
{
    // End:0x1D
    if(Class<KFWeap_MeleeBase>(KFW) != none)
    {
        return false;        
    }
    else
    {
        // End:0x37
        if(Class<KFWeap_ThrownBase>(KFW) != none)
        {
            return false;
        }
    }
    return true;
    //return ReturnValue;    
}

static function ModifyDamageGiven(out int InDamage, int DefaultDamage, int upgLevel, optional Actor DamageCauser, optional KFPawn_Monster MyKFPM, optional KFPlayerController DamageInstigator, optional Class<KFDamageType> DamageType, optional int HitZoneIdx, optional KFWeapon MyKFW)
{
    InDamage += Round((float(DefaultDamage) * default.Damage) * float(upgLevel));
    //return;    
}

static simulated function GetReloadRateScale(out float InReloadRateScale, int upgLevel, KFWeapon KFW, KFPawn OwnerPawn)
{
    InReloadRateScale = 1.0000000 / ((1.0000000 / InReloadRateScale) + (default.ReloadRate * float(upgLevel)));
    //return;    
}

defaultproperties
{
    // --- Localization (auto-generated by mass_localize_dk_upgrades.py) ---
    // Strings live in KFGame/Localization/<lang>/ZedternalTempered.<langext>
    // Section: [ZTUpgrade_Weapon_DualSprayAndPray]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalTempered"
    LocSection="ZTUpgrade_Weapon_DualSprayAndPray"

    Damage=0.05000000
	ReloadRate=0.0500000
    WeaponBonus=(incValue=5,MaxValue=-1)
	UpgradeName="Dual Spray and Pray"
    UpgradeDescription(0)="Increases your <font color=\"#15d7fa\">weapon damage</font> and <font color=\"#15d7fa\">reload speed</font> by <font color=\"#77d914\">+%x%%</font> per level."
}