// Venomous Riposte: Taking damage releases a toxic shockwave that poisons nearby ZEDs.
// Has a cooldown between activations.
// Pattern based on ColdRiposte.
class ZTUpgrade_Skill_VenomousRiposte extends ZTUpgrade_Skill;

static function ModifyDamageTaken(out int InDamage, int DefaultDamage, int upgLevel, KFPawn OwnerPawn, optional class<DamageType> DamageType, optional Controller InstigatedBy, optional KFWeapon MyKFW)
{
	local ZTUpgrade_Skill_VenomousRiposte_Helper UPG;

	if (InDamage > 0)
	{
		UPG = GetHelper(OwnerPawn, upgLevel);
		if (UPG != None && UPG.bReady)
			UPG.PoisonBurst();
	}
}

static function ZTUpgrade_Skill_VenomousRiposte_Helper GetHelper(KFPawn OwnerPawn, int upgLevel)
{
	local ZTUpgrade_Skill_VenomousRiposte_Helper UPG;

	if (KFPawn_Human(OwnerPawn) != None)
	{
		foreach OwnerPawn.ChildActors(class'ZTUpgrade_Skill_VenomousRiposte_Helper', UPG)
		{
			return UPG;
		}

		UPG = OwnerPawn.Spawn(class'ZTUpgrade_Skill_VenomousRiposte_Helper', OwnerPawn);
		UPG.bDeluxe = (upgLevel > 1);
	}

	return UPG;
}

static simulated function DeleteHelperClass(Pawn OwnerPawn)
{
	local ZTUpgrade_Skill_VenomousRiposte_Helper UPG;

	if (OwnerPawn != None)
	{
		foreach OwnerPawn.ChildActors(class'ZTUpgrade_Skill_VenomousRiposte_Helper', UPG)
		{
			UPG.Destroy();
		}
	}
}

