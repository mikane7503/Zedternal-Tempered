	UpgradeDescription(0)="Taking damage releases a <font color=\"#399c0e\">toxic shockwave</font> that <font color=\"#8fce00\">Poisons</font> nearby ZEDs. <font color=\"#ebd402\">20 second cooldown</font>."
	UpgradeDescription(1)="Taking damage releases a <font color=\"#b346ea\">toxic shockwave</font> that <font color=\"#8fce00\">Poisons</font> nearby ZEDs with <font color=\"#b346ea\">increased range and damage</font>. <font color=\"#ebd402\">20 second cooldown</font>."

	UpgradeName="Venomous Riposte"
