// Symbiotic Toxin: Killing poisoned ZEDs restores ammo to your current weapon's magazine.
// Uses ModifyDamageGiven to cache poisoned status, AddVampireHealth as kill trigger.
// Ammo pattern based on MagicBullet.
class ZTUpgrade_Skill_SymbioticToxin extends ZTUpgrade_Skill config(ZedternalUnlimited);

var config array<int> Ammo;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.Ammo[0] = 2;
		default.Ammo[1] = 4;

		// BEGIN TEMPERED INI DEFAULTS (generated; do not edit by hand)
		default.Ammo.Length = 2;
		default.Ammo[0] = 2;
		default.Ammo[1] = 4;
		// END TEMPERED INI DEFAULTS
		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


static function ModifyDamageGiven(out int InDamage, int DefaultDamage, int upgLevel, optional Actor DamageCauser, optional KFPawn_Monster MyKFPM, optional KFPlayerController DamageInstigator, optional class<KFDamageType> DamageType, optional int HitZoneIdx, optional KFWeapon MyKFW)
{
	local ZTUpgrade_Skill_SymbioticToxin_Helper UPG;

	if (MyKFPM != None && DamageInstigator != None && DamageInstigator.Pawn != None)
	{
		UPG = GetHelper(DamageInstigator.Pawn);
		if (UPG != None)
			UPG.UpdateTarget(MyKFPM);
	}
}

static function AddVampireHealth(out int InHealth, int DefaultHealth, int upgLevel, KFPlayerController KFPC, class<DamageType> DT)
{
	local ZTUpgrade_Skill_SymbioticToxin_Helper UPG;

	if (KFPC != None && KFPC.Pawn != None)
	{
		UPG = GetHelper(KFPC.Pawn);
		if (UPG != None && UPG.WasTargetPoisoned())
		{
			if (UPG.Player.WorldInfo.NetMode == NM_Standalone)
				UPG.StandaloneUpdateAmmo(default.Ammo[upgLevel - 1]);
			else
				UPG.ServerUpdateAmmo(default.Ammo[upgLevel - 1]);
		}
	}
}

static function ZTUpgrade_Skill_SymbioticToxin_Helper GetHelper(Pawn OwnerPawn)
{
	local ZTUpgrade_Skill_SymbioticToxin_Helper UPG;

	if (KFPawn_Human(OwnerPawn) != None)
	{
		foreach OwnerPawn.ChildActors(class'ZTUpgrade_Skill_SymbioticToxin_Helper', UPG)
		{
			return UPG;
		}

		UPG = OwnerPawn.Spawn(class'ZTUpgrade_Skill_SymbioticToxin_Helper', OwnerPawn);
	}

	return UPG;
}

static simulated function DeleteHelperClass(Pawn OwnerPawn)
{
	local ZTUpgrade_Skill_SymbioticToxin_Helper UPG;

	if (OwnerPawn != None)
	{
		foreach OwnerPawn.ChildActors(class'ZTUpgrade_Skill_SymbioticToxin_Helper', UPG)
		{
			UPG.Destroy();
		}
	}
}

defaultproperties
{

    // --- Localization (auto-generated by mass_localize_dk_upgrades.py) ---
    // Strings live in KFGame/Localization/<lang>/ZedternalTempered.<langext>
    // Section: [ZTUpgrade_Skill_SymbioticToxin]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalTempered"
    LocSection="ZTUpgrade_Skill_SymbioticToxin"

	UpgradeDescription(0)="Killing <font color=\"#8fce00\">Poisoned</font> ZEDs restores <font color=\"#399c0e\">2</font> ammo to your current magazine."
	UpgradeDescription(1)="Killing <font color=\"#8fce00\">Poisoned</font> ZEDs restores <font color=\"#b346ea\">4</font> ammo to your current magazine."

	UpgradeName="SymbioticToxin"
	UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_SymbioticToxin'
	UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_SymbioticToxin_Deluxe'

	Name="Default__ZTUpgrade_Skill_SymbioticToxin"
}
