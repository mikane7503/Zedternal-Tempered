class ZTUpgrade_Skill_NestOfVipers extends ZTUpgrade_Skill config(ZedternalUnlimited);

var config array<float> TriggerTime;
var config array<float> CloudRange;
var config array<int> CloudDamage;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.TriggerTime[0] = 5.0f;
		default.TriggerTime[1] = 3.0f;
		default.CloudRange[0] = 400.0f;
		default.CloudRange[1] = 600.0f;
		default.CloudDamage[0] = 3;
		default.CloudDamage[1] = 5;

		// BEGIN TEMPERED INI DEFAULTS (generated; do not edit by hand)
		default.TriggerTime.Length = 2;
		default.TriggerTime[0] = 5.000000f;
		default.TriggerTime[1] = 3.000000f;
		default.CloudRange.Length = 2;
		default.CloudRange[0] = 400.000000f;
		default.CloudRange[1] = 600.000000f;
		default.CloudDamage.Length = 2;
		default.CloudDamage[0] = 3;
		default.CloudDamage[1] = 5;
		// END TEMPERED INI DEFAULTS
		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


static simulated function InitiateWeapon(int upgLevel, KFWeapon KFW, KFPawn OwnerPawn)
{
    local ZTUpgrade_Skill_NestOfVipers_Helper ViperHelper;
    local bool bFound;

    if (KFPawn_Human(OwnerPawn) != None && OwnerPawn.Role == Role_Authority)
    {
        bFound = False;
        foreach OwnerPawn.ChildActors(class'ZTUpgrade_Skill_NestOfVipers_Helper', ViperHelper)
        {
            bFound = True;
            break;
        }

        if (!bFound)
        {
            ViperHelper = OwnerPawn.Spawn(class'ZTUpgrade_Skill_NestOfVipers_Helper', OwnerPawn);
            ViperHelper.UpgradeLevel = upgLevel;
        }
    }
}

static function ZTUpgrade_Skill_NestOfVipers_Helper GetHelper(Pawn OwnerPawn)
{
    local ZTUpgrade_Skill_NestOfVipers_Helper ViperHelper;

    if (KFPawn_Human(OwnerPawn) != None)
    {
        foreach OwnerPawn.ChildActors(class'ZTUpgrade_Skill_NestOfVipers_Helper', ViperHelper)
        {
            return ViperHelper;
        }

        // Create one if needed
        ViperHelper = OwnerPawn.Spawn(class'ZTUpgrade_Skill_NestOfVipers_Helper', OwnerPawn);
    }

    return ViperHelper;
}

static simulated function DeleteHelperClass(Pawn OwnerPawn)
{
    local ZTUpgrade_Skill_NestOfVipers_Helper ViperHelper;

    if (OwnerPawn != None)
    {
        foreach OwnerPawn.ChildActors(class'ZTUpgrade_Skill_NestOfVipers_Helper', ViperHelper)
        {
            ViperHelper.Destroy();
        }
    }
}

