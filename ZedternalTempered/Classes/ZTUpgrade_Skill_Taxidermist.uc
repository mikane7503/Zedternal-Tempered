// ===================================================================
// ZTUpgrade_Skill_Taxidermist - Preservation Expert
//
// Set phase: When a set consumes trophies, each trophy has a chance
// to be preserved (counts toward the set but is not consumed).
//
// Stacking phase: Each trophy collected has a chance to also add +1
// to a random other category you already hold. Your preserved
// specimens breed more specimens.
//
// Normal: 20% chance | Deluxe: 40% chance
// ===================================================================
class ZTUpgrade_Skill_Taxidermist extends ZTUpgrade_Skill config(ZedternalUnlimited);

var config array<float> PreserveChance;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.PreserveChance[0] = 0.20f;
		default.PreserveChance[1] = 0.40f;

		// BEGIN TEMPERED INI DEFAULTS (generated; do not edit by hand)
		default.PreserveChance.Length = 2;
		default.PreserveChance[0] = 0.200000f;
		default.PreserveChance[1] = 0.400000f;
		// END TEMPERED INI DEFAULTS
		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


static simulated function InitiateWeapon(int upgLevel, KFWeapon KFW, KFPawn OwnerPawn)
{
    local ZTUpgrade_Perk_Predator_Helper H;

    if (KFPawn_Human(OwnerPawn) != None && OwnerPawn.Role == Role_Authority)
    {
        H = class'ZTUpgrade_Perk_Predator'.static.GetHelper(OwnerPawn);
        if (H != None)
        {
            H.SkillPreserveChance = default.PreserveChance[upgLevel - 1];
            `log("[DK_PREDATOR] Taxidermist:" @ int(H.SkillPreserveChance * 100.0f) $ "% preservation chance");
        }
    }
}

defaultproperties
{

    // --- Localization (auto-generated by mass_localize_dk_upgrades.py) ---
    // Strings live in KFGame/Localization/<lang>/ZedternalTempered.<langext>
    // Section: [ZTUpgrade_Skill_Taxidermist]  -- see DKUpgrade_* base class for details.
    bShouldLocalize=True
    LocPackage="ZedternalTempered"
    LocSection="ZTUpgrade_Skill_Taxidermist"

    UpgradeName="Taxidermist"
    UpgradeDescription(0)="<font color=\"#FFD700\">Taxidermist:</font> <font color=\"#FFFFFF\">20%</font> chance trophies are <font color=\"#87CEEB\">preserved</font> when used in a set. During stacking: <font color=\"#FFFFFF\">20%</font> chance to also add <font color=\"#87CEEB\">+1</font> to a random held category"
    UpgradeDescription(1)="<font color=\"#FFD700\">Taxidermist:</font> <font color=\"#FFFFFF\">40%</font> chance trophies are <font color=\"#87CEEB\">preserved</font> when used in a set. During stacking: <font color=\"#FFFFFF\">40%</font> chance to also add <font color=\"#87CEEB\">+1</font> to a random held category"
    UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_Taxidermist'
    UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_Taxidermist_Deluxe'

    Name="Default__ZTUpgrade_Skill_Taxidermist"
}
