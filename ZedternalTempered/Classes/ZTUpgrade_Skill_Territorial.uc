    bShouldLocalize=True
    LocPackage="ZedternalTempered"
    LocSection="ZTUpgrade_Skill_Territorial"

	UpgradeName="Territorial"
	UpgradeDescription(0)="<font color=\"#4682B4\">Territorial:</font> <font color=\"#FFFFFF\">100%</font> <font color=\"#87CEEB\">faster welding</font> and <font color=\"#F0F8FF\">unwelding</font> speed"
	UpgradeDescription(1)="<font color=\"#4682B4\">Territorial:</font> <font color=\"#FFFFFF\">200%</font> <font color=\"#87CEEB\">faster welding</font> and <font color=\"#F0F8FF\">unwelding</font> speed"

	UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_Territorial'
	UpgradeIcon(1)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_Territorial_Deluxe'

	Name="Default__ZTUpgrade_Skill_Territorial"
}
