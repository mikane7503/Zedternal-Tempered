    UpgradeName="House Edge"
    
    upgradeDescription(0)="Every <font color=\"#ffaa33\">25th kill</font> triggers slot machine: <font color=\"#777777\">80% nothing</font>, <font color=\"#ffaa33\">15% +50 dosh</font>, <font color=\"#ff6600\">4% +150 dosh</font>, <font color=\"#ff0000\">1% +300 dosh</font>."
    upgradeDescription(1)="Every <font color=\"#ffaa33\">20th kill</font> triggers slot machine: <font color=\"#777777\">60% nothing</font>, <font color=\"#ffaa33\">25% +50 dosh</font>, <font color=\"#ff6600\">10% +150 dosh</font>, <font color=\"#ff0000\">5% +300 dosh</font>."
    
