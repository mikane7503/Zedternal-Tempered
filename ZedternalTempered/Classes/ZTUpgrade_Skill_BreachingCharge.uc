// ===================================================================
// ZTUpgrade_Skill_BreachingCharge - Active ability: temporary stumble power boost
// Standard: +50% stumble power for 10s
// Deluxe: +75% stumble power for 10s
// Cooldown: 60s after effect ends
// ===================================================================
class ZTUpgrade_Skill_BreachingCharge extends ZTUpgrade_Skill config(ZedternalUnlimited);

var config array<float> StumblePowerBonus;
var config int MODEVERSION;

static function UpdateConfig()
{
	if (default.MODEVERSION < 1)
	{
		default.StumblePowerBonus[0] = 0.5f;
		default.StumblePowerBonus[1] = 0.75f;

		// BEGIN TEMPERED INI DEFAULTS (generated; do not edit by hand)
		default.StumblePowerBonus.Length = 2;
		default.StumblePowerBonus[0] = 0.500000f;
		default.StumblePowerBonus[1] = 0.750000f;
		// END TEMPERED INI DEFAULTS
		default.MODEVERSION = 1;
		static.StaticSaveConfig();
	}
}


static simulated function InitiateWeapon(int upgLevel, KFWeapon KFW, KFPawn OwnerPawn)
{
	local ZTUpgrade_Skill_BreachingCharge_Helper Helper;
	local ZTPlayerController DKPC;
	local bool bFound;
	
	if (KFPawn_Human(OwnerPawn) == None || OwnerPawn.Role != Role_Authority)
		return;
	
	DKPC = ZTPlayerController(OwnerPawn.Controller);
	if (DKPC == None)
	{
		`log("ZTUpgrade_Skill_BreachingCharge: ERROR - Player does not have ZTPlayerController!");
		return;
	}
	
	bFound = false;
	foreach OwnerPawn.ChildActors(class'ZTUpgrade_Skill_BreachingCharge_Helper', Helper)
	{
		bFound = true;
		Helper.SetTier(upgLevel);
		`log("ZTUpgrade_Skill_BreachingCharge: Updated existing helper to tier" @ upgLevel);
		break;
	}
	
	if (!bFound)
	{
		Helper = OwnerPawn.Spawn(class'ZTUpgrade_Skill_BreachingCharge_Helper', OwnerPawn);
		if (Helper != None)
		{
			Helper.Initialize(upgLevel, KFPawn_Human(OwnerPawn), DKPC);
			`log("ZTUpgrade_Skill_BreachingCharge: Spawned helper for" @ OwnerPawn.PlayerReplicationInfo.PlayerName);
		}
		else
		{
			`log("ZTUpgrade_Skill_BreachingCharge: ERROR - Failed to spawn helper!");
		}
	}
}

static simulated function DeleteHelperClass(Pawn OwnerPawn)
{
	local ZTUpgrade_Skill_BreachingCharge_Helper Helper;
	
	if (OwnerPawn == None)
		return;
	
	foreach OwnerPawn.ChildActors(class'ZTUpgrade_Skill_BreachingCharge_Helper', Helper)
	{
		Helper.Cleanup();
		Helper.Destroy();
		`log("ZTUpgrade_Skill_BreachingCharge: Cleaned up helper");
	}
}

static function ModifyStumblePower(out float InStumblePower, float DefaultStumblePower, int upgLevel,
	optional KFPawn KFP, optional class<KFDamageType> DamageType, optional out float CooldownModifier,
	optional byte BodyPart, optional KFPawn OwnerPawn)
{
	local ZTUpgrade_Skill_BreachingCharge_Helper Helper;
	
	if (OwnerPawn == None)
		return;
	
	foreach OwnerPawn.ChildActors(class'ZTUpgrade_Skill_BreachingCharge_Helper', Helper)
	{
		if (Helper.bActive)
		{
			InStumblePower += DefaultStumblePower * default.StumblePowerBonus[upgLevel - 1];
		}
		break;
	}
}

