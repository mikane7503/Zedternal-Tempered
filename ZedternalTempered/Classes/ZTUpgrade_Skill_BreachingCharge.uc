	upgradeDescription(1)="Unlocks <font color=\"#66cc00\">Breaching Charge (Deluxe)</font> active ability: <font color=\"#00ffff\">+75% stumble power</font> for <font color=\"#ffaa33\">10 seconds</font>. Cooldown: <font color=\"#ff9900\">60 seconds</font>."
	
	UpgradeIcon(0)=Texture2D'ZedternalRBPerkpackage_Resources.Skills.UI_Skill_BreachingCharge'
